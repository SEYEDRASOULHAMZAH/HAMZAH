        hcp_prediction = 1.0  # مقدار پیش‌بینی شده توسط HCP
        
        error = abs(quantum_mean - hcp_prediction)
        error_percentage = (error / hcp_prediction) * 100 if hcp_prediction != 0 else 0
        
        confirmed = error_percentage < 1.0  # خطای کمتر از 1%
        
        return {
            'hcp_prediction': hcp_prediction,
            'quantum_value': quantum_mean,
            'error': error,
