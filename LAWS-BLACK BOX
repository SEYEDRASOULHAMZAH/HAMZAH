    def _generate_quantum_signature(self, encrypted_data: Dict[str, Any]) -> str:
        """تولید امضای کوانتومی"""
        # ترکیب تمام داده‌ها
        combined = b''
        for scenario_id, scenario in encrypted_data.items():
            combined += str(scenario_id).encode()
            for layer in scenario.get('encrypted_layers', []):
                combined += layer.get('encrypted_data', b'')
        
        # 150 دور هش برای 150 سناریو
        signature = combined
        for _ in range(150):
            signature = hashlib.sha3_512(signature).digest()
        
        return signature.hex()
    
    def _calculate_integrity_hash(self, encrypted_data: Dict[str, Any]) -> str:
        """محاسبه هش یکپارچگی"""
        # درخت مرکل برای یکپارچگی
        leaves = []
        
        for scenario_id, scenario in encrypted_data.items():
            scenario_hash = hashlib.sha3_256(
                str(scenario_id).encode() + 
                scenario.get('original_hash', '').encode()
            ).hexdigest()
            leaves.append(scenario_hash.encode())
        
        # ساخت درخت مرکل
        while len(leaves) > 1:
            new_leaves = []
            for i in range(0, len(leaves), 2):
                if i + 1 < len(leaves):
                    combined = leaves[i] + leaves[i + 1]
                else:
                    combined = leaves[i]
                new_leaves.append(hashlib.sha3_256(combined).digest())
            leaves = new_leaves
        
        return leaves[0].hex() if leaves else ''

