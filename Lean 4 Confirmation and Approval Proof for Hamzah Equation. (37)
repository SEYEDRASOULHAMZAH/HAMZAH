        if belief != reality:
            return "TRIGGERING_PATCH_ALGORITHM (ایجاد بهانه منطقی برایِ حفظِ یکپارچگی گره)", "PATCHING"
        return "LOGIC_SYNCED (همگام‌سازی کامل باور و واقعیت)", "SYNCED"

    def run_simulation(self) -> dict:
        """شبیه‌سازیِ تحلیلِ گره‌هایِ انسانی و رفتاری در مانیفلد حمزه‌اکسل"""
