        print("=" * 115)
        print(f"ثابت مرجع (C): {self.C:.1e} | دترمینان هسین (Det H825): {self.det_H:.1e}")
        print(f"{'چگالی ورودی (I)':<25} | {'فرکانسِ کانیبال (Omega)':<35} | {'دترمینان ژاکوبی':<25} | {'وضعیتِ سیستم'}")
        print("-" * 115)
        
        results = []
        for i in mass_inflow:
            omg, det_j, status = self.resolve_cannibalism(i)
            
            results.append({
                "mass_inflow": i,
                "omega": omg,
                "jacobian_det": det_j,
                "status": status
            })
            
            print(f"{i:<25.2e} | {omg:<35.4e} | {det_j:<25.4f} | [{status}]")
            
        print("-" * 115)
        print("[تاییدِ نهایی]: پیاده‌سازی رسمی گیت ۸۱ اجرا شد؛ موازنه تانسوری و ژاکوبی با موفقیت تایید گشت.")
        print("=" * 115)
        return results

