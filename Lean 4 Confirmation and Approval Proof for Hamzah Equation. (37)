        print(f"{'اصلِ علوم انسانی':<25} | {'وضعیتِ پردازشِ HIP (Protocol Check)':<55} | {'وضعیتِ سیستمی'}")
        print("-" * 135)
        
        # 1. تست هرم مازلو با سطح انرژی بحرانی 20
