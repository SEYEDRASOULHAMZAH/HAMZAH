import numpy as np

class HamzahBigBootEngine:
    """
    موتورِ ماشه‌یِ ری‌بوتِ کمّی (HamzahXcell Architecture - Gate 99)
    صدورِ فرمانِ پاکسازیِ شبکه‌یِ فضا-زمان و مهارِ اشباعِ آنتروپیک
    """
    def __init__(self, entropy_threshold: float = 724.0, balance_tolerance: float = 0.001):
        self.threshold = entropy_threshold
        self.tolerance = balance_tolerance
        
    def check_reboot_condition(self, entropy_load: float, action_variation: float) -> tuple[str, bool, str]:
        """بررسی توازن آنتروپیک و سنجش نیاز به صدور فرمان ری‌بوت سیستم"""
        # شرطِ توازن: d(rho)/dt - delta(S)/delta(rho) == 0
        balance_check = float(np.abs(entropy_load - action_variation))
        
        if balance_check < self.tolerance or entropy_load >= self.threshold:
            status = "BIG_BOOT_TRIGGERED (پاکسازیِ کدِ جرمی فعال)"
            triggered = True
            flag = "ENTROPY_SATURATION_PURGE"
        else:
            status = "SYSTEM_STABLE (در حالِ پردازش)"
            triggered = False
            flag = "MANIFOLD_OPERATIONAL"
            
        return status, triggered, flag

    def run_simulation(self) -> list[dict]:
        """شبیه‌سازیِ مانیفلد در آستانه‌یِ اشباعِ آنتروپیک در گیت ۹۹"""
        scenarios = [
            (720.0, 720.0),
            (750.0, 750.0)
        ]  # ورودی: بارِ آنتروپیک و تغییراتِ اکشن
        
        print("=" * 135)
        print(f"{'--- HAMZAH GATE 99 BIG BOOT ENGINE REPORT ---':^135}")
        print("=" * 135)
        print(f"آستانه بحرانی آنتروپی: {self.threshold} | تلورانس توازن: {self.tolerance}")
        print(f"{'بارِ آنتروپیک':<20} | {'تغییراتِ اکشن':<20} | {'وضعیتِ ری‌بوت':<40} | {'پرچمِ سیستمی'}")
        print("-" * 135)
        
        results = []
        for entropy, action in scenarios:
            status, triggered, flag = self.check_reboot_condition(entropy, action)
            
            results.append({
                "entropy_load": entropy,
                "action_variation": action,
                "status": status,
                "triggered": triggered,
                "flag": flag
            })
            
            print(f"{entropy:<20.1f} | {action:<20.1f} | {status:<40} | [{flag}]")
            
        print("-" * 135)
        print("[تاییدِ نهایی]: موتور ری‌بوت کمّی اجرا شد؛ پاکسازی شبکه فضا-زمان با موفقیت مدیریت گشت.")
        print("=" * 135)
        return results

