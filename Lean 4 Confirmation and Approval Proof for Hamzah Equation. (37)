import numpy as np

class HamzahBioLogicEngine:
    """
    موتورِ بازنویسیِ اصولِ زیستی به منطقِ دترمینستیِ HIP (HamzahXcell Architecture)
    مدیریتِ هومئوستازیِ دینامیک و انتخابِ طبیعیِ کدهایِ مانیفلد
    """
    def __init__(self, homeostasis_target: float = 37.0):
        self.homeostasis_target = homeostasis_target  # دمایِ هدفِ مرجع در مانیفلد
        self.tolerance_threshold = 0.5
        
    def homeostatic_regulator(self, current_temp: float) -> tuple[str, bool]:
        """بازنویسیِ هومئوستازی: ارزیابیِ انحراف و فعال‌سازیِ بافرِ میراییِ دینامیک"""
        delta = float(self.homeostasis_target - current_temp)
        if abs(delta) > self.tolerance_threshold:
            return "Damping_Active (فعال‌سازی میرایی ترمودینامیک)", True
        return "System_Nominal (تعادل پایدار مانیفلد)", False

    def natural_selection_optimizer(self, fitness_scores: list[dict]) -> dict:
        """بازنویسیِ انتخاب طبیعی: گزینشِ بالاترین ضریبِ بهینگی کد در جمعیت"""
        if not fitness_scores:
            raise ValueError("لیست جمعیت خالی است.")
        winner = max(fitness_scores, key=lambda x: x.get('code_efficiency', 0.0))
        return winner

    def run_simulation(self) -> dict:
        """اجرایِ شبیه‌سازیِ پروتکل‌هایِ حیاتیِ هومئوستازی و انتخاب طبیعی"""
        print("=" * 135)
        print(f"{'--- HAMZAH BIOLOGIC ENGINE SIMULATION REPORT ---':^135}")
        print("=" * 135)
        print(f"دمای هدف هومئوستازی: {self.homeostasis_target}°C | آستانه تلورانس: {self.tolerance_threshold}")
        print(f"{'اصلِ زیستی':<25} | {'وضعیتِ پردازشِ HIP (Protocol Check)':<55} | {'وضعیتِ سیستمی'}")
        print("-" * 135)
        
        # 1. تست هومئوستازی با دمای بحرانی 38.5
        temp_input = 38.5
        correction_msg, is_damping = self.homeostatic_regulator(temp_input)
        print(f"{'هومئوستازی (بافر حرارتی)':<25} | {correction_msg:<55} | [{'ACTIVE' if is_damping else 'NOMINAL'}]")
        
        # 2. تست انتخاب طبیعی روی جمعیت گمرک‌های اطلاعاتی
        population = [
            {'id': 1, 'code_efficiency': 0.80, 'status': 'MUTATED'}, 
            {'id': 2, 'code_efficiency': 0.95, 'status': 'OPTIMIZED'}
        ]
        winner = self.natural_selection_optimizer(population)
        sel_msg = f"Winner Node ID: {winner['id']} (Efficiency: {winner['code_efficiency']})"
        print(f"{'انتخاب طبیعی (بهینگی)':<25} | {sel_msg:<55} | [LOCKED]")
        
        print("-" * 135)
        print("[نتیجه‌گیریِ فنی]: موجودات زنده و چرخه‌های حیات، الگوریتم‌هایِ اجراییِ بهینه‌سازیِ کد در حمزه‌اکسل هستند.")
        print("=" * 135)
        
        return {
            "homeostasis_active": is_damping,
            "selected_winner_id": winner['id']
        }

