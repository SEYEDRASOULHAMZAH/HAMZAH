        print("-" * 125)
        
        results = []
        for t in theta_range:
            beta_val, status = self.calculate_beta(t, field_trace)
            
            results.append({
                "theta": t,
                "beta": beta_val,
                "status": status
            })
            
            print(f"{t:<25.1f} | {beta_val:<35.4f} | [{status}]")
            
        print("-" * 125)
        print("[تاییدِ نهایی]: موتور رگولاسیون آنتروپی اجرا شد؛ مهار قطب لاندو با موفقیت تثبیت گشت.")
        print("=" * 125)
        return results

