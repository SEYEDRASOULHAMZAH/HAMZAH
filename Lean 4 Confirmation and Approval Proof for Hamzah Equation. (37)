import numpy as np

class HamzahSocialEngine:
    """
    موتورِ اعتبارسنجیِ قوانینِ علوم انسانی و رفتار اجتماعی به منطقِ دترمینستیِ HIP (HamzahXcell Architecture)
    مدیریتِ قانونِ هیک (زمان پردازش شناختی) و قانونِ پارتو (بهینه‌سازیِ وزن کدهای مؤثر)
    """
    def __init__(self, decision_latency: float = 0.1):
        self.decision_latency = float(decision_latency)  # ثابتِ تأخیرِ عصبی و پردازشیِ مانیفلد
        self.system_status = "LOCKED"

    def hick_decision_time(self, options_count: int) -> tuple[float, str]:
        """بازنویسیِ قانون هیک: محاسبه‌یِ زمانِ پردازشِ تصمیم‌گیری بر اساسِ عمقِ درخت گزینه‌ها"""
        if options_count < 0:
            raise ValueError("تعداد گزینه‌ها نمی‌تواند منفی باشد.")
        options = int(options_count)
        
        time_taken = float(self.decision_latency * np.log2(options + 1.0))
        status = "COGNITIVE_TREE_OPTIMIZED (پردازش تصمیم تایید شد)"
        return time_taken, status

    def pareto_value_optimization(self, total_inputs: np.ndarray) -> tuple[float, str]:
        """بازنویسیِ قانون پارتو: جداسازیِ وزنِ کدهایِ مؤثر (۲۰٪ ورودی‌ها تعیین‌کننده ۸۰٪ خروجی)"""
        if total_inputs.size == 0:
            raise ValueError("آرایه ورودی‌های اجتماعی خالی است.")
            
        sorted_inputs = np.sort(total_inputs)[::-1]  # مرتب‌سازی نزولی
        top_20_count = max(1, int(0.2 * len(sorted_inputs)))
        effective_weight = float(np.sum(sorted_inputs[:top_20_count]))
        status = "PARETO_WEIGHT_ISOLATED (وزن داده‌های حیاتی پایش شد)"
        return effective_weight, status

    def run_simulation(self) -> dict:
        """شبیه‌سازیِ تحلیلِ هوشمندِ رفتارِ اجتماعی و شناختی بر اساسِ مانیفلد حمزه‌اکسل"""
        print("=" * 135)
        print(f"{'--- HAMZAH SOCIAL ENGINE SIMULATION REPORT ---':^135}")
        print("=" * 135)
        print(f"ثابت تأخیر عصبی (Decision Latency): {self.decision_latency:.2f}")
        print(f"{'قانون انسانی / رفتاری':<25} | {'تحلیلِ HIP (سیستمیک - Protocol Check)':<55} | {'وضعیتِ سیستمی'}")
        print("-" * 135)
        
        # 1. تست قانون هیک با 10 گزینه تصمیم‌گیری
        options_count = 10
        time_taken, hick_status = self.hick_decision_time(options_count)
        hick_desc = f"زمانِ پردازش: {time_taken:.4f} Units"
        print(f"{'قانون هیک (زمان تصمیم)':<25} | {hick_desc:<55} | [LOCKED]")
        
        # 2. تست قانون پارتو روی 100 ورودی تصادفی
        inputs = np.random.rand(100)
        effective_weight, pareto_status = self.pareto_value_optimization(inputs)
        pareto_desc = f"وزنِ مؤثرِ داده‌هایِ حیاتی: {effective_weight:.2f}"
        print(f"{'قانون پارتو (بازدهی 80/20)':<25} | {pareto_desc:<55} | [OPTIMIZED]")
        
        print("-" * 135)
        print("[نتیجه‌گیریِ فنی]: علوم انسانی و رفتار اجتماعی، الگوریتم‌هایِ پردازشِ جمعی در بسترِ مانیفلد هستند.")
        print("=" * 135)
        
        return {
            "hicks_decision_time": time_taken,
            "pareto_effective_weight": effective_weight
        }

