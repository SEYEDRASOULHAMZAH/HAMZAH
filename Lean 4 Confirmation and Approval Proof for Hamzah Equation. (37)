Python
import numpy as np

class HamzahUniversalEngine:
    """
    موتورِ اعتبارسنجیِ قوانینِ جامع و سیستمی به منطقِ دترمینستیِ HIP (HamzahXcell Architecture)
    ارزیابیِ قانونِ کانوی (هم‌ریختی ساختار و کد) و قانونِ زیپف (بهینگی تراکم توزیع اطلاعات)
    """
    def __init__(self, entropy_const: float = 0.5):
        self.entropy_const = float(entropy_const)  # ثابتِ پایه انتروپی سیستمی
        self.system_status = "LOCKED"

    def check_conway_fit(self, org_structure_nodes: int, code_modules_count: int) -> tuple[str, str]:
        """بازنویسیِ قانونِ کانوی: بررسیِ انطباقِ ساختار سازمانی با معماری ماژول‌های کد"""
        if org_structure_nodes < 0 or code_modules_count < 0:
            raise ValueError("تعداد نودها یا ماژول‌ها نمی‌تواند منفی باشد.")
            
        fit_delta = abs(int(org_structure_nodes) - int(code_modules_count))
        if fit_delta == 0:
            return "OPTIMAL_ISOMORPHISM (هم‌ریختی ساختاری کامل)", "OPTIMIZED"
        else:
            return "STRUCTURAL_FRICTION (اصطکاک ساختاری بین سازمان و کد)", "WARNING"

    def validate_zipf_distribution(self, data_frequencies: list[float] | np.ndarray) -> tuple[str, str]:
        """بازنویسیِ قانونِ زیپف: بررسیِ بهینگیِ توزیعِ داده بر اساس قانون توان (Power Law)"""
        freqs = np.array(data_frequencies, dtype=float)
        if freqs.size < 2:
            raise ValueError("برای محاسبه توزیع زیپف حداقل به دو داده نیاز است.")
            
        # مرتب‌سازی نزولی فرکانس‌ها و محاسبه رتبه
        sorted_freqs = np.sort(freqs)[::-1]
        rank = np.arange(1, len(sorted_freqs) + 1, dtype=float)
        
        # محاسبه ضریب همبستگی پیرسون روی لگاریتم رتبه و فرکانس
        log_rank = np.log(rank)
        log_freq = np.log(np.maximum(sorted_freqs, 1e-10))  # جلوگیری از خطای log(0)
        
        corr_matrix = np.corrcoef(log_rank, log_freq)
        pearson_corr = float(corr_matrix[0, 1])
        
        if pearson_corr < -0.8:
            return f"COMPRESSION_OPTIMAL (تراکم بهینه - Corr: {pearson_corr:.2f})", "LOCKED"
        else:
