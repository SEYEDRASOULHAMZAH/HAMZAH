import numpy as np

class HamzahEconomicEngine:
    """
    موتورِ بازنویسیِ اقتصاد به منطقِ دترمینستیِ HIP (HamzahXcell Architecture)
    بهینه‌سازیِ توزیعِ منابع و پهنای باند بر اساسِ اولویت‌هایِ اطلاعاتی (قانون انگل)
    """
    def __init__(self, total_bandwidth: float = 5000.0):
        self.total_bandwidth = float(total_bandwidth)  # پهنای باند کل / درآمد سیستم مانیفلد
        self.system_status = "LOCKED"

    def allocate_resources(self, priorities: list[dict]) -> dict:
        """تخصیصِ بهینه‌یِ منابع بر اساس فایده نهایی و اولویت‌های حیاتی (قانون انگل در بستر HIP)"""
        if not priorities:
            raise ValueError("لیست اولویت‌های نیازمندی خالی است.")
            
        # مرتب‌سازی بر اساس وزنِ اهمیت (اولویت با داده‌های حیاتی و بقای سیستم)
        sorted_priorities = sorted(priorities, key=lambda x: x.get('weight', 0.0), reverse=True)
        allocation = {}
        remaining = self.total_bandwidth
        
        for p in sorted_priorities:
            name = p.get('name', 'Unknown')
            demand = float(p.get('demand', 0.0))
            
            # تخصیصِ بار بر اساسِ پهنای باندِ باقی‌مانده و تقاضا
            load = min(demand, max(0.0, remaining))
            allocation[name] = float(load)
            remaining -= load
            
        return allocation

    def run_simulation(self) -> dict:
        """شبیه‌سازیِ تخصیصِ درآمدِ سیستم بر اساسِ پارامترهایِ HIP"""
        needs = [
            {'name': 'Food', 'weight': 1.0, 'demand': 1000.0},       # اولویت بالا (قانون انگل / بقا)
            {'name': 'Investment', 'weight': 0.8, 'demand': 2000.0}, # اولویت متوسط (توسعه ساختاری)
            {'name': 'Luxury', 'weight': 0.2, 'demand': 3000.0}     # اولویت پایین (مازاد سیستم)
        ]
        
        allocation_result = self.allocate_resources(needs)
        
        print("=" * 135)
        print(f"{'--- HAMZAH ECONOMIC ENGINE SIMULATION REPORT ---':^135}")
        print("=" * 135)
        print(f"پهنای باند کل سیستم (Total Bandwidth): {self.total_bandwidth:.1f} Units")
        print(f"{'نیاز / مؤلفه':<20} | {'تخصیصِ پهنای باند (HIP Units)':<40} | {'وضعیتِ ثباتِ مانیفلد'}")
        print("-" * 135)
        
        for name, load in allocation_result.items():
            print(f"{name:<20} | {load:<40.1f} | [OPTIMIZED]")
            
        print("-" * 135)
        print("[نتیجه‌گیریِ فنی]: اقتصاد در بستر HIP، بهینه‌سازیِ توزیعِ کد برایِ حفظِ پایداریِ کلانِ سیستم است.")
        print("=" * 135)
        
        return allocation_result

if __name__ == "__main__":
    engine = HamzahEconomicEngine(total_bandwidth=5000.0)
    engine.run_simulation()


