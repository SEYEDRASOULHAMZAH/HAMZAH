        print(f"{'--- HAMZAH GATE 96 VARIANCE GOVERNOR ENGINE REPORT ---':^135}")
        print("=" * 135)
        print(f"ضرایب: Alpha={self.alpha}, Beta={self.beta} | مرز انفجار آنتروپیک: {self.limit}")
        print(f"{'شدتِ نوسان (eps)':<25} | {'تراکم (rho)':<25} | {'واریانس محاسبه‌شده/مهارشده':<30} | {'وضعیتِ سیستم'}")
        print("-" * 135)
        
        results = []
        for s, r in zip(shocks, rho_sats):
            var, status, flag = self.govern_variance(s, r)
            
            results.append({
                "shock": s,
                "rho_sat": r,
                "governed_variance": var,
                "status": status,
                "flag": flag
            })
            
            print(f"{s:<25.2f} | {r:<25.2f} | {var:<30.4f} | [{status}]")
            
        print("-" * 135)
        print("[تاییدِ نهایی]: موتور مهار سرریز واریانس اجرا شد؛ پایداری سنسورها در شرایط فرین تثبیت گشت.")
        print("=" * 135)
        return results

