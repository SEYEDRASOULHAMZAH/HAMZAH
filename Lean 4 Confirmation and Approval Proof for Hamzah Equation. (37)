import numpy as np

class HamzahVarianceGovernorEngine:
    """
    موتورِ مهارِ سرریزِ واریانس (HamzahXcell Architecture - Gate 96)
    تضمینِ پایداریِ سنسورها و جلوگیری از انفجار آنتروپیک در شرایطِ مغناطیسیِ فرین
    """
    def __init__(self, alpha: float = 0.1, beta: float = 0.8, entropy_limit: float = 700.0):
        self.alpha = alpha
        self.beta = beta
        self.limit = entropy_limit  # مرزِ انفجارِ آنتروپیک
        
    def govern_variance(self, shock_epsilon: float, rho_sat: float) -> tuple[float, str, str]:
        """محاسبه واریانس نوسانات مغناطیسی و اعمال وتویِ کاهنده در صورت عبور از مرز بحرانی"""
        # معادله: Var = alpha * eps^2 + beta * rho_sat
        variance = float(self.alpha * (shock_epsilon ** 2) + self.beta * rho_sat)
        
        # وتویِ خطایِ توقف و اعمال Damping برای جلوگیری از Crash
        if variance >= self.limit:
            governed_var = float(self.limit * 0.99)
            status = "VETOED_AND_STABILIZED (مهار شده)"
            flag = "VARIANCE_OVERFLOW_PREVENTED"
        else:
            governed_var = variance
            status = "OPERATIONAL (پایدار)"
            flag = "VARIANCE_WITHIN_BOUNDS"
            
        return governed_var, status, flag

    def run_simulation(self) -> list[dict]:
        """شبیه‌سازیِ برخوردِ ذرات در میدانِ مغناطیسیِ شدید (مگنتار) در گیت ۹۶"""
        shocks = [10.0, 30.0, 50.0]     # شدتِ نوسانات (eps)
        rho_sats = [500.0, 800.0, 900.0]  # تراکمِ اطلاعاتی (rho)
        
