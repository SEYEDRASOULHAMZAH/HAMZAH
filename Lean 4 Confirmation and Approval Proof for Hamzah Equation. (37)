        print("=" * 135)
        print(f"چگالی پلانک (Rho P): {self.rho_p:.3e} | انحنای کلاسیک پایه: {classical_R:.1e}")
        print(f"{'چگالی جاری سیستم':<30} | {'انحنای کوانتومی (پایدار)':<30} | {'وضعیتِ سیستم'}")
        print("-" * 135)
        
        results = []
        for rho in densities:
            q_curv, status = self.stabilize_curvature(classical_R, rho)
            
            results.append({
                "density": rho,
                "quantum_curvature": q_curv,
                "status": status
            })
            
            print(f"{rho:<30.2e} | {q_curv:<30.4e} | [{status}]")
            
        print("-" * 135)
        print("[تاییدِ نهایی]: موتور پایداری گرانش کوانتومی اجرا شد؛ همگام‌سازی متریک با موفقیت تثبیت گشت.")
        print("=" * 135)
        return results

