        self.target_const = target_constant  # ثابتِ مرجع موازنه
        self.rtol = rtol                     # تلورانسِ مجاز برای بررسی پایداری
        
    def balance_density_frequency(self, matter_density: float, current_omega: float) -> tuple[float, str]:
        """محاسبه موازنه چگالی و فرکانس و اعمال تنظیمات کانیبالیستی در صورت انحراف"""
        current_product = matter_density * (current_omega ** 2)
        
        if not np.isclose(current_product, self.target_const, rtol=self.rtol):
            # کانیبالیسم: اصلاحِ امگا برای بازگشت به تعادل تانسوری
            new_omega = float(np.sqrt(self.target_const / matter_density))
            status = "CANNIBAL_ADJUSTMENT_ACTIVE"
        else:
            new_omega = float(current_omega)
            status = "STABLE_COUPLING"
            
        return new_omega, status

    def run_simulation(self) -> list[dict]:
