        print("=" * 115)
        print(f"ثابت هدف موازنه (Target Constant): {self.target_const:.1e} | تلورانس مجاز: {self.rtol}")
        print(f"{'چگالیِ ورودی (I)':<25} | {'فرکانسِ فعلی':<25} | {'فرکانسِ جدید (Omega)':<25} | {'وضعیتِ سیستم'}")
        print("-" * 115)
        
        results = []
        for m, o in stress_scenarios:
            new_o, status = self.balance_density_frequency(m, o)
            
            results.append({
                "matter_density": m,
                "current_omega": o,
                "new_omega": new_o,
                "status": status
            })
            
            print(f"{m:<25.1e} | {o:<25.1e} | {new_o:<25.1e} | [{status}]")
            
        print("-" * 115)
        print("[تاییدِ نهایی]: موتور جفت‌شدگی کانیبال اجرا شد؛ موازنه چگالی و فرکانس تثبیت گشت.")
        print("=" * 115)
        return results

