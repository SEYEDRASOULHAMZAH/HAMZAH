import numpy as np

class HamzahCannibalTensorEngine:
    """
    موتورِ محاسباتیِ تانسورِ کانیبال (HamzahXcell Architecture - State 81)
    راستی‌آزماییِ موازنه تانسوری بینِ چگالیِ ماده (I) و کلاکِ پردازش ($\Omega$) با لحاظ کردن دترمینان هسین
    """
    def __init__(self, constant: float = 1e20, hessian_det: float = 1e10, epsilon: float = 1e-20):
        self.C = constant          # ثابتِ جفت‌شدگی تانسوری
        self.det_H = hessian_det   # دترمینانِ ماتریس هسین (شاخص انحنای موضعی)
        self.epsilon = epsilon     # ضریب پایداری عددی
        
    def calculate_cannibal_equilibrium(self, mass_density_I: float) -> tuple[float, float, str]:
        """محاسبه‌ی فرکانس کانیبال بر اساس تعادل تانسوری I * Omega^2 = C * det(H)"""
        target_product = self.C * self.det_H
        omega_sq = target_product / (mass_density_I + self.epsilon)
        omega = float(np.sqrt(omega_sq))
        
        # ارزیابی وضعیت پایداری تعادل
        if omega > 0 and np.isfinite(omega):
            status = "TENSOR_EQUILIBRIUM_STABLE"
        else:
            status = "EQUILIBRIUM_SINGULARITY_WARNING"
            
        return omega, target_product, status

    def run_simulation(self) -> list[dict]:
        """شبیه‌سازی ورودِ جرم‌هایِ مختلف به سیاهچاله و پایش فرکانس کانیبال تانسوری"""
        mass_levels = [1e15, 1e18, 1e21]
        
        print("=" * 115)
        print(f"{'--- HAMZAH STATE 81 CANNIBAL TENSOR ENGINE REPORT ---':^115}")
        print("=" * 115)
        print(f"ثابت جفت‌شدگی (C): {self.C:.1e} | دترمینان هسین (Det H): {self.det_H:.1e}")
        print(f"{'جرم (I)':<25} | {'فرکانسِ کانیبال (Omega)':<35} | {'محصول هدف (C * Det H)':<25} | {'وضعیتِ سیستم'}")
        print("-" * 115)
        
        results = []
        for i in mass_levels:
            omega, prod, status = self.calculate_cannibal_equilibrium(i)
            
            results.append({
                "mass_density": i,
                "omega": omega,
                "target_product": prod,
                "status": status
            })
            
            print(f"{i:<25.2e} | {omega:<35.4e} | {prod:<25.2e} | [{status}]")
            
        print("-" * 115)
        print("[تاییدِ نهایی]: موتور محاسباتی تانسور کانیبال اجرا شد؛ تعادل فرکانس و چگالی تثبیت گشت.")
        print("=" * 115)
        return results

if __name__ == "__main__":
    engine = HamzahCannibalTensorEngine()
    engine.run_simulation()

