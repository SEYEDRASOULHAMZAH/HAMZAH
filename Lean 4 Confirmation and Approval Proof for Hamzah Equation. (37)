        print(f"{'--- HAMZAH GATE 94 FINE-TUNING ENGINE REPORT ---':^135}")
        print("=" * 135)
        print(f"چگالی پایه (Rho Floor): {self.rho_floor} | ضریب مقیاس‌دهنده: {self.scaling_factor}")
        print(f"{'چگالی اشباع مانیفلد':<25} | {'ثابتِ فیزیکیِ استخراج‌شده':<30} | {'وضعیتِ سیستم'}")
        print("-" * 135)
        
        results = []
        for r in rho_sat_levels:
            const, status = self.calculate_physical_constant(r)
            
            results.append({
                "rho_sat": r,
                "physical_constant": const,
                "status": status
            })
            
            print(f"{r:<25.2e} | {const:<30.6f} | [{status}]")
            
        print("-" * 135)
        print("[تاییدِ نهایی]: موتور تنظیم ظریف اجرا شد؛ استخراج ثوابت فیزیکی با موفقیت تثبیت گشت.")
        print("=" * 135)
        return results

