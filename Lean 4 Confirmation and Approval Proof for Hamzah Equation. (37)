        print("-" * 135)
        
        results = []
        for r in rho_values:
            resolved, status = self.resolve_density(r)
            
            results.append({
                "classical_density": r,
                "resolved_density": resolved,
                "status": status
            })
            
            print(f"{r:<30.2e} | {resolved:<30.4e} | [{status}]")
            
        print("-" * 135)
