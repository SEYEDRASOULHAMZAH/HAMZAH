import numpy as np

class HamzahParadoxCensorEngine:
    """
    موتورِ سدِ سانسورِ پارادوکس (HamzahXcell Architecture - Gate 86)
    حذفِ مسیرهایِ علیِ حلقه‌ای و مهار پارادوکس‌های اطلاعاتی در مانیفلد
    """
    def __init__(self, tolerance: float = 1e-5, epsilon: float = 1e-30):
        self.tolerance = tolerance  # آستانه تحمل برای پذیرش مسیر
        self.epsilon = epsilon      # ضریب پایداری عددی
        
    def check_path_causality(self, jacobian_det: float) -> tuple[float, str]:
        """بررسی علیت مسیر بر اساس دترمینان ژاکوبی و اعمال سانسور در صورت تخلف"""
        # محاسبه وزن مسیر با تابع تضعیف نمایی
        path_weight = float(np.exp(-1.0 / (np.abs(jacobian_det) + self.epsilon)))
        
        # گیت ۸۶: وتو و حذف مسیرهای حلقه‌ای و پارادوکس‌زا
        if path_weight < self.tolerance:
            return 0.0, "CENSORED (مسیر سانسور شد)"
        else:
            return path_weight, "VALID (مسیر مجاز است)"

    def run_simulation(self) -> list[dict]:
        """شبیه‌سازیِ بررسیِ چندین مسیرِ فوتونی در نزدیکیِ سیاهچاله در گیت ۸۶"""
        path_jacobians = [1.0, 0.5, 0.0001, 1e-10]  # دترمینان‌هایِ مشکوک به حلقه (نزدیک به صفر)
        
        print("=" * 125)
        print(f"{'--- HAMZAH GATE 86 PARADOX CENSOR ENGINE REPORT ---':^125}")
        print("=" * 125)
        print(f"آستانه تحمل (Tolerance): {self.tolerance:.1e}")
        print(f"{'دترمینان ژاکوبی':<25} | {'وزنِ مسیر (Path Weight)':<30} | {'وضعیتِ سانسور'}")
        print("-" * 125)
        
        results = []
        for j in path_jacobians:
            weight, status = self.check_path_causality(j)
            
            results.append({
                "jacobian": j,
                "path_weight": weight,
                "status": status
            })
            
            print(f"{j:<25.4e} | {weight:<30.4f} | [{status}]")
            
        print("-" * 125)
        print("[تاییدِ نهایی]: موتور سد سانسور پارادوکس اجرا شد؛ پاکسازی حلقه‌های علی با موفقیت تثبیت گشت.")
        print("=" * 125)
        return results

if __name__ == "__main__":
    engine = HamzahParadoxCensorEngine()
    engine.run_simulation()

