        print(f"پارامتر کف مانیفلد (Rho Floor): {self.rho_floor:.2e} | چگالی اشباع: {self.rho_sat:.1e}")
        print(f"{'قانون فیزیک':<20} | {'وضعیت منطقی HIP':<30} | {'محاسبه دقیق (دترمیننیستی)':<25} | {'پرچمِ سیستمی'}")
        print("-" * 135)
        
        results = []
        for law in laws:
