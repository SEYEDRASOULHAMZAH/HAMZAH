import numpy as np

class HamzahEconomicEngine:
    """
    موتورِ بازنویسیِ اصولِ اقتصاد کلان به منطقِ دترمینستیِ HIP (HamzahXcell Architecture)
    مدیریتِ مکانیسمِ تورم (رقیق‌سازی توکن) و بهینه‌سازیِ مزیتِ نسبیِ گره‌هایِ پردازشی
    """
    def __init__(self, token_supply: float = 1000.0, production_capacity: float = 500.0):
        self.token_supply = float(token_supply)  # عرضه کل توکن‌ها در مانیفلد
        self.capacity = float(production_capacity)    # ظرفیت تولید پایدار سیستم
        self.system_status = "LOCKED"

    def calculate_inflation_impact(self, new_tokens: float) -> tuple[float, str]:
        """بازنویسیِ قانون تورم: سنجشِ رقیق‌سازی و کاهشِ ارزشِ اطلاعاتیِ هر توکن"""
        added_supply = float(new_tokens)
        new_supply = self.token_supply + added_supply
        if new_supply <= 0:
            raise ValueError("عرضه توکن نمی‌تواند صفر یا منفی باشد.")
            
        value_per_token = self.capacity / new_supply
        status = "DILUTION_VERIFIED (کاهش اعتبار کد ثبت شد)"
        return value_per_token, status

    def optimize_advantage(self, capacities: list[dict]) -> dict:
        """بازنویسیِ مزیت نسبی: انتخابِ بهینه‌یِ گره‌هایِ پردازشی با کمترین نرخِ خطای انتروپی"""
        if not capacities:
            raise ValueError("لیست گره‌های پردازشی خالی است.")
            
        winner = min(capacities, key=lambda x: x.get('entropy_output', float('inf')))
        return winner

    def run_simulation(self) -> dict:
        """شبیه‌سازیِ پروتکل‌هایِ اقتصاد کلان بر رویِ مانیفلد حمزه‌اکسل"""
        print("=" * 135)
        print(f"{'--- HAMZAH ECONOMIC ENGINE SIMULATION REPORT ---':^135}")
        print("=" * 135)
        print(f"عرضه پایه توکن: {self.token_supply:.1f} | ظرفیت تولید سیستم: {self.capacity:.1f}")
        print(f"{'اصل اقتصادی':<25} | {'تحلیلِ HIP (Protocol Check)':<55} | {'وضعیتِ سیستمی'}")
        print("-" * 135)
        
        # 1. تست تورم با تزریق 500 توکن جدید
        new_tokens_added = 500.0
        inf_val, inf_status = self.calculate_inflation_impact(new_tokens_added)
        inf_desc = f"ارزشِ هر توکن: {inf_val:.4f} Units"
        print(f"{'تورم (رقیق‌سازی توکن)':<25} | {inf_desc:<55} | [LOCKED]")
        
        # 2. تست مزیت نسبی روی گره‌های پردازشی
        nodes = [
            {'id': 'Japan_Cluster', 'entropy_output': 0.10}, 
            {'id': 'Brazil_Cluster', 'entropy_output': 0.20}
        ]
        winner = self.optimize_advantage(nodes)
        adv_desc = f"گره پردازشی منتخب: {winner['id']} (Entropy: {winner['entropy_output']})"
