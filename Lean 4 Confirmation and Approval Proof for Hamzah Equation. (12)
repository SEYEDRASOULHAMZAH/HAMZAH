    defaultQuasarBridge17.routing_epsilon > 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact qa_conflict_positive
  · exact live_chi_qa_17_positive
  · exact live_qa_rho_bounded base_rho h_rho
  · unfold defaultQuasarBridge17 QuasarBridge17; norm_num




