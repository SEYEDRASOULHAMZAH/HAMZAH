    compute_live_chi_raa defaultRAABridge > 0 ∧
    base_val < base_val * (1 + (compute_live_chi_raa defaultRAABridge)^2) ∧
    defaultRAABridge.routing_epsilon > 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact raa_conflict_positive
  · exact live_chi_raa_positive
  · exact live_raa_density_bounded base_val h_val
  · unfold defaultRAABridge RAABridge; norm_num




