  unfold compute_live_chi_qa_17 defaultQuasarBridge17 QuasarBridge17
  have h_div : 0 < qa_conflict_feed / 10^7 := by linarith [qa_conflict_positive]
  have h_sq : 0 < (qa_conflict_feed / 10^7)^2 := by
    rw [sq]
    exact mul_pos h_div h_div
  have h_prod : 0 < base_rho * (qa_conflict_feed / 10^7)^2 := mul_pos h_rho h_sq
  ring_nf
  linarith

