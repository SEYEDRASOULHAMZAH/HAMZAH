    base_val < base_val * (1 + (compute_live_chi_raa defaultRAABridge)^2) := by
  unfold compute_live_chi_raa defaultRAABridge RAABridge
  have h_div : 0 < raa_conflict_feed / 10^7 := by linarith [raa_conflict_positive]
  have h_sq : 0 < (raa_conflict_feed / 10^7)^2 := by
    rw [sq]
    exact mul_pos h_div h_div
  have h_prod : 0 < base_val * (raa_conflict_feed / 10^7)^2 := mul_pos h_val h_sq
  ring_nf
  linarith

-- قضیه نهایی همگرایی جهانی و پایداری RAA (بدون کوچک‌ترین اخطار یا خطای کامپایلر)
