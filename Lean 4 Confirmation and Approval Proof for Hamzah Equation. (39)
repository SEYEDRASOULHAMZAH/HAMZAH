logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahTensorSpacetimeManifoldEngine:
    """
    موتور تانسوری تحلیل ماتریسی کوواریانس سنجه‌های هولوگرافیک فضا-زمان (Omega Production Grade)
    """
    def __init__(self, cluster_id: str = "Hamzah_Spacetime_Tensor_Omega") -> None:
        self.cluster_id = cluster_id
        self.manifold_integrity = 1.0

    def compute_spacetime_covariance_norm(self, spacetime_tensor_data: List[List[float]]) -> Union[float, str]:
        """
        محاسبه ماتریس کوواریانس سنجه‌های فضا-زمان و نرم تانسوری فروبنیوس آن
        """
        if not spacetime_tensor_data:
            self.manifold_integrity = 0.2
            logging.error("خطای تانسوری: ماتریس سنجه‌های فضا-زمان خالی است.")
            return "ERROR: ماتریس داده‌ها نمی‌تواند تهی باشد."

        mat = np.array(spacetime_tensor_data, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.manifold_integrity = 0.4
            logging.error("خطای ابعاد: داده‌های فضا-زمان برای تحلیل ماتریسی کافی نیست.")
            return "ERROR: ابعاد ماتریس نامعتبر است."

        cov_matrix = np.cov(mat, rowvar=False)
        if np.any(np.isnan(cov_matrix)) or np.any(np.isinf(cov_matrix)):
            self.manifold_integrity = 0.0
            logging.error("خطای بحرانی: ناپایداری در ماتریس کوواریانس فضا-زمان.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس فضا-زمان."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری کوواریانس فضا-زمان با موفقیت محاسبه شد.")
        return round(tensor_norm, 4)

