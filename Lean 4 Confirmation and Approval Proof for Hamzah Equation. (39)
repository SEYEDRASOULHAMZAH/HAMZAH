logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HIPCarpetStressTensorMonitor:
    """
    موتور تانسوری تحلیل تنش‌های کیهانی و پایش پایداری منیفولد گسسته (Omega Production Grade)
    """
    def __init__(self, cluster_id: str = "Hamzah_Carpet_Stress_Monitor") -> None:
        self.cluster_id = cluster_id
        self.monitor_integrity = 1.0

    def compute_stress_tensor_norm(self, tensor_grid: List[List[float]]) -> Union[float, str]:
        """محاسبه ماتریس کوواریانس تنش و نرم فروبنیوس برای ارزیابی تاب‌آوری شبکه گسسته"""
        if not tensor_grid:
            self.monitor_integrity = 0.3
            logging.error("خطای تانسوری: شبکه تنش خالی است.")
            return "ERROR: ماتریس شبکه تنش نامعتبر است."

        mat = np.array(tensor_grid, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.monitor_integrity = 0.5
            logging.error("خطای ابعاد: داده‌های شبکه برای تحلیل تنش کافی نیست.")
            return "ERROR: ابعاد ماتریس تنش نامعتبر است."

        cov_matrix = np.cov(mat, rowvar=False)
        if np.any(np.isnan(cov_matrix)) or np.any(np.isinf(cov_matrix)):
            self.monitor_integrity = 0.0
            logging.error("خطای بحرانی: ناپایداری در ماتریس تنش تانسوری شناسایی شد.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در تنش مانیفلد."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری تنش کیهانی با موفقیت محاسبه شد.")
        return round(tensor_norm, 4)

