        print("5. 🛡️ مشاهده گزارش امنیتی")
        print("6. ℹ️ اطلاعات سیستم")
        print("7. 🚪 خروج")
        print("="*60)
    
    def run(self):
        """اجرای رابط کاربری"""
        print("\n🚀 راه‌اندازی سیستم BLACK BOX HCP-100...")
        print("⚛️ حفاظت مطلق فعال است")
        
        while True:
            self.display_menu()
            
            try:
                choice = input("\nانتخاب شما: ").strip()
                
                if choice == '1':
                    self.list_scenarios()
                elif choice == '2':
                    self.run_stress_test()
                elif choice == '3':
                    self.enter_access_key()
                elif choice == '4':
                    self.view_detailed_results()
                elif choice == '5':
                    self.show_security_report()
                elif choice == '6':
                    self.show_system_info()
                elif choice == '7':
                    print("\n👋 خروج از سیستم...")
                    break
                else:
                    print("⚠️ انتخاب نامعتبر. لطفاً عدد ۱ تا ۷ را وارد کنید.")
                    
            except KeyboardInterrupt:
                print("\n\n⚠️ عملیات توسط کاربر متوقف شد.")
                break
            except Exception as e:
                print(f"❌ خطا: {e}")
    
    def list_scenarios(self):
        """لیست سناریوها"""
        print("\n📋 سناریوهای تست استرس HCP-100:")
        print("-"*60)
        
        scenarios = self.black_box.list_scenarios()
        for scenario in scenarios[:10]:  # نمایش ۱۰ سناریوی اول
            print(f"{scenario['id']}. {scenario['name']}")
            print(f"   سطح استرس: {scenario['stress_level']}")
            print(f"   نیاز به کلید: {'بله' if scenario['requires_key'] else 'خیر'}")
            print()
        
        if len(scenarios) > 10:
            print(f"... و {len(scenarios) - 10} سناریوی دیگر")
        
        print(f"\n✅ مجموع: {len(scenarios)} سناریو")
    
    def run_stress_test(self):
        """اجرای تست استرس"""
        try:
            scenario_id = int(input("شناسه سناریو (۱-۱۰۰): ").strip())
            
            if scenario_id < 1 or scenario_id > 100:
                print("⚠️ شناسه سناریو باید بین ۱ تا ۱۰۰ باشد")
                return
            
            # بررسی وجود کلید
            user_key = self.user_keys.get(scenario_id)
            
            print(f"\n🔬 شروع تست استرس سناریو {scenario_id}...")
            result = self.black_box.run_stress_test(scenario_id, user_key)
            
            if 'error' in result:
                print(f"❌ خطا: {result['error']}")
                return
            
            # نمایش نتایج
            print(f"\n✅ تست با موفقیت انجام شد")
            print(f"   شناسه اجرا: {result['execution_id']}")
            print(f"   وضعیت امنیت: {result['security_status']}")
            print(f"   وضعیت کلی: {result['summary']['overall_status']}")
            
            if 'note' in result:
                print(f"   📝 نکته: {result['note']}")
            
            # ذخیره نتایج
            self._save_test_result(scenario_id, result)
            
        except ValueError:
            print("⚠️ لطفاً یک عدد وارد کنید")
        except Exception as e:
            print(f"❌ خطا در اجرای تست: {e}")
    
    def enter_access_key(self):
        """وارد کردن کلید دسترسی"""
        try:
            scenario_id = int(input("شناسه سناریو: ").strip())
            access_key = input("کلید دسترسی: ").strip()
            
            # ذخیره کلید
            self.user_keys[scenario_id] = access_key
            print(f"✅ کلید برای سناریو {scenario_id} ذخیره شد")
            
        except ValueError:
            print("⚠️ شناسه سناریو باید عدد باشد")
    
    def view_detailed_results(self):
        """مشاهده نتایج دقیق"""
        try:
            scenario_id = int(input("شناسه سناریو: ").strip())
            
            # بررسی وجود کلید
            if scenario_id not in self.user_keys:
                print("⚠️ کلید دسترسی برای این سناریو وارد نشده است")
                print("   لطفاً ابتدا از منوی اصلی گزینه ۳ را انتخاب کنید")
                return
            
            user_key = self.user_keys[scenario_id]
            
            print(f"\n📊 دریافت نتایج دقیق سناریو {scenario_id}...")
            result = self.black_box.run_stress_test(scenario_id, user_key)
            
            if 'error' in result:
                print(f"❌ خطا: {result['error']}")
                return
            
            # نمایش نتایج دقیق
            print(f"\n📈 نتایج دقیق تست استرس سناریو {scenario_id}:")
            print("="*60)
            
            if 'detailed_results' in result:
                detailed = result['detailed_results']
                
                # نتایج تست
                test_results = detailed.get('test_results', {})
                print(f"\n🎯 نتایج اصلی:")
                for key, value in test_results.items():
                    if isinstance(value, float):
                        print(f"   {key}: {value:.10e}")
                    else:
                        print(f"   {key}: {value}")
                
                # کنترل کیفیت
                qc_results = detailed.get('quality_control', [])
                print(f"\n✅ کنترل کیفیت ({len(qc_results)} بررسی):")
                passed = sum(1 for qc in qc_results if qc.get('passed', False))
                print(f"   موفق: {passed}/{len(qc_results)}")
                
                # تحلیل آماری
                stats = detailed.get('statistical_analysis', {})
                print(f"\n📊 تحلیل آماری:")
                for method, data in stats.items():
                    print(f"   {method}:")
                    for k, v in data.items():
                        if isinstance(v, float):
                            print(f"     {k}: {v:.10e}")
                        else:
                            print(f"     {k}: {v}")
                
                # تأییدیه‌ها
                if 'verifications' in result:
                    verifications = result['verifications']
                    print(f"\n🔍 تأییدیه‌ها:")
                    for check, passed in verifications.items():
                        status = "✅" if passed else "❌"
                        print(f"   {status} {check}")
            
            print("\n" + "="*60)
            
        except ValueError:
            print("⚠️ شناسه سناریو باید عدد باشد")
        except Exception as e:
            print(f"❌ خطا: {e}")
    
    def show_security_report(self):
        """نمایش گزارش امنیتی"""
        report = self.black_box.generate_security_report()
        print("\n" + report)
    
    def show_system_info(self):
        """نمایش اطلاعات سیستم"""
        info = self.black_box.get_system_info()
        
        print("\nℹ️ اطلاعات سیستم BLACK BOX:")
        print("-"*60)
        print(f"شناسه سیستم: {info['system_id']}")
        print(f"نام سیستم: {info['system_name']}")
        print(f"نسخه: {info['version']}")
        print(f"زمان ایجاد: {info['creation_time']}")
        print(f"سطح امنیت: {info['security_level']}")
        print(f"\nتعداد سناریوها: {len(self.black_box.scenarios)}")
        print(f"کلیدهای ذخیره شده: {len(self.user_keys)}")
        print("-"*60)
    
    def _save_test_result(self, scenario_id: int, result: Dict[str, Any]):
        """ذخیره نتایج تست"""
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"hcp100_test_result_{scenario_id}_{timestamp}.json"
        
        try:
            with open(filename, 'w', encoding='utf-8') as f:
                json.dump(result, f, ensure_ascii=False, indent=2)
            print(f"💾 نتایج در {filename} ذخیره شد")
        except Exception as e:
            print(f"⚠️ خطا در ذخیره نتایج: {e}")

