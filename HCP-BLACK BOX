class HCP100UserInterface:
    """رابط کاربری برای سیستم BLACK BOX"""
    
    def __init__(self):
        self.black_box = HCP100StressTestBlackBox()
        self.user_keys = {}  # ذخیره کلیدهای کاربر
        
    def display_menu(self):
        """نمایش منو"""
        print("\n" + "="*60)
        print("🎮 رابط کاربری HCP-100 STRESS TEST BLACK BOX")
        print("="*60)
        print("1. 📋 مشاهده سناریوهای موجود")
