def void_lattice_stress_model (void_density void_lattice_scale floor_eps : ℝ) : ℝ :=
  void_density / (void_lattice_scale + floor_eps)

-- قضیه تمامیت صوری: مثبت یا صفر بودن استرس واید تحت مقادیر معتبر
theorem void_lattice_stress_nonneg (void_density void_lattice_scale floor_eps : ℝ)
    (h_density : 0 ≤ void_density) (h_scale : 0 < void_lattice_scale) (h_eps : 0 < floor_eps) :
    0 ≤ void_lattice_stress_model void_density void_lattice_scale floor_eps := by
  unfold void_lattice_stress_model
  apply div_nonneg h_density
  linarith

