import numpy as np
from decimal import Decimal, getcontext

# تنظیم دقت بالا برای شبیه‌سازی دقیق چگالی دینامیکی و تعادل کهکشانی در HIP
getcontext().prec = 120

class HamzahDynamicDensityEngine:
    """
    Deterministic Verification Engine for Table 2/5 (Quantitative Matrix - Dynamic Density Layer \rho_dyn) of HIP.
    Modeling numerical distribution profiles and galactic equilibrium transitions.
    """
    def __init__(self):
        self.RHO_SAT = Decimal('1.0e90')
        self.FLOOR_EPSILON = Decimal('1.155e-20')
        self.OMEGA_H = Decimal('1.176e10')
        self.C = Decimal('299792458')
        
    def evaluate_dynamic_density(self, velocity_rot, gradient_info):
        print(f"[*] Compiling Dynamic Density & Galactic Equilibrium Matrix...")
        v_r = Decimal(str(velocity_rot))
        grad_i = Decimal(str(gradient_info))
        
        # فرمولاسیون چگالی دینامیکی مانیفلد تحت تأثیر میراسازی امگا و فاکتور نسبیتی
        damping_factor = (grad_i / (self.OMEGA_H + self.FLOOR_EPSILON)).exp()
        rel_factor = Decimal('1.0') + ((v_r / self.C) ** 2)
        
        rho_dyn = (self.RHO_SAT / damping_factor) / rel_factor
        
        # قفل مرزی صلب بر روی سقف چگالی اشباع کریستالی
        if rho_dyn > self.RHO_SAT:
            rho_dyn = self.RHO_SAT
            
        status = "RHO_DYN_STABLE (تعادل دینامیکی کهکشانی برقرار است)" if rho_dyn > 0 else "RHO_DYN_DECAY"
        return rho_dyn, status

if __name__ == "__main__":
