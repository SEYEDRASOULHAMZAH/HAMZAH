این اسکریپت صوری اثبات می‌کند که مدل به‌روزرسانی واریانس GARCH در هیچ شرایطی دچار مقدار منفی یا دایورجنس نمی‌شود:

Lean
 
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Positivity

-- تعریف تابع تکامل واریانس GARCH در سیستم اطلاعاتی حمزه
def garch_variance_update (alpha beta err_sq past_var : ℝ) : ℝ :=
  alpha * err_sq + beta * past_var

-- قضیه تمامیت صوری: مثبت یا صفر بودن واریانس GARCH تحت پارامترهای معتبر
theorem garch_variance_nonneg (alpha beta err_sq past_var : ℝ)
    (h_alpha : 0 ≤ alpha) (h_beta : 0 ≤ beta) (h_err : 0 ≤ err_sq) (h_past : 0 ≤ past_var) :
    0 ≤ garch_variance_update alpha beta err_sq past_var := by
  unfold garch_variance_update
  apply add_nonneg (mul_nonneg h_alpha h_err) (mul_nonneg h_beta h_past)

