import Mathlib.Tactic.Omega

-- Dynamic density functional model definition
def dynamic_density_model (rho_sat damping rel_factor : ℝ) : ℝ :=
  (rho_sat / damping) / rel_factor

-- Theorem: Dynamic density is strictly positive under positive parameters
theorem dynamic_density_pos (rho_sat damping rel_factor : ℝ)
    (h_sat : 0 < rho_sat) (h_damping : 0 < damping) (h_rel : 0 < rel_factor) :
    0 < dynamic_density_model rho_sat damping rel_factor := by
  unfold dynamic_density_model
  apply div_pos (div_pos h_sat h_damping) h_rel

