import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Omega

-- تعریف مدل چگالی پویای کهکشانی
def galactic_dyn_density_model (rho_floor kappa pi_p will_sq log_arg : ℝ) : ℝ :=
  rho_floor + kappa * ((pi_p * will_sq) / log_arg)

-- قضیه تمامیت صوری: اثبات مثبت بودن و عدم دایورجنس چگالی پویای کهکشانی
theorem galactic_density_pos (rho_floor kappa pi_p will_sq log_arg : ℝ)
    (h_floor : 0 ≤ rho_floor) (h_kappa : 0 ≤ kappa) (h_pi : 0 ≤ pi_p) 
    (h_will : 0 ≤ will_sq) (h_log : 0 < log_arg) :
    0 ≤ galactic_dyn_density_model rho_floor kappa pi_p will_sq log_arg := by
  unfold galactic_dyn_density_model
  apply add_nonneg h_floor
  apply mul_nonneg h_kappa
  apply div_nonneg (mul_nonneg h_pi h_will) (le_of_lt h_log)


