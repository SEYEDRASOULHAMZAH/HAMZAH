import numpy as np

class HamzahQuantitativeSatEngine:
    """
    موتور تایید دترمیننیستی برای حالات ۵۱ تا ۶۰ (جدول ۱/۵ بخش کمّی) منشور HIP.
    راستی‌آزمایی رفتارهای گسسته تعداد و چگالی حمزه‌اکسل‌ها در تراز اشباع کریستالی.
    """
    def __init__(self):
        self.RHO_SAT = 1.0e90
        self.FLOOR_EPSILON = 1.155e-20
        self.OMEGA_H = 1.176e10
        self.C = 299792458
        
    def evaluate_quantitative_tier(self, input_mass, local_noise):
        # الگوریتم قفل متمم: محاسبه ظرفیت کمّی بیت-مس (حالت ۵۲)
        # I = m * (c^2 / Omega^2)
        info_capacity = input_mass * (self.C ** 2 / self.OMEGA_H ** 2)
        
        # محاسبه چگالی فرآوری‌شده تحت تاثیر نویز رندرینگ پوسته
        calculated_density = info_capacity / (local_noise + self.FLOOR_EPSILON)
        
        # اعمال قفل مرزی صلب: چگالی کمّی هرگز نمی‌تواند از سقف اشباع کریستالی تجاوز کند
        final_density = min(calculated_density, self.RHO_SAT) if calculated_density > 0 else self.RHO_SAT
        
        # کلاسیفیکیشن لایه بر اساس نسبت تراکم کمی حاصل‌شده
        if final_density == self.RHO_SAT:
            tier_status = "RHO_SAT_LOCKED (تراز اشباع کریستالی صلب)"
        else:
            tier_status = "RHO_TRANSITIONAL (تراز گذار کمّی میانی)"
            
        return final_density, tier_status

