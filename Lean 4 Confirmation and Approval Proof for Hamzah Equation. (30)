import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Omega

-- Dynamic density formula model definition
def dynamic_density_formula (rho_f kappa buffer : ℝ) : ℝ :=
  rho_f + kappa * buffer

-- Theorem: Dynamic density formula is strictly positive under positive parameters
theorem dynamic_density_formula_pos (rho_f kappa buffer : ℝ)
    (h_rho : 0 < rho_f) (h_kappa : 0 < kappa) (h_buf : 0 < buffer) :
    0 < dynamic_density_formula rho_f kappa buffer := by
  unfold dynamic_density_formula
  have h_prod : 0 < kappa * buffer := mul_pos h_kappa h_buf
  linarith

