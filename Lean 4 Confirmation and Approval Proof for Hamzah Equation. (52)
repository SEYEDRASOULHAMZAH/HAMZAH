        if (rank == 0) saveCheckpointZlib(argv[3], b+1, startSeed + b + 1, h_results, MAX_SCENARIOS_PER_GPU);
    }

    cudaFree(d_results);
    free(h_results);
    MPI_Finalize();
    return 0;
}

 
