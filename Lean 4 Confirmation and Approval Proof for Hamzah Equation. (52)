// Adaptive Time-Stepping for Neural Manifold Stability
__device__ double adapt_dt(double change, double dt_min, double dt_max) {
    if (fabs(change) > 0.05) return fmax(dt_min, 0.5 * dt_max);
    if (fabs(change) < 0.005) return fmin(dt_max, 2.0 * dt_max);
    return dt_max;
