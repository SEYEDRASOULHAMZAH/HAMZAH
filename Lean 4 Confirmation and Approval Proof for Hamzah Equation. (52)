// High-Performance Simulation Kernel for Alzheimer's Mitigations in 1155D
__global__ void simulateScenarioKernel(double *results, BioParams bio, unsigned long long seed, unsigned long long offset, unsigned long long scenarios) {
    unsigned long long idx = blockIdx.x * blockDim.x + threadIdx.x + offset;
    if (idx >= scenarios) return;

    curandStatePhilox4_32_10_t state;
    curand_init(seed, idx, 0, &state);

    const double dt_min = 0.001, dt_max = 0.02;
    const int max_steps = 1000;

    double Cv[max_steps+1] = {0.0};
    double Cd[max_steps+1] = {0.0};
    double P[max_steps+1]; 
    P[0] = 1.0;
    Cv[0] = 100.0;
    Cd[0] = 0.6;

    double dt = dt_max;
    for (int t = 0; t < max_steps; t++) {
        double Dv = 1.0 + 0.05 * curand_normal_double(&state);
        double Dd = 0.8 + 0.03 * curand_normal_double(&state);

        double dCv = caputo_fractional(Cv, t, mu_v, dt);
        double dCd = caputo_fractional(Cd, t, mu_d, dt);

        Cv[t+1] = fmax(0.0, Cv[t] + dt * (-0.0012 * Cd[t] * Cv[t] + 0.0003 * (100.0 - Cv[t]) - dCv * 1e-5));
        Cd[t+1] = fmax(0.0, Cd[t] + dt * (0.035 - 0.015 * Cd[t] - 0.02 * (Cd[t] * P[t]) / (bio.kd_val + P[t]) - dCd * 1e-5));
        P[t+1] = fmax(0.0, P[t] - dt * (bio.eta_val * (Cd[t] / (bio.kd_val + Cd[t])) * P[t]));

        double change_max = fmax(fabs(Cv[t+1] - Cv[t]), fabs(Cd[t+1] - Cd[t]));
        dt = adapt_dt(change_max, dt_min, dt_max);
    }

    double Rv = 0.0;
    for (int t = 0; t < max_steps; t++) {
        Rv += exp(-bio.lambda_v * (max_steps - t) * dt) * pow(Cv[t] + 1e-5, 1.2) / (1.0 + exp(-bio.gamma_v * (Cv[t] - bio.theta_v)));
    }

    double plaqueReduction = (1.0 - (P[max_steps] / 1.0)) * 100.0;
    double R_comb = alpha * Rv * pow(fmax(0.0, fabs(plaqueReduction) / 100.0), 0.8) * 1.0;

    results[blockIdx.x * blockDim.x + threadIdx.x] = R_comb;
