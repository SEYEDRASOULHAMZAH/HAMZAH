    BioParams bio = loadDatasetHDF5(argv[1]);
    unsigned long long startBatch = 0, startSeed = 1234ULL;
    double *d_results, *h_results;

    h_results = (double*)malloc(MAX_SCENARIOS_PER_GPU * sizeof(double));
    std::string checkpoint_filename = std::string(argv[3]) + "/checkpoint_batch_00000.dat";
    if (loadCheckpointZlib(checkpoint_filename, startBatch, startSeed, h_results, MAX_SCENARIOS_PER_GPU)) {
        if (rank == 0) std::cout << "Resuming from batch " << startBatch << " with seed " << startSeed << "\n";
    }

    int deviceCount;
    cudaGetDeviceCount(&deviceCount);
    cudaSetDevice(rank % deviceCount);

    unsigned long long baseScenarios = TOTAL_SCENARIOS / size;
    unsigned long long scenariosThisRank = baseScenarios;
    if (rank % 2 == 0) scenariosThisRank += baseScenarios * 0.05;
    else scenariosThisRank -= baseScenarios * 0.05;

    unsigned long long batches = scenariosThisRank / MAX_SCENARIOS_PER_GPU;
    cudaMalloc(&d_results, MAX_SCENARIOS_PER_GPU * sizeof(double));

    for (unsigned long long b = startBatch; b < batches; b++) {
        simulateScenarioKernel<<<(MAX_SCENARIOS_PER_GPU + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK, THREADS_PER_BLOCK>>>(d_results, bio, startSeed + b, b * MAX_SCENARIOS_PER_GPU, MAX_SCENARIOS_PER_GPU);
        cudaMemcpyAsync(h_results, d_results, MAX_SCENARIOS_PER_GPU * sizeof(double), cudaMemcpyDeviceToHost);
        cudaDeviceSynchronize();
        saveResultsHDF5(argv[2], h_results, MAX_SCENARIOS_PER_GPU);
        if (rank == 0) saveCheckpointZlib(argv[3], b+1, startSeed + b + 1, h_results, MAX_SCENARIOS_PER_GPU);
    }

    cudaFree(d_results);
    free(h_results);
    MPI_Finalize();
    return 0;
}

 
