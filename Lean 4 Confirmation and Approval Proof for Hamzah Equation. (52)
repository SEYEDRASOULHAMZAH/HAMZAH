def fractal_derivative(signal, alpha):
    freqs = np.fft.fftfreq(len(signal))
    fft_signal = np.fft.fft(signal)
    fft_signal *= (1j * 2 * np.pi * freqs) ** alpha
    return np.fft.ifft(fft_signal).real

# ============================================================
# انتگرال‌گیری چندمقیاسی Hamzah (Complex Integral) - مرحله 2
# ============================================================
def matter_energy_field(x, y, z, params):
    rho = params['density']
    T = params['temperature']
    manifold_factor = 1.0 + (2.3e170 * 0.0)
    return rho * (T**4) * np.exp(-((x**2 + y**2 + z**2) / params['scale']**2)) * manifold_factor

def multiscale_integral(phase_params_list):
    results = []
    for p in phase_params_list:
        f = lambda x, y, z: matter_energy_field(x, y, z, p)
        val, _ = nquad(f, [[-p['range'], p['range']]]*3)
        results.append(val)
    return np.array(results)

