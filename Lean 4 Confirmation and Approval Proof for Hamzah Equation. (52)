// Save results with Zlib compression and Multi-File Checkpoint support
void saveCheckpointZlib(const std::string &filename, unsigned long long batch, unsigned long long seed, double *data, size_t count) {
    std::ostringstream checkpoint_stream;
    checkpoint_stream << "batch_" << std::setw(5) << std::setfill('0') << batch;

    std::string checkpoint_filename = filename + checkpoint_stream.str() + ".dat";
    std::ofstream checkpoint_file(checkpoint_filename, std::ios::binary);
    
    checkpoint_file.write(reinterpret_cast<char*>(&batch), sizeof(batch));
    checkpoint_file.write(reinterpret_cast<char*>(&seed), sizeof(seed));
    
    size_t data_size = count * sizeof(double);
    char *buffer = new char[data_size];
    memcpy(buffer, data, data_size);
    
    uLongf compressed_size = compressBound(data_size);
    char *compressed_buffer = new char[compressed_size];
    compress((Bytef *)compressed_buffer, &compressed_size, (const Bytef *)buffer, data_size);
    
    checkpoint_file.write(reinterpret_cast<char*>(&compressed_size), sizeof(compressed_size));
    checkpoint_file.write(compressed_buffer, compressed_size);

    checkpoint_file.close();
    delete[] buffer;
    delete[] compressed_buffer;
}

bool loadCheckpointZlib(const std::string &filename, unsigned long long &batch, unsigned long long &seed, double *data, size_t count) {
    std::ifstream checkpoint_file(filename, std::ios::binary);
    if (!checkpoint_file.is_open()) return false;

    checkpoint_file.read(reinterpret_cast<char*>(&batch), sizeof(batch));
    checkpoint_file.read(reinterpret_cast<char*>(&seed), sizeof(seed));

    size_t compressed_size;
    checkpoint_file.read(reinterpret_cast<char*>(&compressed_size), sizeof(compressed_size));
    
    char *compressed_buffer = new char[compressed_size];
    checkpoint_file.read(compressed_buffer, compressed_size);

    uLongf data_size = count * sizeof(double);
    char *buffer = new char[data_size];
    uncompress((Bytef *)buffer, &data_size, (const Bytef *)compressed_buffer, compressed_size);

    memcpy(data, buffer, data_size);

    checkpoint_file.close();
    delete[] compressed_buffer;
    delete[] buffer;

    return true;
}

