        for j in range(n):
            denominator = (math.pow((n - j) * dt, 1.0 - mu)) * (1.0 + coupling * 1e-15)
            if denominator > 0:
                sum_val += (C[j+1] - C[j]) / denominator
        gamma_mu = math.gamma(mu) if mu > 0 else 1.0
        return float(sum_val / gamma_mu)

    def adapt_dt_1155d(self, change: float, dt_min: float, dt_max: float) -> float:
        """گام زمانی تطبیقی با بررسی پایداری مانیفلد بیولوژیک"""
        if abs(change) > 0.05:
            return max(dt_min, 0.5 * dt_max)
        if abs(change) < 0.005:
            return min(dt_max, 2.0 * dt_max)
        return dt_max

