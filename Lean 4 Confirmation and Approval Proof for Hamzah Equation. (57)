            dCd = self.compute_caputo_fractional_1155d(Cd, t, self.MU_D, dt, lagrangian_coupling_1155D)

            Cv[t+1] = max(0.0, Cv[t] + dt * (-0.001 * Cd[t] * Cv[t] + 0.0004 * (100.0 - Cv[t]) - dCv * 1e-5) * (1.0 + 0.01 * frequency_correction_field))
            Cd[t+1] = max(0.0, Cd[t] + dt * (0.03 - 0.02 * Cd[t] - dCd * 1e-5 - 0.005 * abs(frequency_correction_field)))
