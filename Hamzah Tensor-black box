    def _calculate_scenario_hash(self, scenario_id):
        """محاسبه هش امنیتی برای سناریو"""
        base_data = f"SCENARIO_{scenario_id}_QUANTUM_SECURE_HASH_V4"
        
        # هش چندلایه
        hash1 = hashlib.sha3_512(base_data.encode()).hexdigest()
        hash2 = hashlib.blake2b(base_data.encode(), digest_size=64).hexdigest()
        hash3 = hashlib.shake_256(base_data.encode()).hexdigest(128)
        
        # ترکیب هش‌ها
        combined = hash1 + hash2 + hash3
        final_hash = hashlib.sha3_512(combined.encode()).hexdigest()
        
        return final_hash
    
