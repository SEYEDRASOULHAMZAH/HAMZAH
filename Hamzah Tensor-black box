                    quantum_noise = 0.005 * (np.random.randn() + 1j * np.random.randn())
                    
                    coupling_matrix[i,j] = strength * position_factor * phase + quantum_noise
        
        # اطمینان از هرمیتی بودن
        coupling_matrix = 0.5 * (coupling_matrix + coupling_matrix.conj().T)
        
        # نرمال‌سازی
        norm = np.linalg.norm(coupling_matrix)
        if norm > 0:
            coupling_matrix = coupling_matrix / norm
        
        return coupling_matrix

