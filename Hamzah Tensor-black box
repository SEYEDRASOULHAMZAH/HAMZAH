        # هرمیتی کردن
        H = (H + H.conj().T) / 2
        
        # مقیاس انرژی
        energy_scale = 1.0 + 0.1 * np.sin(dim_index * np.pi/15) + 0.05 * np.cos(dim_index * np.pi/7)
        H = H * energy_scale
        
        # اضافه کردن جفت‌شدگی ابعادی
        for i in range(op_size):
            for j in range(op_size):
                if i != j:
                    coupling = np.exp(-abs(i-j)/10) * (1 + 0.01 * np.sin(dim_index * np.pi/5))
                    H[i,j] *= coupling
        
        # عملگر تکامل زمانی
        dt = 1e-18  # 1 attosecond
        U = linalg.expm(-1j * H * dt)
        
        return {
            'hamiltonian': H,
            'evolution_operator': U,
            'energy_scale': energy_scale,
            'time_step': dt,
            'dimensional_index': dim_index,
            'unitary_check': np.allclose(U @ U.conj().T, np.eye(op_size), atol=1e-10)
        }
    
