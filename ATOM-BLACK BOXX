    def _run_stress_tests_for_element(self, element_id: int) -> Dict[str, Any]:
        """اجرای تست‌های استرس برای یک عنصر"""
        element = self.hamzah_core.element_database.get(element_id)
        if not element:
            return {'error': f'عنصر {element_id} یافت نشد'}
        
        start_time = time.time()
        test_results = []
        
        # اجرای تمام 300 تست
        for test_id, test_info in self.stress_tests.items():
            test_result = self._execute_stress_test(test_info, element)
            test_results.append(test_result)
        
        # تحلیل نتایج
        analysis = self._analyze_element_stress_results(test_results)
        
        return {
            'element_id': element_id,
            'element_name': element.get('name', f'Element_{element_id}'),
            'total_tests': 300,
            'successful_tests': len([r for r in test_results if r['success']]),
            'failed_tests': len([r for r in test_results if not r['success']]),
            'test_results': test_results,
            'analysis': analysis,
            'execution_time': time.time() - start_time,
            'timestamp': datetime.datetime.now().isoformat()
        }
    
    def _execute_stress_test(self, test_info: Dict[str, Any], element: Dict[str, Any]) -> Dict[str, Any]:
