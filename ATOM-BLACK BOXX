            elapsed = time.time() - start_time
            remaining = (elapsed / (batch_num * 1000)) * (45000 - batch_num * 1000)
            print(f"   ├─ زمان سپری شده: {elapsed:.1f} ثانیه")
            print(f"   └─ زمان باقی‌مانده: {remaining:.1f} ثانیه")
        
