def compute_mip_rho (base_rho : ℝ) (chi : ℝ) : ℝ :=
  base_rho * (1 + chi ^ 2)

def compute_mip_jacobian_det (chi : ℝ) : ℝ :=
  1 / (1 + (25 / 1000 : ℝ) * chi + (5 / 10000 : ℝ) * chi ^ 2)

def compute_total_effective_mass_mip (base_rho chi : ℝ) : ℝ :=
  compute_mip_rho base_rho chi * compute_mip_jacobian_det chi

-- لم ۱: اثبات مثبت بودن چگالی مؤثر پاد-اطلاعات فراداده
theorem mip_rho_always_positive (base_rho chi : ℝ) (h : base_rho > 0) :
    compute_mip_rho base_rho chi > 0 := by
  unfold compute_mip_rho
  have h_sq : 0 ≤ chi ^ 2 := sq_nonneg chi
  have h_sum : 0 < 1 + chi ^ 2 := by linarith
  exact mul_pos h h_sum

-- لم ۲: اثبات مثبت بودن فیلتر ژاکوبیان فراداده هولوگرافیک
