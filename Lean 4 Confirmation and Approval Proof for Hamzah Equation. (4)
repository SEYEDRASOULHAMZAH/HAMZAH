theorem total_effective_mass_mip_positive (base_rho chi : ℝ) (h_rho : base_rho > 0) (h_chi : 0 ≤ chi) :
    compute_total_effective_mass_mip base_rho chi > 0 := by
  unfold compute_total_effective_mass_mip
  have h1 := mip_rho_always_positive base_rho chi h_rho
  have h2 := mip_jacobian_det_always_positive chi h_chi
  exact mul_pos h1 h2

