  · unfold defaultMetadataConstants53; norm_num
  · have h_rho_pos : defaultMetadataConstants53.base_holo_rho > 0 := by
      unfold defaultMetadataConstants53; norm_num
    exact mip_rho_always_positive defaultMetadataConstants53.base_holo_rho chi h_rho_pos
  · exact mip_jacobian_det_always_positive chi h_chi
  · have h_rho_pos : defaultMetadataConstants53.base_holo_rho > 0 := by
      unfold defaultMetadataConstants53; norm_num
    exact total_effective_mass_mip_positive defaultMetadataConstants53.base_holo_rho chi h_rho_pos h_chi
