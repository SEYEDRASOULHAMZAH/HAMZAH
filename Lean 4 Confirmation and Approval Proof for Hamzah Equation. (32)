event = {'energy': 125.05, 'momentum': 1.0}
result = engine.hamzah_reprocessing(event)
print(f"[HAMZAH ENGINE INFO] تحلیل سیستم: {result['status']}")
print(f"[HAMZAH ENGINE INFO] فشار مانیفلد ۱۱۵۵ بعدی: {result['manifold_stress']:.6e}")
