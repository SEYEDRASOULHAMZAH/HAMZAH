engine = HamzahDynamicMassTestEngine(manifold_dim=1155)
classic, hamzah = engine.stress_test_simulation(manifold_stress)

# محاسبه همبستگی برای اثبات وابستگی جرم به فشار محاسباتی سیستم
correlation = np.corrcoef(manifold_stress, hamzah)[0, 1]
print(f"[HAMZAH ENGINE INFO] همبستگی جرم هیگز با استرس سیستم (مدل حمزه): {correlation:.4f}")
print("[HAMZAH ENGINE INFO] نتیجه: هیگز مقدار ثابتی نیست، بلکه یک متغیر وابسته به محاسبات عالم است.")

