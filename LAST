    def _analyze_integral_convergence_advanced(self, integral_value, D_f):
        """تحلیل همگرایی انتگرال‌های فرکتالی با روش‌های پیشرفته"""
        # شبیه‌سازی با تعداد نقاط مختلف برای بررسی همگرایی
        point_counts = [1000, 5000, 10000, 50000, 100000]
        results = []
        errors = []
        
        for n_points in point_counts:
            x_test = np.linspace(-100, 100, n_points)
            
            def test_kernel(x, t_val=1.0, dimension=D_f):
                return np.exp(-x**2 / (4.0 * t_val)) / (4.0 * np.pi * t_val)**(dimension/2.0)
            
            kernel_test = test_kernel(x_test)
            result_test = integrate.simps(kernel_test, x_test)
            results.append(result_test)
            
            if len(results) > 1:
                error = abs(results[-1] - results[-2]) / abs(results[-1]) if results[-1] != 0 else 0
                errors.append(error)
            else:
                errors.append(0)
        
        # تحلیل نرخ همگرایی
        if len(errors) > 1:
            convergence_rate = -np.log(errors[-1] / errors[-2]) / np.log(point_counts[-1] / point_counts[-2]) if errors[-2] != 0 else 0
        else:
            convergence_rate = 0
        
        # تعیین وضعیت همگرایی
        if errors[-1] < 1e-15:
            status = 'همگرا با دقت فوق‌العاده'
        elif errors[-1] < 1e-10:
            status = 'همگرا با دقت بالا'
        elif errors[-1] < 1e-5:
            status = 'همگرا با دقت متوسط'
        else:
            status = 'نیاز به نقاط بیشتر'
        
        return {
            'status': status,
            'final_error': errors[-1] if errors else 0,
            'convergence_rate': convergence_rate,
            'recommended_points': 1000000 if errors[-1] > 1e-10 else 100000,
            'error_trend': 'نزولی نمایی' if convergence_rate > 1 else 'نزولی خطی',
            'numerical_stability': 'پایدار' if errors[-1] < 1e-10 else 'نیاز به بررسی'
        }

