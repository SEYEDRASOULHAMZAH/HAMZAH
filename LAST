        fractal_term = self._compute_fractal_interaction(params)['F_Df']
        
        # ترم اینشتین-هیلبرت برای گرانش
        einstein_hilbert = c**4 / (16.0 * np.pi * G)
        
        # ترم ثابت کیهان‌شناسی
        cosmological_term = Lambda * c**2
        
        # ترم میدان کوانتومی دیراک
        quantum_field_term = hbar * c  # ساده‌سازی برای نمایش
        
        # ترم برهم‌کنش الکترومغناطیس (ساده‌سازی)
        em_interaction = (hbar * c) * self.constants['alpha_fs']
        
        # لاگرانژین کامل
        full_lagrangian = (einstein_hilbert + cosmological_term + 
                          fractal_term + quantum_field_term + em_interaction - hamzah_term)
        
        # بررسی سازگاری ابعادی
        dimensional_check = self._verify_lagrangian_dimensions(full_lagrangian)
        
        return {
