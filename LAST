                    # تبدیل به سیستم معادلات مرتبه اول
                    def schrodinger_system(x, y, E, m, V0, Ω_φ):
                        psi, phi = y
                        dpsi_dx = phi
                        dphi_dx = (2.0 * m / self.constants['hbar']**2) * (V0 + Ω_φ - E) * psi
                        return [dpsi_dx, dphi_dx]
                    
                    sol = solve_ivp(
                        schrodinger_system, 
                        [x[0], x[-1]], 
                        [psi_initial[0], 0],
                        args=(E, m, V0, Ω_φ),
                        t_eval=x,
                        method='RK45',
                        rtol=1e-12
                    )
                    wavefunctions.append(sol.y[0])
                except:
                    wavefunctions.append(psi_initial)
                    
        except Exception as e:
            energy_levels = [E_guess]
            wavefunctions = [np.exp(-x**2 / (1e-18))]
        
