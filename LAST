    def _compute_fractal_interaction_complete(self, params):
        """محاسبه ترم برهم‌کنش فرکتالی با انتگرال‌گیری دقیق و تحلیل کامل"""
        D_f = params.get('D_f', self.constants['D_fractal'])
        t = params.get('t', 1.0)
        dimensions = params.get('dimensions', 3)
        
        # تابع هسته فرکتالی پیشرفته با پارامترهای کامل
        def fractal_kernel_advanced(x, t_val, dimension=D_f, alpha=1.0, beta=1.0):
            """هسته گرین پیشرفته در فضای فرکتالی با پارامترهای تنظیم"""
            # جمله نمایی با تنظیم پارامترهای α و β
            exponential_term = np.exp(-alpha * x**2 / (4.0 * beta * t_val))
            
            # جمله توانی با بعد فرکتالی
            power_term = 1.0 / (4.0 * np.pi * beta * t_val)**(dimension/2.0)
            
            # جمله تصحیح فرکتالی
            fractal_correction = special.gamma(dimension/2.0) / (2.0 * np.pi**(dimension/2.0))
            
            return exponential_term * power_term * fractal_correction
        
        # انتگرال‌گیری چندبعدی فرکتالی با دقت فوق‌العاده
        x_range = np.linspace(-100, 100, 100000)  # افزایش دقت با نقاط بیشتر
