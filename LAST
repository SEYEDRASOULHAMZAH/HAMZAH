            # استفاده از بهینه‌سازی پیشرفته
            solution = optimize.root(
                lambda E: schrodinger_hamzah(np.exp(-x**2 / (1e-18)), x, E, m, V0, Ω_φ), 
                E_guess,
                method='lm',  # روش لونبرگ-مارکارد
                options={'xtol': 1e-20}
            )
            energy_levels = solution.x
            
            # محاسبه توابع موج
            wavefunctions = []
            for E in energy_levels:
