    def _compute_hamzah_primary_complete(self, params):
        """محاسبه معادله اولیه حمزه با دقت کوانتومی کامل و تحلیل کامل"""
        c = self.constants['c']
        hbar = self.constants['hbar']
        G = self.constants['G']
        L = params.get('L', 1.0)
        alpha = params.get('alpha', 1.0/self.constants['alpha_fs'])
        D_f = params.get('D_f', self.constants['D_fractal'])
        g_s = params.get('g_s', 1.0)
        g_w = params.get('g_w', 0.652)
        Lambda = params.get('Lambda', 1.1056e-52)
        ℓ_p = self.constants['ℓ_p']
        
        # محاسبه با دقت کوانتومی فوق‌العاده و کنترل خطا
        with np.errstate(all='ignore'):
            # ترم اول: (c^5/(ħG))^(1/α) با تحلیل ابعادی کامل
            term1_base = (c**5) / (hbar * G)
            term1 = term1_base ** (1.0 / alpha)
            
            # ترم دوم: (L/ℓ_p)^(D_f-1) با تصحیح فرکتالی
            term2 = (L / ℓ_p) ** (D_f - 1)
            
            # ترم سوم: exp(g_s g_w/(4π)) با ثابت‌های جفت‌شدگی دقیق
            term3 = np.exp(g_s * g_w / (4.0 * np.pi))
            
            # ترم چهارم: [ħc/(Λℓ_p^2 (L/ℓ_p)^2) + 10^(-50)] با ثابت کیهان‌شناسی
            denominator = Lambda * ℓ_p**2 * (L/ℓ_p)**2
            term4 = (hbar * c) / denominator + 1e-50
            
            # محاسبه نهایی Ω_φ با کنترل خطا
            Ω_φ = term1 * term2 * term3 * term4
        
        # تحلیل ابعادی کامل و دقیق
        dimensional_analysis = self._complete_dimensional_analysis_advanced(Ω_φ, 'energy_density')
        
        # محاسبه عدم قطعیت و خطا با روش‌های پیشرفته
        uncertainty_analysis = self._compute_uncertainty_analysis_advanced(params)
        
        # تحلیل حساسیت به تغییرات پارامترها
        sensitivity_analysis = self._compute_sensitivity_analysis_advanced(params, Ω_φ)
        
        # اعتبارسنجی با داده‌های تجربی
        experimental_validation = self._experimental_validation_advanced(Ω_φ, params)
        
        return {
            'Ω_φ': float(Ω_φ),
            'components': {
                'term1': float(term1),
                'term2': float(term2),
                'term3': float(term3),
                'term4': float(term4),
                'term1_base': float(term1_base)
            },
