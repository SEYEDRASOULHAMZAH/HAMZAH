    def _compute_hamzah_primary(self, params):
        """محاسبه معادله اولیه حمزه با دقت کوانتومی کامل"""
        c = self.constants['c']
        hbar = self.constants['hbar']
        G = self.constants['G']
        L = params.get('L', 1.0)
        alpha = params.get('alpha', 1.0/self.constants['alpha_fs'])
        D_f = params.get('D_f', self.constants['D_fractal'])
        g_s = params.get('g_s', 1.0)  # ثابت جفت‌شدگی قوی
        g_w = params.get('g_w', 0.652)  # ثابت جفت‌شدگی ضعیف
        Lambda = params.get('Lambda', 1.1056e-52)  # ثابت کیهان‌شناسی دقیق
        
        ℓ_p = self.constants['ℓ_p']
        
        # محاسبه با دقت کوانتومی فوق‌العاده
        with np.errstate(all='ignore'):
            # ترم اول: (c^5/(ħG))^(1/α)
            term1_base = (c**5) / (hbar * G)
            term1 = term1_base ** (1.0 / alpha)
            
            # ترم دوم: (L/ℓ_p)^(D_f-1)
            term2 = (L / ℓ_p) ** (D_f - 1)
            
            # ترم سوم: exp(g_s g_w/(4π))
            term3 = np.exp(g_s * g_w / (4.0 * np.pi))
            
            # ترم چهارم: [ħc/(Λℓ_p^2 (L/ℓ_p)^2) + 10^(-50)]
            denominator = Lambda * ℓ_p**2 * (L/ℓ_p)**2
            term4 = (hbar * c) / denominator + 1e-50
            
            # محاسبه نهایی Ω_φ
            Ω_φ = term1 * term2 * term3 * term4
        
        # تحلیل ابعادی کامل و دقیق
        dimensional_analysis = self._complete_dimensional_analysis(Ω_φ, 'energy_density')
        
        # محاسبه عدم قطعیت و خطا
        uncertainty_analysis = self._compute_uncertainty_analysis(params)
        
        return {
            'Ω_φ': float(Ω_φ),
            'components': {
                'term1': float(term1),
                'term2': float(term2),
                'term3': float(term3),
                'term4': float(term4),
                'term1_base': float(term1_base)
            },
            'dimensional_analysis': dimensional_analysis,
            'uncertainty_analysis': uncertainty_analysis,
            'quantum_certainty': self.constants['certainty_factor'],
            'precision': self.constants['quantum_precision'],
            'physical_interpretation': 'چگالی انرژی کوانتومی خلأ با تصحیح فرکتالی'
        }

    def _compute_hamzah_dual(self, params):
        """محاسبه فرم دوگانه معادله حمزه با تمام جزئیات"""
        c = self.constants['c']
        hbar = self.constants['hbar']
        G = self.constants['G']
        L = params.get('L', 1.0)
        alpha = params.get('alpha', 1.0/self.constants['alpha_fs'])
        D_f = params.get('D_f', self.constants['D_fractal'])
        g_s = params.get('g_s', 1.0)
        g_w = params.get('g_w', 0.652)
        Lambda = params.get('Lambda', 1.1056e-52)
        
        ℓ_p = self.constants['ℓ_p']
        
        with np.errstate(all='ignore'):
            # ترم اول: (ħG/c^5)^(1/α)
            term1_base = (hbar * G) / c**5
            term1 = term1_base ** (1.0 / alpha)
            
            # ترم دوم: (ℓ_p/L)^(D_f-1)
            term2 = (ℓ_p / L) ** (D_f - 1)
            
            # ترم سوم: exp(4π g_s g_w)
            term3 = np.exp(4.0 * np.pi * g_s * g_w)
            
            # ترم چهارم: [Λℓ_p^2 (ℓ_p/L)^2/(ħc) + 10^(-50)]
            numerator = Lambda * ℓ_p**2 * (ℓ_p/L)**2
            term4 = numerator / (hbar * c) + 1e-50
            
            # محاسبه نهایی Ω_φ
            Ω_φ = term1 * term2 * term3 * term4
        
        # بررسی تقارن با فرم اولیه
        primary_result = self._compute_hamzah_primary(params)
        symmetry_ratio = Ω_φ / primary_result['Ω_φ'] if primary_result['Ω_φ'] != 0 else 1.0
        
        return {
