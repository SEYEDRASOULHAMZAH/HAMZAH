    encrypted = bytearray()
    layer_key = self._generate_layer_key(layer)
    
    # رمزنگاری بلوکی
    block_size = 165  # مطابق با 165 بعد
    for i in range(0, len(data), block_size):
        block = data[i:i + block_size]
        if len(block) < block_size:
            block = block.ljust(block_size, b'\x00')
        
        encrypted_block = self._encrypt_block(block, layer_key, i // block_size)
        encrypted.extend(encrypted_block)
    
    return {
        'layer': layer,
        'key_fingerprint': hashlib.sha3_256(layer_key).hexdigest(),
        'encrypted_data': bytes(encrypted),
        'block_count': (len(data) + block_size - 1) // block_size
    }

