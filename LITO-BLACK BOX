    """تولید کلید لایه"""
    base_key = f"LAYER_{layer}_KEY_{time.time_ns()}".encode()
    
    # 1000 دور تقویت
    key = hashlib.sha3_512(base_key).digest()
    for _ in range(999):
        key = hashlib.sha3_512(key).digest()
    
    return key

