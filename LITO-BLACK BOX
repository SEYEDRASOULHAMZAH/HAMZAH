def execute_all_tests_securely(self, user_token: str = None) -> Dict[str, Any]:
    """اجرای امن تمام 250 تست"""
    print(f"\n🧪 اجرای امن تمام 250 تست استرس...")
    
    start_time = time.time()
    results = {
        'execution_id': str(uuid.uuid4()),
        'start_time': datetime.datetime.now().isoformat(),
        'total_tests': 250,
        'completed': 0,
        'passed': 0,
        'failed': 0,
        'category_results': {},
        'detailed_results': {}
    }
    
    # اجرای تست‌ها به صورت گروهی
    categories = self.stress_tester.test_categories
    
    for category, test_ids in categories.items():
        print(f"\n📊 اجرای تست‌های دسته {category}...")
        
        category_results = []
        for test_id in test_ids:
            try:
                test_result = self.execute_test_securely(test_id, user_token)
                category_results.append(test_result)
                
                if test_result.get('status') == 'PASSED':
                    results['passed'] += 1
                else:
                    results['failed'] += 1
                
                results['completed'] += 1
                
                # نمایش پیشرفت
                if test_id % 10 == 0:
                    progress = (results['completed'] / 250) * 100
                    print(f"   پیشرفت: {progress:.1f}% - تست {test_id}/250")
                    
            except Exception as e:
                print(f"❌ خطا در تست {test_id}: {e}")
                results['failed'] += 1
                results['completed'] += 1
        
        results['category_results'][category] = {
            'total': len(test_ids),
            'passed': len([r for r in category_results if r.get('status') == 'PASSED']),
            'failed': len([r for r in category_results if r.get('status') != 'PASSED']),
            'success_rate': len([r for r in category_results if r.get('status') == 'PASSED']) / len(test_ids) if test_ids else 0
        }
    
    # محاسبات نهایی
    results['end_time'] = datetime.datetime.now().isoformat()
    results['execution_duration'] = time.time() - start_time
    results['overall_success_rate'] = results['passed'] / 250 if results['passed'] > 0 else 0
    
    # تصمیم نهایی
    if results['overall_success_rate'] >= 0.9999999999:
        results['final_verdict'] = 'ALL_TESTS_PASSED'
        results['certification'] = 'HAMZAH_165D_250_TEST_CERTIFIED'
    elif results['overall_success_rate'] >= 0.99:
        results['final_verdict'] = 'EXCELLENT_PERFORMANCE'
        results['certification'] = 'HIGH_PERFORMANCE_CERTIFIED'
    else:
        results['final_verdict'] = 'TESTS_COMPLETED_WITH_ISSUES'
        results['certification'] = 'CONDITIONAL_CERTIFICATION'
    
    print(f"\n✅ اجرای تست‌ها کامل شد!")
    print(f"   تست‌های موفق: {results['passed']}/250")
    print(f"   نرخ موفقیت: {results['overall_success_rate']*100:.10f}%")
    print(f"   زمان اجرا: {results['execution_duration']:.2f} ثانیه")
    
    return results

