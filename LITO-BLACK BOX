def _analyze_by_category(self, detailed_results: Dict[str, Any]) -> Dict[str, Any]:
    """تحلیل نتایج بر اساس دسته‌بندی"""
    categories = {
        'تانسور و ریاضیات': {'total': 50, 'passed': 0, 'failed': 0},
        'محاسبات کوانتومی': {'total': 50, 'passed': 0, 'failed': 0},
        'لیتوگرافی و مواد': {'total': 50, 'passed': 0, 'failed': 0},
        'آگاهی و اخلاق': {'total': 50, 'passed': 0, 'failed': 0},
        'انرژی و پایداری': {'total': 50, 'passed': 0, 'failed': 0}
    }
    
    for test_key, result in detailed_results.items():
        # استخراج دسته‌بندی از شناسه تست
        test_id = int(test_key.split('_')[1])
        
        if 1 <= test_id <= 50:
            category = 'تانسور و ریاضیات'
        elif 51 <= test_id <= 100:
            category = 'محاسبات کوانتومی'
        elif 101 <= test_id <= 150:
            category = 'لیتوگرافی و مواد'
        elif 151 <= test_id <= 200:
            category = 'آگاهی و اخلاق'
        else:
            category = 'انرژی و پایداری'
        
        if result['status'] == 'PASSED':
            categories[category]['passed'] += 1
        else:
            categories[category]['failed'] += 1
    
    # محاسبه نرخ موفقیت برای هر دسته
    for category in categories:
        total = categories[category]['total']
        passed = categories[category]['passed']
        categories[category]['success_rate'] = passed / total if total > 0 else 0
    
    return categories

