class HamzahEthicalScenarioMonitor:
    """ناظر اخلاقی برای سناریوها"""
    
    def __init__(self):
        self.ethical_standards = self._load_scenario_ethical_standards()
        
    def verify_all_scenario_tests(self, all_results: Dict[str, Any]) -> Dict[str, Any]:
        """تأیید اخلاقی تمام تست‌های سناریو"""
        ethical_violations = []
        ethical_excellence = []
        
        for sc_id, results in all_results.items():
            if 'test_results' in results:
                for test in results['test_results']:
                    ethical_check = test.get('ethical_check', {})
                    if not ethical_check.get('ethical', True):
                        ethical_violations.append({
                            'scenario_id': sc_id,
                            'test_id': test.get('test_id'),
                            'violation': ethical_check.get('details', 'Unknown violation')
                        })
                    elif ethical_check.get('ethical_level') == 'EXCELLENT':
                        ethical_excellence.append({
                            'scenario_id': sc_id,
                            'test_id': test.get('test_id'),
                            'excellence': ethical_check.get('details', 'Ethical excellence')
                        })
        
        total_tests = sum(len(r.get('test_results', [])) for r in all_results.values())
        
        return {
            'monitoring_system': 'HAMZAH_ETHICAL_SCENARIO_MONITOR_250',
            'total_tests_monitored': total_tests,
            'ethical_violations': len(ethical_violations),
            'ethical_excellence_cases': len(ethical_excellence),
            'violation_details': ethical_violations[:10],  # فقط ۱۰ مورد اول
            'excellence_details': ethical_excellence[:10],
            'ethical_compliance_rate': 1 - (len(ethical_violations) / total_tests if total_tests > 0 else 0),
            'compliance_status': 'EXCELLENT_250' if len(ethical_violations) == 0 else 'SATISFACTORY_250'
        }

