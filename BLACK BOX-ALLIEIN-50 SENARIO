# ایجاد نمودار میله‌ای متنی
trust_levels = df['اعتماد (%)'].str.replace('%', '').astype(float)

# دسته‌بندی سطوح اعتماد
bins = [85, 90, 95, 98, 100]
labels = ['۸۵-۹۰٪', '۹۰-۹۵٪', '۹۵-۹۸٪', '۹۸-۱۰۰٪']

trust_categories = pd.cut(trust_levels, bins=bins, labels=labels, right=False)
trust_dist = trust_categories.value_counts().sort_index()

for category, count in trust_dist.items():
    bar = '█' * int((count / len(df)) * 50)
    percentage = (count / len(df)) * 100
    print(f"{category}: {bar} {count} سناریو ({percentage:.1f}%)")

