        # پیچیدگی شمارش برای بعد مؤثر
        effective_dim = basis_dimension - block_size
        if effective_dim > 0:
            enum_complexity = 0.187 * effective_dim * log2(effective_dim) - 1.019 * effective_dim + 16.1
        else:
            enum_complexity = 0
            
        total_complexity = bkz_complexity + enum_complexity
        
        # اعمال بهینه‌سازی‌های معتبر
        optimization_factors = [
            log2(1.4),  # کاهش بعد
            log2(1.8),  # بهینه‌سازی الگوریتمی
            log2(2.0)   # موازی‌سازی
        ]
        
        optimized_complexity = total_complexity - sum(optimization_factors)
        
        return max(optimized_complexity, 128)  # حداقل امنیت

    def execute_comprehensive_attack(self, public_key=None):
        """
        اجرای حمله جامع به Kyber-768
        """
