        norms = []
        for i in range(basis.nrows):
            norm = sum(basis[i, j] ** 2 for j in range(basis.ncols))
            norms.append(sqrt(norm))
            
        min_norm = min(norms)
        return min_norm * pruning_factor * basis.nrows

