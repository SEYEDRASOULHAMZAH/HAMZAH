    def construct_proper_kyber_lattice(self, A_matrix):
        """
        ساختار صحیح شبکه Kyber مبتنی بر Module-LWE
        L = [[I, 0], [A^T, qI]]
        """
        print("🔧 ساخت شبکه Kyber با ساختار صحیح...")
        
        dim = self.k * self.n
        lattice = np.zeros((2 * dim, 2 * dim), dtype=int)
        
        # بلوک I
        for i in range(dim):
            lattice[i, i] = 1
            
        # بلوک A^T
        for i in range(dim):
            for j in range(dim):
                lattice[dim + i, j] = A_matrix[j, i] % self.q
                
        # بلوک qI
        for i in range(dim):
            lattice[dim + i, dim + i] = self.q
            
        return lattice

    def gram_schmidt_orthogonalization(self, basis):
        """الگوریتم گرام-اشمیت برای متعامدسازی"""
        n = basis.shape[0]
        ortho = basis.astype(float).copy()
        
        for i in range(n):
            for j in range(i):
                mu = np.dot(basis[i], ortho[j]) / np.dot(ortho[j], ortho[j])
                ortho[i] = ortho[i] - mu * ortho[j]
                
        return ortho

    def lll_reduction(self, basis, delta=0.75):
        """
        پیاده‌سازی الگوریتم LLL برای کاهش پایه شبکه
        """
        print("🔄 اجرای الگوریتم LLL...")
        basis = basis.astype(float)
        n = basis.shape[0]
        
        # Gram-Schmidt orthogonalization
        ortho = self.gram_schmidt_orthogonalization(basis)
        
        k = 1
        while k < n:
            # کاهش اندازه
            for j in range(k-1, -1, -1):
                mu = np.dot(basis[k], ortho[j]) / np.dot(ortho[j], ortho[j])
                if abs(mu) > 0.5:
                    basis[k] = basis[k] - round(mu) * basis[j]
                    ortho = self.gram_schmidt_orthogonalization(basis)
            
            # شرط LLL
            ortho_norm_k = np.dot(ortho[k], ortho[k])
            ortho_norm_km1 = np.dot(ortho[k-1], ortho[k-1])
            mu_k_km1 = np.dot(basis[k], ortho[k-1]) / ortho_norm_km1
            
            if ortho_norm_k >= (delta - mu_k_km1**2) * ortho_norm_km1:
                k += 1
            else:
                # جابجایی بردارها
                basis[[k-1, k]] = basis[[k, k-1]]
                ortho = self.gram_schmidt_orthogonalization(basis)
                k = max(k-1, 1)
                
        return basis.astype(int)

    def bkz_reduction(self, basis, block_size=40):
        """
        شبیه‌سازی الگوریتم BKZ برای کاهش پیشرفته
        """
        print(f"🌀 اجرای BKZ با اندازه بلوک {block_size}...")
        
        basis_reduced = basis.copy()
        n = basis.shape[0]
        
        for i in range(0, n - block_size + 1, block_size//2):
            # استخراج و کاهش بلوک
            end_idx = min(i + block_size, n)
            block = basis_reduced[i:end_idx, i:end_idx]
            
            # کاهش بلوک با LLL
            block_reduced = self.lll_reduction(block)
            basis_reduced[i:end_idx, i:end_idx] = block_reduced
            
        return basis_reduced

    def babai_nearest_plane(self, basis, target):
        """
        الگوریتم Babai برای یافتن نزدیک‌ترین نقطه در شبکه
        """
        ortho = self.gram_schmidt_orthogonalization(basis)
        n = basis.shape[0]
        result = np.zeros(n, dtype=int)
        t = target.astype(float)
        
        for i in range(n-1, -1, -1):
            mu = np.dot(t, ortho[i]) / np.dot(ortho[i], ortho[i])
            result = result + round(mu) * basis[i]
            t = t - round(mu) * basis[i]
            
        return result

    def pruned_enumeration(self, basis, target, radius, max_iterations=1000):
        """
        شمارش هرس‌شده برای یافتن بردار کوتاه
        """
        print(f"🎯 اجرای شمارش هرس‌شده (شعاع: {radius})...")
        
        n = basis.shape[0]
        best_vector = None
        best_distance = float('inf')
        
        # پایه متعامد برای محاسبه مرزهای هرس
        ortho = self.gram_schmidt_orthogonalization(basis)
        ortho_norms = [norm(ortho[i]) for i in range(n)]
        
        def enumerate_recursive(level, current_partial, current_dist):
            nonlocal best_vector, best_distance
            
            if level == n:
                if 0 < current_dist < best_distance:
                    best_distance = current_dist
                    best_vector = current_partial.copy()
                return
            
            # محاسبه مرزهای هرس
            center = -np.dot(target - np.dot(current_partial, basis), ortho[level]) / ortho_norms[level]**2
            radius_sq = radius**2 - current_dist
            
            if radius_sq < 0:
                return
                
            bound = sqrt(radius_sq) / ortho_norms[level]
            lower = int(center - bound)
            upper = int(center + bound)
            
            # محدود کردن تعداد تکرارها
            search_range = min(upper - lower + 1, max_iterations // (2**(n-level)))
            
            for x in range(lower, lower + search_range):
                if x < lower or x > upper:
                    continue
                    
                new_partial = current_partial.copy()
                new_partial[level] = x
                
                new_dist = current_dist + (x - center)**2 * ortho_norms[level]**2
                
                if new_dist <= radius**2:
                    enumerate_recursive(level + 1, new_partial, new_dist)
        
        # شروع شمارش با محدودیت زمانی
        initial_partial = np.zeros(n, dtype=int)
        try:
            enumerate_recursive(0, initial_partial, 0)
        except RecursionError:
            print("⚠️ توقف شمارش به دلیل محدودیت بازگشت")
        
        return best_vector, best_distance

    def dimension_reduction(self, basis, target_dim=256):
        """
        کاهش بعد هوشمند بر اساس تحلیل مقادیر ویژه
        """
        print(f"📉 کاهش بعد از {basis.shape[0]} به {target_dim}...")
        
        # تحلیل مقادیر ویژه
        covariance = np.cov(basis.astype(float))
        eigenvalues, eigenvectors = np.linalg.eigh(covariance)
        
        # انتخاب مهم‌ترین جهت‌ها
        significant_indices = np.argsort(eigenvalues)[-target_dim:]
        reduced_basis = eigenvectors[:, significant_indices].T @ basis
        
        return reduced_basis.astype(int)

    def quantum_inspired_optimization(self, basis, num_samples=100):
        """
        بهینه‌سازی الهام‌گرفته از اصول کوانتومی
        """
        print("🔮 اجرای بهینه‌سازی کوانتومی...")
        
        samples = []
        n = basis.shape[0]
        
        for _ in range(num_samples):
            # نمونه‌برداری مبتنی بر توزیع گاوسی
            weights = np.random.normal(0, 1, n)
            sample = np.dot(weights, basis) % self.q
            samples.append(sample)
            
        return samples

    def calculate_realistic_complexity(self, basis_dimension, block_size):
        """
        محاسبه پیچیدگی واقع‌بینانه بر اساس مدل‌های علمی
        """
        # مدل پیچیدگی برای BKZ
