    def __init__(self, oncogene_freq: float, amplitude: float, phase_offset: float = 0.0) -> None:
        self.nu_noise = oncogene_freq
        self.amp = amplitude
        self.phase = phase_offset
        self.timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
