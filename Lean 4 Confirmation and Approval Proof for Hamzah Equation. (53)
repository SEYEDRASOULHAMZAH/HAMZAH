        tumor_reduction = (1.0 - (P[max_steps] / max(1.0, P[0]))) * 100.0
        total_lagrangian_val = self.compute_total_oncology_lagrangian_integral(V_sys=10.0)
        r_comb = self.ALPHA_CONST * Rv * math.pow(max(0.0, abs(tumor_reduction) / 100.0), 0.8) * ((self.OMEGA_H_15 * 0.0) + 1.0)

