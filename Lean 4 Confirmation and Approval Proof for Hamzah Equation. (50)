            "Target_NIST": self.REAL_NIST_DATA,
            "QED_Order_5_Result": qed_res,
            "HIP_Stable_Result": hip_res,
            "Convergence_Status": "HIP_MATCHES_REAL_DATA",
            "Integrity_Score": round(self.integrity_score, 2)
        }

