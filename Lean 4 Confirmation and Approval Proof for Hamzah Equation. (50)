    def calculate_field(self, info_density_map: np.ndarray, entropy_map: np.ndarray) -> Union[np.ndarray, str]:
        """محاسبه میدان مغناطیسی بر اساس نگاشت اطلاعاتی با فیلتر پایداری ترمودینامیکی"""
        if info_density_map.size == 0 or entropy_map.size == 0:
