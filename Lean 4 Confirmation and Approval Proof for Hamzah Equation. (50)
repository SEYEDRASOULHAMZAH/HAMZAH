        """محاسبه دمای تاج خورشیدی مبتنی بر کاهش انتروپی و چگالی اطلاعات در مدل HIP"""
        if s_mat.size == 0:
            self.integrity_score -= 0.2
            logging.error("خطای ترمودینامیکی: بردار انتروپی تهی است.")
            return "ERROR: Empty entropy matrix."

