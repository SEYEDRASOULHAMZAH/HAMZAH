            logging.warning("هشدار ترمودینامیکی: مقدار زیر رادیکال منفی شد؛ ایمن‌سازی انجام شد.")
            radicand_val = max(0.0, radicand_val)

        correction_factor = np.sqrt(radicand_val)
        return float(self.C0 * correction_factor)

