        self.integrity_score: float = 1.0
        logging.info(f"Initializing Solar Flare Predictor Kernel for Cluster: {self.cluster_id} in {self.MANIFOLD_DIM}D.")

    def calculate_criticality(self, s_mat_t: float) -> Union[float, str]:
        """محاسبه شاخص بحرانی C_H بر اساس مقدار انتروپی و آستانه کف"""
        if s_mat_t < 0.0:
            self.integrity_score -= 0.1
