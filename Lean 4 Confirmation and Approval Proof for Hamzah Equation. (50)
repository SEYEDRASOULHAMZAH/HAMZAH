            return np.zeros((1, 1), dtype=complex)
        
        noise_phase = np.exp(1j * np.random.uniform(0, 2 * np.pi, data.shape))
        encoded = np.fft.fft2(data) * noise_phase
        return encoded

    def bharf_decryption(self, encoded_data: np.ndarray) -> np.ndarray:
        """بازخوانی آرشیو از طریق تابش هاوکینگ با کلید تانسور معکوس و فیلتر نویز افق"""
