        """محاسبه تاخیر زمانی سانیار کلاسیک با کنترل خطا"""
        if area <= 0.0 or omega < 0.0:
            self.integrity_score -= 0.15
            logging.warning("هشدار فیزیکی: مساحت یا سرعت زاویه‌ای نامعتبر است.")
            area = abs(area)
            omega = abs(omega)
        
