        """ارزیابی جامع انحراف کلاسیک در برابر پایداری شیار حمزه طی 1000 سال"""
        try:
            time = np.linspace(0, 1000, 1000)
            path_class, path_hamzah = self.simulate_paths(time)

            mean_class_dev = float(np.mean(path_class[1]))
            mean_hamzah_dev = float(np.mean(path_hamzah[1]))

            return {
                "Simulation_Horizon_Years": 1000,
                "Classical_Deviation": mean_class_dev,
                "Hamzah_Groove_Stability": mean_hamzah_dev,
                "Status": "HAMZAH_LATTICE_LOCKED_STABLE"
            }
        except Exception as e:
            self.integrity_score -= 0.15
            logging.error(f"خطا در ارزیابی معیارهای پایداری: {str(e)}")
            return {"Status": "ERROR"}

    def generate_compliance_report(self) -> pd.DataFrame:
        """تولید گزارش ساختاریافته Pandas برای پایداری مداری"""
        res = self.evaluate_stability_metrics()
        report_data = [{
