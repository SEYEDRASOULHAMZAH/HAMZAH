    def simulate_paths(self, time_years: np.ndarray) -> Tuple[Tuple[np.ndarray, np.ndarray], Tuple[np.ndarray, np.ndarray]]:
        """شبیه‌سازی مسیر کلاسیک مارپیچی در برابر شیار قفل‌شده حمزه"""
        try:
            x_class = self.SUN_VELOCITY * time_years
            y_class = self.PLANET_VELOCITY * np.sin(time_years) * self.STABILITY_FACTOR

            x_hamzah = self.SUN_VELOCITY * time_years
            y_hamzah = np.zeros_like(time_years)  # Completely locked in the groove

            return (x_class, y_class), (x_hamzah, y_hamzah)
        except Exception as e:
            self.integrity_score -= 0.2
            logging.error(f"خطا در شبیه‌سازی مسیر مداری: {str(e)}")
            return (np.zeros(1), np.zeros(1)), (np.zeros(1), np.zeros(1))

