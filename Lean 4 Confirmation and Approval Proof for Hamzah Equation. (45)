            radiation_tensor = (expanded_matter + tensor_jitter) * 0.001 / entropy_rate_tensor.unsqueeze(1)
            mean_radiation = torch.mean(radiation_tensor, dim=0).tolist()
            tensor_std = torch.std(radiation_tensor).item()

            return {
