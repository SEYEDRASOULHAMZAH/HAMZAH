        self.mass: float = mass
        self.entropy_bh: float = 4.0 * np.pi * (mass ** 2)
        self.timestamp: str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        logging.info(f"راه‌اندازی موتور تانسوری توزیع‌شده سیاهچاله با تعداد گره: {node_count}")

    def compute_tensor_blackhole_metrics(self) -> Dict[str, Any]:
        """محاسبه موازی تانسوری بافر اطلاعات و سیگنال‌های تابش هاوکینگ با PyTorch"""
        try:
            matter_tensor = torch.tensor([0.95, 0.05], dtype=torch.float64)
            entropy_rate_tensor = torch.full((self.node_count,), 1e70, dtype=torch.float64)
            
            # گسترش بردار ماده برای پردازش موازی در تمام گره‌های 1155D
            expanded_matter = matter_tensor.repeat(self.node_count, 1)
