    def extract_cyclic_block(self, matrix, start_row, start_col, size):
        """استخراج بلوک چرخشی از ماتریس"""
        block = np.zeros((size, size), dtype=complex)
        
        for i in range(size):
            for j in range(size):
                # استفاده از ویژگی چرخشی برای استخراج
                row_idx = (start_row + i) % matrix.shape[0]
                col_idx = (start_col + j) % matrix.shape[1]
                block[i, j] = matrix[row_idx, col_idx]
        
        return block
    
    def build_cyclic_structure(self, blocks):
        """ساخت ساختار چرخشی از بلوک‌ها"""
        num_blocks_per_side = int(np.sqrt(len(blocks)))
        cyclic_matrix = np.zeros((self.total_dim, self.total_dim), dtype=complex)
        
        for idx, block in enumerate(blocks):
            i = idx // num_blocks_per_side
            j = idx % num_blocks_per_side
            
            start_row = i * self.n
            start_col = j * self.n
            end_row = start_row + self.n
            end_col = start_col + self.n
            
            cyclic_matrix[start_row:end_row, start_col:end_col] = block
        
        return cyclic_matrix

