        # اعتبارسنجی زمانی
        temporal_valid = self._temporal_validation(scenario_id)
        
        # اعتبارسنجی ابعاد پنهان
        dimensional_valid = self._dimensional_validation(scenario_id)
        
        overall_valid = success and quantum_valid and temporal_valid and dimensional_valid
        
        return {
