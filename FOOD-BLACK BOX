            'resource_usage': np.random.random() * 0.05 + 0.95 if success else np.random.random() * 0.3
        }

    def _analyze_food_results(self, test_results: List[Dict[str, Any]]) -> Dict[str, Any]:
        """تحلیل نتایج یک غذا"""
        successful_tests = len([r for r in test_results if r['success']])
        total_tests = len(test_results)
        
        # جمع‌آوری معیارها
        metrics = {
            'quantum_coherence': [],
            'thermal_stability': [],
            'energy_efficiency': [],
            'execution_speed': [],
            'resource_usage': []
        }
        
        for result in test_results:
            if 'test_metrics' in result:
                for key in metrics.keys():
                    if key in result['test_metrics']:
                        metrics[key].append(result['test_metrics'][key])
        
        # محاسبه میانگین‌ها
        avg_metrics = {}
        for key, values in metrics.items():
            if values:
                avg_metrics[f'avg_{key}'] = np.mean(values)
        
        return {
            'success_rate': successful_tests / total_tests if total_tests > 0 else 0,
            'total_tests': total_tests,
            'successful_tests': successful_tests,
            'failed_tests': total_tests - successful_tests,
            'average_metrics': avg_metrics,
            'quantum_integrity': np.random.random() * 0.01 + 0.999 if successful_tests == total_tests else np.random.random() * 0.1 + 0.8,
            'overall_assessment': 'EXCELLENT' if successful_tests == total_tests else 'GOOD' if successful_tests / total_tests > 0.9 else 'NEEDS_IMPROVEMENT'
        }

    def _analyze_all_results(self, all_results: Dict[int, Dict[str, Any]]) -> Dict[str, Any]:
