            'blake2b_28': hashlib.blake2b(data, digest_size=28).hexdigest(),
            'shake_256_280': hashlib.shake_256(data).hexdigest(280//8),
            'combined_omega': hashlib.sha3_256(
                hashlib.sha3_512(data).digest() + 
                hashlib.blake2b(data).digest()
            ).hexdigest()
        }
        return hashes

