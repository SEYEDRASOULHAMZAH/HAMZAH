class Hamzah165DEthicalMonitor:
    """ناظر اخلاقی برای تست‌های استرس ۱۶۵D"""
    
    def __init__(self):
        self.ethical_standards = self._load_165d_ethical_standards()
        
    def verify_all_tests(self, all_results: Dict[str, Any]) -> Dict[str, Any]:
        """تأیید اخلاقی تمام تست‌های استرس"""
        ethical_violations = []
        
        for test_id, results in all_results.items():
            if 'test_results' in results:
                for test in results.get('test_results', []):
                    if not test.get('ethical_check', {}).get('ethical', True):
                        ethical_violations.append({
                            'stress_test_id': test_id,
                            'test_id': test.get('test_id'),
                            'violation': test['ethical_check'].get('details', 'Unknown'),
                            'severity': test.get('severity_level', 'MEDIUM')
                        })
        
        total_tests = sum(len(r.get('test_results', [])) for r in all_results.values())
        
        return {
            'monitoring_system': 'HAMZAH_165D_ETHICAL_TEST_MONITOR',
            'total_stress_tests_monitored': len(all_results),
            'total_security_tests_checked': total_tests,
            'ethical_violations': len(ethical_violations),
            'violation_details': ethical_violations,
            'ethical_compliance_rate': 1 - (len(ethical_violations) / total_tests if total_tests > 0 else 0),
            'compliance_status': 'EXCELLENT' if len(ethical_violations) == 0 else 'REVIEW_NEEDED'
        }

