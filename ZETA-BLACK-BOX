                                 default='SECURE_EXECUTOR',
                                 help='حالت تبدیل')
    transform_parser.add_argument('--language', '-l', default='auto', help='زبان کد')
    
    # دستور batch
    batch_parser = subparsers.add_parser('batch', help='تبدیل دسته‌ای')
    batch_parser.add_argument('input_dir', help='دایرکتوری ورودی')
    batch_parser.add_argument('output_dir', help='دایرکتوری خروجی')
    batch_parser.add_argument('--mode', '-m', default='SECURE_EXECUTOR',
                             choices=['SECURE_EXECUTOR', 'INJECTED_CODE', 'UNIFIED'],
                             help='حالت تبدیل')
    
    # دستور string
    string_parser = subparsers.add_parser('string', help='تبدیل رشته کد')
    string_parser.add_argument('code', help='رشته کد')
    string_parser.add_argument('--language', '-l', default='python', help='زبان کد')
