            with open(input_file, 'r', encoding='utf-8') as f:
                code_content = f.read()
            
            if language == 'auto':
                ext = os.path.splitext(input_file)[1].lower()
                lang_map = {
                    '.py': 'python', '.cpp': 'cpp', '.java': 'java',
                    '.js': 'javascript', '.cs': 'csharp', '.go': 'go',
                    '.rs': 'rust', '.rb': 'ruby', '.php': 'php',
                    '.swift': 'swift', '.kt': 'kotlin', '.ts': 'typescript',
                    '.m': 'matlab', '.r': 'r', '.scala': 'scala'
                }
                language = lang_map.get(ext, 'unknown')
            
            result = self.transformer.transform_code(code_content, language, mode)
            
            if output_file and 'output' in result:
                if isinstance(result['output'], str):
                    with open(output_file, 'w', encoding='utf-8') as f:
                        f.write(result['output'])
                else:
                    import json
                    with open(output_file, 'w', encoding='utf-8') as f:
                        json.dump(result['output'], f, ensure_ascii=False, indent=2)
            
            self._record_execution(input_file, result)
            
            print(f"✅ پردازش با موفقیت انجام شد!")
            return result
            
        except Exception as e:
            error_msg = f"خطا در پردازش فایل: {str(e)}"
            print(f"❌ {error_msg}")
            return {'error': error_msg}
    
    def process_code_string(self, code: str, language: str = 'python',
                           mode: str = 'SECURE_EXECUTOR') -> Dict[str, Any]:
        """پردازش رشته کد"""
        print(f"\n📝 پردازش رشته کد (زبان: {language})")
        
        try:
            result = self.transformer.transform_code(code, language, mode)
            return result
        except Exception as e:
            return {'error': str(e)}
    
    def batch_process(self, input_dir: str, output_dir: str,
                     mode: str = 'SECURE_EXECUTOR') -> Dict[str, Any]:
        """پردازش دسته‌ای"""
        import glob
        
        results = {
            'successful': [],
            'failed': [],
            'total': 0
        }
        
        code_files = []
        for ext in ['*.py', '*.cpp', '*.java', '*.js', '*.cs', '*.go', 
                   '*.rs', '*.rb', '*.php', '*.swift', '*.kt', '*.ts']:
            code_files.extend(glob.glob(os.path.join(input_dir, '**', ext), recursive=True))
        
        results['total'] = len(code_files)
        
        for file_path in code_files:
            try:
                rel_path = os.path.relpath(file_path, input_dir)
                output_path = os.path.join(output_dir, rel_path)
                os.makedirs(os.path.dirname(output_path), exist_ok=True)
                
                result = self.process_file(file_path, output_path, mode)
                
                if 'error' not in result:
                    results['successful'].append(file_path)
                else:
                    results['failed'].append({'file': file_path, 'error': result['error']})
                    
            except Exception as e:
                results['failed'].append({'file': file_path, 'error': str(e)})
        
        return results
    
    def _record_execution(self, input_file: str, result: Dict[str, Any]):
        """ثبت تاریخچه اجرا"""
        record = {
            'input_file': input_file,
            'timestamp': time.time_ns(),
            'status': result.get('status', 'UNKNOWN'),
            'mode': result.get('mode', 'UNKNOWN'),
            'execution_time': result.get('execution_time', 0)
        }
        
        self.execution_history.append(record)
        
        history_file = 'zeta_unified_history.json'
        try:
            if os.path.exists(history_file):
                with open(history_file, 'r', encoding='utf-8') as f:
                    history = json.load(f)
            else:
                history = []
            
            history.append(record)
            
            with open(history_file, 'w', encoding='utf-8') as f:
                json.dump(history, f, ensure_ascii=False, indent=2)
        except:
            pass

