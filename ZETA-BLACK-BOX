    def transform_file(self, 
                      input_file: str, 
                      output_dir: str = None,
                      security_level: str = 'ABSOLUTE',
                      language: str = 'auto') -> Dict[str, Any]:
        """تبدیل فایل کد به نسخه امنیتی"""
        print(f"\n📁 تبدیل فایل: {input_file}")
        
        try:
            # خواندن فایل
            with open(input_file, 'r', encoding='utf-8') as f:
                code_content = f.read()
            
            # تشخیص خودکار زبان اگر مشخص نشده
            if language == 'auto':
                import os
                ext = os.path.splitext(input_file)[1].lower()
                lang_map = {
                    '.py': 'python',
                    '.cpp': 'cpp', '.cc': 'cpp', '.cxx': 'cpp',
                    '.java': 'java',
                    '.js': 'javascript',
                    '.cs': 'csharp',
                    '.go': 'go',
                    '.rs': 'rust',
                    '.rb': 'ruby',
                    '.php': 'php',
                    '.swift': 'swift',
                    '.kt': 'kotlin',
                    '.ts': 'typescript',
                    '.m': 'matlab',
                    '.r': 'r', '.R': 'r',
                    '.scala': 'scala'
                }
                language = lang_map.get(ext, 'unknown')
            
            # تبدیل کد
            result = self.transformer.transform_code_to_secure_version(
                code_content, language, security_level
            )
            
            # ذخیره نتایج
            if output_dir:
                self._save_results(result, input_file, output_dir)
            
            # ثبت در تاریخچه
            self._record_deployment(result, input_file)
            
            return result
            
        except Exception as e:
            error_msg = f"خطا در تبدیل فایل: {str(e)}"
            print(f"❌ {error_msg}")
            return {'error': error_msg, 'input_file': input_file}
    
    def transform_code_string(self, 
                            code: str, 
                            language: str = 'python',
                            security_level: str = 'ABSOLUTE') -> Dict[str, Any]:
        """تبدیل رشته کد به نسخه امنیتی"""
        print(f"\n📝 تبدیل رشته کد (زبان: {language})")
        
        try:
            result = self.transformer.transform_code_to_secure_version(
                code, language, security_level
            )
            
            return result
            
        except Exception as e:
            error_msg = f"خطا در تبدیل کد: {str(e)}"
            print(f"❌ {error_msg}")
            return {'error': error_msg, 'code_preview': code[:100] + '...'}
    
    def batch_transform(self, 
                       input_dir: str, 
                       output_dir: str,
                       security_level: str = 'ABSOLUTE',
                       language_map: Dict[str, str] = None) -> Dict[str, Any]:
        """تبدیل دسته‌ای فایل‌های کد"""
        print(f"\n📦 تبدیل دسته‌ای فایل‌ها از: {input_dir}")
        
        import os
        import glob
        
        results = {
            'successful': [],
            'failed': [],
            'skipped': []
        }
        
        # یافتن فایل‌های کد
        code_extensions = ['*.py', '*.cpp', '*.java', '*.js', '*.cs', 
                          '*.go', '*.rs', '*.rb', '*.php', '*.swift',
                          '*.kt', '*.ts', '*.m', '*.r', '*.scala']
        
        code_files = []
        for ext in code_extensions:
            code_files.extend(glob.glob(os.path.join(input_dir, '**', ext), recursive=True))
        
        print(f"   یافت شد {len(code_files)} فایل کد")
        
        # تبدیل هر فایل
        for file_path in code_files:
            try:
                # تعیین زبان
                language = 'auto'
                if language_map:
                    ext = os.path.splitext(file_path)[1].lower()
                    language = language_map.get(ext, 'auto')
                
                # تبدیل فایل
                result = self.transform_file(
                    file_path, output_dir, security_level, language
                )
                
                if 'error' not in result:
                    results['successful'].append({
                        'file': file_path,
                        'result': result.get('transformation_status', 'UNKNOWN')
                    })
                else:
                    results['failed'].append({
                        'file': file_path,
                        'error': result['error']
                    })
                    
            except Exception as e:
                results['failed'].append({
                    'file': file_path,
                    'error': str(e)
                })
        
        # ایجاد گزارش
        report = self._generate_batch_report(results)
        
        print(f"\n📊 گزارش نهایی:")
        print(f"   موفق: {len(results['successful'])}")
        print(f"   ناموفق: {len(results['failed'])}")
        print(f"   نادیده گرفته: {len(results['skipped'])}")
        
        return {
            'batch_results': results,
            'report': report,
            'total_files': len(code_files)
        }
    
    def _save_results(self, result: Dict[str, Any], input_file: str, output_dir: str):
        """ذخیره نتایج تبدیل"""
        import os
        import json
        
        # ایجاد دایرکتوری خروجی
        os.makedirs(output_dir, exist_ok=True)
        
        # نام فایل پایه
        base_name = os.path.splitext(os.path.basename(input_file))[0]
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        
        # ذخیره نتایج کامل
        results_file = os.path.join(output_dir, f"{base_name}_secure_{timestamp}.json")
        with open(results_file, 'w', encoding='utf-8') as f:
            json.dump(result, f, ensure_ascii=False, indent=2)
        
        # ذخیره کد امن (اگر موجود باشد)
        if 'secure_executor' in result and 'executor_code' in result['secure_executor']:
            executor_file = os.path.join(output_dir, f"secure_executor_{base_name}.py")
            with open(executor_file, 'w', encoding='utf-8') as f:
                f.write(result['secure_executor']['executor_code'])
        
        print(f"💾 نتایج در {output_dir} ذخیره شد")
    
    def _record_deployment(self, result: Dict[str, Any], source_file: str):
        """ثبت اطلاعات استقرار"""
        record = {
            'source_file': source_file,
            'timestamp': datetime.datetime.now().isoformat(),
            'transformation_status': result.get('transformation_status', 'UNKNOWN'),
            'security_level': result.get('security_guarantees', {}),
            'preservation_score': result.get('preservation_metrics', {}).get('overall_preservation_score', 0),
            'result_id': hashlib.sha256(str(result).encode()).hexdigest()[:16]
        }
        
        self.deployment_records.append(record)
        
        # ذخیره تاریخچه
        history_file = 'hamzah_blackbox_history.json'
        try:
            with open(history_file, 'r', encoding='utf-8') as f:
                history = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            history = []
        
        history.append(record)
        
        with open(history_file, 'w', encoding='utf-8') as f:
            json.dump(history, f, ensure_ascii=False, indent=2)
    
