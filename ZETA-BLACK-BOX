            elif isinstance(node, ast.ClassDef):
                class_info = {
                    'name': node.name,
                    'methods': [n.name for n in node.body if isinstance(n, ast.FunctionDef)],
                    'lineno': node.lineno,
                    'inheritance': [ast.unparse(base) for base in node.bases]
                }
                structure['classes'].append(class_info)
                
            elif isinstance(node, ast.Import):
                for alias in node.names:
                    structure['imports'].append(alias.name)
                    
            elif isinstance(node, ast.ImportFrom):
                structure['imports'].append(f"from {node.module} import {', '.join([n.name for n in node.names])}")
        
        structure['control_flows'] = self._analyze_control_flow(tree)
        structure['data_flows'] = self._analyze_data_flow(tree)
        structure['security_vulnerabilities'] = self._identify_vulnerabilities(tree)
        
        return structure
    
    def _calculate_function_complexity(self, node: ast.FunctionDef) -> Dict[str, int]:
        metrics = {
            'cyclomatic': 1,
            'nesting': 0,
            'cognitive': 0
        }
        
        for item in ast.walk(node):
            if isinstance(item, (ast.If, ast.While, ast.For, ast.Try, ast.With)):
                metrics['cyclomatic'] += 1
            elif isinstance(item, (ast.And, ast.Or)):
                metrics['cyclomatic'] += 1
                
        return metrics
    
    def _find_function_injection_points(self, node: ast.FunctionDef) -> List[Dict[str, Any]]:
        points = []
        
        points.append({
            'type': 'FUNCTION_ENTRY',
            'lineno': node.lineno,
            'position': 'start',
            'priority': 'HIGH'
        })
        
        for item in ast.walk(node):
            if isinstance(item, ast.Return):
                points.append({
                    'type': 'PRE_RETURN',
                    'lineno': item.lineno,
                    'position': 'before',
                    'priority': 'MEDIUM'
                })
                
        for item in ast.walk(node):
            if isinstance(item, (ast.For, ast.While)):
                points.append({
                    'type': 'LOOP_ENTRY',
                    'lineno': item.lineno,
                    'position': 'start',
                    'priority': 'LOW'
                })
        
        return points
    
