                for target in node.targets:
                    if isinstance(target, ast.Name):
                        var_name = target.id
                        if var_name not in variable_uses:
                            variable_uses[var_name] = {
                                'assignments': [],
                                'uses': []
                            }
                        variable_uses[var_name]['assignments'].append({
                            'lineno': node.lineno,
                            'value': ast.unparse(node.value) if hasattr(node, 'value') else 'unknown'
                        })
            
            elif isinstance(node, ast.Name):
                if isinstance(node.ctx, ast.Load):
                    if node.id in variable_uses:
                        variable_uses[node.id]['uses'].append({
                            'lineno': node.lineno,
                            'context': 'load'
                        })
        
        for var, info in variable_uses.items():
            data_flows.append({
