                              choices=['SECURE_EXECUTOR', 'INJECTED_CODE', 'UNIFIED'],
                              help='حالت تبدیل')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    black_box = ZetaHamzahUnifiedBlackBox()
    
    if args.command == 'transform':
        if os.path.isfile(args.input):
            result = black_box.process_file(args.input, args.output, args.mode, args.language)
        else:
            result = black_box.process_code_string(args.input, args.language, args.mode)
    
    elif args.command == 'batch':
        result = black_box.batch_process(args.input_dir, args.output_dir, args.mode)
    
    elif args.command == 'string':
        result = black_box.process_code_string(args.code, args.language, args.mode)
    
