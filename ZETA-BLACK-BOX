        unity_hash = hashlib.sha3_256(self.unity_matrix.tobytes()).digest()
        combined = data_hash + unity_hash
        
        # تبدیل به نمایش ۱۰۰D
        code_parts = []
        for i in range(0, len(combined), 10):
            chunk = combined[i:i+10]
            tensor_index = i % 100
            
            # نگاشت به فضای تانسور
            tensor_values = []
            for j, byte in enumerate(chunk):
                tensor_value = self.hamzah_tensor[tensor_index, j % 100, byte % 100]
                tensor_values.append(tensor_value)
            
            # کدگذاری
            chunk_code = base64.b85encode(np.array(tensor_values, dtype=complex).tobytes()).decode()
            code_parts.append(chunk_code[:16])
        
        return '-'.join(code_parts)

