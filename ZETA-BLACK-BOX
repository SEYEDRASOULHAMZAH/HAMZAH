                    'lineno': node.lineno,
                    'complexity': len(node.body) + (len(node.orelse) if node.orelse else 0)
                })
            elif isinstance(node, ast.For):
                flows.append({
                    'type': 'LOOP_FOR',
                    'lineno': node.lineno,
                    'iterable': ast.unparse(node.iter) if hasattr(node, 'iter') else 'unknown'
                })
            elif isinstance(node, ast.While):
                flows.append({
                    'type': 'LOOP_WHILE',
                    'lineno': node.lineno,
                    'condition': ast.unparse(node.test) if hasattr(node, 'test') else 'unknown'
                })
        
