class UniversalCodeAnalyzer:
    """تحلیل‌گر جهانی کد برای تمام زبان‌های برنامه‌نویسی"""
    
    def __init__(self):
        self.supported_languages = {
            'python': self._analyze_python,
            'cpp': self._analyze_cpp,
            'java': self._analyze_java,
            'javascript': self._analyze_javascript,
            'csharp': self._analyze_csharp,
            'go': self._analyze_go,
            'rust': self._analyze_rust,
            'ruby': self._analyze_ruby,
            'php': self._analyze_php,
            'swift': self._analyze_swift,
            'kotlin': self._analyze_kotlin,
            'typescript': self._analyze_typescript,
            'matlab': self._analyze_matlab,
            'r': self._analyze_r,
            'scala': self._analyze_scala,
        }
        
    def analyze_code(self, code: str, language: str) -> Dict[str, Any]:
        if language not in self.supported_languages:
            language = self._detect_language(code)
        
        analyzer_func = self.supported_languages.get(language, self._analyze_generic)
        analysis_result = analyzer_func(code)
        analysis_result.update(self._common_analysis(code))
        
        return analysis_result
    
    def _detect_language(self, code: str) -> str:
        language_indicators = {
            'python': ['def ', 'import ', 'from ', 'print(', '# ', 'self.', 'lambda '],
            'cpp': ['#include', 'using namespace', 'std::', 'cout <<', 'cin >>', 'template'],
            'java': ['public class', 'import java.', 'System.out.println', '@Override'],
            'javascript': ['function(', 'const ', 'let ', 'var ', '=>', 'console.log'],
            'csharp': ['using System;', 'namespace ', 'public class', 'Console.WriteLine'],
        }
        
        scores = {lang: 0 for lang in language_indicators}
        
        for lang, indicators in language_indicators.items():
            for indicator in indicators:
                if indicator in code:
                    scores[lang] += 1
        
        detected = max(scores, key=scores.get)
        return detected if scores[detected] > 0 else 'unknown'
    
    def _analyze_python(self, code: str) -> Dict[str, Any]:
        try:
            tree = ast.parse(code)
            
            functions = []
            classes = []
            imports = []
            variables = []
            
            for node in ast.walk(tree):
                if isinstance(node, ast.FunctionDef):
                    functions.append({
                        'name': node.name,
                        'args': [arg.arg for arg in node.args.args],
                        'lineno': node.lineno,
                        'col_offset': node.col_offset
                    })
                elif isinstance(node, ast.ClassDef):
                    classes.append({
                        'name': node.name,
                        'bases': [ast.unparse(base) for base in node.bases],
                        'lineno': node.lineno
                    })
                elif isinstance(node, ast.Import):
                    for alias in node.names:
                        imports.append(alias.name)
                elif isinstance(node, ast.ImportFrom):
                    imports.append(f"from {node.module} import {', '.join([n.name for n in node.names])}")
                elif isinstance(node, ast.Assign):
                    for target in node.targets:
                        if isinstance(target, ast.Name):
                            variables.append(target.id)
            
            tokens = self._tokenize_python(code)
            complexity = self._calculate_complexity(tree)
            
            return {
                'language': 'python',
                'ast_structure': ast.dump(tree, indent=2),
                'functions': functions,
                'classes': classes,
                'imports': imports,
                'variables': variables,
                'tokens': tokens,
                'complexity_metrics': complexity,
                'bytecode': compile(code, '<string>', 'exec').__code__.co_code,
                'original_source': code
            }
            
        except SyntaxError as e:
            return {
                'language': 'python',
                'error': str(e),
                'original_source': code
            }
    
    def _tokenize_python(self, code: str) -> List[Dict[str, Any]]:
        tokens = []
        
        try:
            import tokenize
            import io
            
            code_bytes = code.encode('utf-8')
            token_stream = tokenize.tokenize(io.BytesIO(code_bytes).readline)
            
            for tok in token_stream:
                if tok.type != tokenize.ENCODING:
                    tokens.append({
                        'type': tokenize.tok_name[tok.type],
                        'string': tok.string,
                        'start': tok.start,
                        'end': tok.end,
                        'line': tok.line.strip() if tok.line else ''
                    })
        
        except Exception:
            lines = code.split('\n')
            for line_num, line in enumerate(lines, 1):
                words = line.split()
                for word in words:
                    tokens.append({
                        'type': 'WORD',
                        'string': word,
                        'start': (line_num, line.find(word)),
                        'end': (line_num, line.find(word) + len(word)),
                        'line': line
                    })
        
        return tokens
    
    def _calculate_complexity(self, tree: ast.AST) -> Dict[str, float]:
        complexity = {
            'cyclomatic': 1,
            'cognitive': 0,
            'halstead_volume': 0,
            'maintainability': 100
        }
        
        for node in ast.walk(tree):
            if isinstance(node, (ast.If, ast.While, ast.For, ast.Try, ast.With)):
                complexity['cyclomatic'] += 1
            elif isinstance(node, (ast.And, ast.Or)):
                complexity['cyclomatic'] += 1
        
        operators = set()
        operands = set()
        
        for node in ast.walk(tree):
            node_type = type(node).__name__
            if 'op' in node_type.lower():
                operators.add(node_type)
            elif isinstance(node, ast.Name):
                operands.add(node.id)
        
        n1 = len(operators)
        n2 = len(operands)
        N1 = sum(1 for _ in ast.walk(tree) if 'op' in type(_).__name__.lower())
        N2 = sum(1 for _ in ast.walk(tree) if isinstance(_, ast.Name))
        
        if n1 > 0 and n2 > 0:
            complexity['halstead_volume'] = (N1 + N2) * (np.log2(n1 + n2) if (n1 + n2) > 0 else 0)
            complexity['cognitive'] = complexity['halstead_volume'] * complexity['cyclomatic'] / 100
        
        loc = sum(1 for _ in ast.walk(tree) if isinstance(_, ast.stmt))
        complexity['maintainability'] = max(0, 100 - complexity['cognitive'] - loc/10)
        
        return complexity
    
    def _analyze_generic(self, code: str) -> Dict[str, Any]:
        lines = code.split('\n')
        line_count = len(lines)
        char_count = len(code)
        word_count = len(code.split())
        
        structures = []
        for line_num, line in enumerate(lines, 1):
            if any(struct in line for struct in ['function ', 'def ', 'func ', 'procedure ', 'sub ']):
                structures.append({'type': 'FUNCTION', 'line': line_num, 'content': line[:100]})
            elif any(struct in line for struct in ['class ', 'struct ', 'interface ', 'trait ']):
                structures.append({'type': 'CLASS', 'line': line_num, 'content': line[:100]})
            elif any(struct in line for struct in ['import ', 'include ', 'using ', 'require ']):
                structures.append({'type': 'IMPORT', 'line': line_num, 'content': line[:100]})
        
        return {
            'language': 'generic',
            'line_count': line_count,
            'char_count': char_count,
            'word_count': word_count,
            'structures': structures,
            'original_source': code
        }
    
    def _common_analysis(self, code: str) -> Dict[str, Any]:
        return {
            'hash_md5': hashlib.md5(code.encode()).hexdigest(),
            'hash_sha256': hashlib.sha256(code.encode()).hexdigest(),
            'entropy': self._calculate_entropy(code),
            'compression_ratio': len(zlib.compress(code.encode())) / len(code.encode()),
            'timestamp': time.time()
        }
    
    def _calculate_entropy(self, text: str) -> float:
        if not text:
            return 0.0
        
        freq = {}
        for char in text:
            freq[char] = freq.get(char, 0) + 1
        
        entropy = 0.0
        text_len = len(text)
        
        for count in freq.values():
            probability = count / text_len
            entropy -= probability * np.log2(probability)
        
        return entropy

