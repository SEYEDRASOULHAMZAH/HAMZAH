import numpy as np

class MuonAnomalySimulator1155:
    """
    شبیه‌سازِ حذفِ ناهنجاریِ Muon g-2: کلاسیک (انحراف 5.1 سیگما) vs حمزه (فیلتر Pi_IV در مانیفلد 1155 بعدی)
