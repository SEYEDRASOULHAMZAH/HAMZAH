engine = HamzahSchurClampSimulator1155(energies[0], manifold_dim=1155)

print(f"--- HAMZAHXCELL LIGO PROOF (SCHUR COMPLEMENT / {engine.manifold_dim}D) ---")
print(f"{'Energy_Input':<15} | {'Classic_Divergence':<20} | {'Hamzah_Jacobian_Det':<20}")
for e in energies:
    sim = HamzahSchurClampSimulator1155(e, manifold_dim=1155)
    print(f"{e:<15.1e} | {sim.classic_divergence():<20.2f} | {sim.hamzah_clamped_jacobian():<20.10f}")

