        # بازسازیِ فازِ اسپینور بر اساسِ کدگذاریِ حمزه مقیاس‌شده با ابعاد 1155D
        scaling_factor = np.sqrt(self.manifold_dim / 115.5)
        phase = self.omega * t * self.det_ctime * scaling_factor / 10.0
        return np.exp(1j * phase)

