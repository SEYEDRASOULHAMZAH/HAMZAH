        π = pi
        φ = self.teoh_system.core_constants['golden_ratio']
        e = mp.exp(1)
        
        ΩH_star = (π * φ * e) / (mp.sqrt(5) * mp.log(2))
        
        # تصحیح با معادله حمزه
        correction = self._hamzah_correction_factor(ΩH_star)
        ΩH_star *= correction
        
        return ΩH_star
    
    def _compute_lambda_fractal(self):
        """محاسبه ثابت فرکتالی Λ_f"""
        D_f = self.teoh_system.core_constants['fractal_dimension']
        α = self.teoh_system.core_constants['alpha_fine_structure']
        
        Λ_fractal = mp.power(2, D_f) * mp.exp(-1/α) * mp.sqrt(3)
        
        # تصحیح کوانتومی
        quantum_correction = self._quantum_fractal_correction(Λ_fractal)
        Λ_fractal *= quantum_correction
        
        return Λ_fractal
    
