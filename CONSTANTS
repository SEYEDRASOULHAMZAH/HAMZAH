    def _compute_QIS0_for_constant(self, constant_name, constant_value):
        """محاسبه QIS₀ برای یک ثابت خاص"""
        alpha_star = self.teoh_system.core_constants['alpha_star_universal']
        
        # محاسبه بر اساس نوع ثابت
        if 'planck' in constant_name.lower():
            return self._compute_QIS0_planck_scale(constant_value, alpha_star)
        elif 'mass' in constant_name.lower():
            return self._compute_QIS0_mass_related(constant_value, alpha_star)
        elif 'energy' in constant_name.lower():
            return self._compute_QIS0_energy_related(constant_value, alpha_star)
        elif 'length' in constant_name.lower() or 'distance' in constant_name.lower():
            return self._compute_QIS0_length_related(constant_value, alpha_star)
        elif 'time' in constant_name.lower():
            return self._compute_QIS0_time_related(constant_value, alpha_star)
        else:
            return self._compute_QIS0_general(constant_value, alpha_star)

    def _reconstruct_constant_from_QIS0(self, QIS0_value, constant_name):
        """بازسازی ثابت از QIS₀"""
        alpha_star = self.teoh_system.core_constants['alpha_star_universal']
        
        # استفاده از انتگرال کسری برای بازسازی
        def fractional_integral_reconstruction(QIS0, alpha, terms=10000):
            result = mpf('0')
            h = mpf('1e-6')
            
            for k in range(terms):
                coeff = gamma(alpha + k) / (gamma(k + 1) * gamma(alpha))
                result += coeff * self._kernel_function(k * h) * QIS0
                
            return result * (h**alpha) / gamma(alpha + 1)
        
        return fractional_integral_reconstruction(QIS0_value, alpha_star)

    def _calculate_error(self, original, reconstructed):
        """محاسبه خطای نسبی"""
        if original == 0:
            return abs(reconstructed)
        return abs(reconstructed - original) / abs(original)

    def _perform_stress_tests(self, original, reconstructed, QIS0):
        """انجام تست‌های استرس مختلف"""
        tests = {}
        
        # تست دقت عددی
        tests['numerical_precision'] = self._test_numerical_precision(original, reconstructed)
        
        # تست پایداری
        tests['stability'] = self._test_stability(original, reconstructed, QIS0)
        
        # تست سازگاری ابعادی
        tests['dimensional_consistency'] = self._test_dimensional_consistency(original, reconstructed)
        
        # تست حساسیت
        tests['sensitivity'] = self._test_sensitivity(original, reconstructed, QIS0)
        
        # تست مقاومت در برابر نویز
        tests['noise_resistance'] = self._test_noise_resistance(original, reconstructed)
        
        return tests

    def _test_numerical_precision(self, original, reconstructed):
        """تست دقت عددی"""
        error = self._calculate_error(original, reconstructed)
        return {
            'relative_error': error,
            'precision_level': '1e-100' if error < 1e-100 else '1e-50' if error < 1e-50 else 'نیاز به بهبود',
            'status': 'تأیید شده' if error < 1e-50 else 'نیاز به بررسی'
        }

    def _test_stability(self, original, reconstructed, QIS0):
        """تست پایداری"""
        # تست با تغییرات کوچک در QIS₀
        variations = []
        for i in range(10):
            variation = QIS0 * (1 + (i-5)*1e-10)
            reconstructed_var = self._reconstruct_constant_from_QIS0(variation, 'test')
            error = self._calculate_error(original, reconstructed_var)
            variations.append(error)
        
        max_variation = max(variations)
        return {
            'max_variation': max_variation,
            'stability_level': 'عالی' if max_variation < 1e-40 else 'خوب' if max_variation < 1e-20 else 'متوسط',
            'status': 'پایدار' if max_variation < 1e-20 else 'نیمه پایدار'
        }

    def _test_dimensional_consistency(self, original, reconstructed):
        """تست سازگاری ابعادی"""
        # تحلیل ابعادی ساده شده
        original_dims = self._analyze_dimensions(original)
        reconstructed_dims = self._analyze_dimensions(reconstructed)
        
        return {
            'original_dimensions': original_dims,
            'reconstructed_dimensions': reconstructed_dims,
            'consistency': 'سازگار' if original_dims == reconstructed_dims else 'نیاز به بررسی',
            'status': 'تأیید شده' if original_dims == reconstructed_dims else 'هشدار'
        }

    def _test_sensitivity(self, original, reconstructed, QIS0):
        """تست حساسیت"""
        sensitivity_scores = []
        
        for param_variation in [0.9, 0.99, 1.01, 1.1]:
            modified_QIS0 = QIS0 * param_variation
            modified_reconstructed = self._reconstruct_constant_from_QIS0(modified_QIS0, 'test')
            sensitivity = self._calculate_error(reconstructed, modified_reconstructed)
            sensitivity_scores.append(sensitivity)
        
        avg_sensitivity = sum(sensitivity_scores) / len(sensitivity_scores)
        return {
            'average_sensitivity': avg_sensitivity,
            'sensitivity_level': 'کم' if avg_sensitivity < 1e-30 else 'متوسط' if avg_sensitivity < 1e-15 else 'زیاد',
            'status': 'مقاوم' if avg_sensitivity < 1e-15 else 'حساس'
        }

    def _test_noise_resistance(self, original, reconstructed):
        """تست مقاومت در برابر نویز"""
        noise_levels = [1e-10, 1e-8, 1e-6, 1e-4]
        noise_resistance = []
        
        for noise in noise_levels:
            noisy_original = original * (1 + mpf(str(np.random.normal(0, noise))))
            error = self._calculate_error(noisy_original, reconstructed)
            noise_resistance.append(error)
        
        avg_noise_error = sum(noise_resistance) / len(noise_resistance)
        return {
            'average_noise_error': avg_noise_error,
            'noise_resistance_level': 'عالی' if avg_noise_error < 1e-20 else 'خوب' if avg_noise_error < 1e-10 else 'ضعیف',
            'status': 'مقاوم' if avg_noise_error < 1e-10 else 'حساس به نویز'
        }

    def _analyze_dimensions(self, value):
        """تحلیل ابعادی ساده شده"""
        if value == 0:
            return 'بعدless'
        
        log_value = mp.log(abs(value))
        if log_value < -30:
            return 'مقیاس کوانتومی'
        elif log_value < 0:
            return 'مقیاس میکروسکوپی'
        elif log_value < 30:
            return 'مقیاس ماکروسکوپی'
        else:
            return 'مقیاس کیهانی'

    def _kernel_function(self, x):
        """تابع کرنل برای محاسبات کسری"""
        return exp(-x**2)

    def _compute_QIS0_planck_scale(self, constant, alpha_star):
        """محاسبه QIS₀ برای مقیاس پلانک"""
        return constant * gamma(alpha_star) / (self.constants_database.constants['fundamental_known']['planck_time'] ** alpha_star)

    def _compute_QIS0_mass_related(self, constant, alpha_star):
        """محاسبه QIS₀ برای ثابت‌های مرتبط با جرم"""
        planck_mass = self.constants_database.constants['fundamental_known']['planck_mass']
        return constant * gamma(alpha_star) / (planck_mass ** alpha_star)

    def _compute_QIS0_energy_related(self, constant, alpha_star):
        """محاسبه QIS₀ برای ثابت‌های مرتبط با انرژی"""
        planck_energy = self.constants_database.constants['fundamental_known']['planck_energy']
        return constant * gamma(alpha_star) / (planck_energy ** alpha_star)

    def _compute_QIS0_length_related(self, constant, alpha_star):
        """محاسبه QIS₀ برای ثابت‌های مرتبط با طول"""
        planck_length = self.constants_database.constants['fundamental_known']['planck_length']
        return constant * gamma(alpha_star) / (planck_length ** alpha_star)

    def _compute_QIS0_time_related(self, constant, alpha_star):
        """محاسبه QIS₀ برای ثابت‌های مرتبط با زمان"""
        planck_time = self.constants_database.constants['fundamental_known']['planck_time']
        return constant * gamma(alpha_star) / (planck_time ** alpha_star)

    def _compute_QIS0_general(self, constant, alpha_star):
        """محاسبه QIS₀ عمومی"""
        return constant * gamma(alpha_star)

    def _verify_self_consistency(self, constant_name, constant_value):
        """اعتبارسنجی خودسازگاری برای ثابت‌های TEOH"""
        tests = {}
        
        tests['mathematical_consistency'] = self._check_mathematical_consistency(constant_name, constant_value)
        tests['physical_consistency'] = self._check_physical_consistency(constant_name, constant_value)
        tests['numerical_consistency'] = self._check_numerical_consistency(constant_name, constant_value)
        
        return tests

    def _verify_compatibility_with_known(self, constant_name, constant_value):
        """اعتبارسنجی سازگاری با ثابت‌های شناخته شده"""
        compatibility_scores = {}
        
        for known_name, known_value in self.constants_database.constants['fundamental_known'].items():
            if known_value != 0:
                ratio = constant_value / known_value
                log_ratio = abs(mp.log(ratio))
                compatibility_scores[known_name] = {
                    'ratio': ratio,
                    'log_difference': log_ratio,
                    'compatibility': 'سازگار' if log_ratio < 10 else 'نیمه سازگار' if log_ratio < 100 else 'ناسازگار'
                }
        
        return compatibility_scores

    def _verify_numerical_stability(self, constant_name, constant_value):
        """اعتبارسنجی پایداری عددی"""
        stability_tests = {}
        
        # تست با دقت‌های مختلف
        precisions = [100, 200, 500]
        for prec in precisions:
            with mp.workdps(prec):
                stable_value = mpf(str(constant_value))
                variation = abs((stable_value - constant_value) / constant_value) if constant_value != 0 else 0
                stability_tests[f'precision_{prec}'] = {
                    'variation': variation,
                    'stable': variation < 1e-50
                }
        
        return stability_tests

