    def _evaluate_validation_status(self, error, stress_tests):
        """ارزیابی وضعیت اعتبارسنجی"""
        if error < 1e-50 and all(test.get('status', '') in ['تأیید شده', 'پایدار', 'مقاوم'] for test in stress_tests.values()):
            return 'اعتبارسنجی کامل'
        elif error < 1e-20:
            return 'اعتبارسنجی خوب'
        else:
            return 'نیاز به بررسی بیشتر'

    def _evaluate_teoh_validation(self, self_consistency, compatibility, numerical_stability):
        """ارزیابی اعتبارسنجی ثابت‌های TEOH"""
        consistency_score = sum(1 for test in self_consistency.values() if test == 'تأیید شده')
        compatibility_score = sum(1 for comp in compatibility.values() if comp['compatibility'] == 'سازگار')
        stability_score = sum(1 for test in numerical_stability.values() if test['stable'])
        
        total_score = consistency_score + compatibility_score + stability_score
        max_score = len(self_consistency) + len(compatibility) + len(numerical_stability)
        
        if total_score / max_score > 0.95:
            return 'اعتبارسنجی کامل TEOH'
        elif total_score / max_score > 0.8:
            return 'اعتبارسنجی خوب TEOH'
        else:
            return 'نیاز به بهبود TEOH'

    def _evaluate_cosmological_validation(self, cosmological, observational, dynamical):
        """ارزیابی اعتبارسنجی کیهان‌شناسی"""
        if (cosmological['overall'] == 'سازگار با کیهان‌شناسی استاندارد' and
            observational['overall'] == 'سازگار با مشاهدات' and
            dynamical['overall'] == 'پایدار دینامیکی'):
