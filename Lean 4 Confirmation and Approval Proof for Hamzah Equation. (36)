        print("-" * 115)
        print(f"{str(original_state.tolist()):<30} | {str(np.round(scrambled, 4).tolist()):<35} | {str(np.round(recovered, 4).tolist())}")
        print("-" * 115)
        print(f"[تاییدِ نهایی]: موتور ماتریکس معکوس اجرا شد؛ کدهای منسجم با موفقیت بازیابی گشتند. [{status}]")
        print("=" * 115)
        
        return {
            "original": original_state,
            "scrambled": scrambled,
            "recovered": recovered,
            "status": status
        }

