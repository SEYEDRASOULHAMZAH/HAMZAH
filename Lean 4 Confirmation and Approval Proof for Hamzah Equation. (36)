                "status": status
            })
            
            print(f"Node_{i+1:<10} | {noise_levels[i]:<22.4f} | {beta:<20.4f} [{status}]")
            
        print("-" * 95)
        print("[تاییدِ نهایی]: نویزهای محیطی با موفقیت به فیدبک سازنده تبدیل و پایداری دمایی برقرار شد.")
        print("=" * 95)
        return results

