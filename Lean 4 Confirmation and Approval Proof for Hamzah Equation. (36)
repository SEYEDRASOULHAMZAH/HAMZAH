        print(f"{'کد':<6} | {'مرکز داده (Avg)':<18} | {'متریک دترمینان':<20} | {'وضعیت'}")
        print("-" * 85)
        
        results = []
        for i in range(1, 11):
            telemetry = self.get_realtime_metrics(i)
            # فرمول اصلی دترمینان ژاکوبی مستر با احتساب ثابت‌های امگا و اپسیلون کف
            determinant = (self.omega_h * telemetry) / (self.omega_h + self.floor_epsilon)
            
            # قفل پایداری: اگر دترمینان روی 1.0 باشد سیستم در تعادل کامل است
            is_stable = abs(determinant - 1.0) < 0.1
            status = "STABLE (LOCKED)" if is_stable else "ANOMALY DETECTED"
            
            results.append({
                "state": i,
                "telemetry": telemetry,
                "determinant": determinant,
                "status": status
            })
            
            print(f"{i:02d}    | {telemetry:.4f}             | {determinant:.4f}               | {status}")
            
        print("-" * 85)
        print("[INFO]: تمامی ۱۰ حالت کیفی با تلمتری‌هایِ لحظه‌ای همگام‌سازی و قفل شدند (Zero Drift).")
        print("=" * 85)
        return results

