import numpy as np

class HamzahRedshiftDecompressionEngine:
    """
    موتورِ بازآراییِ کدهایِ ردفیشت (HamzahXcell Architecture - Gate 40)
    دی‌کامپرشنِ سیگنال‌هایِ طیفیِ تلسکوپِ جیمز وب و بازسازیِ فرکانسِ اصلی (Ω_H*)
    """
    def __init__(self, sampling_rate: int = 1000, seed: int = 42):
        self.sampling_rate = sampling_rate  # نرخ نمونه‌برداری
        self.rng = np.random.default_rng(seed)
        
    def recover_original_signal(self, distorted_signal: np.ndarray, distortion_filter: np.ndarray) -> np.ndarray:
        """دی‌کانولوشن در فضای فوریه برای خنثی‌سازی ردفیشت و بازیابی سیگنال اصلی"""
        signal_freq = np.fft.fft(distorted_signal)
        filter_freq = np.fft.fft(distortion_filter)
        
        # بازسازیِ کدِ اصلی با مقاومت در برابر تقسیم بر صفر (اضافه کردن اپسیلون)
        original_signal_freq = signal_freq / (filter_freq + 1e-9)
        
        # تبدیلِ معکوس به فضایِ زمان (بازیابی فاز اصلی)
        recovered_signal = np.fft.ifft(original_signal_freq)
        return np.real(recovered_signal)

    def run_simulation(self) -> dict:
        """اجرای شبیه‌سازی سیگنال ۵۰ هرتز، اعمال فیلتر ردفیشت Void و دی‌کامپرشن نهایی"""
        t = np.linspace(0, 1, self.sampling_rate)
        original_code = np.sin(2 * np.pi * 50 * t)  # کدِ اولیه ۵۰ هرتز
        void_distortion = np.sin(2 * np.pi * 5 * t)  # ردفیشت / فیلترِ محیطی
        distorted_code = original_code * void_distortion  # سیگنالِ دریافتیِ شیفت‌یافته
        
        recovered = self.recover_original_signal(distorted_code, void_distortion)
        
        # استخراج دقیق فرکانس بازیابی شده از طریق تحلیل طیفی فوریه
        fft_recovered = np.fft.fft(recovered)
        freqs = np.fft.fftfreq(len(recovered), 1 / self.sampling_rate)
        peak_freq = float(abs(freqs[np.argmax(np.abs(fft_recovered))]))
        
        status = "DECOMPRESSION_SUCCESSFUL"
        
        print("=" * 105)
        print(f"{'--- HAMZAH GATE 40 REDSHIFT DECOMPRESSION REPORT ---':^105}")
        print("=" * 105)
        print(f"نرخ نمونه‌برداری (Sampling Rate): {self.sampling_rate} Hz")
        print(f"فرکانسِ اصلی هدف: 50.00 Hz")
        print(f"فرکانسِ بازیابی شده: {peak_freq:.2f} Hz")
        print(f"وضعیت دی‌کامپرشن طیفی: [{status}]")
        print("-" * 105)
        print("[تاییدِ نهایی]: اثرات ردفیشت و فیلتر محیطی خنثی و کد اصلی طیفی با موفقیت بازآرایی شد.")
        print("=" * 105)
        
        return {
            "target_freq": 50.0,
            "recovered_freq": peak_freq,
            "status": status
        }

