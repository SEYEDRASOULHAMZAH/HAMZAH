    محدود کردنِ انحنایِ گرانشی در مقیاسِ پلانک و وتویِ تکینگی‌هایِ بی‌نهایت
    """
    def __init__(self, planck_length_sq: float = 1e-70, seed: int = 42):
        self.ell_p_sq = planck_length_sq  # مجذور طول پلانک
        self.rng = np.random.default_rng(seed)
        
    def resolve_curvature(self, r_classical: float) -> float:
        """محاسبه‌ی انحنای وتوشده و کران‌دار با استفاده از معادله‌ی تنظیم‌گر حمزه"""
        r_resolved = r_classical / (1.0 + self.ell_p_sq * r_classical)
        return float(r_resolved)

    def run_simulation(self) -> list[dict]:
        """اجرای شبیه‌سازی انحنای لحظه‌یِ بیگ‌بنگ در مقیاس‌های مختلف کلاسیک تا بی‌نهایت"""
