import numpy as np

class HamzahTensorMappingEngine:
    """
    موتورِ نگاشتِ متممِ تانسوری (HamzahXcell Architecture - Gate 18)
    تراز کردنِ جرمِ مادی با ارزِ اطلاعاتی (Information Currency) در مانیفلد ۳۳۰ بُعدی
    """
    def __init__(self, omega_h: float = 2.99e8, c: float = 2.9979e8):
        self.omega_h = omega_h  # فرکانسِ بنیادین
        self.c = c              # سرعتِ نور (ضریبِ هم‌ارزیِ کلاسیک)
        
    def calculate_required_info(self, mass: float) -> float:
        """محاسبه‌ی ارز اطلاعاتی معادل برای جرم مادی داده‌شده بر اساس معادله‌ی حمزه"""
        energy = mass * (self.c ** 2)
        info_currency = energy / (self.omega_h ** 2)
        return float(info_currency)

    def run_simulation(self) -> list[dict]:
        """اجرای شبیه‌سازی برای ۲۰ ذره با جرم‌هایِ متفاوت در آشکارسازها"""
        masses = np.linspace(1e-28, 1e-25, 20)  # جرم‌هایِ مختلفِ کوارک‌ها و ذرات
        
        print("=" * 95)
        print(f"{'--- HAMZAH GATE 18 TENSOR COMPLEMENT MAPPING REPORT ---':^95}")
        print("=" * 95)
        print(f"{'ذره/مرکز':<15} | {'جرم (kg)':<18} | {'ارزِ اطلاعاتی (I)':<22} | {'وضعیت نگاشت'}")
        print("-" * 95)
        
        results = []
        for i, m in enumerate(masses, start=1):
            info_needed = self.calculate_required_info(m)
            status = "MAPPED"
            
            results.append({
                "node": i,
                "mass": m,
                "info_currency": info_needed,
                "status": status
            })
            
            print(f"Node_{i:<10} | {m:<18.2e} | {info_needed:<22.4e} [{status}]")
            
        print("-" * 95)
        print("[تاییدِ نهایی]: جرم، صرفاً یک پیکسلِ رزرو شده توسطِ ارزِ اطلاعاتی است.")
        print("=" * 95)
        return results

if __name__ == "__main__":
    engine = HamzahTensorMappingEngine()
    engine.run_simulation()

