import numpy as np

class HamzahChronoPumpEngine:
    """
    موتورِ پمپِ مهارِ پارادوکسِ زمانی (HamzahXcell Architecture - Gate 37)
    تضمینِ خطی بودنِ زمان با پایشِ دترمینانِ ماتریکسِ CTime و اصلاحِ ورتیسیته زمانی
    """
    def __init__(self, lambda_tc: float = 0.5, seed: int = 42):
        self.lambda_tc = lambda_tc  # ضریبِ پمپِ مهارِ زمانی
        self.rng = np.random.default_rng(seed)
        
    def stabilize_time(self, ctime_matrix: np.ndarray) -> tuple[float, str]:
        """محاسبه‌ی دترمینان زمان (Temporal Vorticity) و اعمال پمپ مهار پارادوکس"""
        det_t = float(np.linalg.det(ctime_matrix))
        
        # اگر دترمینان != 1 باشد، پارادوکس در حالِ شکل‌گیری است
        if not np.isclose(det_t, 1.0):
            correction = self.lambda_tc * (1.0 - det_t)
            stable_matrix = ctime_matrix * (1.0 + correction)
            status = "PARADOX_SUPPRESSED"
        else:
            stable_matrix = ctime_matrix
            status = "CHRONO_STABLE"
            
        final_det = float(np.linalg.det(stable_matrix))
        return final_det, status

    def run_simulation(self) -> list[dict]:
        """اجرای شبیه‌سازی برای ۱۰ گره‌یِ مرزی در فضایِ Void"""
        n_nodes = 10
        nodes_data = [np.eye(3) + self.rng.normal(0, 0.05, (3, 3)) for _ in range(n_nodes)]
        
        print("=" * 115)
        print(f"{'--- HAMZAH GATE 37 CHRONO-PUMP & PARADOX SUPPRESSION REPORT ---':^115}")
        print("=" * 115)
        print(f"{'گره مرزی':<15} | {'دترمینانِ اولیه':<22} | {'دترمینانِ نهایی (پایدار)':<25} | {'وضعیتِ پمپ'}")
        print("-" * 115)
        
        results = []
        for i, m in enumerate(nodes_data, start=1):
            initial_det = float(np.linalg.det(m))
            final_det, status = self.stabilize_time(m)
            
            results.append({
                "node_id": i,
                "initial_det": initial_det,
                "final_det": final_det,
                "status": status
            })
            
            print(f"Node_{i:<10} | {initial_det:<22.4f} | {final_det:<25.4f} [{status}]")
            
        print("-" * 115)
        print("[تاییدِ نهایی]: خطی‌بودن زمان حفظ شد؛ انحرافات ورتیسیته زمانی توسط پمپ مهار شدند.")
        print("=" * 115)
        return results

