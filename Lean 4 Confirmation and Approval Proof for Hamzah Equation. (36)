            status = "VETOED_AT_PLANCK_CEILING" if r > 1e70 else "CLASSICAL_PASS"
            
            results.append({
                "classical_curvature": float(r),
                "resolved_curvature": r_res,
                "status": status
            })
            
            print(f"{r:<30.2e} | {r_res:<30.4e} | [{status}]")
            
        print("-" * 105)
        print("[تاییدِ نهایی]: وتوی تکینگی با موفقیت اعمال شد؛ مقادیر انحنا در سقف پلانک کران‌دار شدند.")
        print("=" * 105)
        return results

