import numpy as np

class HamzahInfoPortEngine:
    """
    موتورِ تراکمِ فشرده‌سازی اطلاعات (HamzahXcell Architecture - Gate 52)
    تبدیلِ جرمِ سکونِ کلاسیک به تعدادِ پورت‌هایِ اطلاعاتیِ متمم با استفاده از فرکانس هسته و سرعت نور
    """
    def __init__(self, c: float = 299792458.0, omega_h: float = 1.176e10):
        self.c = c                      # سرعتِ نور (m/s)
        self.omega_h = omega_h          # فرکانسِ هسته
        self.det_h = 1.0000             # ثابتِ دترمینانِ مانیفلد
        
    def calculate_info_ports(self, mass_kg: float) -> float:
        """محاسبه‌ی تعداد پورت‌های اطلاعاتی از روی جرم سکون ذره با ضریب مقیاس مانیفلد"""
        port_factor = (self.omega_h / self.c) ** 2
        info_ports = mass_kg * port_factor * self.det_h
        return float(info_ports)

    def run_simulation(self) -> list[dict]:
        """شبیه‌سازی تبدیل جرم ذرات بنیادین (الکترون، پروتون، نوترون) به پورت‌های اطلاعاتی متمم"""
        particles = {
            "Electron": 9.109e-31,
            "Proton": 1.672e-27,
            "Neutron": 1.674e-27
        }
        
        print("=" * 115)
        print(f"{'--- HAMZAH GATE 52 INFO-PORT COMPRESSION ENGINE REPORT ---':^115}")
        print("=" * 115)
        print(f"سرعت نور (c): {self.c} | فرکانس هسته (Omega_h): {self.omega_h:.3e} | دترمینان مانیفلد: {self.det_h}")
        print(f"{'ذره (Particle)':<18} | {'جرمِ سکون (kg)':<22} | {'تعدادِ پورت‌هایِ اطلاعاتی (I)':<30} | {'وضعیت'}")
        print("-" * 115)
        
        results = []
        for p_name, mass in particles.items():
            ports = self.calculate_info_ports(mass)
            status = "PORT_MAPPING_LOCKED" if ports > 0 else "ZERO_MASS_STATE"
            
            results.append({
                "particle": p_name,
                "mass": mass,
                "info_ports": ports,
                "status": status
            })
            
            print(f"{p_name:<18} | {mass:<22.3e} | {ports:<30.4e} | [{status}]")
            
        print("-" * 115)
        print("[تاییدِ نهایی]: موتور تراکم فشرده‌سازی اجرا شد؛ جرم ذرات به پورت‌های اطلاعاتی تبدیل گشتند.")
        print("=" * 115)
        return results

if __name__ == "__main__":
    engine = HamzahInfoPortEngine()
    engine.run_simulation()

