import numpy as np

class HamzahImageReconEngine:
    """
    موتورِ بازسازیِ امپدانسِ تصویر (HamzahXcell Architecture - Gate 80)
    حذفِ نویزِ ساختاریِ خلاء از تصاویرِ NIRSpec جیمز وب و بازسازی هندسی مانیفلد
    """
    def __init__(self, rho_floor: float = 1.155e-20, epsilon: float = 1e-30):
        self.rho_floor = rho_floor  # کفِ چگالیِ مرجع از گیت ۷۱
        self.epsilon = epsilon      # ضریبِ پایداریِ عددی برای جلوگیری از تقسیم بر صفر
        
    def reconstruct_image(self, noisy_void_data: np.ndarray) -> tuple[np.ndarray, str]:
        """بازسازی تصویر و حذف نویز ساختاری خلاء با استفاده از تقسیم طیفی و IFFT"""
        # تقسیم طیفی بر اساس کف چگالی و داده‌های نویزی
        recovered_spectrum = self.rho_floor / (noisy_void_data + self.epsilon)
        
        # تبدیلِ معکوسِ فوریه‌یِ دو‌بعدی برای بازیابی تصویر
        image_recon = np.abs(np.fft.ifft2(recovered_spectrum))
        
        # ارزیابی پایداری و سلامت تصویر بازسازی‌شده
        if np.all(np.isfinite(image_recon)):
            status = "IMAGE_RECONSTRUCTION_SUCCESS"
        else:
            status = "RECONSTRUCTION_SINGULARITY_WARNING"
            
        return image_recon, status

    def run_simulation(self) -> dict:
        """شبیه‌سازیِ بازسازیِ یک تصویر/پیکسل از داده‌هایِ NIRSpec و پایش عملکرد گیت ۸۰"""
        np.random.seed(42)  # برای تکرارپذیری شبیه‌سازی
        void_noise_signals = np.random.uniform(1e-21, 1e-19, (64, 64))  # نویزِ مشاهده شده در Void
        
        reconstructed_image, status = self.reconstruct_image(void_noise_signals)
        
        mean_noisy = float(np.mean(void_noise_signals))
        mean_recon = float(np.mean(reconstructed_image))
        
        print("=" * 115)
        print(f"{'--- HAMZAH GATE 80 IMAGE RECONSTRUCTION ENGINE REPORT ---':^115}")
        print("=" * 115)
        print(f"کف چگالی (Rho Floor): {self.rho_floor:.4e} | وضعیت سیستم: [{status}]")
        print(f"{'وضعیتِ سیگنال':<30} | {'میانگینِ شدتِ روشنایی'}")
        print("-" * 115)
        print(f"{'نویزی (Void Data)':<30} | {mean_noisy:.4e}")
        print(f"{'بازیابی شده (Reconstructed)':<30} | {mean_recon:.4e}")
        print("=" * 115)
        
        return {
            "mean_noisy": mean_noisy,
            "mean_recon": mean_recon,
            "status": status
        }

