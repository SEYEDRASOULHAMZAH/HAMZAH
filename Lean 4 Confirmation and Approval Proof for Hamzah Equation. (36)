import numpy as np

class HamzahSafetySystem:
    """
    سیستمِ تضمینِ پایداری و فیوزِ ایمنیِ کیهانی (Hamzah Safety System)
    جلوگیری از انفجار ساختاری از طریقِ اتلافِ اطلاعاتی و هدایت انرژی مازاد به بافر آنتروپی
    """
    def __init__(self, capacity_limit: float = 1000.0):
        self.capacity_limit = capacity_limit  # حدِ آستانه برایِ جلوگیری از انفجار
        
    def safety_check(self, energy_density: float) -> tuple[float, str]:
        """بررسی چگالی انرژی و فعال‌سازی فیوز ایمنی در صورت تجاوز از حد بحرانی"""
        if energy_density > self.capacity_limit:
            # فعال‌سازیِ فیوز: تبدیلِ انرژیِ مازاد به اطلاعاتِ پس‌زمینه (Dissipation)
            shunted_energy = energy_density - self.capacity_limit
            safe_output = self.capacity_limit
            status = f"CRITICAL_LOAD: Shunting {shunted_energy:.2f} units to Entropy Buffer"
        else:
            safe_output = energy_density
            status = "STABLE_OPERATION"
            
        return float(safe_output), status

    def run_simulation(self, energy_inputs: list[float]) -> list[dict]:
        """اجرای شبیه‌ساز ایمنی برای مراکز انرژی مختلف"""
        print("=" * 85)
        print(f"{'--- HAMZAH COSMIC SAFETY SYSTEM & FUSE REPORT ---':^85}")
        print("=" * 85)
        print(f"{'مرکز انرژی':<15} | {'انرژیِ خام':<15} | {'وضعیتِ حفاظتی'}")
        print("-" * 85)
        
        results = []
        for i, e in enumerate(energy_inputs, start=1):
            output, status = self.safety_check(e)
            results.append({
                "node": i,
                "raw_energy": e,
                "safe_output": output,
                "status": status
            })
            print(f"Node_{i:<10} | {e:<15.2f} | {status}")
            
        print("-" * 85)
        print("[نتیجه]: سیستمِ حفاظتی با موفقیت نوسانات بحران‌زا را مهار و اتلاف کرد.")
        print("=" * 85)
        return results

if __name__ == "__main__":
    safety_engine = HamzahSafetySystem(capacity_limit=1000.0)
    energy_inputs = [500.0, 800.0, 1200.0, 1500.0, 900.0, 2000.0, 300.0, 1100.0, 400.0, 2500.0]
    safety_engine.run_simulation(energy_inputs)

 
