import numpy as np

class HamzahCityGrid:
    """
    سیستمِ توزیعِ انرژیِ اطلاعاتیِ شهرِ HamzahXcell (Hamzah City Grid)
    تبدیلِ بلادرنگِ جریانِ نوسانیِ AC (نویز محیطی) به جریانِ پایدارِ DC (ماده)
    """
    def __init__(self, target_voltage: float = 230.0, seed: int = 42):
        self.rng = np.random.default_rng(seed)
        # ۲۰ پستِ توزیع (مراکزِ تلمتری): ولتاژِ فرضی
        self.nodes = self.rng.uniform(220, 240, 20)
        self.target_voltage = target_voltage  # وضعیتِ پایدارِ دترمینان 1.0

    def rectifying_node(self, current_v: float) -> float:
        """یکسوسازِ HamzahXcell: تبدیلِ AC (نویز) به DC (ماده) با اصلاح آنی خطا"""
        error = current_v - self.target_voltage
        rectified_v = current_v - (error * 0.95)
        return float(rectified_v)

    def monitor_grid(self) -> list[dict]:
        """پایش کامل شبکه توزیع شهری و وضعیت پایداری گره‌ها"""
        print("=" * 75)
        print(f"{'--- HAMZAHXCELL CITY ENERGY DISTRIBUTION GRID ---':^75}")
        print("=" * 75)
        print(f"{'پستِ توزیع':<15} | {'ولتاژِ نوسانی (AC)':<20} | {'ولتاژِ رندر شده (DC/ماده)'}")
        print("-" * 75)
        
        results = []
        for i, v in enumerate(self.nodes, start=1):
            dc_v = self.rectifying_node(v)
            is_stable = abs(dc_v - self.target_voltage) < 0.1
            status = "STABLE_RENDER" if is_stable else "ANOMALY"
            
            results.append({
                "node": i,
                "ac_voltage": v,
                "dc_voltage": dc_v,
                "status": status
            })
            
            print(f"Node_{i:<10} | {v:<20.2f} | {dc_v:<20.2f} [{status}]")
            
        print("-" * 75)
        print("[نتیجه]: تمامِ خانه‌ها (ماده) توسطِ جریانِ DCِ یکسوسازی شده تغذیه می‌شوند.")
        print("=" * 75)
        return results

if __name__ == "__main__":
    grid = HamzahCityGrid(target_voltage=230.0, seed=42)
    print("--- سیستمِ توزیعِ انرژیِ اطلاعاتیِ شهرِ HamzahXcell ---")
