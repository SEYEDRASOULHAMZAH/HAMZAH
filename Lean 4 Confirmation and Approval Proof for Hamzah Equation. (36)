import numpy as np

class HamzahMassBitEngine:
    """
    موتورِ تانسورِ جرم-بیت (HamzahXcell Architecture - Gate 54)
    محاسبه‌یِ وزنِ فیزیکی و تانسورِ جرمِ سلول‌هایِ اطلاعاتی بر اساسِ تانسورِ جهت‌گیری فرا-بعدی
    """
    def __init__(self, rho_sat: float = 1.0e90, epsilon_floor: float = 1.155e-40):
        self.rho_sat = rho_sat              # چگالیِ اشباع (برگرفته از گیت ۵۱)
        self.epsilon_floor = epsilon_floor  # ضریبِ تبدیلِ انرژی-جرم مانیفلد
        
    def calculate_mass_moment(self, direction_vector: np.ndarray) -> np.ndarray:
        """محاسبه‌ی تانسور جرم-بیت با استفاده از ضرب خارجی بردار جهت‌گیری (Outer Product)"""
        # نرمال‌سازی بردار جهت برای ثبات عددی
        norm = np.linalg.norm(direction_vector)
        if norm > 0:
            unit_vector = direction_vector / norm
        else:
            unit_vector = direction_vector
            
        # تانسورِ ضربِ خارجی
        gamma_tensor = np.outer(unit_vector, unit_vector)
        
        # محاسبه‌یِ تانسورِ جرم-بیت: M_ij = rho_sat * Gamma_ij * eps
        mass_tensor = self.rho_sat * gamma_tensor * self.epsilon_floor
        return mass_tensor

    def run_simulation(self) -> list[dict]:
        """شبیه‌سازی جهت‌گیری‌هایِ مختلف برایِ بیت‌هایِ ماده‌ساز در فضای مانیفلد"""
        render_directions = [
            np.array([1.0, 0.0, 0.0]),       # جهتِ X
            np.array([0.707, 0.707, 0.0]),   # جهتِ مایل (Diagonal)
            np.array([0.0, 0.0, 1.0])        # جهتِ Z
        ]
        
        print("=" * 115)
        print(f"{'--- HAMZAH GATE 54 MASS-BIT TENSOR ENGINE REPORT ---':^115}")
        print("=" * 115)
        print(f"چگالی اشباع (Rho Sat): {self.rho_sat:.1e} | ضریب تبدیل (Epsilon Floor): {self.epsilon_floor:.3e}")
        print(f"{'جهت‌گیریِ رندر (Direction)':<25} | {'قطرِ تانسورِ جرم (Mass Diagonal)':<40} | {'وضعیتِ پایداری'}")
        print("-" * 115)
        
        results = []
        for i, d in enumerate(render_directions, start=1):
            m_tensor = self.calculate_mass_moment(d)
            diag_vals = m_tensor.diagonal()
            status = "TENSOR_MOMENT_LOCKED"
            
            results.append({
                "direction": d,
                "mass_tensor": m_tensor,
                "diagonal": diag_vals,
                "status": status
            })
            
            print(f"Dir_{i} {str(d.tolist()):<18} | {str(np.round(diag_vals, 4)):<40} | [{status}]")
            
        print("-" * 115)
        print("[تاییدِ نهایی]: موتور تانسور جرم-بیت اجرا شد؛ وزن تانسوری بیت‌های اطلاعاتی قفل گردید.")
        print("=" * 115)
        return results

if __name__ == "__main__":
    engine = HamzahMassBitEngine()
    engine.run_simulation()

