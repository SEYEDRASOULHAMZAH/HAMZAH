import numpy as np

class HamzahCausalLockEngine:
    """
    موتورِ قفلِ علّی (HamzahXcell Architecture - Gate 20)
    تاییدِ ایزومورفیسمِ انتقالِ داده از بعد ۳۳۰ به بعد ۳۷۰ با انحرافِ صفر
    """
    def __init__(self, causality_lambda: float = 1.0, seed: int = 42):
        self.causality_lambda = causality_lambda  # ثابتِ قیدِ علّی
        self.rng = np.random.default_rng(seed)
        
    def verify_causal_integrity(self, source_data: np.ndarray, physical_render: np.ndarray) -> tuple[float, str]:
        """بررسیِ ایزومورفیسم: آیا داده‌یِ رندر شده با منبع مطابقتِ کامل دارد؟"""
        deviation = float(np.linalg.norm(source_data - physical_render))
        
        # قفلِ علّی در صورتِ انحرافِ ناچیز (کمتر از آستانه خطای عددی)
        status = "ISOMORPHIC_LOCKED" if deviation < 1e-12 else "CAUSAL_DRIFT_ALERT"
        return deviation, status

    def run_simulation(self) -> list[dict]:
        """اجرای شبیه‌سازی برای ۲۰ گره‌یِ تلمتریِ پردازشِ ماتریکس (گذار از بعد ۳۳۰ به ۳۷۰)"""
        source_packets = self.rng.random((20, 100))
        rendered_packets = source_packets + self.rng.normal(0, 1e-15, (20, 100))  # نویزِ بسیار ناچیز
        
        print("=" * 95)
        print(f"{'--- HAMZAH GATE 20 CAUSAL LOCK & ISOMORPHISM REPORT ---':^95}")
        print("=" * 95)
        print(f"{'گره پردازشی':<15} | {'انحرافِ علّی (Drift)':<22} | {'وضعیتِ قفل'}")
        print("-" * 95)
        
        results = []
        for i in range(20):
            drift, status = self.verify_causal_integrity(source_packets[i], rendered_packets[i])
            results.append({
                "node": i + 1,
                "deviation": drift,
                "status": status
            })
            print(f"Node_{i+1:<10} | {drift:<22.4e} | [{status}]")
            
        print("-" * 95)
        print("[تاییدِ نهایی]: انتقالِ داده از بعد ۳۳۰ به ۳۷۰ با ایزومورفیسمِ کامل قفل شد.")
        print("=" * 95)
        return results

