        self.omega_h = 1.176e10
        self.floor_epsilon = 1.155e-20
        self.rng = np.random.default_rng(seed)
        # شبیه‌سازی 20 مرکز داده بلادرنگ (Telemetry Nodes) با توزیع نرمال کنترل‌شده
        self.data_centers = self.rng.normal(1.0, 0.05, 20) 

    def get_realtime_metrics(self, state_index: int) -> float:
        """محاسبه میانگین تلمتری جفتی برای حالت کیفی مشخص‌شده"""
        if not (1 <= state_index <= 10):
            raise ValueError(f"ILLEGAL_STATE: State index {state_index} out of bounds (Must be between 1 and 10).")
        
        idx = (state_index - 1) * 2
        return float(np.mean(self.data_centers[idx:idx+2]))

    def verify_system_integrity(self) -> list[dict]:
        """ارزیابی جامع یکپارچگی سیستم و محاسبه دترمینان ژاکوبی مستر برای تمامی حالات"""
