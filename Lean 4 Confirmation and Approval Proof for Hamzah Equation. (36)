        print(f"{'شاخصِ S (آنتروپی)':<22} | {'واریانسِ ورودی':<22} | {'واریانسِ خروجیِ ایمن':<25} | {'وضعیت مهار سرریز'}")
        print("-" * 110)
        
        results = []
        for s_val in entropy_scenarios:
            output_var = self.regulate_variance(input_var, s_val)
            status = "OVERFLOW_PREVENTED_LOCKED" if output_var < 1e30 else "UNSTABLE"
            
            results.append({
                "entropy_s": s_val,
                "input_variance": input_var,
                "output_variance": output_var,
                "status": status
            })
            
            print(f"{s_val:<22} | {input_var:<22.2e} | {output_var:<25.4e} | [{status}]")
            
        print("-" * 110)
        print("[تاییدِ نهایی]: مدیریت واریانس فرین با موفقیت اجرا شد؛ سرریزهای عددی کاملاً مهار شدند.")
        print("=" * 110)
