import numpy as np

class HamzahPhasorDivergenceEngine:
    """
    موتورِ کنترلِ دایورجنسِ فازور (HamzahXcell Architecture - Gate 36)
    سانسورِ خودکارِ مسیرهایِ منجر به پارادوکسِ علّی در مانیفلد فضا-زمان
    """
    def __init__(self, convergence_threshold: float = 1e-10, seed: int = 42):
        self.convergence_threshold = convergence_threshold
        self.rng = np.random.default_rng(seed)
        
    def validate_path(self, connection_matrix: np.ndarray) -> tuple[float, str]:
        """محاسبه‌ی وزن مسیر و سانسور خودکار مسیرهای مستعد پارادوکس علّی"""
        det_m = float(np.linalg.det(connection_matrix))
        
        # پیشگیری از تقسیم بر صفر و مدیریت حالات بحرانی دترمینان
        if abs(det_m) < self.convergence_threshold:
            w_path = 0.0  # سانسورِ کاملِ مسیر
            status = "CAUSAL_PARADOX_NULLIFIED"
        else:
            w_path = float(np.exp(-1.0 / det_m))
            status = "VALID" if w_path > 0.01 else "CAUSAL_PARADOX_NULLIFIED"
            
        return w_path, status

    def run_simulation(self) -> list[dict]:
        """اجرای شبیه‌سازی برای ۲۰ مسیرِ رادیویی با ماتریکس‌های اتصال متفاوت"""
        n_paths = 20
        paths_data = [self.rng.random((3, 3)) for _ in range(n_paths)] 
        
        print("=" * 110)
        print(f"{'--- HAMZAH GATE 36 PHASOR DIVERGENCE & CAUSAL CENSORSHIP REPORT ---':^110}")
        print("=" * 110)
        print(f"{'مسیر/منبع':<15} | {'دترمینان (Det M)':<22} | {'وزنِ علّی (W_path)':<22} | {'وضعیت علّی سیستم'}")
        print("-" * 110)
        
        results = []
        for i, m in enumerate(paths_data, start=1):
            det_val = float(np.linalg.det(m))
            w, status = self.validate_path(m)
            
            results.append({
                "path_id": i,
                "determinant": det_val,
                "w_path": w,
                "status": status
            })
            
            print(f"Path_{i:<10} | {det_val:<22.4f} | {w:<22.4f} [{status}]")
            
        print("-" * 110)
        print("[تاییدِ نهایی]: دایورجنس فازور کنترل شد؛ مسیرهای ناقض علیت با موفقیت سانسور شدند.")
        print("=" * 110)
        return results

if __name__ == "__main__":
    engine = HamzahPhasorDivergenceEngine()
    engine.run_simulation()

