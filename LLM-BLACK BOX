    print("\n🎯 مرحله 4: بررسی شرایط PASS/FAIL...")
    
    # شرایط HADI: انحراف نسبی باید ≤ 10^-50 باشد
    hadi_limit = 1e-50
    passed = relative_deviation <= hadi_limit
    
    if passed:
        status = "✅ PASS"
        status_icon = "✅"
        print(f"   {status_icon} انحراف نسبی ({relative_deviation:.10e}) ≤ حد HADI ({hadi_limit:.0e})")
    else:
