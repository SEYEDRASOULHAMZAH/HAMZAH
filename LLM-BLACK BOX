    def _generate_165d_dimension_entropy(self, dimension: int) -> bytes:
        """تولید آنتروپی برای یک بعد خاص از تانسور ۱۶۵D"""
        entropy = bytearray()
        
        # شبیه‌سازی بعد با ماتریس پیچیده کوانتومی-فرکتالی
        matrix_size = 256  # 256×256 برای پیچیدگی بیشتر
        for _ in range(8):  # ۸ نمونه برای هر بعد
            # ماتریس ابعاد بالا با مقادیر مختلط و ساختار فرکتالی
            matrix = np.random.randn(matrix_size, matrix_size) + \
                    1j * np.random.randn(matrix_size, matrix_size)
            
            # اعمال ساختار فرکتالی
            for level in range(5):
                matrix = self._apply_fractal_structure(matrix, level)
            
            # تبدیلات ویژه بعدی حمزه
            for transform in range(5):
                matrix = matrix @ np.conj(matrix).T @ matrix @ np.conj(matrix).T
                matrix = matrix / np.linalg.norm(matrix)
            
            entropy.extend(matrix.tobytes())
            
            # افزودن امضای بعدی حمزه
            dimension_signature = self._create_hamzah_dimension_signature(dimension, transform)
            entropy.extend(dimension_signature)
        
        # تبدیل برگشت‌ناپذیر با الگوریتم SHA3-512
        irreversible = hashlib.shake_256(entropy).digest(len(entropy) * 4)
        return irreversible
    
    def _apply_fractal_structure(self, matrix: np.ndarray, level: int) -> np.ndarray:
        """اعمال ساختار فرکتالی بر ماتریس"""
        size = matrix.shape[0]
        if size % 2 == 0:
            half = size // 2
            # ساختار خودشبیال
            for i in range(half):
                for j in range(half):
                    sub_matrix = matrix[i*2:(i+1)*2, j*2:(j+1)*2]
                    # اعمال نسبت طلایی (نسبت فرکتالی)
                    golden_ratio = (1 + math.sqrt(5)) / 2
                    matrix[i, j] = sub_matrix[0, 0] * golden_ratio ** level
        return matrix
    
