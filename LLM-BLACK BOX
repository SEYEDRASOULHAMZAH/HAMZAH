    print("\n📈 مرحله 3: محاسبه انحراف پایداری...")
    
    # انحراف نسبی در نرم
    norm_deviation = abs(final_metrics['frobenius_norm'] - initial_metrics['frobenius_norm'])
    relative_deviation = norm_deviation / initial_metrics['frobenius_norm']
    
    # انحراف در پایداری
    stability_deviation = abs(final_metrics['stability_index'] - initial_metrics['stability_index'])
    
    print(f"   • انحراف مطلق نرم: {norm_deviation:.10e}")
    print(f"   • انحراف نسبی نرم: {relative_deviation:.10e}")
    print(f"   • انحراف پایداری: {stability_deviation:.10e}")
    
