def generate_165d_tensor(seed=42):
    """تولید تانسور 165D با ابعاد واقعی"""
    print("🔧 در حال تولید تانسور 165D...")
    np.random.seed(seed)
    
    # ابعاد اصلی: 165×165×165×165 (برای سادگی 10×10×10×10 استفاده می‌کنیم)
    shape = (10, 10, 10, 10)  # در نسخه واقعی: (165, 165, 165, 165)
    
    # تولید با توزیع گاوسی مختلط
    real_part = np.random.normal(0, 1/np.sqrt(2), shape)
    imag_part = np.random.normal(0, 1/np.sqrt(2), shape)
    tensor = real_part + 1j * imag_part
    
    # نرمال‌سازی
    norm = np.sqrt(np.sum(np.abs(tensor)**2))
    tensor = tensor / norm
    
    print(f"✅ تانسور تولید شد - شکل: {tensor.shape}")
    print(f"   نرم اولیه: {norm:.10e}")
    
    return tensor

