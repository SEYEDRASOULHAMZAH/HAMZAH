    # ========================================================================
    # مرحله 5: تحلیل آماری
    # ========================================================================
    
    print("\n📊 مرحله 5: تحلیل آماری پیشرفته...")
    
    # محاسبه فاصله اطمینان
    confidence_level = 0.9999999999999999  # 99.99999999999999%
    
    # شبیه‌سازی مونت کارلو ساده
    deviations = []
    for _ in range(100):
        sample_noise = calculate_planck_thermal_noise(planck_temperature, initial_tensor.shape)
        sample_tensor = initial_tensor + noise_factor * sample_noise
        sample_metrics = calculate_tensor_metrics(sample_tensor)
        sample_deviation = abs(sample_metrics['frobenius_norm'] - initial_metrics['frobenius_norm']) / initial_metrics['frobenius_norm']
        deviations.append(sample_deviation)
    
    deviations = np.array(deviations)
    mean_deviation = np.mean(deviations)
    std_deviation = np.std(deviations)
    
    # فاصله اطمینان 99.99999999999999%
    z_score = 8.0  # برای سطح اطمینان فوق‌العاده بالا
    ci_lower = mean_deviation - z_score * (std_deviation / np.sqrt(100))
    ci_upper = mean_deviation + z_score * (std_deviation / np.sqrt(100))
    
    print(f"   • میانگین انحراف: {mean_deviation:.10e}")
    print(f"   • انحراف معیار: {std_deviation:.10e}")
    print(f"   • فاصله اطمینان {confidence_level*100:.2f}%: [{ci_lower:.10e}, {ci_upper:.10e}]")
    
