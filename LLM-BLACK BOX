    def _calculate_hamzah_tensor_value(self, byte: int, dimension: int, position: int) -> int:
        """محاسبه مقدار تانسوری حمزه"""
        # ثابت‌های تانسور حمزه ۱۶۵D
        hamzah_165d_constants = [
            0x11, 0x65, 0xD1, 0x65, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD,
            0xEE, 0xFF, 0x12, 0x34, 0x56, 0x78, 0x90, 0xAB, 0xCD, 0xEF,
            0x16, 0x51, 0x65, 0xD1, 0x65, 0x23, 0x45, 0x67, 0x89, 0x01
        ]
        
        # محاسبه پیچیده با در نظر گرفتن بعد و موقعیت و نسبت طلایی
        golden_ratio = (1 + math.sqrt(5)) / 2
        base_value = int(byte * dimension * position * golden_ratio) % 256
        
        constant_index = (dimension * position * 7) % len(hamzah_165d_constants)
        tensor_constant = hamzah_165d_constants[constant_index]
        
        # اعمال تبدیل غیرخطی حمزه
        hamzah_transform = (base_value ^ tensor_constant * 3 + dimension * 7) % 256
        
        return hamzah_transform
    
