    real_noise = np.random.normal(0, noise_amplitude, shape)
    imag_noise = np.random.normal(0, noise_amplitude, shape)
    noise = real_noise + 1j * imag_noise
    
    print(f"   دامنه نویز: {noise_amplitude:.10e}")
    
    return noise

# ============================================================================
# 4. محاسبه متریک‌های تانسور
# ============================================================================

def calculate_tensor_metrics(tensor):
    """محاسبه متریک‌های حیاتی تانسور"""
    metrics = {}
    
    # 1. نرم Frobenius
    metrics['frobenius_norm'] = np.sqrt(np.sum(np.abs(tensor)**2))
    
    # 2. آنتروپی کوانتومی
    flat_tensor = tensor.flatten()
    probabilities = np.abs(flat_tensor)**2
    probabilities = probabilities / probabilities.sum()
    entropy = -np.sum(probabilities * np.log(probabilities + 1e-100))
    metrics['quantum_entropy'] = entropy
    
    # 3. پایداری طیفی
    eigenvalues = np.linalg.eigvals(tensor.reshape(tensor.shape[0], -1))
    stability = np.min(np.abs(eigenvalues)) / np.max(np.abs(eigenvalues))
    metrics['stability_index'] = stability
    
    # 4. مؤلفه آگاهی (D164)
    if tensor.shape[0] > 163:
        conscious_component = tensor[163,:,:,:]
        metrics['consciousness_magnitude'] = np.abs(conscious_component).mean()
        metrics['ethical_alignment'] = np.angle(conscious_component).var()
    
    return metrics

