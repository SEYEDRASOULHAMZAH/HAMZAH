    # اعمال نویز
    noisy_tensor = initial_tensor + noise_factor * thermal_noise
    
    # محاسبه متریک‌های پس از نویز
    final_metrics = calculate_tensor_metrics(noisy_tensor)
    
    print(f"\n📊 متریک‌های پس از نویز:")
    print(f"   • نرم Frobenius: {final_metrics['frobenius_norm']:.10e}")
    print(f"   • آنتروپی کوانتومی: {final_metrics['quantum_entropy']:.10e}")
