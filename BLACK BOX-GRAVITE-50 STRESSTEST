def _encrypt_layer(self, data: bytes, layer_index: int) -> Dict[str, Any]:
    """رمزنگاری یک لایه"""
    # تولید کلید لایه از ماتریس تانسوری
    key = self._generate_layer_key(layer_index)
    
    # رمزنگاری بلوکی
    block_size = 256
    encrypted = bytearray()
    
    for i in range(0, len(data), block_size):
        block = data[i:i+block_size]
        if len(block) < block_size:
            block = block.ljust(block_size, b'\x00')
        
        encrypted_block = self._encrypt_with_tensor(block, key, i // block_size)
        encrypted.extend(encrypted_block)
    
    return {
        'layer': layer_index,
        'key_fingerprint': hashlib.sha3_256(key).hexdigest(),
        'encrypted_data': bytes(encrypted),
        'tensor_matrix_used': layer_index % 50
    }

def _encrypt_with_tensor(self, block: bytes, key: bytes, index: int) -> bytes:
    """رمزنگاری با استفاده از تانسور"""
    encrypted = bytearray()
    
    # تبدیل بایت‌ها به اعداد مختلط
    complex_block = []
    for i, byte in enumerate(block):
        phase = 2 * math.pi * byte / 256
        complex_block.append(complex(math.cos(phase), math.sin(phase)))
    
    # اعمال تبدیل تانسوری
    if len(complex_block) >= 165:
        # استفاده از ماتریس تانسور ۱۶۵×۱۶۵
        matrix = self.tensor_matrices[index % len(self.tensor_matrices)]
        
        # تبدیل بخش اول
        vec = np.array(complex_block[:165])
        transformed = matrix @ vec
        
        for val in transformed:
            magnitude = abs(val)
            angle = math.atan2(val.imag, val.real)
            encrypted_byte = int((magnitude * 255) % 256) ^ int((angle * 128 / math.pi) % 256)
            encrypted.append(encrypted_byte)
    else:
        # برای بلوک‌های کوچکتر
        for byte in block:
            encrypted.append(byte ^ key[len(encrypted) % len(key)])
    
    return bytes(encrypted)
