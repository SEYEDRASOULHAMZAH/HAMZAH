        entropy_layers.append(hashed)
    
    # لایه ۲: آنتروپی تانسور ۱۶۵ بعدی
    tensor_entropy = np.random.randn(165, 165, 165).tobytes()
    entropy_layers.append(tensor_entropy)
    
