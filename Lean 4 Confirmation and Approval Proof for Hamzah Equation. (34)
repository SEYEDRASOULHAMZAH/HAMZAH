        self.dim = dimension
        # شبیه‌سازی ماتریس ژاکوبی مستر با خواص ثابت بودن دترمینان (ماتریس همانی مقیاس‌شده برای مراکز)
        self.J = np.eye(20) 

    def stabilize(self, input_noise):
        # اپراتور Gamma: میرایی تانسوری بر اساس دترمینان ماتریس ژاکوبی
        gamma = np.linalg.det(self.J)
        feedback = input_noise * gamma
        return input_noise - feedback

