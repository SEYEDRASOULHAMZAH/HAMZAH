import numpy as np

class HamzahTensorEngine:
    """
    موتور محاسباتی پیشرفته حمزه‌اکسل برای تحلیل تانسوری چگالی
    و معادله کلان هم‌ارزی (HES) در مانیفلد ۱۱۵۵ بعدی
    """
    def __init__(self):
        self.kappa_1155 = 1.618e-35  # ضریب کوپلینگ ابعاد بالاتر
        self.epsilon_floor = 1.0e-40 # سد ناوردایی برای ثبات سیستم
        self.R_H = 1.0e-15           # شعاع افق پایه
        self.K_factor = 1.155        # افست کالیبراسیون مانیفلد

    def calculate_tensor_density(self, r, s_oblivion, pi_p, w_v):
        """محاسبه چگالی تانسوری حمزه‌اکسل بر اساس فرمول بنیادی"""
        log_term = np.log((r / self.R_H) + 1.155)
        exp_term = np.exp(-s_oblivion)
        denominator = self.K_factor * log_term * exp_term
        
        numerator = pi_p * (w_v**2)
        rho_x = 1.0 + self.kappa_1155 * (numerator / denominator)
        return rho_x

    def calculate_hes_energy(self, i_density, omega_h, s_mat):
        """محاسبه انرژی طبق معادله کلان هم‌ارزی (HES)"""
        numerator = i_density * (omega_h**2)
        denominator = s_mat + self.epsilon_floor
        return numerator / denominator

