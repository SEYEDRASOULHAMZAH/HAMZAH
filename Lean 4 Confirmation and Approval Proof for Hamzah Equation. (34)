import numpy as np

class HamzahQualityDynamics:
    """
    موتور پردازش حساسیت دیفرانسیلی (Differential Sensitivity Engine) 
    برای محاسبه نرخ تغییرات کیفیت پردازش نسبت به نویز آنتروپیک در مانیفلد ۱۱۵۵ بعدی
    """
    def __init__(self):
        self.manifold_dim = 1155
        self.I = 1.0e10          # چگالی اطلاعات پایه
        self.EPSILON = 1.155e-20   # سد پایداری هولوگرافیک

    def calculate_dynamics(self, entropy_level):
        # محاسبه کیفیت (Q-Factor)
        q_factor = self.I / (entropy_level + self.EPSILON)
        
        # محاسبه نرخ حساسیت (مشتق اول کیفیت نسبت به آنتروپی: dQ/dS)
        sensitivity = -self.I / ((entropy_level + self.EPSILON)**2)
        
        # تعیین کلاس بر اساس Q-Factor
        if q_factor > 1e40:
            phase = "X_cr (Crystalline)"
        elif 1e10 <= q_factor <= 1e40:
            phase = "X_gt (Gate/Transition)"
        else:
            phase = "X_bf (Sparse Buffer)"
            
        return q_factor, sensitivity, phase

if __name__ == "__main__":
    # تحلیل سناریوهای حاد و سطوح مختلف آنتروپی
    engine = HamzahQualityDynamics()
    test_entropies = [0.0, 1e-25, 1e-15, 1e-5] 

    print("=" * 95)
    print(f"{'Entropy (S)':<15} | {'Quality Factor (Q)':<20} | {'Sensitivity (dQ/dS)':<22} | {'Phase Classification'}")
    print("-" * 95)
    for s in test_entropies:
