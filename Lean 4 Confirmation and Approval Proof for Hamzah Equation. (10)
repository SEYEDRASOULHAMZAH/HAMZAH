    compute_neutron_rho base_rho chi > 0 := by
  unfold compute_neutron_rho
  positivity

theorem neutron_jacobian_det_positive (chi : ℝ) (h_chi : 0 ≤ chi) :
    compute_neutron_jacobian_det chi > 0 := by
  unfold compute_neutron_jacobian_det
  positivity

