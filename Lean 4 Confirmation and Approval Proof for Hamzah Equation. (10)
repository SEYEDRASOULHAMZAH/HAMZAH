-- تابع تبدیل بلادرنگ χ بر اساس فاکتور تعارض ستاره نوترونی و متریک فشرده
def compute_live_chi_neutron_32 (bridge : NeutronBridge32) : ℝ :=
  bridge.conflict_factor

-- لم ۱: اثبات مثبت بودن متغیر χ ستاره نوترونی
