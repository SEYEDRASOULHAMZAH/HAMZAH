    compute_neutron_jacobian_det chi ≤ 1 := by
  unfold compute_neutron_jacobian_det
  have h_den : 1 ≤ 1 + (5 / 100 : ℝ) * chi + (2 / 100 : ℝ) * chi ^ 2 := by
    have t1 : 0 ≤ (5 / 100 : ℝ) * chi := by positivity
    have t2 : 0 ≤ (2 / 100 : ℝ) * chi ^ 2 := by positivity
    linarith
