    base_rho < base_rho * (1 + (compute_live_chi_neutron_32 defaultNeutronBridge32)^2) := by
  unfold compute_live_chi_neutron_32 defaultNeutronBridge32 NeutronBridge32
  have h_div : 0 < neutron_conflict_feed / 10^7 := by linarith [neutron_conflict_positive]
  have h_sq : 0 < (neutron_conflict_feed / 10^7)^2 := by
    rw [sq]
    exact mul_pos h_div h_div
  have h_prod : 0 < base_rho * (neutron_conflict_feed / 10^7)^2 := mul_pos h_rho h_sq
  ring_nf
  linarith

