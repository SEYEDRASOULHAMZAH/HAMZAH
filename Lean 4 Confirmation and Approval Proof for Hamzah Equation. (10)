    compute_live_chi_neutron_32 defaultNeutronBridge32 > 0 := by
  unfold compute_live_chi_neutron_32 defaultNeutronBridge32 NeutronBridge32
  have h_pos : neutron_conflict_feed > 0 := neutron_conflict_positive
  linarith

-- لم ۲: اثبات کران‌دار بودن چگالی ستاره نوترونی (اصلاح‌شده با ring_nf جهت حل کامل ترم‌های غیرخطی توزیع‌پذیر)
