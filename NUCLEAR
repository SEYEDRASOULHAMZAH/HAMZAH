    def _analyze_system_stability(self, results: Dict[str, float], 
                                parameters: Dict[str, float]) -> Dict[str, Any]:
        """تحلیل پایداری سیستم"""
        stability_metrics = {
            'lyapunov_exponents': self._compute_lyapunov_exponents(results, parameters),
            'bifurcation_analysis': self._analyze_bifurcations(results, parameters),
            'chaos_indicators': self._compute_chaos_indicators(results, parameters),
            'resilience_metrics': self._compute_resilience_metrics(results, parameters)
        }
        
        # شاخص پایداری کلی
        overall_stability = (
            results['stability_index'] *
            stability_metrics['resilience_metrics']['recovery_factor'] /
            (1 + stability_metrics['chaos_indicators']['max_lyapunov'])
        )
        
        stability_metrics['overall_stability'] = float(overall_stability)
        stability_metrics['stability_class'] = (
            'HIGHLY_STABLE' if overall_stability > 10 else
            'STABLE' if overall_stability > 1 else
            'MARGINALLY_STABLE' if overall_stability > 0.1 else
            'UNSTABLE'
        )
        
        return stability_metrics
    
    def _compute_lyapunov_exponents(self, results: Dict[str, float], 
                                  parameters: Dict[str, float]) -> List[float]:
        """محاسبه نمادهای لیاپانوف"""
        # پیاده‌سازی ساده‌شده
        omega = results['omega_phi_primary']
        coherence = results['quantum_coherence_strength']
        coupling = results['gravitational_coupling']
        
        # سه نماد لیاپانوف اصلی
        lyapunov_1 = np.log(abs(omega)) / 100
        lyapunov_2 = np.log(abs(coherence)) / 100
        lyapunov_3 = np.log(abs(coupling)) / 100
        
        return [float(lyapunov_1), float(lyapunov_2), float(lyapunov_3)]
    
    def _analyze_bifurcations(self, results: Dict[str, float], 
                            parameters: Dict[str, float]) -> Dict[str, Any]:
        """تحلیل انشعاب‌های سیستم"""
        # نقاط انشعاب بالقوه
        bifurcation_points = []
        
        # پارامترهای مختلف برای تحلیل
        param_range = np.linspace(0.5, 2.0, 50)
        
        for factor in param_range:
            modified_params = parameters.copy()
            modified_params['characteristic_length'] *= factor
            
            modified_results = self.compute_quantum_gravity_parameters(modified_params)
            
            # بررسی تغییرات ناگهانی
            omega_change = abs(modified_results['omega_phi_primary'] - results['omega_phi_primary'])
            stability_change = abs(modified_results['stability_index'] - results['stability_index'])
            
            if omega_change > 0.1 * results['omega_phi_primary'] or stability_change > 0.5:
                bifurcation_points.append({
                    'parameter_factor': float(factor),
                    'omega_change': float(omega_change),
                    'stability_change': float(stability_change),
                    'bifurcation_type': 'PITCHFORK' if stability_change > 0.5 else 'SADDLE_NODE'
                })
        
        return {
            'bifurcation_points': bifurcation_points,
            'critical_parameters': [bp['parameter_factor'] for bp in bifurcation_points],
            'system_responsiveness': len(bifurcation_points) / len(param_range)
        }
    
    def _compute_chaos_indicators(self, results: Dict[str, float], 
                                parameters: Dict[str, float]) -> Dict[str, float]:
        """محاسبه شاخص‌های آشوب"""
        omega = results['omega_phi_primary']
        fractal = results['fractal_interaction_strength']
        
        # بعد همبستگی (تخمین)
        correlation_dimension = fractal / 2
        
        # نماد لیاپانوف ماکسیمم
        max_lyapunov = np.log(omega + fractal) / 100
        
        # آنتروپی کولموگروف-سینای
        kolmogorov_entropy = max_lyapunov * correlation_dimension
        
        # بعد فرکتالی مؤثر
        effective_fractal_dimension = 2 + (fractal - 2) * np.exp(-max_lyapunov)
        
        return {
            'correlation_dimension': float(correlation_dimension),
            'max_lyapunov': float(max_lyapunov),
            'kolmogorov_entropy': float(kolmogorov_entropy),
            'effective_fractal_dimension': float(effective_fractal_dimension),
            'chaos_level': 'HIGH' if max_lyapunov > 0.1 else 'MODERATE' if max_lyapunov > 0.01 else 'LOW'
        }
    
    def _compute_resilience_metrics(self, results: Dict[str, float], 
                                  parameters: Dict[str, float]) -> Dict[str, float]:
        """محاسبه معیارهای تاب‌آوری"""
        stability = results['stability_index']
        coherence = results['quantum_coherence_strength']
        coupling = results['gravitational_coupling']
        
        # زمان بازگشت به تعادل
        recovery_time = 1 / (stability * coherence)
        
        # حاشیه پایداری
        stability_margin = stability - 1  # فاصله از آستانه ناپایداری
        
        # تحمل خطا
        error_tolerance = coherence / (coupling + 1e-10)
        
        # قابلیت تطبیق
        adaptability = np.sqrt(coherence * stability)
        
        return {
            'recovery_time': float(recovery_time),
            'stability_margin': float(stability_margin),
            'error_tolerance': float(error_tolerance),
            'adaptability': float(adaptability),
            'recovery_factor': float(1 / recovery_time) if recovery_time > 0 else 1000
        }
    
    def _optimize_system_parameters(self, initial_params: Dict[str, float]) -> Dict[str, Any]:
        """بهینه‌سازی پارامترهای سیستم"""
        print("🔧 بهینه‌سازی پارامترهای سیستم...")
        
        # تابع هدف: ماکزیمم کردن Ω_φ و پایداری
        def objective(params_array):
            params = initial_params.copy()
            params['characteristic_length'] = params_array[0]
            params['fractal_dimension'] = params_array[1]
            params['strong_coupling'] = params_array[2]
            params['weak_coupling'] = params_array[3]
            params['alpha_parameter'] = params_array[4]
            
            results = self.compute_quantum_gravity_parameters(params)
            
            # ترکیب چند هدفه
            score = (
                results['omega_phi_primary'] *
                results['stability_index'] *
                results['quantum_coherence_strength']
            )
            
            return -score  # منفی برای کمینه‌سازی
        
        # حد و مرز پارامترها
        bounds = [
            (0.1, 10.0),    # characteristic_length
            (1.1, 2.9),     # fractal_dimension
            (0.1, 5.0),     # strong_coupling
            (0.01, 1.0),    # weak_coupling
            (0.1, 5.0)      # alpha_parameter
        ]
        
        # نقطه شروع
        x0 = [
            initial_params.get('characteristic_length', 1.0),
            initial_params.get('fractal_dimension', 2.5),
            initial_params.get('strong_coupling', 1.0),
            initial_params.get('weak_coupling', 0.1),
            initial_params.get('alpha_parameter', 1.0)
        ]
        
        # بهینه‌سازی
        try:
            result = optimize.minimize(
                objective, x0, bounds=bounds,
                method='L-BFGS-B',
                options={'maxiter': 1000, 'ftol': 1e-12}
            )
            
            optimal_params = initial_params.copy()
            optimal_params['characteristic_length'] = result.x[0]
            optimal_params['fractal_dimension'] = result.x[1]
            optimal_params['strong_coupling'] = result.x[2]
            optimal_params['weak_coupling'] = result.x[3]
            optimal_params['alpha_parameter'] = result.x[4]
            
            optimal_results = self.compute_quantum_gravity_parameters(optimal_params)
            
            improvement = {
                'omega_phi': (optimal_results['omega_phi_primary'] / 
                            self.compute_quantum_gravity_parameters(initial_params)['omega_phi_primary'] - 1) * 100,
                'stability': (optimal_results['stability_index'] / 
                            self.compute_quantum_gravity_parameters(initial_params)['stability_index'] - 1) * 100,
                'coherence': (optimal_results['quantum_coherence_strength'] / 
                            self.compute_quantum_gravity_parameters(initial_params)['quantum_coherence_strength'] - 1) * 100
            }
            
            return {
                'optimal_parameters': optimal_params,
                'optimal_results': optimal_results,
                'optimization_success': result.success,
                'improvement_percentages': improvement,
                'final_objective_value': float(-result.fun),
                'iterations': result.nit,
                'message': result.message
            }
            
        except Exception as e:
            return {
                'optimal_parameters': initial_params,
                'optimal_results': self.compute_quantum_gravity_parameters(initial_params),
                'optimization_success': False,
                'error': str(e),
                'improvement_percentages': {'omega_phi': 0, 'stability': 0, 'coherence': 0}
            }
    
