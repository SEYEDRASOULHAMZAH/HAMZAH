        advantages = {}
        for tech, metrics in existing_tech.items():
            advantage = {}
            for key in pb10_metrics:
                if key in metrics:
                    if key == 'cost':
                        # برای هزینه، عدد کمتر بهتر است
                        advantage[key] = metrics[key] / pb10_metrics[key] if pb10_metrics[key] > 0 else float('inf')
                    else:
                        # برای سایر معیارها، عدد بیشتر بهتر است
                        advantage[key] = pb10_metrics[key] / metrics[key] if metrics[key] > 0 else float('inf')
            
