    def _analyze_convergence(self, results: List[Dict[str, float]]) -> Dict[str, Any]:
        """تحلیل همگرایی شبیه‌سازی‌ها"""
        omega_values = [r['omega_phi_primary'] for r in results]
        
        # محاسبه میانگین متحرک
        window_size = len(omega_values) // 10
        moving_averages = []
        std_errors = []
        
        for i in range(window_size, len(omega_values)):
            window = omega_values[i-window_size:i]
            moving_averages.append(np.mean(window))
            std_errors.append(np.std(window) / np.sqrt(len(window)))
        
        # تحلیل همگرایی
        final_mean = moving_averages[-1] if moving_averages else np.mean(omega_values)
        final_std_error = std_errors[-1] if std_errors else np.std(omega_values) / np.sqrt(len(omega_values))
        
        # ضریب همگرایی
        if len(moving_averages) > 1:
            convergence_rate = abs(moving_averages[-1] - moving_averages[-2]) / moving_averages[-2]
        else:
            convergence_rate = 0
        
        return {
            'final_mean': float(final_mean),
            'final_std_error': float(final_std_error),
            'convergence_rate': float(convergence_rate),
            'converged': convergence_rate < 0.0001,
            'required_iterations': len(omega_values),
            'confidence_interval': [
                float(final_mean - 2*final_std_error),
                float(final_mean + 2*final_std_error)
            ]
        }
    
    def _compute_sensitivity_matrix(self, results: List[Dict[str, float]], 
                                  base_params: Dict[str, float]) -> Dict[str, Any]:
        """محاسبه ماتریس حساسیت"""
        # این یک پیاده‌سازی ساده است
        sensitivities = {}
        
        for param in base_params:
            if isinstance(base_params[param], (int, float)):
                # مشتق جزئی عددی
                delta = base_params[param] * 0.01
                perturbed_params = base_params.copy()
                perturbed_params[param] += delta
                
                base_result = self.compute_quantum_gravity_parameters(base_params)
                perturbed_result = self.compute_quantum_gravity_parameters(perturbed_params)
                
                sensitivity = {}
                for key in base_result:
                    if isinstance(base_result[key], (int, float)):
                        if base_result[key] != 0:
                            rel_change = (perturbed_result[key] - base_result[key]) / base_result[key]
                            param_change = delta / base_params[param]
                            sensitivity[key] = float(rel_change / param_change)
                
                sensitivities[param] = sensitivity
        
        return sensitivities
    
