        # شاخص برتری کلی
        overall_superiority = {}
        for tech in advantages:
            # میانگین هندسی مزیت‌ها
            values = list(advantages[tech].values())
            geometric_mean = np.exp(np.mean(np.log([v for v in values if v > 0])))
