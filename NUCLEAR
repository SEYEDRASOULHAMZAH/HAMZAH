    def _compute_correlations(self, results: List[Dict[str, float]]) -> Dict[str, float]:
        """محاسبه همبستگی‌های بین متغیرها"""
        # استخراج داده‌ها
        omega_values = [r['omega_phi_primary'] for r in results]
        coherence_values = [r['quantum_coherence_strength'] for r in results]
        coupling_values = [r['gravitational_coupling'] for r in results]
        fractal_values = [r['fractal_interaction_strength'] for r in results]
        
        # محاسبه همبستگی‌ها
        correlations = {
            'omega_coherence': float(np.corrcoef(omega_values, coherence_values)[0, 1]),
            'omega_coupling': float(np.corrcoef(omega_values, coupling_values)[0, 1]),
