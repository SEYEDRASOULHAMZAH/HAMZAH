    def _optimize_material_design(self, candidates: List[Dict[str, Any]], 
                                requirements: Dict[str, Any]) -> Dict[str, Any]:
        """بهینه‌سازی طراحی مواد"""
        # ارزیابی کاندیدها بر اساس معیارهای چندگانه
        scored_candidates = []
        
        for candidate in candidates:
            score = 0
            
            # امتیاز بر اساس دمای کاری
            if requirements.get('temperature_range')[1] > 1000:
                if 'Tungsten' in candidate['name']:
                    score += 3
                elif 'Carbon' in candidate['name']:
                    score += 2
                elif 'Beryllium' in candidate['name']:
                    score += 1
            
            # امتیاز بر اساس شار حرارتی
            if requirements.get('heat_flux', 0) > 5e6:
                if 'good thermal conductivity' in str(candidate['advantages']).lower():
                    score += 2
            
            # امتیاز بر اساس مقاومت تشعشعی
            if requirements.get('neutron_flux', 0) > 1e17:
                if 'low activation' in str(candidate['advantages']).lower():
                    score += 2
            
            scored_candidates.append({
                **candidate,
                'score': score
            })
        
        # انتخاب برترین
        scored_candidates.sort(key=lambda x: x['score'], reverse=True)
        best_candidate = scored_candidates[0]
        
        # بهینه‌سازی ترکیب
        optimized_composition = self._optimize_composition(best_candidate, requirements)
        
        # بهینه‌سازی ریزساختار
        optimized_microstructure = self._optimize_microstructure(best_candidate, requirements)
        
        return {
            'selected_material': best_candidate['name'],
            'selection_score': best_candidate['score'],
            'optimized_composition': optimized_composition,
            'optimized_microstructure': optimized_microstructure,
            'alternative_materials': scored_candidates[1:3] if len(scored_candidates) > 1 else []
        }
    
