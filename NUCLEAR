    def _perform_thermal_analysis(self, requirements: Dict[str, Any]) -> Dict[str, Any]:
        """انجام تحلیل حرارتی"""
        heat_flux = requirements.get('heat_flux', 1e6)  # W/m²
        surface_area = requirements.get('surface_area', 100)  # m²
        coolant_type = requirements.get('coolant_type', 'helium')
        
        # محاسبه توان حرارتی کل
        total_power = heat_flux * surface_area
        
        # انتخاب خواص خنک‌کننده
        coolant_props = self.coolant_properties.get(coolant_type, self.coolant_properties['helium'])
        
        # محاسبه دبی جرمی مورد نیاز
        delta_T = 100  # K (افزایش دمای طراحی)
        specific_heat = 5190 if coolant_type == 'helium' else 4180 if coolant_type == 'water' else 190  # J/kg·K
        
        mass_flow_rate = total_power / (specific_heat * delta_T)
        
        # محاسبه ضریب انتقال حرارت
        # استفاده از رابطه دیتوس-بولتر برای جریان آشفته
        Re = 10000  # عدد رینولدز (فرض اولیه)
        Pr = 0.68 if coolant_type == 'helium' else 6.14 if coolant_type == 'water' else 0.1
        Nu = 0.023 * Re**0.8 * Pr**0.4
        
        # خواص برای محاسبه h
        k = 0.152 if coolant_type == 'helium' else 0.606 if coolant_type == 'water' else 15  # W/m·K
        D_h = 0.01  # قطر هیدرولیکی (m) - فرض اولیه
        
        h = Nu * k / D_h
        
        # محاسبه مقاومت حرارتی
        R_conv = 1 / (h * surface_area)
        
        # محاسبه دمای سطح
        T_coolant_inlet = 300 + 273.15  # K (تبدیل به کلوین)
        T_surface = T_coolant_inlet + total_power * R_conv + delta_T/2
        
        return {
            'total_heat_power': total_power,
            'required_mass_flow_rate': mass_flow_rate,
            'heat_transfer_coefficient': h,
            'convective_resistance': R_conv,
            'surface_temperature': T_surface - 273.15,  # تبدیل به سلسیوس
            'coolant_temperature_rise': delta_T,
            'thermal_analysis_status': 'COMPLETE'
        }
    
    def _perform_hydraulic_analysis(self, requirements: Dict[str, Any]) -> Dict[str, Any]:
        """انجام تحلیل هیدرولیکی"""
        coolant_type = requirements.get('coolant_type', 'helium')
        mass_flow_rate = self._perform_thermal_analysis(requirements)['required_mass_flow_rate']
        
        # خواص سیال
        if coolant_type == 'helium':
            rho = 16.2  # kg/m³ at 300K, 10MPa
            mu = 2.0e-5  # Pa·s
        elif coolant_type == 'water':
            rho = 996  # kg/m³ at 300K, 10MPa
            mu = 8.9e-4  # Pa·s
        else:
            rho = 9700  # kg/m³ for PbLi at 600K
            mu = 1.3e-3  # Pa·s
        
        # پارامترهای طراحی
        D_h = 0.01  # قطر هیدرولیکی (m)
        A_cs = np.pi * (D_h/2)**2  # سطح مقطع (m²)
        L = 10  # طول کانال (m) - فرض اولیه
        
        # محاسبه سرعت
        velocity = mass_flow_rate / (rho * A_cs)
        
        # محاسبه عدد رینولدز
        Re = rho * velocity * D_h / mu
        
        # محاسبه افت فشار
        if Re < 2300:
            # جریان آرام
            f = 64 / Re
        else:
            # جریان آشفته - معادله چرچیل
            f = 8 * ((8/Re)**12 + (1/((2.457 * np.log(1/((7/Re)**0.9 + 0.27*0.0001/D_h)))**16 + (37530/Re)**16))**1.5)**(1/12)
        
        delta_p = f * (L/D_h) * (0.5 * rho * velocity**2)
        
        # توان پمپاژ
        pump_power = mass_flow_rate * delta_p / rho
        
        # برای MHD (اگر مایع فلزی در میدان مغناطیسی)
        if coolant_type == 'lead_lithium':
            B = 5  # میدان مغناطیسی (T)
            sigma = 7.8e5  # هدایت الکتریکی (S/m)
            delta_p_mhd = sigma * B**2 * velocity * L
        
        return {
            'flow_velocity': velocity,
            'reynolds_number': Re,
            'flow_regime': 'Laminar' if Re < 2300 else 'Turbulent',
            'friction_factor': f,
            'pressure_drop': delta_p,
            'pumping_power': pump_power,
            'mhd_pressure_drop': delta_p_mhd if coolant_type == 'lead_lithium' else 0,
            'hydraulic_analysis_status': 'COMPLETE'
        }
    
    def _perform_structural_analysis(self, requirements: Dict[str, Any]) -> Dict[str, Any]:
        """انجام تحلیل سازه‌ای"""
        pressure = requirements.get('pressure', 10e6)  # Pa
        temperature = self._perform_thermal_analysis(requirements)['surface_temperature'] + 273.15  # K
        material = requirements.get('material', 'tungsten')
        
        # خواص مواد
        if material == 'tungsten':
            E = 400e9  # Pa
            nu = 0.28
            alpha = 4.5e-6  # 1/K
            sigma_y = 1.8e9  # Pa (تنش تسلیم)
            sigma_uts = 2.2e9  # Pa (استحکام کششی نهایی)
        elif material == 'copper':
            E = 128e9  # Pa
            nu = 0.34
            alpha = 16.5e-6  # 1/K
            sigma_y = 0.3e9  # Pa
            sigma_uts = 0.4e9  # Pa
        else:
            E = 200e9  # Pa
            nu = 0.3
            alpha = 12e-6  # 1/K
            sigma_y = 0.5e9  # Pa
            sigma_uts = 0.7e9  # Pa
        
        # تحلیل استوانه تحت فشار (دیواره کانال خنک‌کننده)
        r_i = 0.005  # شعاع داخلی (m)
        r_o = 0.006  # شعاع خارجی (m)
        
        # تنش حلقوی
        sigma_theta = pressure * r_i**2 / (r_o**2 - r_i**2) * (1 + r_o**2 / r_i**2)
        
        # تنش شعاعی
        sigma_r = -pressure * r_i**2 / (r_o**2 - r_i**2) * (1 - r_o**2 / r_i**2)
        
        # تنش محوری
        sigma_z = pressure * r_i**2 / (r_o**2 - r_i**2)
        
        # تنش وون مایسز
        sigma_vm = np.sqrt(0.5 * ((sigma_theta - sigma_r)**2 + 
                                 (sigma_r - sigma_z)**2 + 
                                 (sigma_z - sigma_theta)**2))
        
        # فاکتور ایمنی
        safety_factor = sigma_y / sigma_vm
        
        # تحلیل تنش حرارتی
        delta_T = 100  # K (گرادیان دمایی در ضخامت)
        sigma_thermal = E * alpha * delta_T / (1 - nu)
        
        # تنش ترکیبی
        sigma_total = sigma_vm + sigma_thermal
        
        # فاکتور ایمنی ترکیبی
        safety_factor_total = sigma_y / sigma_total
        
        return {
            'hoop_stress': sigma_theta,
            'radial_stress': sigma_r,
            'axial_stress': sigma_z,
            'von_mises_stress': sigma_vm,
            'thermal_stress': sigma_thermal,
            'total_stress': sigma_total,
            'safety_factor_pressure': safety_factor,
            'safety_factor_combined': safety_factor_total,
            'design_status': 'ACCEPTABLE' if safety_factor_total > 1.5 else 'REDESIGN_REQUIRED',
            'structural_analysis_status': 'COMPLETE'
        }
    
