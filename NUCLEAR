    def _calculate_thermal_stress(self, requirements: Dict[str, Any]) -> Dict[str, float]:
        """محاسبه تنش‌های حرارتی"""
        T_max = requirements.get('temperature_range')[1]
        T_min = requirements.get('temperature_range')[0]
        alpha = 5e-6  # ضریب انبساط حرارتی (1/K) - مقدار نمونه
        E = 400e9  # مدول الاستیسیته (Pa) - مقدار نمونه
        nu = 0.3  # نسبت پواسون - مقدار نمونه
        
        # تنش حرارتی در یک بعد
        thermal_stress = alpha * E * (T_max - T_min) / (1 - nu)
        
        # ضریب تمرکز تنش (برای گوشه‌ها و سوراخ‌ها)
        stress_concentration = 3.0  # مقدار محافظه‌کارانه
        
        return {
            'thermal_stress_1d': thermal_stress,
            'stress_with_concentration': thermal_stress * stress_concentration,
            'safety_factor': 2.0,  # فاکتور ایمنی اعمال شده
            'allowable_stress': thermal_stress * stress_concentration * 2.0,
            'conclusion': 'Design acceptable' if thermal_stress * stress_concentration * 2.0 < 1e9 else 'Redesign needed'
        }
    
    def _estimate_radiation_damage(self, requirements: Dict[str, Any]) -> Dict[str, float]:
        """تخمین آسیب تشعشعی"""
        neutron_flux = requirements.get('neutron_flux', 1e18)  # n/m²s
        energy = 14.1e6  # انرژی نوترون (eV) برای D-T fusion
        lifetime = requirements.get('lifetime', 10)  # years
        dpa_cross_section = 3e-27  # سطح مقطع برای ایجاد جابجایی (m²) - مقدار نمونه
        
        # محاسبه dpa (جابجایی بر اتم)
        seconds_per_year = 365.25 * 24 * 3600
        total_fluence = neutron_flux * lifetime * seconds_per_year
        dpa = total_fluence * dpa_cross_section
        
        # تولید هلیوم (appm)
        he_production_cross_section = 1e-28  # m²
        he_appm = total_fluence * he_production_cross_section * 1e6
        
        # تورم (swelling)
        swelling_rate = 0.001  # % per dpa - وابسته به دما
        total_swelling = swelling_rate * dpa * 100  # درصد
        
        return {
            'total_fluence': total_fluence,
            'dpa': dpa,
            'helium_production': he_appm,
            'expected_swelling': total_swelling,
            'damage_level': (
                'LOW' if dpa < 1 else
                'MODERATE' if dpa < 10 else
                'HIGH' if dpa < 100 else
                'EXTREME'
            )
        }
    
    def _mechanical_design(self, requirements: Dict[str, Any]) -> Dict[str, Any]:
        """طراحی مکانیکی"""
        mechanical_load = requirements.get('mechanical_load', 100e6)  # Pa
        safety_factor = 2.5
        
        # تنش مجاز
        allowable_stress = mechanical_load * safety_factor
        
        # طراحی برای خستگی
        fatigue_life_cycles = 1e6  # چرخه هدف
        fatigue_strength_reduction = 0.7  # ضریب کاهش برای خستگی
        
        # طراحی برای شکست
        fracture_toughness_required = 30  # MPa√m
        critical_flaw_size = (fracture_toughness_required / (1.12 * allowable_stress))**2 / np.pi
        
        return {
            'allowable_stress': allowable_stress,
            'required_yield_strength': allowable_stress * 1.5,  # 1.5 برای اطمینان از تسلیم نشدن
            'fatigue_design_stress': allowable_stress * fatigue_strength_reduction,
            'required_fatigue_life': fatigue_life_cycles,
            'critical_flaw_size': critical_flaw_size,
            'inspection_requirement': f"Inspect for flaws > {critical_flaw_size*1000:.2f} mm"
        }
    
