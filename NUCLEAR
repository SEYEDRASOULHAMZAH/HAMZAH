    def _compute_vacuum_fluctuations(self, Omega_phi: float, parameters: Dict[str, float]) -> Dict[str, float]:
        """محاسبه نوسانات خلأ کوانتومی"""
        L = np.float128(parameters.get('characteristic_length', 1.0))
        plate_distance = np.float128(parameters.get('plate_distance', 1e-6))
        temperature = np.float128(parameters.get('temperature', 300.0))
        
        # چگالی انرژی خلأ
        vacuum_energy_density = (
            (self.constants['hbar'] * self.constants['c'] * np.pi**2) /
            (30 * L**4) * Omega_phi
        )
        
        # فشار کازیمیر
        casimir_pressure = (
            (np.pi**2 * self.constants['hbar'] * self.constants['c']) /
            (240 * plate_distance**4) * Omega_phi
        )
        
        # اصلاحات دمایی
        if temperature > 0:
            thermal_correction = (
                special.zeta(3) * self.constants['k_B'] * temperature /
                (8 * np.pi * plate_distance**3)
            )
            casimir_pressure -= thermal_correction
        
        # نوسانات میدان
        field_fluctuations = np.sqrt(self.constants['hbar'] / (2 * L)) * Omega_phi**0.25
        
        return {
            'energy_density': float(vacuum_energy_density),
