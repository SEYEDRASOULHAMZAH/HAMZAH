    def _validate_parameters(self, L: float, D_f: float, g_s: float, g_w: float, alpha: float):
        """اعتبارسنجی پارامترها با معیارهای فیزیکی"""
        if L <= 0:
            raise ValueError("Characteristic length must be positive")
        if not (1 < D_f < 3):
            raise ValueError("Fractal dimension must be between 1 and 3")
        if g_s <= 0 or g_w <= 0:
            raise ValueError("Coupling constants must be positive")
        if alpha <= 0:
            raise ValueError("Alpha parameter must be positive")
        
        # اعتبارسنجی اضافی
        if L < 1e-15:  # Smaller than femtometer
            warnings.warn("Characteristic length is extremely small")
        if D_f > 2.8:  # Very high fractal dimension
            warnings.warn("High fractal dimension may indicate measurement issues")
    
    def _compute_dual_representation(self, parameters: Dict[str, float]) -> float:
        """محاسبه نمایش دوگانه با دقت بسیار بالا"""
        c = np.float128(self.constants['c'])
        hbar = np.float128(self.constants['hbar'])
        G = np.float128(self.constants['G'])
        Lambda = np.float128(self.constants['Lambda'])
        ell_p = np.float128(self.constants['planck_length'])
        
        L = np.float128(parameters.get('characteristic_length', 1.0))
        D_f = np.float128(parameters.get('fractal_dimension', 2.5))
        g_s = np.float128(parameters.get('strong_coupling', 1.0))
        g_w = np.float128(parameters.get('weak_coupling', 0.1))
        alpha = np.float128(parameters.get('alpha_parameter', 1.0))
        
        term1 = (hbar * G / c**5)**(1/alpha)
        term2 = (ell_p / L)**(D_f - 1)
        term3 = np.exp(4 * np.pi * g_s * g_w)
        term4 = (Lambda * ell_p**2 * (ell_p / L)**2) / (hbar * c) + 1e-50
        correction = np.exp(-(ell_p/L)**2 * np.exp(alpha/2))
        
        return term1 * term2 * term3 * term4 * correction
    
    def _compute_field_energy(self, Omega_phi: float, parameters: Dict[str, float]) -> float:
        """محاسبه انرژی میدان با جزئیات کامل"""
        volume = np.float128(parameters.get('plasma_volume', 100.0))
        field_strength = np.float128(parameters.get('field_strength', 1.0))
        epsilon_r = np.float128(parameters.get('relative_permittivity', 1.0))
        mu_r = np.float128(parameters.get('relative_permeability', 1.0))
        
        # انرژی الکتریکی
        electric_energy = 0.5 * self.constants['epsilon_0'] * epsilon_r * field_strength**2 * volume
        
        # انرژی مغناطیسی
        magnetic_energy = 0.5 * (field_strength**2) / (self.constants['mu_0'] * mu_r) * volume
        
        # انرژی میدان کوانتومی-گرانشی
        quantum_gravity_energy = Omega_phi * volume * field_strength**2
        
        # انرژی کل
        total_energy = electric_energy + magnetic_energy + quantum_gravity_energy
        
        return float(total_energy)
    
    def _compute_quantum_stability(self, Omega_phi: float, parameters: Dict[str, float]) -> Dict[str, float]:
        """محاسبه پایداری کوانتومی با مدل‌های پیشرفته"""
