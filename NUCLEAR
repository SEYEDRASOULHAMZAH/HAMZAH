def _generate_summary_plots(self, report: Dict[str, Any]):
    """تولید نمودارهای خلاصه"""
    try:
        import matplotlib.pyplot as plt
        import numpy as np
        
        # داده‌های نمونه برای نمودارها
        performance = report['performance_analysis']
        
        # 1. نمودار راداری برای عملکرد کلی
        fig, axes = plt.subplots(2, 2, figsize=(12, 10))
        
        # نمودار 1: عملکرد فنی
        tech_data = list(performance['technical_performance'].values())[:4]
        tech_labels = ['بازده انرژی', 'ظرفیت حرارتی', 'عملکرد مواد', 'دسترسی']
        axes[0, 0].bar(tech_labels, tech_data)
        axes[0, 0].set_title('عملکرد فنی')
        axes[0, 0].set_ylim(0, 1)
        
        # نمودار 2: عملکرد اقتصادی
        econ_data = list(performance['economic_performance'].values())[:4]
        econ_labels = ['بازده سرمایه', 'هزینه انرژی', 'دوره بازگشت', 'کارایی هزینه']
        axes[0, 1].plot(econ_labels, econ_data, 'o-')
        axes[0, 1].set_title('عملکرد اقتصادی')
        
        # نمودار 3: مقایسه ایمنی
        safety_data = list(performance['safety_performance']['safety_margins'].values())
        safety_labels = ['حرارتی', 'سازه‌ای', 'هسته‌ای']
        axes[1, 0].pie(safety_data, labels=safety_labels, autopct='%1.1f%%')
        axes[1, 0].set_title('حاشیه ایمنی')
        
        # نمودار 4: عملکرد محیط زیستی
        env_data = [performance['environmental_performance']['carbon_footprint'] * 1000,
                  0.5,  # Placeholder for waste
                  0.8]  # Placeholder for resource efficiency
        env_labels = ['ردپای کربن', 'تولید پسماند', 'کارایی منابع']
        axes[1, 1].barh(env_labels, env_data)
        axes[1, 1].set_title('عملکرد محیط زیستی')
        
        plt.suptitle('خلاصه عملکرد سیستم ULTIMATE PB-10', fontsize=16, fontweight='bold')
        plt.tight_layout()
        plt.savefig('pb10_performance_summary.png', dpi=300, bbox_inches='tight')
        plt.close()
        
        print("📊 نمودارهای خلاصه در pb10_performance_summary.png ذخیره شد.")
        
    except Exception as e:
        print(f"⚠️ خطا در تولید نمودارها: {e}")

