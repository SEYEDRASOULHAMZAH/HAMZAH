                prob = risk['probability']
                impact_map = {'LOW': 1, 'MEDIUM': 3, 'HIGH': 5, 'VERY_HIGH': 10}
                impact = impact_map.get(risk['impact'], 3)
                
                overall_risk_score += prob * impact
                risk_count += 1
        
        if risk_count > 0:
            overall_risk_score /= risk_count
        
        risks['overall_risk_assessment'] = {
            'risk_score': float(overall_risk_score),
