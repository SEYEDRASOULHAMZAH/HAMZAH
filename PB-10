    def _calculate_quantum_confidence(self, results, confidence=0.999):
        """محاسبه فاصله اطمینان کوانتومی"""
        n = len(results)
        mean = np.mean(results)
        std_err = stats.sem(results)
        h = std_err * stats.t.ppf((1 + confidence) / 2, n - 1)
        return mean - h, mean + h
    
    def _quantum_scientific_validation(self, results, input_data, capability):
