        centralized = []
        distributed = []

        for s in stress_levels:
            c_val = self.system_survival(1, s)
            d_val = self.system_survival(2, s)
            centralized.append(c_val if isinstance(c_val, float) else 0.0)
            distributed.append(d_val if isinstance(d_val, float) else 0.0)

        tensor_metric = (sum(distributed) / (sum(centralized) + self.EPSILON_FLOOR)) * self.OMEGA_H_13

        report = {
            "Timestamp": self.timestamp,
            "Manifold_Dimension": self.MANIFOLD_DIM,
            "Omega_H_13": self.OMEGA_H_13,
            "Stress_Levels_Count": len(stress_levels),
            "Final_Centralized_Survival": centralized[-1],
            "Final_Distributed_Survival": distributed[-1],
            "Tensor_Metric": float(tensor_metric),
            "Integrity_Score": round(self.integrity_score, 2),
            "Status": "TOPOLOGY_SURVIVAL_NOMINAL"
        }
        return report

