    def _calculate_overall_score(self, results):
        """محاسبه امتیاز کلی سیستم"""
        # وزن‌دهی به بخش‌های مختلف
        weights = {
            'equations': 0.25,
            'laws': 0.20,
            'mysteries': 0.25,
            'monte_carlo': 0.15,
            'quality_control': 0.15
        }
        
        scores = {}
        
        # امتیاز معادلات
        eq_scores = [result.get('qc_score', 0.9) for category in results['equations'].values() 
                    for result in category.values() if isinstance(result, dict)]
        scores['equations'] = np.mean(eq_scores) if eq_scores else 0.9
        
        # امتیاز قوانین
        law_scores = [result.get('qc_verification', {}).get('qc_score', 0.9) 
                     for category in results['laws'].values() 
                     for result in category.values() if isinstance(result, dict)]
        scores['laws'] = np.mean(law_scores) if law_scores else 0.9
        
        # امتیاز معماها
        mystery_scores = [result.get('certainty_level', 0.9) 
                         for category in results['mysteries'].values() 
                         for result in category.values() if isinstance(result, dict)]
        # تبدیل درصد به عدد
        mystery_scores_num = [float(score.strip('%'))/100 if isinstance(score, str) else score 
                             for score in mystery_scores]
        scores['mysteries'] = np.mean(mystery_scores_num) if mystery_scores_num else 0.9
        
        # امتیاز مونت کارلو
        scores['monte_carlo'] = results.get('monte_carlo', {}).get('convergence', {}).get('confidence', 0.999)
        
        # امتیاز کنترل کیفیت
        scores['quality_control'] = results.get('quality_control', {}).get('final_qc_assessment', {}).get('final_score', 0.999)
        
        # محاسبه امتیاز وزنی
        weighted_score = sum(scores[category] * weight for category, weight in weights.items())
        
        return {
            'weighted_score': weighted_score,
            'component_scores': scores,
            'weights': weights,
            'final_normalized': min(weighted_score / sum(weights.values()), 1.0)
        }

