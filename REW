def make_results_serializable(obj):
    """تبدیل نتایج به فرمت قابل ذخیره در JSON"""
    if isinstance(obj, (np.int_, np.intc, np.intp, np.int8, np.int16, np.int32, np.int64)):
        return int(obj)
    elif isinstance(obj, (np.float_, np.float16, np.float32, np.float64)):
        return float(obj)
    elif isinstance(obj, (np.ndarray,)):
        return obj.tolist()
    elif isinstance(obj, (dict,)):
        return {key: make_results_serializable(value) for key, value in obj.items()}
    elif isinstance(obj, (list, tuple)):
        return [make_results_serializable(item) for item in obj]
    elif isinstance(obj, (sp.Basic,)):
        return str(obj)
    else:
        return obj

