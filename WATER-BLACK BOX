    def _apply_climate_transform(self, data: bytes, index: int) -> bytes:
        """اعمال تبدیل اقلیمی"""
        transformed = bytearray()
        
        climate_constants = [
            0x15, 0x23, 0x37, 0x41, 0x53, 0x67, 0x71, 0x83, 0x97, 0x101,
            0x113, 0x127, 0x131, 0x149, 0x151, 0x163, 0x167, 0x179, 0x181, 0x193
        ]
        
        for i, byte in enumerate(data):
            # تبدیل مبتنی بر ثابت‌های اقلیمی
            climate_byte = (byte * climate_constants[index % len(climate_constants)]) % 256
            climate_byte ^= climate_constants[i % len(climate_constants)]
            transformed.append(climate_byte)
        
        return bytes(transformed)
    
    def _apply_hydro_transform(self, data: bytes, index: int) -> bytes:
        """اعمال تبدیل هیدرولیکی"""
        transformed = bytearray()
        
        hydro_principles = [
            "تبخیر", "تقطیر", "چگالش", "بارش",
            "جریان", "فشار", "غلظت", "تصفیه"
        ]
        
        principle_hash = hashlib.sha3_512(
            hydro_principles[index % len(hydro_principles)].encode()
        ).digest()
        
        for i, byte in enumerate(data):
            hydro_byte = byte ^ principle_hash[i % len(principle_hash)]
            # اعمال چرخه آب
            hydro_byte = (hydro_byte * (i + 1)) % 256
            transformed.append(hydro_byte)
        
        return bytes(transformed)
    
