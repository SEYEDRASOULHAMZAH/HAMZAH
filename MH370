class WitnessAnalysis:
    """تحلیل شهادت شاهدان عینی"""
    
    def __init__(self):
        self.witnesses = {
            'Michael_McKay': {
                'location': 'Songa Mercur oil platform',
                'position': (5.3, 104.0, 0),  # درجه، حدود 150km شرق IGARI
                'reliability': 0.9,
                'description': 'dense orange luminosity in the sky',
                'time': '18:25 UTC',
                'duration': 'several minutes'
            },
            'Catherine_T': {
                'location': 'British merchant vessel',
                'position': (6.5, 103.5, 0),  # درجه، حدود 50km شمال غرب IGARI
                'reliability': 0.85,
                'description': 'intense orange glow, not like normal aircraft lights',
                'time': '18:25-18:27 UTC',
                'duration': '1-2 minutes'
            }
        }
    
    def calculate_visibility(self, event_position, witness_position, altitude_m):
        """محاسبه قابلیت مشاهده از موقعیت شاهد"""
        
        # فاصله افقی
        earth_radius = 6371000  # متر
        lat1, lon1 = np.radians(event_position[:2])
        lat2, lon2 = np.radians(witness_position[:2])
        
        # فاصله بزرگ‌دایره
        dlat = lat2 - lat1
        dlon = lon2 - lon1
        a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
        c = 2 * np.arctan2(np.sqrt(a), np.sqrt(1-a))
        distance_m = earth_radius * c
        
        # ارتفاع زاویه‌ای
        # خط افق برای ناظر در سطح دریا: d = 3.57 * sqrt(h) where h in meters, d in km
        horizon_distance_m = 3570 * np.sqrt(witness_position[2] if witness_position[2] > 0 else 1)
        
        # اگر رویداد بالاتر از افق باشد
        if distance_m < horizon_distance_m:
            elevation_angle = np.degrees(np.arctan2(altitude_m, distance_m))
            visible = elevation_angle > 0
        else:
            # فراتر از افق
            visible = False
            elevation_angle = 0
        
        # شدت نور قابل مشاهده (فرضی)
        # نور نارنجی (589nm) با شدت پلاسما
        visibility_score = 1 / (1 + (distance_m / 50000)**2)  # کاهش با مربع فاصله
        
        return {
            'distance_km': distance_m / 1000,
            'elevation_deg': elevation_angle,
            'visible': visible,
            'horizon_limit_km': horizon_distance_m / 1000,
            'visibility_score': visibility_score,
            'reliability_adjusted': visibility_score * self.witnesses[list(self.witnesses.keys())[0]]['reliability']
        }

