def calculate_detection_probability(distance_km, direction_deg, auv_params):
    """
    محاسبه احتمال تشخیص برای یک AUV در فاصله و جهت مشخص
    """
    # تبدیل جهت به رادیان
    direction_rad = np.radians(direction_deg)
    
    # موقعیت شروع AUV
    start_lat = actual_coords[0] + (distance_km / 111.32) * np.cos(direction_rad)
    start_lon = actual_coords[1] + (distance_km / (111.32 * np.cos(np.radians(actual_coords[0])))) * np.sin(direction_rad)
    
    # مسیر حرکت AUV (خط مستقیم به سمت مرکز)
    path_length_km = distance_km
    num_steps = int(path_length_km / 0.1)  # گام‌های 100 متری
    
    # شبیه‌سازی خطاها
    navigation_errors = np.random.normal(
        0, 
        monte_carlo_params['navigation_error_km'], 
        num_steps
    )
    
    current_errors = np.random.normal(
        0,
        monte_carlo_params['current_error_km'],
        num_steps
    )
    
    # شبیه‌سازی میدان پلاسما
    def plasma_field_strength(distance_to_center_km):
        """محاسبه قدرت میدان پلاسما"""
        if distance_to_center_km <= 0.1:  # 100 متری
            return {
                'electric': 10.0,
                'magnetic': 1e-4,
                'interference': 0.99
            }
        elif distance_to_center_km <= 0.5:  # 500 متری
            return {
                'electric': 1.0,
                'magnetic': 1e-5,
                'interference': 0.5
            }
        elif distance_to_center_km <= 1.0:  # 1 کیلومتر
            return {
                'electric': 0.1,
                'magnetic': 1e-6,
                'interference': 0.1
            }
        else:
            return {
                'electric': 0.01,
                'magnetic': 1e-7,
                'interference': 0.01
            }
    
    # شبیه‌سازی مسیر و تشخیص
    detection_events = []
    for step in range(num_steps):
        # موقعیت فعلی AUV
        fraction = step / num_steps
        current_lat = start_lat + fraction * (actual_coords[0] - start_lat)
        current_lon = start_lon + fraction * (actual_coords[1] - start_lon)
        
        # افزودن خطاها
        current_lat += navigation_errors[step] / 111.32
        current_lon += current_errors[step] / (111.32 * np.cos(np.radians(current_lat)))
        
        # فاصله تا مرکز پلاسما
        distance_to_center = haversine(
            current_lat, current_lon,
            actual_coords[0], actual_coords[1]
        )
        
        # محاسبه میدان پلاسما
        plasma_field = plasma_field_strength(distance_to_center)
        
        # محاسبه تداخل روی سونار
        sonar_interference = 1 - plasma_field['interference']
        
        # شبیه‌سازی عملکرد سونار
        sonar_range_effective = monte_carlo_params['sonar_range_km'] * sonar_interference
        
        # احتمال تشخیص در این نقطه
        if distance_to_center <= sonar_range_effective:
            # فاکتورهای تأثیرگذار
            detection_factors = [
                monte_carlo_params['sonar_accuracy'],  # دقت سونار
                1 - (distance_to_center / sonar_range_effective),  # فاصله معکوس
                1 - plasma_field['interference'] * 0.5,  # تداخل پلاسما
                np.exp(-distance_to_center)  # تضعیف نمایی
            ]
            
            detection_prob = np.mean(detection_factors)
            detection_events.append(detection_prob)
    
    # احتمال تشخیص در طول مسیر
    if detection_events:
        max_detection_prob = max(detection_events)
        # میانگین وزنی با توجه به نقاط نزدیک‌تر
        return max_detection_prob
    else:
        return 0.0

def simulate_auv_group(distance_km, direction_deg):
    """
    شبیه‌سازی گروه 10 تایی AUV
    """
    detection_probs = []
    failure_probs = []
    
    for auv_id in range(monte_carlo_params['num_auv']):
        # پارامترهای هر AUV
        auv_params = {
            'id': auv_id,
            'sonar_type': 'Multibeam' if auv_id % 2 == 0 else 'Side-scan',
            'frequency_khz': np.random.choice([100, 300, 900]),
            'power_w': np.random.uniform(1000, 10000),
            'vulnerability': np.random.beta(2, 5)  # توزیع بتا برای آسیب‌پذیری
        }
        
        # احتمال تشخیص
        det_prob = calculate_detection_probability(distance_km, direction_deg, auv_params)
        detection_probs.append(det_prob)
        
        # احتمال خرابی (با توجه به میدان پلاسما)
        # میدان در نزدیکی مرکز قوی‌تر است
        field_strength_factor = min(1.0, 0.5 / max(distance_km, 0.1))
        failure_prob = min(0.99, auv_params['vulnerability'] * field_strength_factor)
        failure_probs.append(failure_prob)
    
    # محاسبات گروهی
    group_detection_prob = 1 - np.prod([1 - p for p in detection_probs])
    group_failure_prob = 1 - np.prod([1 - p for p in failure_probs])
    
    return {
        'distance_km': distance_km,
        'direction_deg': direction_deg,
        'individual_probs': detection_probs,
        'group_detection_prob': group_detection_prob,
        'group_failure_prob': group_failure_prob,
        'expected_detections': sum(detection_probs),
        'expected_failures': sum(failure_probs),
        'success_rate': group_detection_prob * (1 - group_failure_prob)
    }
