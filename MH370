            avg_failure = np.mean([r['group_failure_prob'] for r in group_results])
            avg_success = np.mean([r['success_rate'] for r in group_results])
            
            # محاسبه فاصله واقعی
            lat_offset = (distance / 111.32) * np.cos(np.radians(direction))
            lon_offset = (distance / (111.32 * np.cos(np.radians(actual_coords[0])))) * np.sin(np.radians(direction))
            
            end_lat = actual_coords[0] + lat_offset
            end_lon = actual_coords[1] + lon_offset
            
            actual_distance = haversine(
                end_lat, end_lon,
                actual_coords[0], actual_coords[1]
            )
            
            # ذخیره نتایج
            all_results.append({
                'distance_km': distance,
                'direction_deg': direction,
                'start_lat': end_lat,
                'start_lon': end_lon,
                'actual_distance_km': actual_distance,
                'detection_probability': avg_detection,
                'failure_probability': avg_failure,
                'success_probability': avg_success,
                'risk_level': 'بسیار بالا' if avg_failure > 0.7 else 
                             'بالا' if avg_failure > 0.4 else
                             'متوسط' if avg_failure > 0.2 else
                             'پایین',
                'recommendation': 'اجتناب' if avg_failure > 0.5 else 
                                'با احتیاط' if avg_failure > 0.2 else
                                'امن'
            })
            
            # نمایش پیشرفت
            completed += 1
            if completed % 25 == 0:
                print(f"پیشرفت: {completed}/{total_scenarios} سناریو ({completed/total_scenarios*100:.1f}%)")
    
    print("✅ شبیه‌سازی مونت‌کارلو کامل شد!")
    return pd.DataFrame(all_results)

