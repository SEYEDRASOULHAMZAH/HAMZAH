def calculate_lithium_plasma_properties():
    """محاسبات خواص پلاسمای لیتیوم"""
    
    # ثابت‌های فیزیکی
    m_e = constants.m_e  # جرم الکترون
    e = constants.e  # بار الکترون
    epsilon_0 = constants.epsilon_0  # گذردهی خلأ
    
    # پارامترهای لیتیوم
    n_e = 1e28  # چگالی الکترون (تخمینی) - الکترون/متر³
    m_ion = 1.15e-26  # جرم یون لیتیوم (kg)
    
    # فرکانس پلاسمای الکترون
    omega_pe = np.sqrt(n_e * e**2 / (m_e * epsilon_0))
    
    # فرکانس پلاسمای یون لیتیوم
    omega_pi = np.sqrt(n_e * e**2 / (m_ion * epsilon_0))
    
    # طول موج پلاسما
    lambda_p = 2 * np.pi * constants.c / omega_pe
    
    # عمق پوستی (skin depth)
    sigma = 1e7  # رسانایی پلاسما (تخمینی) - Siemens/m
    delta = np.sqrt(2 / (constants.mu_0 * omega_pe * sigma))
    
    return {
        'electron_plasma_frequency_hz': omega_pe,
        'ion_plasma_frequency_hz': omega_pi,
        'plasma_wavelength_m': lambda_p,
        'skin_depth_m': delta,
        'electron_density_m3': n_e
    }

