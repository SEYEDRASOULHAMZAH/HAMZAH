def calculate_fields_at_distance(distance_m):
    """محاسبات میدان‌ها در فاصله مشخص"""
    
    # پارامترهای پلاسما
    P = worst_case_scenario['plasma_parameters']
    
    # 1. میدان الکتریکی (بر اساس قانون عکس مجذور فاصله)
    E0 = P['electric_field_10m']  # V/m در 10 متر
    E_field = E0 * (10 / distance_m)**2
    
    # 2. میدان مغناطیسی
    B0 = P['magnetic_field_10m']  # T در 10 متر
    B_field = B0 * (10 / distance_m)**2
    
    # 3. گرادیان فشار
    PG0 = P['pressure_gradient']  # Pa/m در 10 متر
    P_gradient = PG0 * (10 / distance_m)
    
    # 4. چگالی انرژی الکترومغناطیسی
    energy_density = 0.5 * (
        constants.epsilon_0 * E_field**2 + 
        (B_field**2) / constants.mu_0
    )
    
    # 5. توان دریافتی توسط آنتن‌ها
    # فرض: آنتن 1 متری با بهره 0 dB
    antenna_area = 1.0  # m²
    received_power = energy_density * constants.c * antenna_area
    
    # 6. القای ولتاژ در حلقه‌ها
    # فرض: حلقه 1 متر مربعی
    loop_area = 1.0  # m²
    frequency = P['plasma_frequency']
    induced_voltage = 2 * np.pi * frequency * B_field * loop_area
    
    # 7. جریان القایی در کابل‌ها
    # مقاومت کابل: 0.1 اهم/متر
    cable_resistance = 0.1  # Ω/m
    cable_length = 100  # متر
    induced_current = induced_voltage / (cable_resistance * cable_length)
    
    # 8. نیروی لورنتس روی کابل‌ها
    lorentz_force = induced_current * B_field * cable_length
    
    # 9. گرمایش القایی
    # مقاومت ویژه مس: 1.68e-8 Ω·m
    copper_resistivity = 1.68e-8
    cable_cross_section = 1e-4  # m² (10 mm²)
    heating_power = induced_current**2 * (
        copper_resistivity * cable_length / cable_cross_section
    )
    
    # 10. تنش مکانیکی روی سازه
    # فشار دینامیکی ناشی از میدان
    dynamic_pressure = 0.5 * constants.mu_0 * B_field**2
    
    return {
        'distance_m': distance_m,
        'electric_field_v_per_m': E_field,
        'magnetic_field_t': B_field,
        'pressure_gradient_pa_per_m': P_gradient,
        'energy_density_j_per_m3': energy_density,
        'received_power_w': received_power,
        'induced_voltage_v': induced_voltage,
        'induced_current_a': induced_current,
        'lorentz_force_n': lorentz_force,
        'heating_power_w': heating_power,
        'dynamic_pressure_pa': dynamic_pressure,
        'plasma_frequency_hz': frequency
    }

def simulate_time_to_failure(field_data, distance_m):
    """شبیه‌سازی زمانی تا خرابی کامل"""
    
    # معادلات تخریب تجهیزات
    # مدل آرنیوس (Arrhenius) برای خرابی الکترونیکی
    def arrhenius_model(E_field, time_hours):
        # انرژی فعال‌سازی برای خرابی: 0.5-1.0 eV
        Ea = 0.8 * constants.e  # J
        k = 1.38e-23  # ثابت بولتزمن
        
        # دمای مؤثر با گرمایش القایی
        base_temp = 275.15  # K (2°C)
        heating = field_data['heating_power'] * time_hours * 3600 / (500 * 4186)  # °C
        effective_temp = base_temp + heating
        
        # نرخ خرابی
        failure_rate = np.exp(-Ea / (k * effective_temp)) * (E_field / 1.0)**2
        
        # احتمال خرابی در زمان t
        P_failure = 1 - np.exp(-failure_rate * time_hours)
        
        return P_failure, effective_temp - 273.15
    
    # محاسبه برای بازه‌های زمانی مختلف
    time_points = np.linspace(0.1, 24, 100)  # 0.1 تا 24 ساعت
    results = []
    
    for t in time_points:
        P_fail, temp = arrhenius_model(field_data['electric_field_v_per_m'], t)
        
        # زمان‌بندی خرابی‌های مختلف
        failure_timeline = {
            'حساس‌ترین سیستم‌ها (مگنتومتر)': max(0.1, 0.5 / field_data['electric_field_v_per_m']),
            'سیستم ارتباطی': max(0.5, 2.0 / field_data['electric_field_v_per_m']),
            'سیستم ناوبری': max(1.0, 5.0 / field_data['electric_field_v_per_m']),
            'سیستم‌های قدرت': max(2.0, 10.0 / field_data['electric_field_v_per_m']),
            'ساختار مکانیکی': max(5.0, 20.0 / field_data['pressure_gradient_pa_per_m'] * 1e6)
        }
        
        # شمارش سیستم‌های خراب در زمان t
        failed_count = sum(1 for ft in failure_timeline.values() if ft <= t)
        
        results.append({
            'time_hours': t,
            'failure_probability': P_fail,
            'temperature_c': temp,
            'failed_systems': failed_count,
            'operational_status': 'عادی' if failed_count == 0 else 
                                 'محدود' if failed_count <= 2 else
                                 'بحرانی' if failed_count <= 4 else
                                 'غیرعملیاتی'
        })
    
    return results
