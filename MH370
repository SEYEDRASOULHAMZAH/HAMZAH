                    for l in range(dim):
                        dg_jl = np.gradient(g[j, l])[i] if i < len(np.gradient(g[j, l])) else 0
                        dg_il = np.gradient(g[i, l])[j] if j < len(np.gradient(g[i, l])) else 0
