class IGARIMoment:
    """شبیه‌سازی لحظه‌به‌لحظه نقطه IGARI"""
    
    def __init__(self):
        # زمان دقیق
        self.event_time = datetime(2014, 3, 8, 18, 25, 0)  # 18:25 UTC
        
        # موقعیت جغرافیایی
        self.latitude = 6.921111  # درجه شمالی
        self.longitude = 103.915278  # درجه شرقی
        self.altitude_ft = 35000  # پا
        self.altitude_m = 10668  # متر
        
        # پارامترهای پرواز
        self.true_airspeed_kts = 471  # گره
        self.true_airspeed_mps = 242.3  # متر بر ثانیه
        self.heading = 40  # درجه (شمال شرقی)
        self.mach = 0.84  # عدد ماخ
        
        # مشخصات بوئینگ 777-200ER
        self.wingspan_m = 60.9  # متر
        self.length_m = 63.7  # متر
        self.height_m = 18.5  # متر
        self.mass_kg = 242670  # کیلوگرم (حداکثر وزن برخاست)
        self.fuel_kg = 49100  # کیلوگرم سوخت باقیمانده
        
        # پارامترهای محیطی
        self.temp_c = -56.5  # درجه سانتی‌گراد در 35000 پا
        self.pressure_pa = 23842  # پاسکال
        self.density_kg_m3 = 0.41  # چگالی هوا
        
        # پارامترهای باتری لیتیوم
        self.lithium_mass_kg = 221  # کیلوگرم
        self.lithium_cells = 4500  # تعداد سلول (تخمین)
        self.battery_voltage = 3.7  # ولت هر سلول
        self.total_energy_j = 221 * 150 * 3600  # ژول
        
        # پارامترهای رادار نظامی
        self.radar_frequencies = {
            'Thai_Military': {'freq_hz': 2.8e9, 'power_w': 1e6, 'range_km': 400},  # S-band
            'Malaysian_Military': {'freq_hz': 1.3e9, 'power_w': 5e5, 'range_km': 300},  # L-band
            'Indonesian_Military': {'freq_hz': 5.6e9, 'power_w': 8e5, 'range_km': 250}  # C-band
        }
        
    def calculate_plasma_formation(self, radar_power):
        """محاسبه تشکیل پلاسما از برهم‌کنش رادار با باتری لیتیوم"""
        
        # چگالی انرژی رادار در هواپیما
        radar_power_density = radar_power / (4 * np.pi * (100e3)**2)  # W/m² در فاصله 100km
        
        # انرژی دریافتی توسط باتری‌ها
        battery_cross_section = 10  # m² (تخمین سطح مؤثر)
        received_power = radar_power_density * battery_cross_section
        
        # گرمایش باتری‌ها
        specific_heat_li = 3.58e3  # J/(kg·K) برای لیتیوم
        temperature_increase = received_power * 120 / (self.lithium_mass_kg * specific_heat_li)  # در 120 ثانیه
        
        # آستانه runaway حرارتی برای باتری لیتیوم
        thermal_runaway_threshold = 80  # درجه سانتی‌گراد
        
        # احتمال تشکیل پلاسما
        plasma_probability = min(1.0, temperature_increase / thermal_runaway_threshold)
        
        return {
            'radar_power_density_w_m2': radar_power_density,
            'received_power_w': received_power,
            'temperature_increase_c': temperature_increase,
            'thermal_runaway': temperature_increase > thermal_runaway_threshold,
            'plasma_probability': plasma_probability,
            'time_to_plasma_s': thermal_runaway_threshold / (temperature_increase/120) if temperature_increase > 0 else float('inf')
        }
    
    def simulate_aircraft_dynamics(self, start_time, end_time, dt=0.1):
        """شبیه‌سازی دینامیک هواپیما در بازه زمانی"""
        
        time_steps = int((end_time - start_time).total_seconds() / dt)
        time_array = np.linspace(0, (end_time - start_time).total_seconds(), time_steps)
        
        # شرایط اولیه
        x = np.zeros(time_steps)  # موقعیت شرقی (متر)
        y = np.zeros(time_steps)  # موقعیت شمالی (متر)
        z = np.full(time_steps, self.altitude_m)  # ارتفاع (متر)
        
        v = np.full(time_steps, self.true_airspeed_mps)  # سرعت (m/s)
        heading = np.full(time_steps, self.heading)  # سمت (درجه)
        roll = np.zeros(time_steps)  # غلت (درجه)
        pitch = np.zeros(time_steps)  # گام (درجه)
        
        # در لحظه IGARI: پیچ ناگهانی به چپ
        turn_start_idx = int(30 / dt)  # 30 ثانیه پس از شروع
        turn_duration_idx = int(120 / dt)  # 120 ثانیه مدت پیچ
        
        for i in range(turn_start_idx, min(turn_start_idx + turn_duration_idx, time_steps)):
            heading[i] = heading[i-1] - 0.5  # پیچ 0.5 درجه بر ثانیه
            roll[i] = 25 * np.sin(2 * np.pi * (i - turn_start_idx) / turn_duration_idx)
        
        # محاسبه مسیر
        heading_rad = np.radians(heading)
        for i in range(1, time_steps):
            x[i] = x[i-1] + v[i] * dt * np.sin(heading_rad[i])
            y[i] = y[i-1] + v[i] * dt * np.cos(heading_rad[i])
            
            # نوسانات ارتفاعی بر اساس مدل حمزه
            if i > 180:  # 18 ثانیه پس از شروع پیچ
                z[i] = self.altitude_m + 4572 * np.sin(2 * np.pi * (i-180)/600)  # نوسان 4572 متری
        
        return {
            'time_s': time_array,
            'x_m': x,
            'y_m': y,
            'z_m': z,
            'velocity_mps': v,
            'heading_deg': heading,
            'roll_deg': roll,
            'pitch_deg': pitch,
            'dt': dt
        }

