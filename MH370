        """کالیبراسیون یک دستگاه خاص"""
        if device_id not in self.calibration_matrix:
            return {'error': f'دستگاه با شناسه {device_id} یافت نشد.'}
        
        device_info = self.calibration_matrix[device_id]
        calibration_func = device_info['calibration_function']
        
        # اجرای کالیبراسیون
        if calibration_func == self.calibrate_generic:
            calibration_result = calibration_func(current_value, device_id)
        else:
            calibration_result = calibration_func(current_value)
        
        # ذخیره نتایج
        self.calibrated_devices[device_id] = calibration_result
        self.calibration_status[device_id] = 'CALIBRATED'
        
        return calibration_result
    
    def calibrate_all_devices(self, current_values: Dict[int, Any] = None) -> Dict:
        """کالیبراسیون تمام ۵۰ دستگاه"""
        logger.info("شروع کالیبراسیون کامل ۵۰ دستگاه...")
        
        results = {}
        
        for device_id in range(1, 51):
            current_value = current_values.get(device_id, None) if current_values else None
            logger.info(f"کالیبراسیون دستگاه {device_id}: {self.calibration_matrix[device_id]['apparatus']}")
            
            result = self.calibrate_device(device_id, current_value)
            results[device_id] = result
        
        # تحلیل نتایج
        calibrated_count = len([r for r in results.values() if 'error' not in r])
        
        calibration_summary = {
            'total_devices': 50,
            'calibrated_devices': calibrated_count,
            'calibration_percentage': (calibrated_count / 50) * 100,
            'timestamp': datetime.datetime.now().isoformat(),
            'results': results
        }
        
        logger.info(f"کالیبراسیون کامل شد: {calibrated_count}/50 دستگاه کالیبره شدند.")
        
        return calibration_summary
    
    def generate_calibration_report(self) -> str:
        """تولید گزارش کالیبراسیون"""
        report_lines = []
        report_lines.append("=" * 100)
        report_lines.append("گزارش کالیبراسیون ناوگان جستجوی MH370")
        report_lines.append(f"تاریخ تولید: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        report_lines.append("=" * 100)
        report_lines.append("")
        
        for device_id in range(1, 51):
            device_info = self.calibration_matrix[device_id]
            status = self.calibration_status.get(device_id, 'NOT_CALIBRATED')
            
            report_lines.append(f"دستگاه #{device_id}:")
            report_lines.append(f"  وسیله نقلیه: {device_info['vessel']}")
            report_lines.append(f"  دستگاه: {device_info['apparatus']}")
            report_lines.append(f"  پیکربندی استاندارد: {device_info['standard_config']}")
            report_lines.append(f"  پیکربندی حمزه: {device_info['hamzah_config']}")
            report_lines.append(f"  منطق مهندسی: {device_info['engineering_rationale']}")
            report_lines.append(f"  وضعیت کالیبراسیون: {status}")
            
            if device_id in self.calibrated_devices:
                cal_data = self.calibrated_devices[device_id]
                report_lines.append(f"  مقدار فعلی: {cal_data.get('current_value', 'N/A')}")
                report_lines.append(f"  مقدار هدف: {cal_data.get('target_value', cal_data.get('hamzah_config', 'N/A'))}")
            
            report_lines.append("")
        
        # خلاصه
        calibrated = len([s for s in self.calibration_status.values() if s == 'CALIBRATED'])
        report_lines.append("=" * 100)
        report_lines.append(f"خلاصه: {calibrated}/50 دستگاه کالیبره شده‌اند ({calibrated/50*100:.1f}%)")
        report_lines.append("=" * 100)
        
        return "\n".join(report_lines)

# ==================== ADVANCED SEARCH ALGORITHM ====================
class AdvancedSearchAlgorithm:
    """الگوریتم جستجوی پیشرفته با کالیبراسیون حمزه"""
    
    def __init__(self):
        self.constants = HamzahConstants()
        self.calibration_system = SearchFleetCalibration()
        self.search_grid = None
        self.probability_map = None
        self.detection_history = []
        
    def create_search_grid(self) -> np.ndarray:
        """ایجاد شبکه جستجوی سه‌بعدی حول مختصات هدف"""
        lat_range = 0.1  # ۰٫۱ درجه ≈ ۱۱ کیلومتر
        lon_range = 0.1  # ۰٫۱ درجه ≈ ۱۱ کیلومتر
        depth_range = 100  # ۱۰۰ متر
        
        # ایجاد شبکه
        lat_points = np.linspace(
            self.constants.LAT_TARGET - lat_range,
            self.constants.LAT_TARGET + lat_range,
            1000
        )
        
        lon_points = np.linspace(
            self.constants.LON_TARGET - lon_range,
            self.constants.LON_TARGET + lon_range,
            1000
        )
        
        depth_points = np.linspace(
            self.constants.DEPTH_TARGET - depth_range,
            self.constants.DEPTH_TARGET + depth_range,
            100
        )
        
        # شبکه سه‌بعدی
        grid = np.meshgrid(lat_points, lon_points, depth_points, indexing='ij')
        self.search_grid = grid
        
        return grid
    
    def calculate_probability_map(self) -> np.ndarray:
        """محاسبه نقشه احتمال حضور هواپیما"""
        if self.search_grid is None:
            self.create_search_grid()
        
        lat_grid, lon_grid, depth_grid = self.search_grid
        
        # محاسبه فاصله از مرکز هدف
        lat_diff = lat_grid - self.constants.LAT_TARGET
        lon_diff = lon_grid - self.constants.LON_TARGET
        depth_diff = depth_grid - self.constants.DEPTH_TARGET
        
        # فاصله سه‌بعدی
        distance_3d = np.sqrt(
            (lat_diff * 111320)**2 +  # تبدیل درجه به متر
            (lon_diff * 111320 * np.cos(np.radians(self.constants.LAT_TARGET)))**2 +
            depth_diff**2
        )
        
        # توزیع گاوسی حول هدف
        sigma = 165.0  # انحراف معیار ۱۶۵ متر
        probability = np.exp(-0.5 * (distance_3d / sigma)**2)
        
        # اعمال تانسور ۱۶۵-بعدی
        tensor_factor = self.calculate_tensor_factor(distance_3d)
        probability *= tensor_factor
        
        self.probability_map = probability
        
        return probability
    
    def calculate_tensor_factor(self, distance: np.ndarray) -> np.ndarray:
        """محاسبه فاکتور تانسوری ۱۶۵-بعدی"""
        omega = self.constants.OMEGA_H_STAR
        factor = 1.0 / (1.0 + np.exp(-distance / 165.0))
        factor *= np.sin(2 * np.pi * omega * distance / 165000.0)**2
        return factor
    
    def simulate_search_operation(self, num_iterations: int = 1000) -> Dict:
        """شبیه‌سازی عملیات جستجو"""
        logger.info(f"شروع شبیه‌سازی عملیات جستجو با {num_iterations} تکرار...")
        
        search_results = []
        
        for i in range(num_iterations):
            # موقعیت‌های تصادفی در شبکه
            if self.probability_map is None:
                self.calculate_probability_map()
            
            # انتخاب نقطه تصادفی بر اساس توزیع احتمال
            flat_prob = self.probability_map.flatten()
            flat_prob /= flat_prob.sum()
            
            random_idx = np.random.choice(len(flat_prob), p=flat_prob)
            idx_3d = np.unravel_index(random_idx, self.probability_map.shape)
            
            lat = self.search_grid[0][idx_3d]
            lon = self.search_grid[1][idx_3d]
            depth = self.search_grid[2][idx_3d]
            
            # محاسبه فاصله از هدف
            distance_to_target = self.calculate_distance_to_target(lat, lon, depth)
            
            # محاسبه احتمال تشخیص
            detection_prob = self.calculate_detection_probability(distance_to_target)
            
            # شبیه‌سازی تشخیص
            detected = np.random.random() < detection_prob
            
            result = {
                'iteration': i + 1,
                'latitude': lat,
                'longitude': lon,
                'depth': depth,
                'distance_to_target': distance_to_target,
                'detection_probability': detection_prob,
                'detected': detected
            }
            
            search_results.append(result)
            
            if detected:
                logger.info(f"تکرار {i+1}: هواپیما در فاصله {distance_to_target:.1f} متری تشخیص داده شد!")
                break
        
        # تحلیل نتایج
        detected_iterations = [r['iteration'] for r in search_results if r['detected']]
        detection_rate = len(detected_iterations) / num_iterations if search_results else 0
        
        simulation_summary = {
            'total_iterations': num_iterations,
            'detected_iterations': detected_iterations,
            'detection_rate': detection_rate,
            'average_detection_probability': np.mean([r['detection_probability'] for r in search_results]),
            'min_distance_achieved': min([r['distance_to_target'] for r in search_results]) if search_results else float('inf'),
            'search_results': search_results[:100]  # فقط ۱۰۰ نتیجه اول
        }
        
        logger.info(f"شبیه‌سازی کامل شد. نرخ تشخیص: {detection_rate*100:.2f}%")
        
        return simulation_summary
    
    def calculate_distance_to_target(self, lat: float, lon: float, depth: float) -> float:
        """محاسبه فاصله سه‌بعدی از هدف"""
        # فاصله افقی
        lat_diff = (lat - self.constants.LAT_TARGET) * 111320  # متر
        lon_diff = (lon - self.constants.LON_TARGET) * 111320 * np.cos(np.radians(self.constants.LAT_TARGET))
        
        horizontal_distance = np.sqrt(lat_diff**2 + lon_diff**2)
        
        # فاصله عمودی
        vertical_distance = abs(depth - self.constants.DEPTH_TARGET)
        
        # فاصله سه‌بعدی
        distance_3d = np.sqrt(horizontal_distance**2 + vertical_distance**2)
        
        return distance_3d
    
    def calculate_detection_probability(self, distance: float) -> float:
        """محاسبه احتمال تشخیص بر اساس فاصله"""
        if distance <= 165.0:  # داخل شعاع بحرانی
            return 1.0
        elif distance <= 1000.0:  # نزدیک
            return 0.9 * np.exp(-distance / 1000.0)
        else:  # دور
            return 0.1 * np.exp(-distance / 10000.0)
    
