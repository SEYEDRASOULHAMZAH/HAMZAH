def monte_carlo_simulation(num_simulations=1000):
    """شبیه‌سازی مونت کارلو حوادث"""
    
    results = {
        'خرابی کامل تجهیزات': 0,
        'آتش‌سوزی/انفجار الکتریکی': 0,
        'پارگی سازه/کابل': 0,
        'از دست دادن کنترل': 0,
        'غرق‌شدگی': 0,
        'نجات موفق': 0
    }
    
    # پارامترهای احتمالاتی
    params = {
        'E_field_variation': 0.3,      # ±30% تغییرات میدان
        'equipment_tolerance': 0.2,    # ±20% تحمل تجهیزات
        'human_response_time': [10, 60],  # زمان پاسخ انسانی (ثانیه)
        'safety_systems': 0.7          # احتمال عملکرد سیستم‌های ایمنی
    }
    
    for sim in range(num_simulations):
        # تولید مقادیر تصادفی
        E_actual = field_data_10m['electric_field_v_per_m'] * \
                   np.random.uniform(1 - params['E_field_variation'], 
                                     1 + params['E_field_variation'])
        
        B_actual = field_data_10m['magnetic_field_t'] * \
                   np.random.uniform(1 - params['E_field_variation'], 
                                     1 + params['E_field_variation'])
        
        # شبیه‌سازی خرابی‌ها
        failures = []
        
        # احتمال خرابی کامل
        P_complete_failure = min(1.0, E_actual / 5.0)  # متناسب با میدان
        
        if np.random.random() < P_complete_failure:
            results['خرابی کامل تجهیزات'] += 1
            failures.append('خرابی کامل')
        
        # احتمال آتش‌سوزی (با جریان القایی)
        P_fire = min(1.0, field_data_10m['induced_current'] / 50)
        if np.random.random() < P_fire:
            results['آتش‌سوزی/انفجار الکتریکی'] += 1
            failures.append('آتش‌سوزی')
        
        # احتمال پارگی (با نیروی لورنتس)
        P_rupture = min(1.0, field_data_10m['lorentz_force'] / 10000)
        if np.random.random() < P_rupture:
            results['پارگی سازه/کابل'] += 1
            failures.append('پارگی')
        
        # احتمال از دست دادن کنترل
        P_control_loss = min(1.0, E_actual / 3.0)
        if np.random.random() < P_control_loss:
            results['از دست دادن کنترل'] += 1
            failures.append('کنترل')
        
        # احتمال غرق‌شدگی (اگر چند خرابی اتفاق بیفتد)
        if len(failures) >= 3 and np.random.random() < 0.8:
            results['غرق‌شدگی'] += 1
        
        # احتمال نجات (اگر خرابی‌ها محدود باشد)
        if len(failures) <= 1 and np.random.random() < params['safety_systems']:
            results['نجات موفق'] += 1
    
    # تبدیل به درصد
    for key in results:
        results[key] = (results[key] / num_simulations) * 100
    
    return results

