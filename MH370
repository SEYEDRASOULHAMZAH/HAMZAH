# محاسبه احتمال‌ها
def calculate_statistical_significance():
    """محاسبه معنی‌داری آماری"""
    
    # پارامترهای منطقه
    search_area_km2 = 120000
    anomaly_area_km2 = 0.01  # 100m × 100m
    
    # احتمال قرارگیری تصادفی یک حادثه
    p_single = anomaly_area_km2 / search_area_km2
    
    # تعداد حوادث
    n_incidents = 4
    
    # احتمال تصادفی بودن همه حوادث
    p_all_random = p_single ** (n_incidents - 1)
    
    # احتمال در سناریوی سقوط
    p_crash = total_probability
    
    # نسبت احتمال (Bayes Factor)
    bayes_factor = p_crash / p_all_random if p_all_random > 0 else float('inf')
    
    # محاسبه احتمال پسین (با فرض احتمال پیشین 50-50)
    prior = 0.5
    likelihood_ratio = p_crash / (1 - p_crash) if p_crash < 1 else float('inf')
    posterior = (likelihood_ratio * prior) / (1 + likelihood_ratio * prior)
    
    return {
        'p_single_incident': p_single,
        'p_all_random': p_all_random,
        'p_crash_scenario': p_crash,
        'bayes_factor': bayes_factor,
        'posterior_probability': posterior,
        'odds_ratio': p_crash / p_all_random if p_all_random > 0 else float('inf')
    }

stats = calculate_statistical_significance()

print(f"\n🔢 **آمارهای کلیدی:**")
