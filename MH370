        # محاسبه پاسخ سازه
        frequency_ratio = natural_frequency / 1.0  # نسبت به فرکانس غالب
        dynamic_amplification = 1 / np.sqrt((1 - frequency_ratio**2)**2 + (2 * damping_ratio * frequency_ratio)**2)
        
        # شتاب واقعی وارد بر سازه
        actual_acceleration = ground_acceleration * dynamic_amplification
        
        # نیروی اینرسی
