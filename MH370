class StructuralDisintegration:
    """تحلیل گسستگی ساختاری در لحظه IGARI"""
    
    def __init__(self):
        # پارامترهای مواد
        self.aluminum_yield_strength = 276e6  # Pa (آلومینیوم 7075-T6)
        self.composite_yield_strength = 600e6  # Pa (کامپوزیت‌های ساختاری)
        self.fatigue_limit = 0.3  # نسبت به استحکام تسلیم
        
        # مکان‌های بحرانی
        self.critical_locations = {
            'right_flaperon': {'location': (30, 5, -2), 'material': 'composite', 'stress_factor': 1.2},
            'left_flaperon': {'location': (-30, 5, -2), 'material': 'composite', 'stress_factor': 1.0},
            'r1_panel': {'location': (15, 10, 0), 'material': 'aluminum', 'stress_factor': 0.8},
            'wing_root': {'location': (0, 15, 0), 'material': 'aluminum', 'stress_factor': 1.5}
        }
    
    def calculate_stress_distribution(self, aircraft_dynamics, tunnel_field, time_idx):
        """محاسبه توزیع تنش روی هواپیما"""
        
        # تنش‌های آیرودینامیکی
        dynamic_pressure = 0.5 * 0.41 * aircraft_dynamics['velocity_mps'][time_idx]**2  # Pa
        roll_stress = dynamic_pressure * np.sin(np.radians(aircraft_dynamics['roll_deg'][time_idx]))
        
        # تنش‌های تانسوری
        tensorial_stress = tunnel_field[time_idx]['field_strength'] * 1e6  # Pa (تخمین)
        
        # تنش گریز از مرکز
        turn_rate_rad_s = np.radians(np.gradient(aircraft_dynamics['heading_deg'][:time_idx+1]))
        centrifugal_stress = aircraft_dynamics['velocity_mps'][time_idx] * np.abs(turn_rate_rad_s[-1]) * 242670  # N
        
        # محاسبه تنش در نقاط بحرانی
        stress_distribution = {}
        for name, loc_data in self.critical_locations.items():
            # تنش پایه
            base_stress = dynamic_pressure * loc_data['stress_factor'] * 0.01  # 1% فشار دینامیکی
            
            # تنش تانسوری (بستگی به موقعیت دارد)
            position_factor = 1 + 0.1 * loc_data['location'][0]  # ضریب موقعیت
            
            # تنش گریز از مرکز (بیشتر در نوک بال)
            centrifugal_factor = 1 + 0.05 * abs(loc_data['location'][0])
            
            # تنش کل
            total_stress = (base_stress + 
                          tensorial_stress * position_factor + 
                          centrifugal_stress * centrifugal_factor * 1e-6)
            
            # حد استحکام
            yield_strength = (self.composite_yield_strength if loc_data['material'] == 'composite' 
                            else self.aluminum_yield_strength)
            
            # فاکتور ایمنی
            safety_factor = yield_strength / total_stress if total_stress > 0 else float('inf')
            
            # احتمال شکست
            failure_probability = 1 / (1 + np.exp(10 * (safety_factor - 1)))
            
            stress_distribution[name] = {
                'total_stress_pa': total_stress,
                'yield_strength_pa': yield_strength,
                'safety_factor': safety_factor,
                'failure_probability': failure_probability,
                'critical': safety_factor < 1.5
            }
        
        return stress_distribution

