def calculate_spectral_match():
    """محاسبه تطابق طیفی پیکسل زرد با عناصر مختلف"""
    
    measured_wavelength = 589  # نانومتر
    
    # خطوط نشری عناصر (نانومتر)
    element_lines = {
        'Lithium (Li⁺)': [589.592, 670.791],
        'Sodium (Na)': [589.0, 589.6],
        'Copper (Cu)': [510.5, 521.8],
        'Aluminium (Al)': [396.1, 394.4],
        'Natural minerals': [450, 550, 650]  # سولفیدها، اکسیدها
    }
    
    # محاسبه خطا
    spectral_matches = {}
    for element, lines in element_lines.items():
        min_error = min([abs(line - measured_wavelength) for line in lines])
        match_percentage = 100 * (1 - min_error/measured_wavelength)
        spectral_matches[element] = {
            'error_nm': min_error,
            'match_percentage': match_percentage,
            'plausibility': 'High' if match_percentage > 99 else 'Medium' if match_percentage > 95 else 'Low'
        }
    
    return spectral_matches

