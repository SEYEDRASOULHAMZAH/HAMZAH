    def generate_pressure_data(self, scenario='apocalypse'):
        """تولید داده‌های فشار Real-Time"""
        pressure = self.constants.extreme_pressures[scenario]
        
        # اضافه کردن نویز و نوسانات
        time_points = np.arange(0, 10, 1/self.sampling_rate)  # 10 ثانیه
        base_pressure = pressure * np.ones_like(time_points)
        
        # نویز تصادفی
        noise = np.random.normal(0, pressure * 0.01, len(time_points))
        
        # نوسانات دوره‌ای
        oscillation = pressure * 0.05 * np.sin(2 * np.pi * 1.0 * time_points)
        
        # پالس‌های تصادفی
        pulses = np.zeros_like(time_points)
        pulse_indices = np.random.choice(len(time_points), 10, replace=False)
        pulses[pulse_indices] = pressure * 0.1
        
        combined = base_pressure + noise + oscillation + pulses
        
        return {
            'time': time_points,
            'pressure': combined,
            'mean': np.mean(combined),
            'std': np.std(combined),
            'max': np.max(combined),
            'min': np.min(combined)
        }
    
    def generate_temperature_data(self, scenario='hot_vent'):
        """تولید داده‌های دما Real-Time"""
        temperature = self.constants.extreme_temperatures[scenario]
        
        time_points = np.arange(0, 10, 1/self.sampling_rate)
        
        # گرادیان دمایی
        if scenario == 'hot_vent':
            # گرادیان شدید دمایی
            gradient = np.linspace(273.15, temperature, len(time_points))
            noise = np.random.normal(0, 10, len(time_points))
            data = gradient + noise
        else:
            data = temperature * np.ones_like(time_points)
            noise = np.random.normal(0, 0.1, len(time_points))
            data += noise
        
        return {
            'time': time_points,
            'temperature': data,
            'gradient': np.gradient(data),
            'mean': np.mean(data),
            'std': np.std(data)
        }
    
    def generate_current_data(self, scenario='tsunami'):
        """تولید داده‌های جریان Real-Time"""
        velocity = self.constants.extreme_currents[scenario]
        
        time_points = np.arange(0, 10, 1/self.sampling_rate)
        
        # مدل جریان آشفته
        base_flow = velocity * np.ones_like(time_points)
        
        # نوسانات توربولانس
        turbulence = np.random.normal(0, velocity * 0.3, len(time_points))
        
        # گردابه‌های بزرگ
        vortices = velocity * 0.5 * np.sin(2 * np.pi * 0.1 * time_points)
        
        # جریان برشی
        shear = velocity * 0.2 * np.tanh(time_points - 5)
        
        combined = base_flow + turbulence + vortices + shear
        
        return {
            'time': time_points,
            'velocity': combined,
            'direction_x': np.cos(2 * np.pi * 0.05 * time_points),
            'direction_y': np.sin(2 * np.pi * 0.05 * time_points),
            'turbulence_intensity': np.std(turbulence) / velocity,
            'mean_velocity': np.mean(combined)
        }
    
    def generate_magnetic_data(self, scenario='anomaly'):
        """تولید داده‌های مغناطیسی Real-Time"""
        field = self.constants.extreme_magnetic[scenario]
        
        time_points = np.arange(0, 10, 1/self.sampling_rate)
        
        # میدان پایه
        base_field = field * np.ones_like(time_points)
        
        # نوسانات
        fluctuations = field * 0.1 * np.sin(2 * np.pi * 50 * time_points)  # 50 Hz
        
        # پالس‌های شدید
        pulses = np.zeros_like(time_points)
        for i in range(5):
            start = np.random.randint(0, len(time_points) - 100)
            pulses[start:start+100] = field * 0.5 * np.exp(-np.arange(100)/10)
        
        # نویز
        noise = np.random.normal(0, field * 0.01, len(time_points))
        
        combined = base_field + fluctuations + pulses + noise
        
        return {
            'time': time_points,
            'field': combined,
            'gradient': np.gradient(combined),
            'spectrum': np.fft.fft(combined),
            'mean': np.mean(combined),
            'std': np.std(combined)
        }
    
    def generate_seismic_data(self, scenario='magnitude_9'):
        """تولید داده‌های لرزه‌ای Real-Time"""
        magnitude = self.constants.extreme_seismic[scenario]
        
        time_points = np.arange(0, 60, 1/100)  # 60 ثانیه با 100 Hz
        
        # شتابنگاشت مصنوعی
        duration = 60
        t = time_points
        
        # مؤلفه‌های مختلف
        p_wave = 0.1 * np.exp(-t/5) * np.sin(2 * np.pi * 1.0 * t)
        s_wave = 0.5 * np.exp(-t/10) * np.sin(2 * np.pi * 0.5 * t)
        surface_wave = 1.0 * np.exp(-t/20) * np.sin(2 * np.pi * 0.2 * t)
        
        # نویز
        noise = 0.05 * np.random.randn(len(t))
        
        # مقیاس بر اساس بزرگی
        scale_factor = 10**(1.5 * magnitude - 8.0)
        acceleration = (p_wave + s_wave + surface_wave + noise) * scale_factor
        
        # تبدیل به g
        acceleration_g = acceleration / 9.81
        
        return {
            'time': t,
            'acceleration': acceleration,
            'acceleration_g': acceleration_g,
            'velocity': integrate.cumtrapz(acceleration, t, initial=0),
            'displacement': integrate.cumtrapz(
                integrate.cumtrapz(acceleration, t, initial=0), t, initial=0
            ),
            'pga': np.max(np.abs(acceleration_g)),
            'pgv': np.max(np.abs(integrate.cumtrapz(acceleration, t, initial=0))),
            'pgd': np.max(np.abs(integrate.cumtrapz(
                integrate.cumtrapz(acceleration, t, initial=0), t, initial=0
            )))
        }

