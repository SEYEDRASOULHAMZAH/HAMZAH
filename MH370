class LithiumDisintegrationAnalysis:
    """تحلیل پراکندگی لیتیوم در صورت سقوط و تخریب هواپیما"""
    
    def __init__(self):
        # پارامترهای لیتیوم
        self.lithium_mass_kg = 4.42  # کیلوگرم لیتیوم خالص در 221 کیلوگرم باتری (≈2%)
        self.lithium_moles = self.lithium_mass_kg * 1000 / 6.94  # مول
        
        # شرایط اقیانوس در عمق 4648 متر
        self.depth_m = 4648.35
        self.pressure_atm = self.depth_m * 1025 * 9.81 / 101325  # ≈460 اتمسفر
        self.temp_c = 2.0  # درجه سانتی‌گراد
        self.temp_k = self.temp_c + 273.15
        self.salinity_psu = 34.8  # واحد عملی نمک
        
        # پارامترهای آب دریا
        self.seawater_density = 1027  # kg/m³
        self.background_li_conc = 0.17  # mg/L = 0.17 g/m³ (غلظت طبیعی لیتیوم)
        self.background_li_mg_per_l = 0.17
        
        # پارامترهای انتشار
        self.diffusion_coefficient = 1e-9  # m²/s (ضریب انتشار مولکولی در آب سرد)
        self.current_velocity = 0.05  # m/s (سرعت جریان در عمق)
        self.turbulent_diffusion = 0.1  # m²/s (انتشار آشفته)
        
        # زمان
        self.years_since = 12  # سال از 2014 تا 2026
        self.seconds_since = self.years_since * 365.25 * 24 * 3600
        
    def calculate_dispersion_volume(self, dispersion_time):
        """محاسبه حجم پراکندگی بر اساس زمان"""
        # مدل انتشار سه‌بعدی با جریان
        effective_diffusion = self.diffusion_coefficient + self.turbulent_diffusion
        
        # شعاع انتشار
        dispersion_radius = np.sqrt(6 * effective_diffusion * dispersion_time)
        
        # جابجایی ناشی از جریان
        advection_distance = self.current_velocity * dispersion_time
        
        # حجم مؤثر انتشار (بیضی‌گون)
        volume_ellipsoid = (4/3) * np.pi * dispersion_radius**2 * advection_distance
        
        return {
            'dispersion_radius_m': dispersion_radius,
            'advection_distance_m': advection_distance,
            'effective_volume_m3': volume_ellipsoid,
            'effective_concentration_mg_per_l': (self.lithium_mass_kg * 1e6) / volume_ellipsoid
        }
    
    def lithium_water_reaction(self):
        """واکنش لیتیوم با آب دریا"""
        # واکنش: 2Li + 2H₂O → 2LiOH + H₂ + heat
        lithium_density = 534  # kg/m³
        reaction_heat = 278  # kJ/mol (گرمای واکنش)
        hydrogen_production = 0.5  # mol H₂ per mol Li
        
        # محاسبات
        total_heat_j = self.lithium_moles * reaction_heat * 1000
        total_hydrogen_moles = self.lithium_moles * hydrogen_production
        hydrogen_volume = total_hydrogen_moles * 22.4  # لیتر در شرایط استاندارد
        
        # اثر بر آب دریا
        water_volume_affected = total_heat_j / (4186 * 5)  # فرض: افزایش 5 درجه‌ای
        
        return {
            'total_heat_mj': total_heat_j / 1e6,
            'hydrogen_production_m3': hydrogen_volume / 1000,
            'water_temp_increase_c': 5,  # تخمین
            'water_volume_affected_m3': water_volume_affected,
            'li_ion_concentration_moles_per_l': self.lithium_moles / (water_volume_affected * 1000)
        }

