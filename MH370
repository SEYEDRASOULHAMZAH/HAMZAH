def calculate_energy_transfer():
    """محاسبه انتقال انرژی در لحظه IGARI"""
    
    # انرژی موجود
    battery_energy = igari.total_energy_j
    kinetic_energy = 0.5 * igari.mass_kg * igari.true_airspeed_mps**2
    potential_energy = igari.mass_kg * constants.g * igari.altitude_m
    
    # انرژی مورد نیاز برای انتقال تانسوری
    # معیار: انرژی معادل جرم در میدان گرانشی قوی
    schwarzschild_radius = 2 * constants.G * igari.mass_kg / constants.c**2
    tensorial_energy_required = igari.mass_kg * constants.c**2 * 1e-12  # بسیار کمتر از E=mc²
    
    # انرژی پلاسمای لیتیوم
    lithium_ionization_energy = 5.3917  # eV برای اولین الکترون
    total_ionization_energy = igari.lithium_moles * constants.N_A * lithium_ionization_energy * constants.e
    
    # محاسبه بازده
    available_energy = battery_energy + kinetic_energy + potential_energy
    required_energy = tensorial_energy_required + total_ionization_energy
    
    efficiency = available_energy / required_energy if required_energy > 0 else 0
    
    return {
        'battery_energy_j': battery_energy,
        'kinetic_energy_j': kinetic_energy,
        'potential_energy_j': potential_energy,
        'total_available_j': available_energy,
        'tensorial_required_j': tensorial_energy_required,
        'ionization_required_j': total_ionization_energy,
        'total_required_j': required_energy,
        'energy_efficiency': efficiency,
        'feasible': efficiency > 1
    }

energy_analysis = calculate_energy_transfer()

