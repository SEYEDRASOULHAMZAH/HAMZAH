        actual_coordinates['latitude'],
        actual_coordinates['longitude']
    )
    
    # منطقه جستجو
    search_area = circle_area(
        estimated_source['lat'], estimated_source['lon'],
        search_radius
    )
    
    # احتمال کشف
    coverage_ratio = min(1.0, simulation_params['num_searches_per_scenario'] * 
                       (simulation_params['sensor_range_km']**2 * np.pi) / 
                       (search_area * 1e6))
    
    detection_probability = coverage_ratio * np.exp(-distance_to_actual / search_radius)
    
    return {
        'scenario': f'Drift_Based_{scenario_num}',
        'start_point': start,
        'estimated_source': estimated_source,
        'search_radius_km': search_radius,
        'search_area_km2': search_area,
        'distance_to_actual_km': distance_to_actual,
        'detection_probability': detection_probability,
        'success': distance_to_actual <= simulation_params['sensor_range_km'],
        'time_days': 45,
        'cost_million': 40
    }
def simulate_hydrophone_based_search(scenario_num):
    """شبیه‌سازی جستجو براساس داده‌های هیدروفون"""
    
    # شبکه هیدروفون CTBTO
    hydrophone_stations = [
        {'name': 'H08', 'lat': -7.0, 'lon': 72.0, 'range_km': 3000},
        {'name': 'H01', 'lat': -49.0, 'lon': 70.0, 'range_km': 3500},
        {'name': 'H03', 'lat': -38.0, 'lon': 77.0, 'range_km': 3200},
        {'name': 'H10', 'lat': -12.0, 'lon': 96.0, 'range_km': 2800},
    ]
    
    # تریانگولاسیون سیگنال‌های فرضی
    # فرض: چند ایستگاه "سیگنال ضعیف" گزارش دادند
    
    simulated_signals = []
    for station in hydrophone_stations:
        # شبیه‌سازی احتمال دریافت سیگنال
        dist_to_actual = haversine(
            station['lat'], station['lon'],
            actual_coordinates['latitude'],
            actual_coordinates['longitude']
        )
        
        # سیگنال با فاصله تضعیف می‌شود
        signal_strength = 1 / (1 + (dist_to_actual / station['range_km'])**2)
        
        if np.random.random() < signal_strength * 0.1:  # 10% شانس تشخیص
            # افزودن نویز به موقعیت
            error_lat = np.random.normal(0, 50) / 111  # درجه
            error_lon = np.random.normal(0, 50) / (111 * np.cos(np.radians(station['lat'])))
            
            simulated_signals.append({
                'station': station['name'],
                'lat': station['lat'] + error_lat,
                'lon': station['lon'] + error_lon,
                'strength': signal_strength,
                'error_km': np.random.exponential(100)  # کیلومتر
            })
    
    if len(simulated_signals) >= 3:
        # تریانگولاسیون
        estimated_position = triangulate(simulated_signals)
        
        # عدم قطعیت تریانگولاسیون
        uncertainty = np.mean([s['error_km'] for s in simulated_signals])
        
        distance_to_actual = haversine(
            estimated_position['lat'], estimated_position['lon'],
            actual_coordinates['latitude'],
            actual_coordinates['longitude']
        )
        
        detection_probability = 1 / (1 + (distance_to_actual / uncertainty)**2)
    else:
        # جستجوی وسیع در منطقه محتمل
        search_center = {'lat': -35.0, 'lon': 94.0}
        uncertainty = 500  # کیلومتر
        
        distance_to_actual = haversine(
            search_center['lat'], search_center['lon'],
            actual_coordinates['latitude'],
            actual_coordinates['longitude']
        )
        
        detection_probability = 0.01  # احتمال بسیار پایین
    
    return {
        'scenario': f'Hydrophone_Based_{scenario_num}',
        'num_signals': len(simulated_signals),
        'estimated_position': estimated_position if 'estimated_position' in locals() else search_center,
        'uncertainty_km': uncertainty,
        'distance_to_actual_km': distance_to_actual,
        'detection_probability': detection_probability,
        'success': distance_to_actual <= simulation_params['sensor_range_km'],
        'time_days': 60,
        'cost_million': 25
    }
def simulate_grid_search(scenario_num):
    """شبیه‌سازی جستجوی سیستماتیک شبکه‌ای"""
    
    # منطقه جستجوی اصلی کلاسیک
    search_regions = [
        {
            'name': 'Priority Area 1',
            'bounds': {'lat_min': -36, 'lat_max': -32, 'lon_min': 92, 'lon_max': 96},
            'priority': 0.4
        },
        {
            'name': 'Priority Area 2', 
            'bounds': {'lat_min': -38, 'lat_max': -34, 'lon_min': 90, 'lon_max': 94},
            'priority': 0.3
        },
        {
            'name': 'Priority Area 3',
            'bounds': {'lat_min': -40, 'lat_max': -36, 'lon_min': 88, 'lon_max': 92},
            'priority': 0.2
        },
        {
            'name': 'Secondary Area',
            'bounds': {'lat_min': -42, 'lat_max': -38, 'lon_min': 86, 'lon_max': 90},
            'priority': 0.1
        }
    ]
    
    # انتخاب منطقه براساس اولویت
    region = np.random.choice(
        search_regions,
        p=[r['priority'] for r in search_regions]
    )
    
    # طراحی شبکه جستجو
    area_width = region['bounds']['lon_max'] - region['bounds']['lon_min']
    area_height = region['bounds']['lat_max'] - region['bounds']['lat_min']
    area_km2 = (area_width * 111.32) * (area_height * 111.32) * np.cos(np.radians(-35))
    
    # تراکم جستجو (کیلومتر بین خطوط)
    search_spacing = 5  # کیلومتر
    
    # تعداد خطوط جستجو
    num_lines = int(area_km2 / search_spacing / simulation_params['sensor_range_km'])
    
    # احتمال پوشش منطقه
    coverage_ratio = min(1.0, 
                       num_lines * simulation_params['sensor_range_km'] * 2 /
                       np.sqrt(area_km2 * 1e6))
    
    # آیا منطقه شامل مختصات واقعی است؟
    in_region = (
        region['bounds']['lat_min'] <= actual_coordinates['latitude'] <= region['bounds']['lat_max'] and
        region['bounds']['lon_min'] <= actual_coordinates['longitude'] <= region['bounds']['lon_max']
    )
    
    if in_region:
        # فاصله تا نزدیکترین خط جستجو
        search_lines_lat = np.linspace(
            region['bounds']['lat_min'],
            region['bounds']['lat_max'],
            num_lines
        )
        
        min_distance = min([
            haversine(lat, actual_coordinates['longitude'],
                     actual_coordinates['latitude'], actual_coordinates['longitude'])
            for lat in search_lines_lat
        ])
        
        detection_probability = coverage_ratio * np.exp(-min_distance / simulation_params['sensor_range_km'])
    else:
        detection_probability = 0
    
    return {
        'scenario': f'Grid_Search_{scenario_num}',
        'search_region': region['name'],
        'area_km2': area_km2,
        'search_spacing_km': search_spacing,
        'num_search_lines': num_lines,
        'coverage_ratio': coverage_ratio,
        'in_region': in_region,
        'distance_to_nearest_line_km': min_distance if in_region else None,
        'detection_probability': detection_probability,
        'success': in_region and (min_distance <= simulation_params['sensor_range_km']),
        'time_days': 90,
        'cost_million': 60
    }
