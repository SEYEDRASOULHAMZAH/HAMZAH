def calculate_safety_parameters():
    """محاسبات پارامترهای ایمنی و خطر"""
    
    # 1. میدان الکتریکی خطرناک
    # آستانه خطر برای تجهیزات الکترونیکی: 1 V/m
    safe_electric_field = 1.0  # V/m
    
    # محاسبه میدان در فواصل مختلف
    def electric_field_at_distance(distance_m):
        # میدان الکتریکی پلاسما
        plasma_potential = 100  # ولت (تخمین)
        return plasma_potential / distance_m
    
    # 2. میدان مغناطیسی خطرناک
    # آستانه برای تجهیزات: 0.1 میلی‌تسلا
    safe_magnetic_field = 0.1e-3  # T
    
    # 3. گرادیان فشار خطرناک
    # آستانه برای سازه‌ها: 1e6 Pa/m
    safe_pressure_gradient = 1e6  # Pa/m
    
    # 4. تشعشعات الکترومغناطیسی
    # محدوده فرکانس خطرناک: 1 kHz - 100 GHz
    dangerous_freq_range = (1e3, 1e11)  # Hz
    
    # 5. اثرات روی بدن انسان
    # SAR (Specific Absorption Rate) خطرناک: > 4 W/kg
    safe_sar = 4.0  # W/kg
    
    # محاسبه فاصله ایمن
    def calculate_safe_distances():
        # فاصله برای میدان الکتریکی
        e_field_distance = 100 / safe_electric_field  # m
        
        # فاصله برای میدان مغناطیسی
        b_field_distance = np.sqrt(
            constants.mu_0 * 1000 * 10**2 / 
            (2 * np.pi * safe_magnetic_field)
        )
        
        # فاصله برای فشار
        p_gradient_distance = plasma_results['pressure_gradient_pa_per_m'] / safe_pressure_gradient
        
        return {
            'safe_distance_electric_m': max(100, e_field_distance),
            'safe_distance_magnetic_m': max(100, b_field_distance),
            'safe_distance_pressure_m': max(50, p_gradient_distance),
            'minimum_safe_distance_m': max(100, e_field_distance, b_field_distance, p_gradient_distance)
        }
    
