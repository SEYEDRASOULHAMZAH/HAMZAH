def analyze_monte_carlo_results(results_df):
    """
    تحلیل آماری جامع نتایج مونت‌کارلو
    """
    
    print("\n" + "="*80)
    print("📊 تحلیل آماری نتایج مونت‌کارلو")
    print("="*80)
    
    # آمارهای کلی
    total_scenarios = len(results_df)
    
    # دسته‌بندی براساس فاصله
    distance_stats = []
    for dist_group in [0, 5, 10, 15, 20]:
        if dist_group == 0:
            group_data = results_df[results_df['distance_km'] < 5]
            label = 'کمتر از 5 کیلومتر'
        else:
            group_data = results_df[
                (results_df['distance_km'] >= dist_group) & 
                (results_df['distance_km'] < dist_group + 5)
            ]
            label = f'{dist_group}-{dist_group+5} کیلومتر'
        
        if len(group_data) > 0:
            distance_stats.append({
                'distance_range': label,
                'count': len(group_data),
                'avg_detection': group_data['detection_probability'].mean(),
                'avg_failure': group_data['failure_probability'].mean(),
                'avg_success': group_data['success_probability'].mean(),
                'max_risk': group_data['risk_level'].value_counts().index[0]
            })
    
    # دسته‌بندی براساس جهت
    direction_stats = []
    direction_groups = {
        'شمالی (0-45°)': (0, 45),
        'شمال شرقی (45-90°)': (45, 90),
        'شرقی (90-135°)': (90, 135),
        'جنوب شرقی (135-180°)': (135, 180),
        'جنوبی (180-225°)': (180, 225),
        'جنوب غربی (225-270°)': (225, 270),
        'غربی (270-315°)': (270, 315),
        'شمال غربی (315-360°)': (315, 360)
    }
    
    for dir_label, (dir_min, dir_max) in direction_groups.items():
        group_data = results_df[
            (results_df['direction_deg'] >= dir_min) & 
            (results_df['direction_deg'] < dir_max)
        ]
        
        if len(group_data) > 0:
            direction_stats.append({
                'direction': dir_label,
                'count': len(group_data),
                'avg_detection': group_data['detection_probability'].mean(),
                'avg_failure': group_data['failure_probability'].mean(),
                'best_distance': group_data.loc[group_data['success_probability'].idxmax(), 'distance_km'],
                'worst_distance': group_data.loc[group_data['failure_probability'].idxmax(), 'distance_km']
            })
    
    # محاسبه بهینه‌ترین و بدترین سناریوها
    best_scenario = results_df.loc[results_df['success_probability'].idxmax()]
    worst_scenario = results_df.loc[results_df['failure_probability'].idxmax()]
    
    # محاسبه معیارهای تصمیم‌گیری
    decision_metrics = {
        'threshold_safe': 0.1,      # آستانه ایمن برای احتمال خرابی
        'threshold_effective': 0.7, # آستانه مؤثر برای احتمال تشخیص
        'optimal_distance': None,
        'optimal_direction': None,
        'safe_zones': [],
        'danger_zones': []
    }
    
    # یافتن مناطق ایمن (احتمال خرابی < 10%، احتمال تشخیص > 70%)
    safe_zones = results_df[
        (results_df['failure_probability'] < decision_metrics['threshold_safe']) &
        (results_df['detection_probability'] > decision_metrics['threshold_effective'])
    ]
    
    if len(safe_zones) > 0:
        decision_metrics['optimal_distance'] = safe_zones.loc[safe_zones['success_probability'].idxmax(), 'distance_km']
        decision_metrics['optimal_direction'] = safe_zones.loc[safe_zones['success_probability'].idxmax(), 'direction_deg']
        decision_metrics['safe_zones'] = safe_zones[['distance_km', 'direction_deg', 'success_probability']].head(10).values.tolist()
    
    # یافتن مناطق خطرناک (احتمال خرابی > 50%)
    danger_zones = results_df[results_df['failure_probability'] > 0.5]
    if len(danger_zones) > 0:
        decision_metrics['danger_zones'] = danger_zones[['distance_km', 'direction_deg', 'failure_probability']].head(10).values.tolist()
    
    return {
        'total_scenarios': total_scenarios,
        'overall_stats': {
            'avg_detection_prob': results_df['detection_probability'].mean(),
            'avg_failure_prob': results_df['failure_probability'].mean(),
            'avg_success_rate': results_df['success_probability'].mean(),
            'std_detection': results_df['detection_probability'].std(),
            'std_failure': results_df['failure_probability'].std()
        },
        'distance_statistics': distance_stats,
        'direction_statistics': direction_stats,
        'best_scenario': best_scenario.to_dict(),
        'worst_scenario': worst_scenario.to_dict(),
        'decision_metrics': decision_metrics
    }

# تحلیل نتایج
analysis = analyze_monte_carlo_results(results_df)
