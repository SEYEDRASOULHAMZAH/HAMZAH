def calculate_errors(real, pred):
    """محاسبه خطاهای نسبی و مطلق"""
    errors = {}
    for key in real.keys():
        if isinstance(real[key], (int, float)) and isinstance(pred[key], (int, float)):
            if real[key] != 0:
                rel_error = abs(pred[key] - real[key]) / abs(real[key])
            else:
                rel_error = abs(pred[key])
            abs_error = abs(pred[key] - real[key])
            errors[key] = {
                'relative': rel_error,
                'absolute': abs_error,
                'match_score': 1 - min(rel_error, 1)  # نمره تطابق 0-1
            }
    return errors

