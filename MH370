        # تنش برشی پایه
        base_shear_stress = inertial_force / (64.8 * 18.5)  # سطح مقطع
        
        # تنش خمشی
        bending_moment = inertial_force * 31.85  # نصف طول
        section_modulus = 1.2e6  # m³ (تخمینی)
        bending_stress = bending_moment / section_modulus
        
        # تحلیل خستگی
        stress_cycles = 300  # 5 دقیقه × 1Hz
        fatigue_damage = (bending_stress / 140e6)**3 * stress_cycles  قانون ماینر
        
        # شبیه‌سازی شتاب زمین
        np.random.seed(5)
