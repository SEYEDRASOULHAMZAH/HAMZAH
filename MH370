def calculate_stability_metrics():
    """محاسبه معیارهای پایداری سیستم"""
    
    # انرژی کل سیستم
    E_total = shield_params['total_energy_j']
    
    # انرژی مورد نیاز برای پایداری
    # معیار لوسون (Lawson Criterion) برای پلاسمای محصور
    n_tau_E = 1e20  # m⁻³·s (برای پلاسمای لیتیوم)
    
    # دمای پلاسما
    T_plasma = 1e4  # K
    
    # انرژی محصور
    E_confined = 3 * constants.k * T_plasma * plasma_params['electron_density_m3'] * \
                shield_params['shield_volume_m3']
    
    # زمان پایداری
    tau_stability = E_confined / E_total if E_total > 0 else 0
    
    # ضریب پایداری
    stability_factor = tau_stability / (12 * 365.25 * 24 * 3600)  # نسبت به ۱۲ سال
    
    return {
        'total_energy_j': E_total,
        'confined_energy_j': E_confined,
        'plasma_temperature_k': T_plasma,
        'lawson_parameter': n_tau_E,
        'stability_time_s': tau_stability,
        'stability_time_years': tau_stability / (365.25 * 24 * 3600),
        'stability_factor': stability_factor
    }

stability_metrics = calculate_stability_metrics()

