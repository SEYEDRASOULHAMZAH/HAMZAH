def calculate_group_scores(scenarios_dict):
    classic_scores = []
    hamzah_scores = []
    
    for scenario, data in scenarios_dict.items():
        if 'match_classic' in data:
            classic_scores.append(data['match_classic'])
            hamzah_scores.append(data['match_hamzah'])
        elif 'classic_probability' in data:
            classic_scores.append(data['classic_probability'])
            hamzah_scores.append(data['hamzah_probability'])
    
    return {
        'classic_mean': np.mean(classic_scores),
        'hamzah_mean': np.mean(hamzah_scores),
        'classic_std': np.std(classic_scores),
        'hamzah_std': np.std(hamzah_scores),
        'hamzah_superiority': np.mean(hamzah_scores) - np.mean(classic_scores)
    }

