class SpectralAnalysis:
    """تحلیل طیف‌سنجی دقیق پیکسل زرد"""
    
    def __init__(self):
        self.constants = {
            'h': constants.h,
            'c': constants.c,
            'k': constants.k,
            'e': constants.e
        }
        
    def calculate_lithium_spectrum(self, temperature, pressure):
        """محاسبه طیف نشری لیتیوم در شرایط عمق"""
        
        # خطوط نشری اصلی لیتیوم
        lines = {
            'Li_I_670.791': {
                'wavelength': 670.791e-9,  # متر
                'transition': '2s → 2p',
                'oscillator_strength': 0.75,
                'energy': 1.85  # eV
            },
            'Li_I_610.364': {
                'wavelength': 610.364e-9,
                'transition': '2p → 3d',
                'oscillator_strength': 0.12,
                'energy': 2.03  # eV
            },
            'Li_II_548.5': {
                'wavelength': 548.5e-9,
                'transition': '1s² → 1s2p',
                'oscillator_strength': 0.89,
                'energy': 2.26  # eV
            }
        }
        
        # اثر فشار و دما روی خطوط
        pressure_broadening = pressure / 101325  # نسبی به فشار اتمسفر
        thermal_broadening = np.sqrt(temperature / 300)  # نسبی به دمای اتاق
        
        # محاسبه پروفایل وویگت (Voigt) برای هر خط
        spectra = {}
        for line_name, line_data in lines.items():
            # پهنای دوپلر
            mass = 1.1526e-26 if 'Li_I' in line_name else 1.1526e-26 / 2  # kg
            doppler_width = line_data['wavelength'] / self.constants['c'] * \
                           np.sqrt(2 * self.constants['k'] * temperature / mass)
            
            # پهنای فشار
            pressure_width = 0.001e-9 * pressure_broadening  # m
            
            # پهنای طبیعی
            natural_width = 1e-12  # m (تخمین)
            
            # پهنای کل (تقریب)
            total_width = np.sqrt(doppler_width**2 + pressure_width**2 + natural_width**2)
            
            # شدت خط
            intensity = line_data['oscillator_strength'] * np.exp(-line_data['energy'] * \
                        self.constants['e'] / (self.constants['k'] * temperature))
            
            spectra[line_name] = {
                'central_wavelength': line_data['wavelength'],
                'doppler_width': doppler_width,
                'pressure_width': pressure_width,
                'total_width': total_width,
                'relative_intensity': intensity,
                'peak_intensity': intensity / (np.sqrt(2*np.pi) * total_width)
            }
        
        return spectra
    
    def simulate_yellow_pixel(self, spectra, resolution=0.1):
        """شبیه‌سازی پیکسل زرد با وضوح بالا"""
        
        # محدوده طول موج
        wavelengths = np.linspace(380e-9, 750e-9, int((750-380)/resolution))
        
        # طیف ترکیبی
        total_spectrum = np.zeros_like(wavelengths)
        
        for line_name, line_data in spectra.items():
            # پروفایل گاوسی برای هر خط
            line_profile = line_data['peak_intensity'] * \
                          np.exp(-0.5 * ((wavelengths - line_data['central_wavelength']) / \
                          line_data['total_width'])**2)
            
            total_spectrum += line_profile
        
        # نرمالایز کردن
        total_spectrum = total_spectrum / np.max(total_spectrum)
        
        # افزودن نویز
        noise = 0.01 * np.random.randn(len(wavelengths))
        total_spectrum += noise
        
        # اعمال محدودیت آشکارساز
        detector_response = 0.8 * np.ones_like(wavelengths)  # راندمان 80%
        detected_spectrum = total_spectrum * detector_response
        
        return wavelengths, detected_spectrum

