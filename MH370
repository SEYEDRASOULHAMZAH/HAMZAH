class DetectionCapabilityAnalysis:
    """تحلیل قابلیت تشخیص پیکسل زرد در سناریوی سقوط"""
    
    def __init__(self):
        # پارامترهای دستگاه‌های تشخیص
        self.sonar_frequency = 100e3  # Hz
        self.sonar_power = 10e3  # W
        self.beam_width = 1  # درجه
        self.pulse_length = 0.001  # ثانیه
        
        # حساسیت طیف‌سنج
        self.spectrometer_resolution = 0.1  # nm
        self.detection_threshold = 1e-6  # حداقل شدت قابل تشخیص (نرمالایز)
        
        # پارامترهای پیکسل زرد
        self.yellow_pixel_wavelength = 589e-9  # متر
        self.yellow_pixel_bandwidth = 5e-9  # متر
        
    def calculate_minimum_detectable_concentration(self, path_length):
        """محاسبه حداقل غلظت قابل تشخیص لیتیوم"""
        # ضریب جذب لیتیوم در آب دریا
        absorption_coefficient = 0.01  # m⁻¹ per mg/L (تخمین)
        
        # شدت سیگنال برگشتی
        # معادله رادار: Pr = Pt * G² * λ² * σ / (4π)³ * R⁴
        # برای سونار: معادله مشابه
        
        # مقطع سیگنال برگشتی از لیتیوم
        cross_section_per_kg = 1e-4  # m²/kg (تخمین)
        
        # حداقل سیگنال قابل تشخیص
        min_detectable_signal = 1e-12  # W
        
        # محاسبه حداقل جرم
        min_mass = (min_detectable_signal * (4 * np.pi * path_length**2)**2) / \
                   (self.sonar_power * (constants.c / self.sonar_frequency)**2 * cross_section_per_kg)
        
        return {
            'min_detectable_mass_kg': min_mass,
            'min_detectable_concentration_mg_per_l': (min_mass * 1e6) / (1 * 1 * path_length),  # در حجم 1m³
            'path_length_m': path_length,
            'detection_possible': min_mass < 4.42  # کمتر از کل لیتیوم موجود
        }
    
    def analyze_yellow_pixel_characteristics(self, concentration_profile):
        """تحلیل ویژگی‌های پیکسل زرد"""
        # پیکسل زرد در گزارش: نقطه‌ای، بسیار درخشان، باند باریک
        
        # محاسبه نسبت سیگنال به نویز
        signal_strength = np.max(concentration_profile) if hasattr(concentration_profile, 'max') else concentration_profile
        background = 0.17  # mg/L
        
        snr = (signal_strength - background) / background if background > 0 else 0
        
        # وضوح مکانی
        spatial_resolution = 1  # متر (برای سونار باند پهن)
        
        # ویژگی‌های پیکسل گزارش شده
        reported_pixel = {
            'size': 'point-like',  # نقطه‌ای
            'intensity': 'high',  # درخشان
            'spectral_purity': 'monochromatic',  # تک‌رنگ
            'stability': 'constant',  # پایدار
            'snr_minimum': 100  # حداقل SNR گزارش شده
        }
        
        return {
            'calculated_snr': snr,
            'meets_criteria': snr > reported_pixel['snr_minimum'],
            'expected_pixel_size_m': spatial_resolution,
            'is_point_source': spatial_resolution < 10,  # کمتر از 10 متر
            'concentration_peak_mg_per_l': signal_strength
        }

