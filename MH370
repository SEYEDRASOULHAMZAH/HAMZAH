def calculate_statistics(errors_dict, model_name):
    """محاسبه آمارهای کلیدی"""
    match_scores = [errors_dict[key]['match_score'] for key in errors_dict]
    
    stats_dict = {
        'مدل': model_name,
        'میانگین تطابق': np.mean(match_scores),
        'انحراف معیار تطابق': np.std(match_scores),
        'حداکثر تطابق': np.max(match_scores),
        'حداقل تطابق': np.min(match_scores),
        'تعداد تطابق کامل': sum(1 for score in match_scores if score == 1),
        'تعداد تطابق > 0.9': sum(1 for score in match_scores if score > 0.9),
        'تعداد تطابق < 0.5': sum(1 for score in match_scores if score < 0.5),
        'RMSE': np.sqrt(np.mean([errors_dict[key]['absolute']**2 for key in errors_dict])),
        'R²': 1 - (np.var([errors_dict[key]['absolute'] for key in errors_dict]) / 
                   np.var(list(real_data.values())[:len(errors_dict)]))
    }
    return stats_dict

