def sensitivity_analysis():
    """تحلیل حساسیت نتایج به پارامترها"""
    
    # تغییر پارامترهای کلیدی
    parameters_to_test = {
        'sensor_range_km': [1, 5, 10, 20],
        'search_pattern': ['grid', 'spiral', 'random'],
        'success_threshold_km': [0.5, 1, 2, 5],
        'num_searches_per_scenario': [500, 1000, 2000, 5000]
    }
    
    sensitivity_results = {}
    
    for param_name, param_values in parameters_to_test.items():
        print(f"\n🔬 تحلیل حساسیت برای پارامتر: {param_name}")
        
        success_rates = []
        for value in param_values:
            # تغییر پارامتر
            original_value = simulation_params[param_name]
            simulation_params[param_name] = value
            
            # اجرای مجدد 10 سناریو نمونه
            sample_results = []
            for i in range(10):
                if 'Satellite' in param_name:
                    result = simulate_satellite_based_search(i)
                elif 'Drift' in param_name:
                    result = simulate_drift_based_search(i)
                elif 'Grid' in param_name:
                    result = simulate_grid_search(i)
                else:
                    result = simulate_satellite_based_search(i)
                sample_results.append(result)
            
            success_rate = sum([r['success'] for r in sample_results]) / len(sample_results) * 100
            success_rates.append(success_rate)
            
            print(f"  {param_name} = {value}: نرخ موفقیت = {success_rate:.2f}%")
            
            # بازگرداندن مقدار اصلی
            simulation_params[param_name] = original_value
        
        sensitivity_results[param_name] = {
            'values': param_values,
            'success_rates': success_rates,
            'optimal_value': param_values[np.argmax(success_rates)]
        }
    
    return sensitivity_results

# اجرای تحلیل حساسیت
