    @staticmethod
    @jit(nopython=True, parallel=True)
    def quantum_monte_carlo_kernel(iterations: int) -> Tuple[float, float, float]:
        """هسته محاسباتی مونت کارلو کوانتومی (بهینه‌شده)"""
        sum_lagrangian = 0.0
        sum_squared = 0.0
        valid_count = 0
        
        for i in range(iterations):
            # تولید پارامترهای تصادفی با توزیع گاوسی
            Q_H = np.random.normal(1.0, 0.1)
            IGARI_sync = np.random.normal(1.0, 0.05)
            Xi_SIO = np.random.normal(1.0, 0.15)
            G_munu = np.random.normal(1.65, 0.01)
            P_lock = np.random.normal(1.0, 0.02)
            
            # محاسبه لاگرانژین
            L = Q_H * IGARI_sync + Xi_SIO * (G_munu * P_lock)
            L += 1.65e-34 * 0.0 / np.exp(1e12)  # ترم آنتروپی
            
            if np.isfinite(L):
                sum_lagrangian += L
                sum_squared += L**2
                valid_count += 1
        
        mean = sum_lagrangian / valid_count if valid_count > 0 else 0
        variance = (sum_squared / valid_count - mean**2) if valid_count > 0 else 0
        
        return mean, variance, valid_count
    
    def run_full_simulation(self) -> Dict:
        """اجرای شبیه‌سازی کامل"""
        logger.info(f"شروع شبیه‌سازی مونت کارلو با {self.num_simulations:,} تکرار...")
        
        # استفاده از پردازش موازی
        num_cores = mp.cpu_count()
        chunk_size = self.num_simulations // num_cores
        
        with ProcessPoolExecutor(max_workers=num_cores) as executor:
            futures = [executor.submit(self.quantum_monte_carlo_kernel, chunk_size) 
                      for _ in range(num_cores)]
            
            results = [f.result() for f in futures]
        
        # تجمیع نتایج
        total_mean = 0
        total_variance = 0
        total_valid = 0
        
        for mean, var, valid in results:
            total_mean += mean * valid
            total_variance += var * valid
            total_valid += valid
        
        final_mean = total_mean / total_valid if total_valid > 0 else 0
        final_variance = total_variance / total_valid if total_valid > 0 else 0
        final_std = np.sqrt(final_variance)
        
        # محاسبه فاصله اطمینان
        z_score = stats.norm.ppf((1 + self.confidence_level) / 2)
        ci_lower = final_mean - z_score * final_std / np.sqrt(total_valid)
        ci_upper = final_mean + z_score * final_std / np.sqrt(total_valid)
        
        self.results = {
            'mean_lagrangian': final_mean,
            'std_lagrangian': final_std,
            'confidence_interval': (ci_lower, ci_upper),
            'total_iterations': total_valid,
            'confidence_level': self.confidence_level,
            'error_margin': z_score * final_std / np.sqrt(total_valid)
        }
        
        logger.info(f"شبیه‌سازی کامل شد. میانگین لاگرانژین: {final_mean:.10e}")
        
        return self.results
    
    def stress_test_simulation_v2(self, num_stress_tests: int = 30) -> pd.DataFrame:
