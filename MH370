# ==================== ADVANCED QUALITY CONTROL FOR STRESS TESTS ====================
class AdvancedQualityControl(QualityControlSystem):
    """سیستم کنترل کیفیت پیشرفته برای آزمون‌های تنش"""
    
    def validate_stress_test_results(self, stress_test_results):
        """اعتبارسنجی نتایج آزمون‌های تنش"""
        validation_results = []
        
        for phase in ['phase1', 'phase2', 'phase3']:
            for test in stress_test_results.get(phase, []):
                validation = {
                    'test_name': test['test_name'],
                    'phase': phase,
                    'validation_checks': []
                }
                
                # بررسی ۱: اعتبار مقادیر عددی
                if 'calculated_value' in test:
                    if np.isfinite(test['calculated_value']):
                        validation['validation_checks'].append(('مقدار عددی معتبر', True))
                    else:
                        validation['validation_checks'].append(('مقدار عددی معتبر', False))
                
                # بررسی ۲: دامنه اطمینان
                if 'confidence' in test:
                    if 0 <= test['confidence'] <= 1:
                        validation['validation_checks'].append(('دامنه اطمینان معتبر', True))
                    else:
                        validation['validation_checks'].append(('دامنه اطمینان معتبر', False))
                
                # بررسی ۳: معیارهای فیزیکی
                if 'passed' in test:
                    validation['validation_checks'].append(('معیار فیزیکی', test['passed']))
                
                # محاسبه نمره اعتبارسنجی
                passed_checks = sum(1 for check in validation['validation_checks'] if check[1])
                total_checks = len(validation['validation_checks'])
                validation['validation_score'] = (passed_checks / total_checks) * 100 if total_checks > 0 else 0
                
                validation_results.append(validation)
        
        # محاسبه میانگین نمره
        avg_validation_score = np.mean([v['validation_score'] for v in validation_results]) if validation_results else 0
        
        return {
            'validation_results': validation_results,
            'avg_validation_score': avg_validation_score,
            'overall_valid': avg_validation_score > 95.0
        }

