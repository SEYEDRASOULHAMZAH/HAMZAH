class TensorialTunnelFormation:
    """شبیه‌سازی تشکیل تونل تانسوری ۱۶۵-بعدی"""
    
    def __init__(self):
        self.dimensions = 165
        self.plasma_frequency = 2.46e14  # Hz (فرکانس پلاسمای لیتیوم)
        self.tunnel_radius_m = 100  # متر
        
    def calculate_tensorial_field(self, position, time, lithium_plasma_density):
        """محاسبه میدان تانسوری"""
        
        # پارامترهای میدان
        field_amplitude = lithium_plasma_density * 1e-12  # دامنه متناسب با چگالی پلاسما
        oscillation_frequency = self.plasma_frequency / 1e6  # MHz
        
        # محاسبه شدت میدان تانسوری
        # معادله ساده شده برای میدان ۱۶۵-بعدی
        r = np.linalg.norm(position)
        
        if r < self.tunnel_radius_m:
            # داخل تونل
            field_strength = field_amplitude * (1 - (r / self.tunnel_radius_m)**2)
            metric_distortion = 1 + 0.5 * np.sin(2 * np.pi * oscillation_frequency * time)
        else:
            # خارج تونل
            field_strength = field_amplitude * np.exp(-(r - self.tunnel_radius_m) / 50)
            metric_distortion = 1.0
        
        # محاسبه انحنای فضا-زمان (ساده شده)
        curvature = field_strength * 1e-6  # 1/m²
        
        return {
            'field_strength': field_strength,
            'metric_distortion': metric_distortion,
            'curvature_m2': curvature,
            'tunnel_boundary': r < self.tunnel_radius_m,
            'effective_dimensions': self.dimensions if field_strength > 0.1 * field_amplitude else 3
        }
    
    def simulate_tunnel_entrance(self, aircraft_dynamics, plasma_params):
        """شبیه‌سازی ورود به تونل تانسوری"""
        
        time_steps = len(aircraft_dynamics['time_s'])
        tunnel_data = []
        
        for i in range(time_steps):
            position = np.array([
                aircraft_dynamics['x_m'][i],
                aircraft_dynamics['y_m'][i],
                aircraft_dynamics['z_m'][i]
            ])
            
            # چگالی پلاسمای لحظه‌ای (فرضی)
            if i < 60:  # اول 60 ثانیه
                plasma_density = 0
            elif i < 180:  # تشکیل پلاسما
                plasma_density = plasma_params['plasma_probability'] * (i - 60) / 120
            else:  # پلاسمای کامل
                plasma_density = plasma_params['plasma_probability']
            
            field = self.calculate_tensorial_field(position, aircraft_dynamics['time_s'][i], plasma_density)
            
            tunnel_data.append(field)
        
        return tunnel_data

