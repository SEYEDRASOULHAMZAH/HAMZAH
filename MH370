class LithiumPlasmaShield:
    """کلاس محاسبات دقیق پلاسمای محافظ لیتیومی"""
    
    def __init__(self):
        # ثابت‌های فیزیکی
        self.m_e = constants.m_e  # جرم الکترون
        self.m_li = 1.1526e-26  # جرم یون لیتیوم-7 (kg)
        self.e = constants.e  # بار الکترون
        self.epsilon_0 = constants.epsilon_0  # گذردهی خلأ
        self.mu_0 = constants.mu_0  # تراوایی خلأ
        self.c = constants.c  # سرعت نور
        
        # پارامترهای MH370
        self.battery_mass = 221  # kg
        self.aircraft_mass = 250000  # kg (بوئینگ 777)
        self.depth = 4648.35  # متر
        self.pressure = self.depth * 1025 * 9.81 / 1e5  # اتمسفر (≈460 atm)
        
        # پارامترهای پلاسما (براساس مقاله)
        self.li_density = 534  # kg/m³
        self.energy_density = 1e12  # J/m³
        self.plasma_frequency = 2.46e14  # Hz (فرکانس پلاسمای لیتیوم)
        
    def calculate_plasma_parameters(self, electron_density):
        """محاسبات دقیق پارامترهای پلاسما"""
        
        # فرکانس پلاسمای الکترون
        omega_pe = np.sqrt(electron_density * self.e**2 / (self.m_e * self.epsilon_0))
        
        # فرکانس پلاسمای یون
        omega_pi = np.sqrt(electron_density * self.e**2 / (self.m_li * self.epsilon_0))
        
        # طول موج پلاسما
        lambda_p = 2 * np.pi * self.c / omega_pe
        
        # فرکانس سیکلوترون الکترون (با فرض میدان مغناطیسی زمین)
        B_earth = 50e-6  # T (میدان مغناطیسی زمین در عمق)
        omega_ce = self.e * B_earth / self.m_e
        omega_ci = self.e * B_earth / self.m_li
        
        # عمق پوستی (Skin Depth)
        sigma = 1e7  # رسانایی پلاسما (S/m)
        delta = np.sqrt(2 / (self.mu_0 * omega_pe * sigma))
        
        # طول دبای (Debye Length)
        T_e = 1e4  # دمای الکترون (K) - تخمین
        lambda_D = np.sqrt(self.epsilon_0 * constants.k * T_e / (electron_density * self.e**2))
        
        return {
            'electron_plasma_freq_hz': omega_pe,
            'ion_plasma_freq_hz': omega_pi,
            'plasma_wavelength_m': lambda_p,
            'electron_cyclotron_freq_hz': omega_ce,
            'ion_cyclotron_freq_hz': omega_ci,
            'skin_depth_m': delta,
            'debye_length_m': lambda_D,
            'electron_density_m3': electron_density
        }
    
    def calculate_shield_thickness(self, energy_input):
        """محاسبه ضخامت لایه محافظ پلاسمایی"""
        
        # انرژی موجود در باتری‌ها
        E_total = self.battery_mass * 150 * 3600  # وات-ساعت به ژول
        
        # راندمان تبدیل انرژی به پلاسما
        efficiency = 0.3  # 30% راندمان
        
        # انرژی قابل استفاده
        E_usable = E_total * efficiency
        
        # چگالی انرژی پلاسما
        rho_E = self.energy_density  # J/m³
        
        # حجم پلاسما
        V_plasma = E_usable / rho_E
        
        # فرض: پلاسما کره‌ای اطراف هواپیما
        # حجم بوئینگ 777 ≈ 1000 m³
        V_aircraft = 1000  # m³
        
        # حجم کل کره شامل هواپیما و پلاسما
        V_total = V_aircraft + V_plasma
        
        # شعاع کره محافظ
        R_total = (3 * V_total / (4 * np.pi))**(1/3)
        R_aircraft = (3 * V_aircraft / (4 * np.pi))**(1/3)
        
        # ضخامت لایه محافظ
        shield_thickness = R_total - R_aircraft
        
        return {
            'total_energy_j': E_total,
            'usable_energy_j': E_usable,
            'plasma_volume_m3': V_plasma,
            'total_radius_m': R_total,
            'aircraft_radius_m': R_aircraft,
            'shield_thickness_m': shield_thickness,
            'shield_volume_m3': 4/3 * np.pi * (R_total**3 - R_aircraft**3)
        }

