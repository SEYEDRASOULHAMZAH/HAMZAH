# ==================== SAFETY & WARNING SYSTEM ====================
class SafetyWarningSystem:
    """سیستم هشدار ایمنی برای شعاع ۱۶۵ متری"""
    
    def __init__(self):
        self.constants = HamzahConstants()
        self.warning_history = []
        self.safety_status = 'SAFE'
        self.approach_warnings = []
        
    def check_proximity(self, current_lat: float, current_lon: float, current_depth: float) -> Dict:
        """بررسی فاصله از هواپیما"""
        # محاسبه فاصله
        distance = self.calculate_distance(current_lat, current_lon, current_depth)
        
        # بررسی سطح خطر
        if distance < 165.0:
            danger_level = 'CRITICAL'
            warning_message = '⚠️ هشدار بحرانی: داخل شعاع ۱۶۵ متری هستید!'
            action_required = 'فوری عقب‌نشینی کنید!'
            safety_status = 'DANGER'
        elif distance < 330.0:
            danger_level = 'HIGH'
            warning_message = '⚠️ هشدار بالا: نزدیک شعاع ۱۶۵ متری هستید.'
            action_required = 'سرعت را کاهش دهید و با احتیاط ادامه دهید.'
            safety_status = 'WARNING'
        elif distance < 1000.0:
            danger_level = 'MEDIUM'
            warning_message = '⚠️ هشدار متوسط: در منطقه حساس هستید.'
            action_required = 'سرعت کم و نظارت مداوم.'
            safety_status = 'CAUTION'
        else:
            danger_level = 'LOW'
            warning_message = '✅ وضعیت ایمن: خارج از منطقه خطر.'
            action_required = 'ادامه عملیات مجاز.'
            safety_status = 'SAFE'
        
        warning_data = {
            'timestamp': datetime.datetime.now().isoformat(),
            'current_position': {
                'latitude': current_lat,
                'longitude': current_lon,
                'depth': current_depth
            },
            'distance_to_target': distance,
            'danger_level': danger_level,
            'warning_message': warning_message,
            'action_required': action_required,
            'safety_status': safety_status
        }
        
        self.warning_history.append(warning_data)
        self.safety_status = safety_status
        
        if danger_level in ['CRITICAL', 'HIGH']:
            self.approach_warnings.append(warning_data)
            self.trigger_emergency_protocol(danger_level)
        
        return warning_data
    
    def calculate_distance(self, lat: float, lon: float, depth: float) -> float:
        """محاسبه فاصله سه‌بعدی از هواپیما"""
        # فاصله افقی
        lat_diff = (lat - self.constants.LAT_TARGET) * 111320  # متر
        lon_diff = (lon - self.constants.LON_TARGET) * 111320 * np.cos(np.radians(self.constants.LAT_TARGET))
        
        horizontal_distance = np.sqrt(lat_diff**2 + lon_diff**2)
        
        # فاصله عمودی
        vertical_distance = abs(depth - self.constants.DEPTH_TARGET)
        
        # فاصله سه‌بعدی
        distance_3d = np.sqrt(horizontal_distance**2 + vertical_distance**2)
        
        return distance_3d
    
    def trigger_emergency_protocol(self, danger_level: str):
        """فعال‌سازی پروتکل اضطراری"""
        protocols = {
            'CRITICAL': {
                'actions': [
                    'فعال‌سازی ترمز اضطراری مغناطیسی',
                    'قطع فوری پیشران',
                    'فعال‌سازی شناوری اضطراری',
                ],
                'message': 'پروتکل اضطراری بحرانی فعال شد!'
            },
            'HIGH': {
                'actions': [
                    'کاهش سرعت به ۰٫۰۱ متر بر ثانیه',
                    'فعال‌سازی سنسورهای اضافی',
                    'آماده‌سازی برای عقب‌نشینی',
                ],
                'message': 'پروتکل هشدار بالا فعال شد.'
            }
        }
        
        if danger_level in protocols:
            protocol = protocols[danger_level]
            logger.warning(protocol['message'])
            
            for action in protocol['actions']:
                logger.info(f"  • {action}")
    
    def generate_safety_report(self) -> str:
        """تولید گزارش ایمنی"""
        if not self.warning_history:
            return "هیچ هشداری ثبت نشده است."
        
        report_lines = []
        report_lines.append("=" * 80)
        report_lines.append("گزارش ایمنی عملیات جستجوی MH370")
        report_lines.append(f"وضعیت فعلی: {self.safety_status}")
