    anomaly_area_km2 = np.pi * anomaly_radius_km**2
    
    # احتمال قرارگیری تصادفی یک حادثه در این ناحیه
    p_single = anomaly_area_km2 / total_search_area_km2
    
    # تعداد حوادث متمرکز
    n_incidents = 4  # پیکسل زرد + ۳ حادثه جستجو
    
    # احتمال تصادفی بودن همه حوادث
    p_random = p_single ** (n_incidents - 1)  # یک نقطه مرجع داریم
    
    # احتمال غیرتصادفی بودن
    p_significant = 1 - p_random
    
    return p_random, p_significant, p_single

