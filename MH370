class AdvancedTools:
    """کلاس ابزارهای پیشرفته برای تحلیل و شبیه‌سازی"""
    
    @staticmethod
    def calculate_hamzah_tensor_field():
        """محاسبه میدان تانسوری حمزه"""
        # ایجاد شبکه سه‌بعدی
        x = np.linspace(-100, 100, 50)
        y = np.linspace(-100, 100, 50)
        z = np.linspace(-100, 100, 50)
        X, Y, Z = np.meshgrid(x, y, z)
        
        # محاسبه میدان تانسوری
        R = np.sqrt(X**2 + Y**2 + Z**2)
        field = 165 * np.exp(-R**2 / (2 * 42**2)) * np.sin(2 * np.pi * 1.65 * R)
        
        return X, Y, Z, field
    
    @staticmethod
    def perform_spectral_analysis(signal, fs):
        """تحلیل طیفی سیگنال"""
        # تبدیل فوریه
        fft_result = np.fft.fft(signal)
        frequencies = np.fft.fftfreq(len(signal), 1/fs)
        
        # محاسبه طیف توان
        power_spectrum = np.abs(fft_result)**2
        
        # یافتن فرکانس‌های غالب
        dominant_freqs = frequencies[np.argsort(power_spectrum)[-5:]]
        
        return {
            'frequencies': frequencies[:len(frequencies)//2],
            'power_spectrum': power_spectrum[:len(power_spectrum)//2],
            'dominant_frequencies': dominant_freqs,
            'total_power': np.sum(power_spectrum)
        }
    
    @staticmethod
    def optimize_transfer_parameters():
        """بهینه‌سازی پارامترهای انتقال با الگوریتم ژنتیک"""
        from scipy.optimize import differential_evolution
        
        def objective_function(params):
            # تابع هدف: کمینه کردن انرژی مصرفی و خطاها
            energy_weight, time_weight, space_weight = params
            
            # محاسبه تابع هزینه
            cost = (energy_weight * 1.65e6 + 
                   time_weight * 1e-9 + 
                   space_weight * 0.001)
            
            return cost
        
        # محدودیت پارامترها
        bounds = [(0.1, 10.0), (0.1, 10.0), (0.1, 10.0)]
        
        # اجرای الگوریتم ژنتیک
        result = differential_evolution(objective_function, bounds, maxiter=1000)
        
        return {
            'optimal_weights': result.x,
            'min_cost': result.fun,
            'success': result.success,
            'iterations': result.nit
        }
    
