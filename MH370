class CrashDispersionSimulation:
    """شبیه‌سازی پراکندگی لیتیوم در صورت سقوط"""
    
    def __init__(self):
        self.grid_size = 500  # متر
        self.resolution = 1   # متر
        self.time_steps = 100
        
    def simulate_instantaneous_release(self, total_mass, location):
        """شبیه‌سازی رهاسازی لحظه‌ای لیتیوم"""
        x = np.linspace(-self.grid_size/2, self.grid_size/2, int(self.grid_size/self.resolution))
        y = np.linspace(-self.grid_size/2, self.grid_size/2, int(self.grid_size/self.resolution))
        X, Y = np.meshgrid(x, y)
        
        # توزیع اولیه گاوسی در نقطه سقوط
        sigma = 10  # متر (وسعت اولیه)
        initial_concentration = total_mass * np.exp(-((X - location[0])**2 + (Y - location[1])**2) / (2 * sigma**2))
        initial_concentration /= (2 * np.pi * sigma**2)  # نرمالایز
        
        return X, Y, initial_concentration
    
    def simulate_diffusion_over_time(self, initial_conc, diffusion_coeff, current_vector, time_years):
        """شبیه‌سازی انتشار در طول زمان"""
        time_seconds = time_years * 365.25 * 24 * 3600
        
        # انتشار افقی
        horizontal_spread = np.sqrt(4 * diffusion_coeff * time_seconds)
        
        # جابجایی ناشی از جریان
        advection_x = current_vector[0] * time_seconds
        advection_y = current_vector[1] * time_seconds
        
        # توزیع نهایی
        X, Y = initial_conc
        final_conc = initial_conc * np.exp(-((X - advection_x)**2 + (Y - advection_y)**2) / (4 * diffusion_coeff * time_seconds))
        final_conc /= (4 * np.pi * diffusion_coeff * time_seconds)
        
        return final_conc, horizontal_spread, (advection_x, advection_y)

