        'طول دبای محاسبه شده m': np.sqrt(ε0 * kB * (params['دمای آب'] + 273.15) / (params['چگالی الکترون پلاسما'] * e**2)),
        
        # 3. انرژی پلاسما
        'انرژی پلاسما J': 0.4 * params['جرم لیتیوم'] * 150 * 3600,  # 40% راندمان
        
        # 4. فشار پلاسما
        'فشار پلاسما Pa': params['چگالی الکترون پلاسما'] * kB * (params['دمای آب'] + 273.15),
        
        # 5. میدان مغناطیسی تولید شده
        'میدان مغناطیسی T': μ0 * 1000 * 10**2 / (2 * (10**2 + params['عمق']**2)**(3/2)),
        
        # 6. اعتماد کلی مدل
        'اعتماد کلی مدل همزه': np.prod([
