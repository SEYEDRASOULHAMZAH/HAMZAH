    total_time = df['time_days'].sum()
    
    # میانگین فاصله از هدف
    avg_distance = df['distance_to_actual_km'].mean()
    min_distance = df['distance_to_actual_km'].min()
    max_distance = df['distance_to_actual_km'].max()
    
    # میانگین احتمال کشف
    avg_probability = df['detection_probability'].mean()
    
    # تحلیل گروه‌ها
    groups = ['Satellite', 'Drift', 'Hydrophone', 'Grid', 'New_Evidence']
    group_stats = {}
    
    for group in groups:
        group_data = df[df['scenario'].str.contains(group)]
        if len(group_data) > 0:
            group_stats[group] = {
                'count': len(group_data),
                'success_rate': group_data['success'].mean() * 100,
                'avg_distance': group_data['distance_to_actual_km'].mean(),
                'min_distance': group_data['distance_to_actual_km'].min(),
                'avg_probability': group_data['detection_probability'].mean(),
                'avg_cost': group_data['cost_million'].mean(),
                'avg_time': group_data['time_days'].mean()
            }
    
    # محاسبه کارایی هزینه
    cost_per_success = total_cost / total_success if total_success > 0 else float('inf')
    
    # احتمال کلی موفقیت
    overall_success_probability = 1 - np.prod(1 - df['detection_probability'])
    
    return {
        'total_scenarios': len(df),
        'successful_scenarios': int(total_success),
        'success_rate': (total_success / len(df)) * 100,
