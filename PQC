        effective_precision = base_precision * noise_resistance
        
        return min(effective_precision, base_precision * 1.0001)

    def _fractal_dimension_processor(self, input_complexity):
        """پردازش ابعاد فرکتالی - تبدیل پیچیدگی نمایی به خطی"""
