            adjusted_laser_hz = curr_freq + min(step_modifier * Decimal('1.0e25'), frequency_deviation)
            tuning_status = "TUNING_FEEDBACK_ACTIVE (در حال کالیبراسیون و انطباق کدهای خلاء)"
            
