        self.OMEGA_H = 1.176e10
        self.FLOOR_EPSILON = 1.155e-20
        self.RHO_SAT = 1.0e90
        
    def execute_quantitative_boot(self, boundary_entropy_load):
        # بررسی قفل دترمینان لایه حاکمیتی بعد ۱۱۵۵ (حالت ۹۷)
        raw_info_matrix = np.eye(4) * self.OMEGA_H
        
