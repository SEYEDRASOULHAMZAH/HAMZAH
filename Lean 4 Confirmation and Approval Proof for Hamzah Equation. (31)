    (h_start : manifold.test_start = 51)
    (h_end : manifold.test_end = 60)
    (h_rho : manifold.rho_sat_order = 1.0e90)
    (h_eps : 0 < manifold.epsilon_floor) :
    manifold.test_end - manifold.test_start + 1 = 10 ∧ manifold.rho_sat_order = 1.0e90 ∧ manifold.epsilon_floor > 0 := by
  have h_range : manifold.test_end - manifold.test_start + 1 = 10 := by
