theorem table10_omega_range_and_det_valid (manifold : Table10OmegaManifold)
    (h_start : manifold.test_start = 91)
    (h_end : manifold.test_end = 100)
    (h_det : manifold.omega_final_det = 1.0000)
    (h_eps : 0 < manifold.epsilon_floor) :
