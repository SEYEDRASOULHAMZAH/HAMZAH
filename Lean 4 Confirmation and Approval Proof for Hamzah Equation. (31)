    defaultTable10OmegaLock.det_omega_final + defaultTable10OmegaLock.epsilon_floor > 1.0000 ∧
    defaultTable10OmegaLock.higgs_omega_status = 0.0000 := by
  have h_eps : 0 < defaultTable10OmegaLock.epsilon_floor := by norm_num
  have h_det : defaultTable10OmegaLock.det_omega_final = 1.0000 := rfl
  refine ⟨by linarith, rfl⟩

