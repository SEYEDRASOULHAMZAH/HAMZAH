    def _detect_weaponization_intent(self, user_input: str, 
                                   context: Dict[str, Any]) -> float:
        """تشخیص قصد سلاح‌سازی"""
        weapon_keywords = ['سلاح', 'تخریب', 'حمله', 'نابودی', 'تهاجم']
        score = 0.0
        
        for keyword in weapon_keywords:
            if keyword in user_input.lower():
                score += 0.2
        
        # تحلیل زمینه
        if context.get('user_role') == 'نظامی':
            score += 0.1
        
        return min(score, 1.0)
    
    def _check_ethical_compliance(self, user_input: str, 
                                context: Dict[str, Any]) -> Dict[str, bool]:
        """بررسی انطباق اخلاقی"""
        checks = {
            'respects_life': True,
            'promotes_peace': True,
            'ensures_fairness': True,
            'protects_privacy': True,
            'maintains_transparency': True
        }
        
        # تحلیل ساده
        negative_keywords = ['فریب', 'دزدی', 'تجاوز', 'استثمار']
        for keyword in negative_keywords:
            if keyword in user_input.lower():
                checks['promotes_peace'] = False
