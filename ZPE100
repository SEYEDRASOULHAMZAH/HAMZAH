        }
    
    def _generate_qc_recommendations(self, results: Dict[str, Any]) -> List[Dict[str, Any]]:
        """تولید توصیه‌های بهبود بر اساس نتایج QC"""
        recommendations = []
        
        # تحلیل نقاط ضعف
        weak_points = []
        for protocol_id, result in results.items():
            if isinstance(result, dict) and 'qc_score' in result:
                if result['qc_score'] < 0.99:
                    weak_points.append({
                        'protocol': result.get('protocol_info', {}).get('name', protocol_id),
                        'score': result['qc_score'],
                        'issues': self._identify_issues(result)
                    })
        
        # تولید توصیه‌ها
        if weak_points:
            for point in weak_points:
                recommendations.append({
                    'priority': 'بالا' if point['score'] < 0.95 else 'متوسط',
                    'area': point['protocol'],
                    'issue': '، '.join(point['issues'][:3]),
                    'recommendation': self._get_recommendation_for_issue(point['issues'][0] if point['issues'] else ''),
                    'estimated_effort': 'کم' if point['score'] > 0.98 else 'متوسط' if point['score'] > 0.95 else 'زیاد'
                })
        
        # توصیه‌های عمومی
        general_recommendations = [
            {
                'priority': 'پایین',
                'area': 'عمومی',
                'issue': 'بهبود مستمر',
                'recommendation': 'پیاده‌سازی سیستم مدیریت کیفیت مستمر',
                'estimated_effort': 'متوسط'
            },
            {
                'priority': 'پایین',
                'area': 'مستندسازی',
                'issue': 'بهبود ردپایی',
                'recommendation': 'افزایش سطح مستندسازی فرآیندها',
                'estimated_effort': 'کم'
            }
        ]
        
        recommendations.extend(general_recommendations)
        
        return recommendations
    
    def _identify_issues(self, result: Dict[str, Any]) -> List[str]:
        """شناسایی مشکلات از نتایج QC"""
        issues = []
        
        if 'analysis_results' in result:
            analysis = result['analysis_results']
            
            # مشکلات سازگاری
            if 'compatibility_checks' in analysis:
                failed_checks = [c for c in analysis['compatibility_checks'] 
                               if not c.get('in_range', True)]
                if failed_checks:
                    issues.append(f'{len(failed_checks)} مورد عدم سازگاری')
            
            # مشکلات آماری
            if 'statistical_analysis' in analysis:
                outliers = analysis['statistical_analysis'].get('outlier_detection', [])
                if outliers:
                    issues.append(f'{len(outliers)} نقطه پرت آماری')
        
        # مشکلات نمره
        if result.get('qc_score', 1) < 0.99:
            issues.append(f'نمره QC پایین ({result["qc_score"]:.3f})')
        
        return issues if issues else ['هیچ مشکل عمده‌ای شناسایی نشد']
    
    def _get_recommendation_for_issue(self, issue: str) -> str:
        """دریافت توصیه برای یک مشکل خاص"""
        recommendations = {
            'عدم سازگاری': 'بازنگری و کالیبراسیون مجدد تجهیزات اندازه‌گیری',
            'نقطه پرت آماری': 'بررسی علل ویژه و حذف عوامل مزاحم',
            'نمره QC پایین': 'بازرسی کامل و آزمایش‌های تکمیلی',
            'روند نامطلوب': 'تحلیل ریشه‌ای و اصلاح فرآیند'
        }
        
        return recommendations.get(issue, 'بررسی توسط متخصص مربوطه')

