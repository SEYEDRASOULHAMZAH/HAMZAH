    def _calculate_overall_score(self, results: Dict[str, Any]) -> float:
        """محاسبه نمره کلی سناریو"""
        weights = {
            'technical': 0.4,
            'safety': 0.3,
            'performance': 0.2,
            'ethical': 0.1
        }
        
        scores = []
        
        # نمره فنی
        tech = results['technical_results']
        tech_score = (
            tech['tensor_verification']['unitarity'] * 0.3 +
            tech['energy_extraction']['efficiency'] / 100 * 0.4 +
            tech['quantum_properties']['entanglement_fidelity'] / 100 * 0.3
        )
        scores.append(('technical', tech_score))
        
        # نمره ایمنی
        safety = results['safety_results']
        safety_score = (
            safety['containment_integrity'] * 0.4 +
            safety['emergency_response']['containment_activation'] * 0.3 +
            safety['cybersecurity']['system_availability'] / 100 * 0.3
        )
        scores.append(('safety', safety_score))
        
        # نمره عملکرد
        perf = results['performance_results']
        perf_score = (
            (1 - perf['power_quality']['harmonic_distortion'] / 100) * 0.3 +
            perf['reliability']['availability'] / 100 * 0.4 +
            perf['scalability']['resource_utilization'] / 100 * 0.3
        )
        scores.append(('performance', perf_score))
        
        # نمره اخلاقی
        ethical = results['ethical_results']
        ethical_score = (
            ethical['ethical_compliance']['fairness'] * 0.3 +
            ethical['consciousness_respect']['free_will_respect'] * 0.3 +
            ethical['anti_weaponization']['weaponization_prevention'] * 0.4
        )
        scores.append(('ethical', ethical_score))
        
        # میانگین وزنی
        overall_score = sum(weights[cat] * score for (cat, score) in scores)
        
        return overall_score
    
    def run_all_scenarios(self) -> Dict[str, Any]:
        """اجرای تمام سناریوهای تست"""
        print("🚀 شروع اجرای تمام ۵۰ سناریوی تست...")
        
        all_results = {}
        scenario_scores = []
        execution_times = []
        
        for scenario in self.scenarios:
            scenario_id = scenario['id']
            try:
                result = self.run_scenario(scenario_id)
                all_results[f'scenario_{scenario_id}'] = result
                scenario_scores.append(result['overall_score'])
                execution_times.append(result['execution_summary']['total_time'])
                
                # استراحت بین سناریوها (در شبیه‌سازی)
                time.sleep(0.01)
                
            except Exception as e:
                print(f"❌ خطا در سناریوی #{scenario_id}: {e}")
                all_results[f'scenario_{scenario_id}'] = {
                    'error': str(e),
                    'success': False
                }
        
        # تحلیل کلی
        successful_scenarios = sum(1 for r in all_results.values() 
                                 if r.get('success', False) or 
                                 r.get('overall_score', 0) > 0.9)
        
        return {
            'individual_results': all_results,
            'summary_statistics': {
                'total_scenarios': len(self.scenarios),
                'successful_scenarios': successful_scenarios,
                'success_rate': successful_scenarios / len(self.scenarios),
                'average_score': np.mean(scenario_scores) if scenario_scores else 0,
                'std_score': np.std(scenario_scores) if len(scenario_scores) > 1 else 0,
                'total_execution_time': sum(execution_times),
                'average_execution_time': np.mean(execution_times) if execution_times else 0
            },
            'certification': self._generate_overall_certification(
                successful_scenarios, len(self.scenarios)
            )
        }
    
    def _generate_overall_certification(self, successful: int, 
                                      total: int) -> Dict[str, Any]:
        """تولید گواهی کلی"""
        success_rate = successful / total if total > 0 else 0
        
        if success_rate >= 0.999:
            level = 'طلایی کوانتومی'
            status = 'تأیید کامل'
        elif success_rate >= 0.99:
            level = 'نقره‌ای کوانتومی'
