                    print(f"وضعیت: {'قبول' if qc_results['passed'] else 'رد'}")
                
                elif choice == '7':
                    print("\n👨‍🏫 راهنمای هوشمند کاربر:")
                    omega_system.interactive_user_session()
                
                elif choice == '8':
                    print("\n📋 در حال تهیه گزارش کامل...")
                    report = omega_system.generate_final_report()
                    summary = report['executive_summary']
                    print(f"پروژه: {summary['project_name']}")
                    print(f"ماموریت: {summary['mission']}")
                    print("\nدستاوردهای کلیدی:")
                    for achievement in summary['key_achievements']:
                        print(f"  • {achievement}")
                
                elif choice == '9':
                    print("\n🚀 شروع تحلیل کامل سیستم...")
                    results = omega_system.run_complete_analysis()
                    summary = results['summary']
                    perf = summary['performance_metrics']
                    print(f"\n📊 عملکرد کلی سیستم: {perf['overall_performance']*100:.2f}%")
                    print(f"سطح عملکرد: {perf['performance_level']}")
                    
                    print("\n🏆 قابلیت‌های کلیدی:")
