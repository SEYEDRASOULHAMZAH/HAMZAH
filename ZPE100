    def _assess_safety(self, requested_action: str, 
                     system_state: Dict[str, Any]) -> Dict[str, Any]:
        """ارزیابی ایمنی درخواست کاربر"""
        safety_levels = {
            'low_risk': ['مشاهده وضعیت', 'دریافت گزارش', 'تنظیم نمایش'],
            'medium_risk': ['تغییر پارامترها', 'شروع فرآیند', 'توقف فرآیند'],
            'high_risk': ['تغییرات اساسی', 'غیرفعال‌سازی ایمنی', 'دسترسی سطح بالا']
        }
        
        risk_level = 'low_risk'
        for level, actions in safety_levels.items():
            if requested_action in actions:
                risk_level = level
                break
        
        return {
            'risk_level': risk_level,
            'safety_score': {'low_risk': 1.0, 'medium_risk': 0.7, 'high_risk': 0.3}[risk_level],
            'required_authorization': risk_level != 'low_risk',
