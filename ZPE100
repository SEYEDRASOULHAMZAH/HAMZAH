        """اجرای یک سناریوی تست"""
        if scenario_id < 1 or scenario_id > len(self.scenarios):
            raise ValueError(f"شناسه سناریو باید بین ۱ و {len(self.scenarios)} باشد")
        
        scenario = self.scenarios[scenario_id - 1]
        
        print(f"🎯 شروع سناریوی تست #{scenario_id}: {scenario['name']}")
