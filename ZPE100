    def _analyze_emotional_tone(self, text: str) -> Dict[str, float]:
        """تحلیل لحن احساسی"""
        positive_words = ['عالی', 'ممتاز', 'عالیست', 'خوب', 'عالی']
        negative_words = ['بد', 'ضعیف', 'مشکل', 'خطا', 'ایراد']
        confused_words = ['نمی‌دانم', 'سردرگم', 'گیج', 'مبهم', 'پیچیده']
        
        positive_score = sum(1 for word in positive_words if word in text) / len(positive_words)
        negative_score = sum(1 for word in negative_words if word in text) / len(negative_words)
        confused_score = sum(1 for word in confused_words if word in text) / len(confused_words)
        
        return {
            'positive': positive_score,
            'negative': negative_score,
            'confused': confused_score,
            'neutral': 1.0 - (positive_score + negative_score + confused_score)
        }
    
    def _assess_knowledge_level(self, text: str, 
                              context: Dict[str, Any]) -> float:
        """ارزیابی سطح دانش کاربر"""
        beginner_indicators = ['چگونه', 'چطور', 'راهنمایی', 'کمک']
        advanced_indicators = ['بهینه‌سازی', 'پارامتر', 'تنظیمات پیشرفته', 'کد']
        
        beginner_score = sum(1 for word in beginner_indicators if word in text)
        advanced_score = sum(1 for word in advanced_indicators if word in text)
        
        if advanced_score > beginner_score:
            return 0.8  # پیشرفته
        elif beginner_score > 0:
            return 0.3  # مبتدی
        else:
            return 0.5  # متوسط
    
    def _detect_confusion(self, text: str) -> float:
        """تشخیص سردرگمی کاربر"""
        confusion_indicators = [
            'نمی‌فهمم', 'سردرگم', 'گیج', 'مبهم', 'پیچیده',
            '؟', 'چرا', 'چگونه', 'چه طور'
        ]
        
        score = sum(1 for indicator in confusion_indicators 
                   if indicator in text)
        
        # نرمال‌سازی
        return min(score / 5, 1.0)
    
