            },
            'overall_certification': self._generate_overall_qc_certification(
                passed_protocols, len(self.qc_protocols),
                np.mean(protocol_scores) if protocol_scores else 0
            ),
            'recommendations': self._generate_qc_recommendations(all_results)
        }
    
