    def run_all_qc_protocols(self, component_id: str = 'default') -> Dict[str, Any]:
        """اجرای تمام پروتکل‌های QC"""
        print(f"🔬 شروع اجرای تمام پروتکل‌های QC برای جزء {component_id}...")
        
        all_results = {}
        protocol_scores = []
        execution_times = []
        
        for protocol in self.qc_protocols:
            protocol_id = protocol['id']
            try:
                result = self.run_qc_protocol(protocol_id, component_id)
                all_results[f'protocol_{protocol_id}'] = result
                protocol_scores.append(result['qc_score'])
                execution_times.append(result['execution_time'])
                
                # استراحت بین پروتکل‌ها
