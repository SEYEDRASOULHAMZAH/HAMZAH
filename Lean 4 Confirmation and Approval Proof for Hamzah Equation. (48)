        if not action_deltas:
            return {"Verdict": "REJECT", "Action": "بردار کنش خالی است."}

        state_tensor = torch.tensor(action_deltas, dtype=torch.float32)
        total_action = torch.sum(torch.abs(state_tensor)).item()

        if total_action > 50.0:
            return {
                "Verdict": "REJECT",
