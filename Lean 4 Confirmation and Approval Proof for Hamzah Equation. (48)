        logging.info(f"Initializing Boson Mass Kernel for Cluster: {self.cluster_id} in {self.MANIFOLD_DIM}D Manifold.")

    def hip_boson_mass(self, i_density: float, s_mat: float) -> Union[float, str]:
        """محاسبه جرم بوزون بر اساس فرمول همزه با فیلتر کران پایین انتروپی"""
        if s_mat < 0:
            self.integrity_score -= 0.15
            logging.error("خطای ترمودینامیک: نویز انتروپی نمی‌تواند منفی باشد.")
            return "ERROR: Negative entropy noise detected."
        
        try:
            factor = (self.OMEGA_H / self.C) ** 2
            mass = i_density * factor * (s_mat + self.EPSILON_FLOOR)
            return float(mass * 1e-9) # خروجی به واحد گیگاالکترون‌ولت (GeV)
        except Exception as ex:
            self.integrity_score -= 0.3
            logging.error(f"خطای بحرانی در محاسبه جرم: {str(ex)}")
            return "ERROR: Calculation overflow."

    def evaluate_entropy_noise_spectrum(self) -> Dict[str, Any]:
        """ارزیابی طیف نویز انتروپی حسگرهای LHC برای بوزون‌های W و Z"""
        try:
            entropy_noise = np.linspace(0.1e-20, 0.5e-20, 5)
            results = []
            for s in entropy_noise:
                m_w = self.hip_boson_mass(self.I_W, float(s))
                m_z = self.hip_boson_mass(self.I_Z, float(s))
                results.append({
                    "Entropy_Noise_Level": float(s),
                    "Calculated_W_Mass_GeV": m_w,
                    "Calculated_Z_Mass_GeV": m_z
                })
            return {
                "Evaluation_Status": "STABLE_NOMINAL",
                "Manifold": f"{self.MANIFOLD_DIM}D",
                "Data": results
            }
        except Exception as ex:
            return {"Evaluation_Status": "ERROR", "Details": str(ex)}

    def run_boson_simulation_report(self) -> Dict[str, Any]:
        eval_res = self.evaluate_entropy_noise_spectrum()
        report = {
            "Timestamp": self.timestamp,
            "Cluster_ID": self.cluster_id,
            "Constants": {"OMEGA_H": self.OMEGA_H, "C": self.C, "EPSILON_FLOOR": self.EPSILON_FLOOR},
            "Simulation_Results": eval_res,
