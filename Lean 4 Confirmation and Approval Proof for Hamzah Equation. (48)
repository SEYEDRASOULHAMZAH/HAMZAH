        tensor_state = torch.tensor(mass_values, dtype=torch.float32)
        mean_mass = torch.mean(tensor_state).item()
        tensor_variance = torch.var(tensor_state).item()

        return {
            "Mean_Boson_Mass": float(mean_mass),
