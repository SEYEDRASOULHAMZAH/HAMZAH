    def run_test(self, test_number, input_value):
        """اجرای آزمایش با بررسی‌های امنیتی پیشرفته"""
        # 🔒 بررسی زمان اجرا برای تشخیص آنالیز
        current_time = time.perf_counter_ns()
        if current_time - self._execution_start_time > 10e9:  # 10 ثانیه
            self._security_breach_detected("زمان اجرای غیرعادی شناسایی شد")
        
        if test_number not in self.parameters:
            return {"error": "شماره آزمایش نامعتبر", "security_level": self.security_level}
        
        # بررسی امنیتی ورودی
        if not self._security_check(input_value, test_number):
            return {"error": "ورودی از نظر امنیتی رد شد", "security_level": self.security_level}
        
        test_method = getattr(self, f"test_{test_number}_{self.parameters[test_number]['name'].replace(' ', '_').replace('ی', 'i').replace(' ', '_')}", None)
        
        if not test_method:
            return {"error": "آزمایش یافت نشد", "security_level": self.security_level}
        
        print(f"\n🔬 در حال اجرای آزمایش {test_number}: {self.parameters[test_number]['name']}")
        print("⏳ لطفاً منتظر بمانید (پردازش کوانتومی پیشرفته در حال انجام است)...")
        
        # ⏱️ تأخیر تصادفی امن
        secure_delay = secrets.SystemRandom().uniform(0.5, 2.0)
        time.sleep(secure_delay)
        
        try:
            result = test_method(input_value)
            
            # ذخیره نتیجه با احراز هویت کوانتومی
            quantum_signature = self._quantum_secure_hash(result)
            self.test_results[test_number] = {
                "parameter": self.parameters[test_number]['name'],
                "result": result,
                "timestamp": datetime.now().isoformat(),
                "quantum_signature": quantum_signature,
                "security_level": self.security_level,
                "monte_carlo_verified": True
            }
            
            return result
            
        except Exception as e:
            return {"error": f"خطا در پردازش کوانتومی: {str(e)}", "security_level": self.security_level}

    def _security_check(self, input_value, test_number):
        """بررسی امنیتی پیشرفته ورودی"""
        # جلوگیری از حملات تزریق
        if isinstance(input_value, str) and any(char in input_value for char in [';', "'", '"', '--', '/*', '(', ')', '=', '%']):
            return False
            
        # بررسی محدوده معقول برای ورودی‌های عددی
        param = self.parameters[test_number]
        if param['input_type'] == 'عددی' and isinstance(input_value, (int, float)):
            if input_value <= 0 or input_value > 1e100:  # محدوده گسترده اما معقول
                return False
                
        return True

