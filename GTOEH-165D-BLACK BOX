        """محاسبه امتیاز امنیتی"""
        scores = []
        
        for group_name, results in all_results.items():
            for test in results:
                if test['status'] == 'PASS':
                    scores.append(1.0)
                elif test['status'] == 'WARNING':
                    scores.append(0.7)
                elif test['status'] == 'FAIL':
                    scores.append(0.3)
        
        return np.mean(scores) if scores else 0.0
    
