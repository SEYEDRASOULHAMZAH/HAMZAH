        failed_tests = 0
        warning_tests = 0
        
        for group_name, results in all_results.items():
            for test in results:
                total_tests += 1
                if test['status'] == 'PASS':
                    passed_tests += 1
                elif test['status'] == 'FAIL':
                    failed_tests += 1
                elif test['status'] == 'WARNING':
                    warning_tests += 1
        
        success_rate = passed_tests / total_tests if total_tests > 0 else 0
        
