        dreams = list(self.black_box.dream_engine.dream_engines.keys())
        
        print("\n✨ انتخاب آرزو برای اجرا:")
        for i, dream in enumerate(dreams, 1):
            print(f"   {i}. {dream.replace('_', ' ').title()}")
        
        try:
            choice = int(input("\n🎯 شماره آرزو: "))
            if 1 <= choice <= len(dreams):
                dream_name = dreams[choice-1]
                print(f"🚀 اجرای آرزوی: {dream_name.replace('_', ' ').title()}")
                
                # دریافت پارامترهای اختیاری
                parameters = {}
                add_params = input("➕ افزودن پارامترهای سفارشی؟ (y/n): ").lower()
                if add_params == 'y':
                    print("📝 پارامترها (key=value format، برای پایان enter خالی):")
                    while True:
                        param_input = input("   پارامتر: ")
                        if not param_input:
                            break
                        if '=' in param_input:
                            key, value = param_input.split('=', 1)
                            parameters[key.strip()] = value.strip()
                
                # اجرای آرزو
                result = self.black_box.dream_engine.execute_dream(dream_name, parameters)
                
                print(f"\n📊 نتایج آرزوی {dream_name}:")
