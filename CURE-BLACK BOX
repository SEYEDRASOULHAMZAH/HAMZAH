            # بررسی امنیتی
            security_check = self.security_auditor.check_test_security(test_id, test_info)
            
            return {
                'stress_test_id': test_id,
                'omega_test_id': omega_test_id,
                'test_name': test_info['name'],
                'test_group': test_info['group'],
                'success': test_success and quantum_validation['valid'] and ethical_check['ethical'] and security_check['secure'],
                'attack_simulated': attack_success,
                'quantum_validation': quantum_validation,
