    def _run_stress_tests_for_omega_test(self, omega_test_id: str) -> Dict[str, Any]:
        """اجرای ۲۰۰ تست استرس برای یک تست اُمگا"""
        stress_tests = self.stress_test_suite.get(omega_test_id, {})
        
        if not stress_tests:
            return {'error': f'هیچ تست استرسی برای {omega_test_id} یافت نشد'}
        
        start_time = time.time()
        test_results = []
        
        # اجرای ۲۰۰ تست استرس
        for stress_test_id, test_info in stress_tests.items():
            test_result = self._execute_single_stress_test(test_info, omega_test_id)
            test_results.append(test_result)
        
        # تحلیل نتایج
        analysis = self._analyze_stress_test_results(test_results)
        
        return {
