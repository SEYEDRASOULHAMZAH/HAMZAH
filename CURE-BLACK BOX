        """محاسبه رتبه امنیتی"""
        if score >= 0.999999:
            return 'ABSOLUTE_SECURITY'
        elif score >= 0.99999:
            return 'MAXIMUM_SECURITY'
        elif score >= 0.9999:
            return 'HIGH_SECURITY'
        elif score >= 0.99:
            return 'MEDIUM_SECURITY'
        else:
            return 'LOW_SECURITY'

