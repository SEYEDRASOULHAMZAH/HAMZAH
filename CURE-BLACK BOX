def create_sample_omega_tests(count: int = 50) -> Dict[str, Any]:
    """ایجاد نمونه تست‌های اُمگا برای آزمایش"""
    print(f"\n🧪 ایجاد {count} تست نمونه اُمگا...")
    
    sample_tests = {}
    
    # انواع تست
    test_types = [
        "TECHNICAL_SAFETY",
        "ONCOLOGY_GENETIC", 
        "CARDIO_METABOLIC",
        "NEURO_IMMUNE_PSYCH",
        "TRAUMA_INFECTIOUS_AGING"
    ]
    
    for i in range(1, count + 1):
        test_id = f"TEST-{i:03d}"
        test_type = test_types[i % len(test_types)]
        
        # ایجاد یک شبه-آبجکت تست
        test_obj = type('OmegaStressTest', (), {
            'test_id': test_id,
            'test_name_fa': f'تست نمونه {i} - {test_type}',
            'test_name_en': f'Sample Test {i} - {test_type}',
            'test_type': type('TestType', (), {'value': test_type})(),
            'severity_level': random.randint(5, 10),
            'scenario_description_fa': f'سناریوی تست نمونه شماره {i}',
            'initial_conditions': {'param1': 1.0, 'param2': 0.5},
            'success_criteria': {'success_rate': {'min': 0.999}},
            'execution_script': f'# کد تست نمونه {i}',
            'tensor_equations_used': [sym.Symbol(f'Ω_E_{i}')],
            'quantum_mechanisms': ['Quantum Entanglement', 'Superposition'],
            'ethical_challenge_level': random.randint(1, 5)
        })()
        
        sample_tests[test_id] = test_obj
    
    print(f"✅ {len(sample_tests)} تست نمونه ایجاد شد")
    return sample_tests

