            }
    
    def _simulate_attack(self, test_info: Dict[str, Any], omega_test_id: str) -> bool:
        """شبیه‌سازی حمله بر اساس نوع تست"""
        test_group = test_info.get('group', '')
        
        # نرخ موفقیت حمله بر اساس گروه تست
        attack_success_rates = {
            'رمزنگاری_کوانتومی': 0.0000001,  # 0.00001% chance
            'اخلاقی_NE': 0.000001,           # 0.0001% chance
            'پایداری_تانسور': 0.00001,       # 0.001% chance
            'امنیت_اجرا': 0.0001,            # 0.01% chance
            'مقاومت_مهندسی_معکوس': 0.00001,  # 0.001% chance
            'حفاظت_معادلات': 0.0000001,      # 0.00001% chance
            'ثبات_ابعاد_پنهان': 0.000001,    # 0.0001% chance
            'اعتبارسنجی_کوانتومی': 0.00001,  # 0.001% chance
            'پاسخ_به_حمله': 0.0001,         # 0.01% chance
            'تست_نهایی_جامع': 0.000001       # 0.0001% chance
        }
        
        base_rate = attack_success_rates.get(test_group, 0.001)
        
