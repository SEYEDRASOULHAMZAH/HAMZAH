                'security_score': results.get('successful_stress_tests', 0) / results.get('total_stress_tests', 1) if results.get('total_stress_tests', 0) > 0 else 0,
                'critical_issues': results.get('critical_failures', 0),
                'recommendations': self._generate_security_recommendations(results)
            }
            security_assessments.append(assessment)
        
        avg_security_score = np.mean([a['security_score'] for a in security_assessments]) if security_assessments else 0
        
        return {
            'audit_system': 'OMEGA_SECURITY_AUDITOR',
            'total_omega_tests_assessed': len(security_assessments),
