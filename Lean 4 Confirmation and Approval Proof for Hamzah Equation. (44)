    """
    def __init__(self) -> None:
        self.omega_h: float = 1.176e10
        self.epsilon_floor: float = 1.155e-20
        self.c: float = 299792458.0
        self.timestamp: str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
