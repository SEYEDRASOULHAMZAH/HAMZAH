        """محاسبه چگالی کف خلاء با کنترل خطاهای تفکیک‌شده و فیلتر مخرج صفر"""
        try:
            if self.c == 0:
                raise ZeroDivisionError("سرعت نور نمی‌تواند صفر باشد.")
            
            numerator = (self.omega_h ** 2) * self.epsilon_floor
            denominator = self.c ** 4
            
