    def __init__(self, omega_h: float = 1.176e10, epsilon_floor: float = 1.155e-20, c: float = 299792458.0, cluster_id: str = "Hamzah_Simulation_Cluster_1155") -> None:
        self.omega_h: float = omega_h
        self.epsilon_floor: float = epsilon_floor
        self.c: float = c
        self.cluster_id: str = cluster_id
        self.timestamp: str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.integrity_score: float = 1.0
        
        self.real_data = {
            "NREL": {"m": 5e-24, "s": 0.8e-20},
            "CERN": {"m": 1e-23, "s": 0.2e-20},
            "IBM_Quantum": {"m": 2e-24, "s": 1.5e-20},
            "Santa_Fe": {"m": 3e-24, "s": 3.0e-20}
        }
        logging.info(f"راه‌اندازی هسته شبیه‌سازی چندمرکزی برای کلاستر: {self.cluster_id}")

    def classical_energy(self, m: float) -> float:
        """محاسبه انرژی کلاسیک بر اساس E = mc^2"""
        return float(m * (self.c ** 2))

    def hamzah_energy(self, m: float, s_mat: float) -> Union[float, str]:
        """محاسبه انرژی HIP با اعمال کف پایداری هولوگرافیک و مهار تکینگی"""
        try:
            safe_s = max(0.0, float(s_mat))
            denominator = safe_s + self.epsilon_floor
            i_density = m * ((self.c ** 2) / (self.omega_h ** 2))
            energy = (i_density / denominator) * (self.omega_h ** 2)
            if np.isnan(energy) or np.isinf(energy):
                self.integrity_score -= 0.15
                return "ERROR: انحراف تانسوری (NaN/Inf)"
            return float(energy)
        except Exception as e:
            self.integrity_score -= 0.2
            logging.error(f"خطای محاسباتی HIP در شبیه‌سازی: {str(e)}")
            return f"ERROR: {str(e)}"

