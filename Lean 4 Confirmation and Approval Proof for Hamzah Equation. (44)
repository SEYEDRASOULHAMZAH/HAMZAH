    def calculate_raw_density(self) -> Union[float, str]:
        """محاسبه چگالی خام با کنترل خطاهای تفکیک‌شده و فیلتر ممیز شناور"""
        try:
            exponent = self.omega_h * self.psi_will
            raw_density = self.i_vacuum * np.exp(exponent)
            
            if np.isnan(raw_density) or np.isinf(raw_density):
                raise ValueError("محاسبه چگالی خام به مقدار نامعتبر (NaN یا Inf) منجر شد.")
                
            return float(raw_density)
        except Exception as e:
            self.integrity_score -= 0.3
