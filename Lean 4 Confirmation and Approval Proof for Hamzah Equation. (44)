import numpy as np
import datetime
import logging
from typing import Dict, Any, List, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahHIPScenarioEngine:
    """
    HamzahXcell: Information Primacy (HIP) Scenario Evaluation Kernel (Omega Production Grade)
    موتور محاسباتی پیشرفته برای ارزیابی سناریوهای بحرانی و جلوگیری از واگرایی تکینگی در ابعاد ۱۱۵۵D.
    """
    def __init__(self, omega_h: float = 1.176e10, epsilon_floor: float = 1.155e-20, c: float = 299792458.0, cluster_id: str = "Hamzah_HIP_Scenarios") -> None:
        self.omega_h: float = omega_h
        self.epsilon_floor: float = epsilon_floor
        self.c: float = c
        self.cluster_id: str = cluster_id
        self.timestamp: str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.integrity_score: float = 1.0
        logging.info(f"راه‌اندازی هسته ارزیابی سناریوهای HIP برای کلاستر: {self.cluster_id}")

    def hip_compute(self, i_density: float, s_mat: float) -> Union[float, str]:
        """محاسبه انرژی مبتنی بر حاکمیت اطلاعاتی حمزه با مهار خطاهای تقسیم بر صفر و انتروپی منفی"""
        try:
            safe_s = max(0.0, float(s_mat))
            denominator = safe_s + self.epsilon_floor
            if denominator == 0.0:
                self.integrity_score -= 0.2
                return "ERROR: مخرج مقادیر صفر است."
            
            energy = (float(i_density) / denominator) * (self.omega_h ** 2)
            if np.isnan(energy) or np.isinf(energy):
                self.integrity_score -= 0.3
                return "ERROR: خطای آنتروپی محاسباتی (NaN/Inf)."
            return float(energy)
        except Exception as e:
            self.integrity_score -= 0.25
            logging.error(f"خطای محاسباتی در HIP: {str(e)}")
            return f"ERROR: {str(e)}"

    def evaluate_all_scenarios(self) -> Dict[str, Any]:
        """ارزیابی جامع تمام سناریوهای فیزیک اطلاعاتی در مانیفلد ۱۱۵۵D"""
        scenarios = {
            "Normal State": (1e-24, 1e-20),
            "Zero Information (I=0)": (0.0, 1e-20),
            "Zero Entropy (S=0)": (1e-24, 0.0),
            "Massless State (m=0)": (0.0, 1e-20)
        }
        
        report_results = []
        for name, (m, s) in scenarios.items():
            i_den = m * (self.c ** 2 / self.omega_h ** 2)
            e_hip = self.hip_compute(i_den, s)
            
            status = "Stable"
            if isinstance(e_hip, str) and "ERROR" in e_hip:
                status = "CRASH (DivByZero/Singularity)"
            elif s == 0.0 and name != "Zero Entropy (S=0)":
                status = "CRASH (Singular Entropy)"

            report_results.append({
                "Scenario": name,
                "HIP_Energy": f"{e_hip:.4e}" if isinstance(e_hip, float) else e_hip,
                "Status": status
            })

        return {
            "Timestamp": self.timestamp,
            "Cluster_ID": self.cluster_id,
            "Scenarios": report_results,
            "Integrity_Score": round(self.integrity_score, 2),
            "Engine_Status": "HIP_SCENARIOS_VERIFIED_1155D"
        }

if __name__ == "__main__":
    engine = HamzahHIPScenarioEngine()
    report = engine.evaluate_all_scenarios()
    print(f"{'Scenario':<25} | {'HIP Energy (J)':<20} | {'Status'}")
    print("-" * 65)
    for sc in report["Scenarios"]:
        print(f"{sc['Scenario']:<25} | {str(sc['HIP_Energy']):<20} | {sc['Status']}")
    print(f"\n[HAMZAH-XCELL] Integrity Score: {report['Integrity_Score']}")
    print("\n[HAMZAH-XCELL] هسته سناریوهای HIP با موفقیت اجرا شد.")

