            self.integrity_score -= 0.15
            logging.error("خطای تنسوری: ماتریس داده‌های رصدی خالی است.")
            return 0.0, 0.0, 0.0

        try:
            tensor_contraction = np.einsum('abcd,abcd->', self.H_tensor, observational_data)
            energy = float(np.sum(tensor_contraction) * 1.618)
            safe_data = np.maximum(observational_data, 1e-10)
            entropy = float(-np.sum(safe_data * np.log(safe_data)))
            matter_metric = float(np.sqrt(energy**2 + entropy**2))
            return energy, entropy, matter_metric
        except Exception as e:
            self.integrity_score -= 0.3
            logging.error(f"خطای محاسباتی در انقباض تنسوری: {str(e)}")
            return 0.0, 0.0, 0.0

    async def stream_observation_data(self) -> None:
        """شبیه‌سازی دریافت و پردازش بلادرنگ داده‌های رصدی در منیفولد ۱۱۵۵ بعدی"""
