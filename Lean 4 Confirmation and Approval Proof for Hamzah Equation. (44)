            mean_classical = torch.mean(classical_energies).item()
            convergent_nodes = int(torch.sum(hamzah_energies > 0.0).item())

            return {
                "Mean_Classical_Energy": float(mean_classical),
                "Mean_Hamzah_Energy": float(mean_hamzah),
                "Energy_Diff_Variance": float(energy_diff_variance),
                "Convergent_Manifold_Nodes": convergent_nodes,
