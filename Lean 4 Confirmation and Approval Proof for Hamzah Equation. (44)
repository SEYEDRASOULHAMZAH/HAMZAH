            hip_energies = (i_density / (entropies + eps_tensor)) * torch.pow(omega_tensor, 2)

            mean_classical = torch.mean(classical_energies).item()
            mean_hip = torch.mean(hip_energies).item()
            tensor_stable = torch.all(hip_energies >= 0.0).item()

            return {
                "Mean_Classical_Tensor_Energy": float(mean_classical),
                "Mean_HIP_Tensor_Energy": float(mean_hip),
                "Tensor_Stability_Verified": bool(tensor_stable),
                "Topology": "Zariski_Research_Telemetry_Tensor_1155D"
            }
        except Exception as e:
