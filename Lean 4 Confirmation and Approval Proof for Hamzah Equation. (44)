        logging.info(f"راه‌اندازی هسته کنترل انرژی بلادرنگ برای کلاستر: {self.cluster_id}")

    def calculate_classical_runaway_energy(self, time_step: float, noise: float) -> float:
        """مدل کلاسیک: رشد غیرقابل کنترل انرژی و واگرایی سیستم (بدون کنترل اطلاعاتی)"""
        energy = (time_step ** 1.5) + noise
