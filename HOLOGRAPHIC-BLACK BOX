    def _measure_system_stability(self) -> float:
        """اندازه‌گیری پایداری سیستم"""
        # استفاده از تانسور حمزه
        tensor_stability = abs(np.trace(self.tensor_system.tensor @ 
                                       self.tensor_system.tensor.conj().T))
        normalized_stability = tensor_stability / self.constants.hamzah_dimensions
        
        # بهبود با عملگر یکانی
        unitary_stability = abs(np.trace(self.tensor_system.unitary_operator @ 
                                        self.tensor_system.unitary_operator.conj().T))
        unitary_normalized = unitary_stability / self.constants.hamzah_dimensions
        
        # میانگین پایداری
        overall_stability = (normalized_stability + unitary_normalized) / 2
        
        return float(overall_stability)
    
    def _analyze_comprehensive_results(self, security: Dict, baseline: Dict, 
                                      stress_tests: Dict) -> Dict[str, Any]:
        """تحلیل جامع نتایج"""
