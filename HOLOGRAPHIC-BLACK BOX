        start_time = time.time()
        results = {}
        
        if parallel:
            # اجرای موازی با استفاده از ProcessPoolExecutor
            with ProcessPoolExecutor(max_workers=mp.cpu_count()) as executor:
                futures = {}
                
                for scenario in self.scenarios:
                    future = executor.submit(self._run_single_scenario, scenario)
                    futures[future] = scenario['id']
                
                # جمع‌آوری نتایج
                for future in futures:
                    scenario_id = futures[future]
                    try:
                        result = future.result(timeout=3600)  # زمان‌بندی 1 ساعت
                        results[scenario_id] = result
                        
                        # نمایش پیشرفت
                        progress = len(results) / len(self.scenarios) * 100
                        print(f"   پیشرفت: {progress:.1f}% - سناریو {scenario_id} تکمیل شد")
                        
                    except Exception as e:
                        results[scenario_id] = {
                            'success': False,
                            'error': str(e),
                            'execution_time': 0,
                            'details': {}
                        }
        else:
            # اجرای سریالی
            for scenario in self.scenarios:
                scenario_id = scenario['id']
                result = self._run_single_scenario(scenario)
                results[scenario_id] = result
                
                # نمایش پیشرفت
                progress = scenario_id / len(self.scenarios) * 100
                print(f"   پیشرفت: {progress:.1f}% - سناریو {scenario_id} تکمیل شد")
        
        total_time = time.time() - start_time
        
        # تحلیل نتایج
        analysis = self._analyze_results(results)
        
        return {
            'total_scenarios': len(self.scenarios),
            'executed_scenarios': len(results),
            'total_execution_time': total_time,
            'scenario_results': results,
            'overall_analysis': analysis,
