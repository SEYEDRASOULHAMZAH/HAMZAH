        # بررسی یکپارچگی
        integrity_valid = self.security_system.verify_integrity(encrypted)
        
        # تست مقاومت در برابر حملات
        attack_resistance = self._test_attack_resistance()
        
        return {
            'encryption_test': {
                'original_data_size': len(test_data),
                'encryption_layers': len(encrypted['encrypted_layers']),
                'obfuscation_applied': encrypted.get('obfuscation_matrix_applied', False),
