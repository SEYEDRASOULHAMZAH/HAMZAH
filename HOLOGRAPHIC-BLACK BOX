        }
    
    def _run_single_scenario(self, scenario: Dict[str, Any]) -> Dict[str, Any]:
        """اجرای یک سناریوی تست استرس"""
        scenario_id = scenario['id']
        start_time = time.time()
        
        try:
            # بر اساس گروه سناریو، تست مناسب را اجرا می‌کنیم
            group = scenario['group']
            
            if group == 'دقت فوق‌فراپلانک':
                result = self._run_precision_test(scenario)
            elif group == 'شرایط فوق‌شدید':
                result = self._run_extreme_conditions_test(scenario)
            elif group == 'بلندمدت فوق‌بحرانی':
                result = self._run_long_term_test(scenario)
            elif group == 'امنیت فوق‌مطلق':
                result = self._run_security_test(scenario)
            elif group == 'عملکرد فوق‌بحرانی':
                result = self._run_performance_test(scenario)
            elif group == 'علیت و زمان':
                result = self._run_causality_test(scenario)
            elif group == 'ابعاد و هندسه':
                result = self._run_dimensional_test(scenario)
            elif group == 'آگاهی و اخلاق':
                result = self._run_consciousness_test(scenario)
            elif group == 'کیهانی و فراکیهانی':
                result = self._run_cosmic_test(scenario)
            elif group == 'نهایی و ترکیبی':
                result = self._run_combined_test(scenario)
            else:
                result = {'success': False, 'error': 'گروه سناریو ناشناخته'}
            
            execution_time = time.time() - start_time
            
            return {
                'scenario_id': scenario_id,
                'scenario_name': scenario['name'],
                'group': group,
                'success': result.get('success', False),
                'execution_time': execution_time,
                'details': result.get('details', {}),
