            return "ERROR: داده‌های دما نمی‌توانند تهی باشند."

        mat = np.array(channel_temperatures, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.manifold_integrity = 0.4
            logging.error("خطای ابعاد: داده‌های دما برای تحلیل تانسوری ناکافی است.")
            return "ERROR: ابعاد ماتریس نامعتبر است."

        cov_matrix = np.cov(mat, rowvar=False)
