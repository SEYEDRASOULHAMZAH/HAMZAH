import numpy as np

# داده‌های فاکتور مقیاس کیهانی در زمان‌های مختلف
scale_factor_data = [0.1, 0.5, 1.0, 2.3, 5.0]

# -------------------------------------------------------------
# ۱. پیاده‌سازی کلاسیک نرخ انبساط (بدون فیلتر پایداری متریک)
# -------------------------------------------------------------
def classic_expansion_rate(scale_factors):
    # محاسبه مشتق ساده بدون پوشش در برابر نوسانات تانسوری فضا
    return np.gradient(scale_factors)

# -------------------------------------------------------------
# ۲. پیاده‌سازی موتور تانسوری مانیفلد کیهانی حمزه (HamzahCosmicTensorEngine)
# -------------------------------------------------------------
class HamzahCosmicTensorEngine:
    def __init__(self, cluster_id="Hamzah_Cosmic_Tensor_Omega"):
        self.cluster_id = cluster_id
        self.stability_index = 1.0

    def compute_metric_expansion_tensor(self, scale_factors):
        """
        محاسبه تانسور انبساط متریک مجهز به فیلتر مهار واگرایی چگالی انرژی تاریک
        """
        if not scale_factors or any(sf <= 0 for sf in scale_factors):
            self.stability_index = 0.3
            return "ERROR: ناپایداری متریک! فاکتور مقیاس نمی‌تواند صفر یا منفی باشد."
        
        sf_array = np.array(scale_factors, dtype=np.float32)
        expansion_gradient = np.gradient(sf_array)
        
        # فیلتر تانسوری برای پایداری انحنای فضا-زمان
        damped_tensor = expansion_gradient * np.exp(-0.05 * sf_array)
        return [round(float(val), 4) for val in damped_tensor]

# -------------------------------------------------------------
# اجرای تست مقایسه‌ای تانسوری کیهانی
# -------------------------------------------------------------
if __name__ == "__main__":
    tensor_engine = HamzahCosmicTensorEngine()
    
    print("=== تست تانسوری اول: فاکتور مقیاس نرمال مانیفلد ===")
    print(f"فرمول کلاسیک: {classic_expansion_rate(scale_factor_data)}")
    print(f"موتور تانسوری Hamzah: {tensor_engine.compute_metric_expansion_tensor(scale_factor_data)}")
    
    print("\n=== تست تانسوری دوم: ورود داده‌های بحرانی و مقدار صفر مقیاس ===")
    invalid_sf = [1.0, 0.0, -2.0]
    res_err = tensor_engine.compute_metric_expansion_tensor(invalid_sf)
    print(f"موتور تانسوری Hamzah: {res_err} | ضریب پایداری مانیفلد: {tensor_engine.stability_index}")

 
