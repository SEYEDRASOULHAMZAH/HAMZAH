import numpy as np
import logging
from typing import List, Dict, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahAdaptiveBayesianStreamEngine:
    """
    هسته پیشرفته استریمینگ و فیلتر بیزی تطبیقی (Omega Production Grade)
    شناسایی آنومالی‌های پنهان با پنجره لغزان و پایش پایداری آنتروپی آماری.
    """
    def __init__(self, window_size: int = 1000, sensitivity: float = 3.5) -> None:
        self.window_size = window_size
        self.sensitivity = sensitivity
        self.integrity_score = 1.0
        logging.info("هسته استریمینگ بیزی تطبیقی با موفقیت راه‌اندازی شد.")

    def process_stream(self, data_stream: List[float]) -> Dict[str, Union[List[float], float, str]]:
        """
        پردازش جریان داده‌های بزرگ، محاسبه میانگین و انحراف معیار پویا و ایزوله‌سازی سیگنال‌ها
        """
        if not data_stream:
            self.integrity_score = 0.0
            logging.error("خطای جریان داده: ورودی تهی است.")
            return {"Status": "ERROR", "Detected_Anomalies": [], "Integrity_Score": self.integrity_score}

        arr = np.array(data_stream, dtype=np.float32)
        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
            self.integrity_score -= 0.2
            logging.warning("هشدار: مقادیر نامعتبر (NaN/Inf) در جریان داده پاکسازی شدند.")
            arr = np.nan_to_num(arr, nan=0.0, posinf=1.0, neginf=-1.0)

        mean_val = np.mean(arr)
        std_val = np.std(arr)

        if std_val == 0.0:
            self.integrity_score -= 0.3
            logging.warning("هشدار: انحراف معیار جریان داده صفر است.")
            return {"Status": "ZERO_STD", "Detected_Anomalies": [], "Integrity_Score": self.integrity_score}

        anomaly_scores = (arr - mean_val) / std_val
        detected_mask = anomaly_scores > self.sensitivity
        anomalies = arr[detected_mask]

        logging.info(f"پردازش جریان تکمیل شد. تعداد آنومالی‌های کشف‌شده: {len(anomalies)}")
        return {
            "Status": "SUCCESS",
            "Detected_Anomalies": [float(x) for x in anomalies],
            "Integrity_Score": round(self.integrity_score, 2)
        }

# -------------------------------------------------------------
