import math

# داده‌های واقعی کیهانی
h0 = 70.0  # ضوابط ثابت هابل (km/s/Mpc)
speed_of_light = 299792.458  # سرعت نور بر حسب کیلومتر بر ثانیه

# -------------------------------------------------------------
# ۱. پیاده‌سازی کلاسیک (کورکورانه، بدون درک قوانین نسبیت و مرز سرعت نور)
# -------------------------------------------------------------
def classic_hubbles_law(distance, h0_val):
    """
    این فرمول فقط ضرب ساده انجام می‌دهد و کاری به محدودیت‌های فیزیکی جهان ندارد؛
    اگر فاصله بسیار زیاد باشد، سرعتی بالاتر از سرعت نور تولید می‌کند که نقض فیزیک است!
    """
    return h0_val * distance

# -------------------------------------------------------------
# ۲. پیاده‌سازی موتور هوشمند حمزه (HamzahXcell Kernel - Relativistic Control)
# -------------------------------------------------------------
class HamzahXcellKernel:
    def __init__(self, cluster_id="Hamzah_Cosmic_Alpha"):
        self.cluster_id = cluster_id
        self.integrity_score = 1.0
        self.cosmic_limit = speed_of_light

    def calculate_cosmic_recession(self, distance, h0_val):
        """
        محاسبه سرعت دور شدن کهکشان با اعمال فیلتر مرز افق رویداد کیهانی و پایداری مانیفلد
        """
        if distance <= 0 or h0_val <= 0:
            self.integrity_score = 0.5
            return "ERROR: ابعاد کیهانی یا ثابت هابل نامعتبر است."
            
        velocity = h0_val * distance
        
        # لایه هوشمند: بررسی اینکه آیا کهکشان از افق دید جهان قابل مشاهده خارج شده است؟
        if velocity > self.cosmic_limit:
            self.integrity_score = 0.75  # اعلام هشدار برای خروج از محدوده فیزیک کلاسیک
            return f"BOUND_REACHED: خارج از افق کیهانی! سرعت فرضی تانسوری: {velocity:,.2f} km/s (مهار شده)"
            
        return f"{velocity:,.2f} km/s"

# -------------------------------------------------------------
# اجرای تست مقایسه‌ای و تحلیل خروجی مانیفلد
# -------------------------------------------------------------
if __name__ == "__main__":
    kernel = HamzahXcellKernel()
    
    # تست کهکشان نزدیک (Virgo) و کهکشان دور (Deep Space)
    dist_virgo = 16.5
    dist_deep = 5000.0 
    
    print("=== گزارش تحلیل کیهانی مانیفلد ===")
    print(f"کهکشان خوشه سنبله (Virgo) - فاصله: {dist_virgo} Mpc")
    print(f" -> فرمول کلاسیک: {classic_hubbles_law(dist_virgo, h0):,.2f} km/s")
    print(f" -> موتور HamzahXcell: {kernel.calculate_cosmic_recession(dist_virgo, h0)}")
    
    print("-" * 65)
    
    print(f"کهکشان اعماق کیهان (Deep Space) - فاصله: {dist_deep} Mpc")
    print(f" -> فرمول کلاسیک: {classic_hubbles_law(dist_deep, h0):,.2f} km/s (نقض آشکار قوانین نسبیت!)")
    print(f" -> موتور HamzahXcell: {kernel.calculate_cosmic_recession(dist_deep, h0)} | امتیاز پایداری: {kernel.integrity_score}")

 
