import numpy as np
import logging
from typing import List, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahRollingSigmaDynamicFilterEngine:
    """
    هسته پیشرفته فیلتر پنجره متحرک با انحراف معیار پویا (Omega Production Grade)
    شناسایی و اصلاح هوشمند اسپایک‌ها و نویزهای لحظه‌ای در استریم داده‌های سنسور.
    """
    def __init__(self, window_size: int = 10, threshold_sigma: float = 3.0) -> None:
        self.window_size = window_size
        self.threshold_sigma = threshold_sigma
        self.history: List[float] = []
        self.integrity_score = 1.0
        logging.info("هسته فیلتر پنجره متحرک بیزی با موفقیت راه‌اندازی شد.")

    def process_sample(self, raw_value: float) -> Union[float, str]:
        """
        بررسی مقدار ورودی، محاسبه پویای میانگین و انحراف معیار پنجره متحرک و مهار اسپایک
        """
        if np.isnan(raw_value) or np.isinf(raw_value):
            self.integrity_score -= 0.1
            logging.warning("مقدار نامعتبر (NaN/Inf) شناسایی شد. استفاده از آخرین مقدار پایدار.")
            return self.history[-1] if self.history else 0.0

        self.history.append(raw_value)
        if len(self.history) < 5:
            return float(raw_value)

        window = self.history[-self.window_size:]
        moving_mean = float(np.mean(window))
        moving_std = float(np.std(window))
        moving_std = max(moving_std, 1e-5) # جلوگیری از تقسیم بر صفر

        if abs(raw_value - moving_mean) > (self.threshold_sigma * moving_std):
            self.integrity_score -= 0.05
            logging.warning(f"اسپایک لحظه‌ای شناسایی شد: {raw_value:.2f}. اصلاح با میانگین متحرک: {moving_mean:.2f}")
            corrected = moving_mean
            self.history[-1] = corrected # به‌روزرسانی تاریخچه با مقدار اصلاح‌شده
            return round(corrected, 4)

        logging.info("نمونه داده با موفقیت از فیلتر عبور کرد.")
        return round(raw_value, 4)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی هسته پنجره متحرک
# -------------------------------------------------------------
if __name__ == "__main__":
    np.random.seed(42)
    engine = HamzahRollingSigmaDynamicFilterEngine()
    print("--- تست هسته پنجره متحرک متکی بر انحراف معیار ---")
    
    for i in range(20):
        raw = 25.0 + np.random.normal(0, 0.5)
        if i == 10: 
            raw = 45.0 # اسپایک فندک الکتریکی
        clean = engine.process_sample(raw)
        print(f"ثانیه {i:02d} -> خام: {raw:6.2f} | خروجی فیلترشده (حمزه): {clean:6.2f}")
    
    print(f"امتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

