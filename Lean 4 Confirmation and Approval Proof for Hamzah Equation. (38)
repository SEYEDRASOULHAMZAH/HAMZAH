import numpy as np
import logging
from typing import List, Union, Dict

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahXcellAnomalyEngine:
    """
    موتور پیشرفته تشخیص آنومالی بیزی و فیلترینگ نویز (HamzahXcell-AnomalyEngine - Omega Production Grade)
    شناسایی سیگنال‌های واقعی در حضور نویز پس‌زمینه با تنظیم پویای آستانه حساسیت.
    """
    def __init__(self, sensitivity: float = 3.0) -> None:
        self.sensitivity = sensitivity
        self.integrity_score = 1.0
        logging.info("هسته تشخیص آنومالی بیزی حمزه با موفقیت مستقر شد.")

    def detect_signals(self, data_stream: List[float]) -> Union[List[float], str]:
        """
        محاسبه پویای میانگین، انحراف معیار و ایزوله‌سازی سیگنال‌های واقعی از نویز
        """
        if not data_stream:
            self.integrity_score = 0.2
            logging.error("خطای آنومالی: جریان داده‌های ورودی خالی است.")
            return "ERROR: جریان داده نمی‌تواند تهی باشد."

        arr = np.array(data_stream, dtype=np.float32)
        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
            self.integrity_score = 0.4
            logging.warning("هشدار: مقادیر نامعتبر (NaN/Inf) در جریان داده شناسایی شد.")
            arr = np.nan_to_num(arr, nan=0.0, posinf=1.0, neginf=-1.0)

        mean_val = np.mean(arr)
        std_val = np.std(arr)

        if std_val == 0.0:
            self.integrity_score = 0.6
            logging.warning("هشدار: انحراف معیار داده‌ها صفر است. بازگشت لیست خالی.")
            return []

        anomaly_scores = (arr - mean_val) / std_val
        filtered_indices = anomaly_scores > self.sensitivity
        isolated_signals = arr[filtered_indices]

        logging.info("فیلترینگ و تشخیص سیگنال‌های آنومالی با موفقیت انجام شد.")
        return [float(val) for val in isolated_signals]

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی موتور تشخیص آنومالی
# -------------------------------------------------------------
