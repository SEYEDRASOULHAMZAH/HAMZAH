import numpy as np
import logging
from typing import Dict, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahCausalGrowthPredictionEngine:
    """
    هسته پیشرفته پیش‌بینی رشد علی و مدیریت ظرفیت باربری (Omega Production Grade)
    مدل‌سازی مسیر علی لجستیک، محاسبه تطبیقی و فیلترینگ نویزهای محیطی.
    """
    def __init__(self, target_capacity: float = 100.0) -> None:
        self.K = target_capacity # ظرفیتِ نهاییِ پیش‌بینی شده
        self.integrity_score = 1.0
        logging.info("هسته پیشبینی رشد HamzahXcell-Level11 با موفقیت راه‌اندازی شد.")

    def predict_growth(self, current_pop: float, time_step: int) -> Union[float, str]:
        """
        پیش‌بینی وضعیتِ علیِ جمعیت و حرکت به سمت ظرفیت نهایی K با مهار نویز
        """
        if np.isnan(current_pop) or np.isinf(current_pop):
            self.integrity_score -= 0.15
            logging.warning("مقدار نامعتبر (NaN/Inf) در جمعیت شناسایی شد.")
            return 0.0

        if current_pop < 0.0:
            self.integrity_score -= 0.1
            logging.error("خطا: جمعیت نمی‌تواند منفی باشد.")
            return "ERROR: مقدار جمعیت نامعتبر است."

        # مدلِ لجستیکِ ایده‌آل (مسیرِ علی)
        r = 0.5
        ideal_growth = current_pop + (r * current_pop * (1.0 - current_pop / self.K))
        
        logging.info(f"گام {time_step}: محاسبه مسیر علی با موفقیت انجام شد.")
        return float(ideal_growth)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی پیش‌بینی رشد علی
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahCausalGrowthPredictionEngine(target_capacity=100.0)
    pop_data = [10.0, 15.0, 23.0, 35.0, 52.0] # نویز: رشدِ ناگهانی در گام ۳
    
    current_p = 10.0
    print("--- تست رسمی هسته پیش‌بینی رشد HamzahXcell ---")
    print(f"{'گام':<5} | {'جمعیت (با نویز)':<20} | {'HamzahXcell (مسیرِ علی)'}")
    
    for i, p in enumerate(pop_data):
        pred = engine.predict_growth(current_p, i)
        print(f"{i:<5} | {p:<20.1f} | {pred:<20.2f}")
        current_p = p # به‌روزرسانی بر اساس واقعیت
    
    print(f"\nامتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

