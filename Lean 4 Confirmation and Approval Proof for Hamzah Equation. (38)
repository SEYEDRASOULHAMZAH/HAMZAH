class HamzahAdaptiveSpikeFilterEngine:
    """
    هسته هوشمند مهار اسپایک و فیلتر تطبیقی نرخ تغییرات (Omega Production Grade)
    تشخیص آنومالی‌های لحظه‌ای و مهار پرش‌های ناگهانی در داده‌های سنسور صنعتی.
    """
    def __init__(self, max_delta: float = 5.0, initial_value: float = 25.0) -> None:
        self.max_delta = max_delta
        self.last_stable = initial_value
        self.integrity_score = 1.0
        logging.info("هسته فیلتر تطبیقی مهار اسپایک حمزه با موفقیت مستقر شد.")

    def process_reading(self, raw_value: float) -> Union[float, str]:
        """
        بررسی انحراف مقدار خام از آخرین وضعیت پایدار و فیلتر کردن پرش‌های غیرفیزیکی
        """
        if np.isnan(raw_value) or np.isinf(raw_value):
            self.integrity_score -= 0.15
            logging.warning("هشدار: مقدار نامعتبر (NaN/Inf) در خوانش سنسور شناسایی شد.")
            return self.last_stable

        # بررسی منطقی نرخ تغییرات (مشتق گسسته)
        delta = abs(raw_value - self.last_stable)
        if delta > self.max_delta:
            self.integrity_score -= 0.05
            logging.warning(f"اسپایک ناگهانی شناسایی شد: {raw_value:.2f} (تغییر بیش از حد مجاز). مهار روی مقدار پایدار: {self.last_stable:.2f}")
            return self.last_stable

        self.last_stable = raw_value
        logging.info("خوانش سنسور با موفقیت تایید و پردازش شد.")
        return float(raw_value)

