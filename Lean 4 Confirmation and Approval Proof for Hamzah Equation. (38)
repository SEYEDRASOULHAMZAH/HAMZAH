import numpy as np
import logging
from typing import List, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahCausalEntityRenderingEngine:
    """
    هسته پیشرفته رندر موجودیت علی و فیلتر میانه متحرک (Omega Production Grade)
    استخراج سیگنال بنیادین و مهار نویز رله پیش از رندر نهایی داده‌ها.
    """
    def __init__(self, memory_depth: int = 5, deviation_multiplier: float = 2.0) -> None:
        self.memory_depth = memory_depth
        self.deviation_multiplier = deviation_multiplier
        self.memory: List[float] = []
        self.integrity_score = 1.0
        logging.info("هسته رندر موجودیت علی HamzahXcell با موفقیت راه‌اندازی شد.")

    def render_causal_entity(self, noisy_data: float) -> Union[float, str]:
        """
        محاسبه پایه علی و فیلتر کردن نویزهای ناگهانی بر اساس میانه و انحراف معیار حافظه
        """
        if np.isnan(noisy_data) or np.isinf(noisy_data):
            self.integrity_score -= 0.15
            logging.warning("هشدار علی: مقدار ورودی نامعتبر (NaN/Inf) است.")
            return self.memory[-1] if self.memory else 0.0

        self.memory.append(noisy_data)
        if len(self.memory) > self.memory_depth:
            self.memory.pop(0)

        if len(self.memory) > 1:
            causal_basis = float(np.np.median(self.memory) if hasattr(np, 'np') else np.median(self.memory))
            std_val = float(np.std(self.memory))
            std_val = max(std_val, 1e-5) # جلوگیری از انحراف صفر

            # بررسی انحراف از پایه علی
            if abs(noisy_data - causal_basis) > (self.deviation_multiplier * std_val):
                self.integrity_score -= 0.05
                logging.warning(f"نویز رله شناسایی شد: {noisy_data:.2f}. بازگشت به موجودیت علی: {causal_basis:.2f}")
                self.memory[-1] = causal_basis # اصلاح تاریخچه با مقدار بنیادین
                return round(causal_basis, 4)

        logging.info("داده علی با موفقیت رندر و تایید شد.")
        return round(noisy_data, 4)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی رندر موجودیت علی
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahCausalEntityRenderingEngine()
    data_stream = [25.0, 25.1, 24.9, 25.2, 80.0, 25.0, 25.1] # عدد ۸۰ نویز رله است
    
