import numpy as np
import logging
from typing import List, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahAdvancedSensorFilterEngine:
    """
    هسته فیلترینگ پیشرفته سنسورها با بافر لغزان تطبیقی (Omega Production Grade)
    تشخیص و اصلاح آنومالی‌های ناشی از پرش‌های شدید محیطی.
    """
    def __init__(self, buffer_size: int = 10, deviation_threshold: float = 2.0) -> None:
        self.buffer_size = buffer_size
        self.deviation_threshold = deviation_threshold
        self.buffer: List[float] = []
        self.integrity_score = 1.0
        logging.info("هسته فیلترینگ پیشرفته سنسور راه‌اندازی شد.")

    def filter_reading(self, raw_sensor_value: float) -> Union[float, str]:
        """
        ارزیابی مقدار سنسور، محاسبه میانگین بافر و حذف پرش‌های غیرمنطقی (Outliers)
        """
        if np.isnan(raw_sensor_value) or np.isinf(raw_sensor_value):
            self.integrity_score -= 0.1
            logging.warning("هشدار: مقدار نامعتبر در ورودی سنسور شناسایی شد.")
            return self.buffer[-1] if self.buffer else 0.0

        if not self.buffer:
            self.buffer.append(raw_sensor_value)
            return raw_sensor_value

        mean_val = float(np.mean(self.buffer))
        std_val = float(np.std(self.buffer)) if len(self.buffer) > 1 else 1.0
        std_val = max(std_val, 1e-5) # جلوگیری از تقسیم بر صفر

        # بررسی انحراف از میانگین بر اساس آستانه حساسیت
        if abs(raw_sensor_value - mean_val) > (self.deviation_threshold * std_val):
            self.integrity_score -= 0.05
            logging.warning(f"پرش غیرمنطقی شناسایی شد: {raw_sensor_value:.2f}. اصلاح با میانگین بافر.")
            corrected_value = mean_val
        else:
            corrected_value = raw_sensor_value

        # به‌روزرسانی بافر لغزان
        self.buffer.append(corrected_value)
        if len(self.buffer) > self.buffer_size:
            self.buffer.pop(0)

        logging.info("فیلتر داده سنسور با موفقیت اعمال شد.")
        return round(corrected_value, 4)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی فیلتر سنسور
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahAdvancedSensorFilterEngine()
    print("--- تست فیلتر پیشرفته سنسور ---")
    simulated_data = [25.0, 25.5, 38.2, 24.8, 25.2, 12.0, 25.1]
    
    for idx, val in enumerate(simulated_data):
        clean_val = engine.filter_reading(val)
        print(f"گام {idx+1} -> خام: {val:.2f} | فیلترشده (حمزه): {clean_val}")
    
    print(f"امتیاز پایداری نهایی هسته: {round(engine.integrity_score, 2)}")

