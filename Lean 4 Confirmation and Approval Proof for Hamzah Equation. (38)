Python
import numpy as np
import logging
from typing import List, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahEMINoiseFilterEngine:
    """
    هسته پیشرفته فیلتر نویز EMI و حفظ لبه اطلاعات (Omega Production Grade)
    تفکیک نویزهای فرکانس بالا (Jitter) از تغییرات و لبه‌های معنادار پله‌ای سیگنال.
    """
    def __init__(self, sensitivity: float = 2.0) -> None:
        self.sensitivity = sensitivity
        self.integrity_score = 1.0
        logging.info("هسته فیلتر نویز EMI HamzahXcell-Level5 با موفقیت راه‌اندازی شد.")

    def clean_signal(self, noisy_signal: List[float]) -> Union[List[float], str]:
        """
        پاکسازی سیگنال آلوده با تکیه بر آستانه حساسیت علی و حفظ اطلاعات لبه
        """
        if not noisy_signal or len(noisy_signal) < 3:
            self.integrity_score -= 0.2
            logging.error("خطای سیگنال: طول بردار ورودی برای فیلترینگ ناکافی است.")
            return "ERROR: بردار سیگنال نامعتبر یا بسیار کوتاه است."

        filtered = []
        for i in range(1, len(noisy_signal) - 1):
            curr_val = noisy_signal[i]
            prev_val = noisy_signal[i-1]
            
            if np.isnan(curr_val) or np.isinf(curr_val):
                self.integrity_score -= 0.05
                logging.warning(f"مقدار نامعتبر در ایندکس {i} شناسایی و اصلاح شد.")
                filtered.append(prev_val)
                continue

            delta = abs(curr_val - prev_val)
            if delta < self.sensitivity:
                # حذف نویز (Jitter) با تکیه بر مقدار پیشین
                filtered.append(prev_val)
            else:
                # حفظ اطلاعات جدید و لبه معنادار (Edge)
                filtered.append(curr_val)

        logging.info("فیلترینگ سیگنال و حذف نویز EMI با موفقیت انجام شد.")
        return filtered

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی فیلتر هوشمند سیگنال
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahEMINoiseFilterEngine(sensitivity=2.0)
    
    # تولید داده شبیه‌سازی‌شده
    base_signal = np.array([10.0, 10.0, 10.0, 20.0, 20.0, 20.0, 30.0, 30.0, 30.0])
    np.random.seed(42)
    emi_noise = np.random.normal(0, 0.3, len(base_signal))
    noisy_input = base_signal + emi_noise
    
    cleaned_output = engine.clean_signal(list(noisy_input))
    
    print("--- تست رسمی هسته فیلتر نویز HamzahXcell ---")
    print(f"{'داده آلوده (EMI)':<20} | {'HamzahXcell (اطلاعات خالص)':<20}")
    # تطبیق برای نمایش چاپ
    for n, c in zip(noisy_input[1:-1], cleaned_output):
        print(f"{n:<20.2f} | {c:<20.2f}")
    
    print(f"\nامتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

