class HamzahTensorPortfolioRiskEngine:
    """
    موتور ارزیابی ریسک سبد سرمایه‌گذاری تانسوری با محافظت در برابر تکینگی ماتریس کوواریانس
    """
    def __init__(self, engine_id: str = "Hamzah_Portfolio_Risk_Omega") -> None:
        self.engine_id = engine_id
        self.risk_integrity = 1.0

    def compute_portfolio_var(self, asset_returns: List[float], confidence_level: float = 0.95) -> Union[float, str]:
        """
        محاسبه Value at Risk با فیلتر مقادیر نامعتبر و اعتبارسنجی تانسوری
        """
        if not asset_returns:
            self.risk_integrity = 0.2
            logging.error("خطای ریسک: بردار بازده دارایی‌ها خالی است.")
            return "ERROR: بردار بازده نمی‌تواند تهی باشد."

        returns_np = np.array(asset_returns, dtype=np.float32)
        if np.any(np.isnan(returns_np)) or np.any(np.isinf(returns_np)):
            self.risk_integrity = 0.0
            logging.error("خطای بحرانی: مقادیر نامعتبر (NaN یا Inf) در داده‌های ریسک یافت شد.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در بازده دارایی‌ها یافت شد."

        mean_ret = np.mean(returns_np)
        std_ret = np.std(returns_np)
        var_value = mean_ret - std_ret * 1.645 # تقریب نرمال برای سطح اطمینان 95%
        
        logging.info("ارزش در معرض ریسک (VaR) با موفقیت محاسبه شد.")
