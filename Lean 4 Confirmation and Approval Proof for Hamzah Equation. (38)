            return f"CLASSICAL_LIMIT: {classic_local_realism_solver(a1, a2, b1, b2):.4f}"
            
        # همبستگی کوانتومی دو فوتون درهم‌تنیده برابر است با: -cos(2 * (A - B))
        corr_a1b1 = -np.cos(2 * (a1 - b1))
        corr_a1b2 = -np.cos(2 * (a2 - b2))
        corr_a2b1 = -np.cos(2 * (a2 - b1))
        corr_a2b2 = -np.cos(2 * (a2 - b2))
        
        # شاخص نابرابری CHSH بل
        s_value = abs(corr_a1b1 - corr_a1b2 + corr_a2b1 + corr_a2b2)
        
