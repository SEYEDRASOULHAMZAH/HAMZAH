import numpy as np
import logging
from typing import List, Union

logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahTensorRealTimeManifoldEngine:
    """
    موتور تانسوری تحلیل ماتریسی کوواریانس جریان‌های زنده DAQ (Omega Production Grade)
    """
    def __init__(self, cluster_id: str = "Hamzah_RealTime_Tensor_Omega") -> None:
        self.cluster_id = cluster_id
        self.manifold_integrity = 1.0

    def compute_stream_covariance_norm(self, stream_matrix: List[List[float]]) -> Union[float, str]:
        """
        محاسبه ماتریس کوواریانس جریان‌های لحظه‌ای و نرم تانسوری فروبنیوس آن
        """
        if not stream_matrix:
            self.manifold_integrity = 0.2
            logging.error("خطای تانسوری: ماتریس جریان زنده خالی است.")
            return "ERROR: ماتریس داده‌ها نمی‌تواند تهی باشد."

        mat = np.array(stream_matrix, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.manifold_integrity = 0.4
            logging.error("خطای ابعاد: داده‌های جریان برای تحلیل ماتریسی کافی نیست.")
            return "ERROR: ابعاد ماتریس نامعتبر است."

        cov_matrix = np.cov(mat, rowvar=False)
        if np.any(np.isnan(cov_matrix)) or np.any(np.isinf(cov_matrix)):
            self.manifold_integrity = 0.0
            logging.error("خطای بحرانی: ناپایداری در ماتریس کوواریانس جریان زنده.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس جریان."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری کوواریانس جریان زنده با موفقیت محاسبه شد.")
        return round(tensor_norm, 4)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی موتور تانسوری جریان زنده
# -------------------------------------------------------------
if __name__ == "__main__":
    tensor_engine = HamzahTensorRealTimeManifoldEngine()
    sample_stream_data = [
        [1.2, 1155.05, 7500.0],
        [0.1, 1140.20, 120.0],
        [0.3, 1141.50, 95.0]
    ]
    
