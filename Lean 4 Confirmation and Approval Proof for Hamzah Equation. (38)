import numpy as np
import logging
from typing import List, Union

logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahTensorPressureManifoldEngine:
    """
    موتور تانسوری تحلیل ماتریسی کوواریانس فشار و مانیفلد چندکاناله (Omega Production Grade)
    """
    def __init__(self, cluster_id: str = "Hamzah_Pressure_Tensor_Omega") -> None:
        self.cluster_id = cluster_id
        self.manifold_integrity = 1.0

    def compute_pressure_covariance_norm(self, channel_pressures: List[List[float]]) -> Union[float, str]:
        """
        محاسبه ماتریس کوواریانس جریان‌های فشار و نرم تانسوری فروبنیوس آن
        """
        if not channel_pressures:
            self.manifold_integrity = 0.2
            logging.error("خطای تانسوری: جریان فشار خالی است.")
            return "ERROR: داده‌های فشار نمی‌توانند تهی باشند."

        mat = np.array(channel_pressures, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.manifold_integrity = 0.4
            logging.error("خطای ابعاد: داده‌های فشار برای تحلیل تانسوری ناکافی است.")
            return "ERROR: ابعاد ماتریس نامعتبر است."

        cov_matrix = np.cov(mat, rowvar=False)
        if np.any(np.isnan(cov_matrix)) or np.any(np.isinf(cov_matrix)):
            self.manifold_integrity = 0.0
            logging.error("خطای بحرانی: ناپایداری در ماتریس کوواریانس فشار.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس فشار."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری کوواریانس فشار با موفقیت محاسبه شد.")
        return round(tensor_norm, 4)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی موتور تانسوری فشار
