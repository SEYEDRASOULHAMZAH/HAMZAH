class HamzahTensorAnomalyMatrixEngine:
    """
    موتور تانسوری تحلیل همبستگی چندبعدی آنومالی‌ها (Omega Production Grade)
    """
    def __init__(self, engine_id: str = "Hamzah_Tensor_Anomaly_Omega") -> None:
        self.engine_id = engine_id
        self.matrix_integrity = 1.0

    def compute_anomaly_covariance_norm(self, multi_feature_data: List[List[float]]) -> Union[float, str]:
        """
        محاسبه نرم فروبنیوس ماتریس کوواریانس ویژگی‌های جریان داده
        """
        if not multi_feature_data:
            self.matrix_integrity = 0.1
            logging.error("خطای تانسوری: ماتریس ویژگی‌های چندبعدی خالی است.")
            return "ERROR: ماتریس داده‌ها نمی‌تواند تهی باشد."

        mat = np.array(multi_feature_data, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.matrix_integrity = 0.3
            logging.error("خطای ابعاد: ابعاد ماتریس ویژگی‌ها برای تحلیل کافی نیست.")
            return "ERROR: ابعاد ماتریس ناکافی است."

        cov_matrix = np.cov(mat, rowvar=False)
        if np.any(np.isnan(cov_matrix)) or np.any(np.isinf(cov_matrix)):
            self.matrix_integrity = 0.0
            logging.error("خطای بحرانی: ناپایداری تانسوری در ماتریس کوواریانس.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری ماتریس کوواریانس با موفقیت محاسبه شد.")
        return round(tensor_norm, 4)

