class HamzahGravitationalStressFilterEngine:
    """
    هسته پیشرفته مهار تنش گرانشی و میدان‌های خارجی (Omega Production Grade)
    تفکیک تنش‌های آنی محیطی (مانند نزدیک شدن آهنربا) از حرکت‌های واقعی سیستم.
    """
    def __init__(self, stress_threshold: float = 10.0) -> None:
        self.causal_entity_state = 0.0
        self.stress_threshold = stress_threshold
        self.integrity_score = 1.0
        logging.info("هسته مهار تنش گرانشی HamzahXcell-Level2 با موفقیت راه‌اندازی شد.")

    def process_reading(self, sensor_reading: float) -> Union[float, str]:
        """
        بررسی اختلاف مقدار ورودی با حالت علی و مهار تنش‌های فراتر از آستانه مجاز
        """
        if np.isnan(sensor_reading) or np.isinf(sensor_reading):
            self.integrity_score -= 0.15
            logging.warning("هشدار: مقدار نامعتبر (NaN/Inf) در خوانش سنسور شناسایی شد.")
            return self.causal_entity_state

        if self.causal_entity_state == 0.0:
            self.causal_entity_state = sensor_reading
            return sensor_reading

        diff = abs(sensor_reading - self.causal_entity_state)
        if diff > self.stress_threshold:
            self.integrity_score -= 0.05
            logging.warning(f"تنش گرانشی/خارجی شناسایی شد: {sensor_reading:.2f}. حفظ هسته علی: {self.causal_entity_state:.2f}")
            return self.causal_entity_state

        self.causal_entity_state = sensor_reading
        logging.info("داده سنسور با موفقیت تایید و حالت علی به‌روزرسانی شد.")
        return float(sensor_reading)

