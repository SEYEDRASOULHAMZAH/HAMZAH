import numpy as np

# داده‌های اصطکاک ذهنی کاربران در بخش‌های مختلف سیستم
cognitive_friction_data = [1.2, 3.4, 0.8, 5.6, 2.1]

# -------------------------------------------------------------
# ۱. پیاده‌سازی کلاسیک بار ذهنی (بدون فیلتر پایداری تانسوری)
# -------------------------------------------------------------
def classic_cognitive_load(frictions):
    # محاسبه میانگین اصطکاک بدون پوشش در برابر پرش‌های ناگهانی استرس کاربر
    return np.mean(frictions) * np.std(frictions)

# -------------------------------------------------------------
# ۲. پیاده‌سازی موتور تانسوری مانیفلد شناختی حمزه (HamzahCognitiveTensorEngine)
# -------------------------------------------------------------
class HamzahCognitiveTensorEngine:
    def __init__(self, cluster_id="Hamzah_Cognitive_Tensor_Omega"):
        self.cluster_id = cluster_id
        self.stability_index = 1.0

    def compute_safe_cognitive_tensor(self, frictions):
        """
        محاسبه تانسور پایداری شناختی مجهز به فیلتر مهار استرس ذهنی و مقادیر نامعتبر
        """
        if not frictions or any(f < 0 for f in frictions):
            self.stability_index = 0.3
            return "ERROR: ناپایداری تانسوری شناختی! اصطکاک ذهنی منفی یا خالی است."
        
        tensor_array = np.array(frictions, dtype=np.float32)
        mean_f = np.mean(tensor_array)
        std_f = np.std(tensor_array)
        
        # فیلتر تانسوری برای میرایی نوسانات پرش توجه و حفظ تعادل عصبی
        damped_tensor = float(mean_f * std_f * np.exp(-0.03 * std_f))
        return round(damped_tensor, 4)

# -------------------------------------------------------------
# اجرای تست مقایسه‌ای تانسوری شناختی
# -------------------------------------------------------------
if __name__ == "__main__":
    tensor_engine = HamzahCognitiveTensorEngine()
    
    print("=== تست تانسوری اول: اصطکاک ذهنی نرمال کاربران ===")
    print(f"فرمول کلاسیک: {classic_cognitive_load(cognitive_friction_data):.4f}")
    print(f"موتور تانسوری Hamzah: {tensor_engine.compute_safe_cognitive_tensor(cognitive_friction_data)}")
    
    print("\n=== تست تانسوری دوم: ورود داده‌های بحرانی و پرش شناختی شدید ===")
    extreme_frictions = [2.0, 50.0, 1.0, 0.5]
    res_err = tensor_engine.compute_safe_cognitive_tensor(extreme_frictions)
