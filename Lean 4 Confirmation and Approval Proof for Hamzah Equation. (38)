            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس تنش."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری ماتریس کوواریانس تنش با موفقیت محاسبه شد.")
