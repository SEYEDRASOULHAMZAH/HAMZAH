import numpy as np
import logging
from typing import Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahSCFDampingConvergenceEngine:
    """
    هسته پیشرفته پایش همگرایی SCF و کنترل واگرایی چگالی (Omega Production Grade)
    شناسایی نوسانات شدید در محاسبات چگالی و اعمال ضرایب تعدیل‌گر علی.
    """
    def __init__(self, damping_factor: float = 0.3) -> None:
        self.damping = damping_factor
        self.integrity_score = 1.0
        logging.info("هسته همگرایی SCF HamzahXcell-Level10 با موفقیت راه‌اندازی شد.")

    def iterate_scf(self, current_density: float, new_density: float) -> Union[float, str]:
        """
        بررسی همگرایی علی و اعمال ضریب دمپینگ در صورت بروز واگرایی یا نوسان
        """
        if np.isnan(current_density) or np.isnan(new_density) or np.isinf(current_density):
            self.integrity_score -= 0.15
            logging.warning("هشدار عددی: مقادیر چگالی نامعتبر (NaN/Inf) شناسایی شد.")
            return current_density

        diff = new_density - current_density
        
        # شناساییِ شروعِ واگرایی (نوسان)
        if abs(diff) > 0.5:
            self.integrity_score -= 0.02
            logging.warning(f"واگرایی شناسایی شد! اختلاف: {diff:.3f}. اعمال کنترل حمزه...")
            # فرمولِ حمزه: میانگینِ وزنی برای بازگشت به مسیر
            corrected_density = current_density + (diff * self.damping)
            return float(corrected_density)

        logging.info("چگالی در مسیر همگرایی پایدار است.")
        return float(new_density)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی همگرایی SCF
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahSCFDampingConvergenceEngine(damping_factor=0.3)
    density_history = [0.1, 0.9, 0.2, 0.8, 0.3] # نوسانِ شدید کلاسیک
    
    current_d = 0.1
    print("--- تست رسمی هسته همگرایی SCF HamzahXcell ---")
    print(f"{'گام':<5} | {'حدسِ کلاسیک':<15} | {'خروجی حمزه (پایداری)'}")
    
    for i, d in enumerate(density_history):
        clean_d = engine.iterate_scf(current_d, d)
        print(f"{i:<5} | {d:<15.3f} | {clean_d:<20.3f}")
        current_d = clean_d # به‌روزرسانی برای گام بعد
    
    print(f"\nامتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

