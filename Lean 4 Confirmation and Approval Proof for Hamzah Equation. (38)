import logging
from typing import Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

# ثابت معیار لوسن برای واکنش گداخت دوتریوم-تریتیم (D-T)
LAWSON_THRESHOLD = 3.0e21  # keV * s / m^3

# -------------------------------------------------------------
# ۱. پیاده‌سازی کلاسیک (فقط ضرب ریاضی بدون درک پایداری پلاسما)
# -------------------------------------------------------------
def classic_fusion_solver(density: float, temperature: float, confinement_time: float) -> float:
    """
    این فرمول فقط حاصل‌ضرب سه‌گانه را حساب می‌کند و ضریب بازدهی انرژی (Q)
    را به صورت کاملاً خطی بالا می‌برد، بدون اینکه متوجه انفجار یا فروپاشی پلاسما شود.
    """
    triple_product = density * temperature * confinement_time
    q_factor = triple_product / LAWSON_THRESHOLD
    return q_factor

# -------------------------------------------------------------
# ۲. موتور هوشمند حمزه (HamzahFusionKernel - MHD Plasma Monitor)
# -------------------------------------------------------------
class HamzahFusionKernel:
    def __init__(self, cluster_id: str = "Hamzah_Fusion_Alpha") -> None:
        self.cluster_id = cluster_id
        self.integrity_score = 1.0
        self.greenwald_density_limit = 1.0e20  # حد مجاز چگالی پلاسما در توکامک (m^-3)

    def execute_plasma_fusion_protocol(self, density: float, temperature: float, confinement_time: float) -> Union[str, float]:
        """
        هسته هوشمند حمزه: تحلیل معیار لوسن همراه با پایش ناپایداری‌های مغناطیسی پلاسما
        """
        if density <= 0 or temperature <= 0 or confinement_time <= 0:
            self.integrity_score = 0.3
            logging.error("خطای فیزیکی: مقادیر فیزیکی پلاسما نامعتبر یا صفر است.")
            return "ERROR: مقادیر فیزیکی پلاسما نامعتبر است."

        # لایه هوشمند حمزه: پایش حد گرین‌والد برای جلوگیری از فروپاشی ناگهانی
        if density > self.greenwald_density_limit:
            self.integrity_score = 0.0  # خاموشی اضطراری رآکتور
            logging.warning("هشدار بحرانی پلاسما: چگالی از حد گرین‌والد عبور کرد و ناپایداری رخ داد.")
            return "PLASMA_DISRUPTION: فروپاشی مغناطیسی! چگالی از حد گرین‌والد فراتر رفت."

        # محاسبه حاصل‌ضرب سه‌گانه گداخت
        triple_product = density * temperature * confinement_time
        q_factor = triple_product / LAWSON_THRESHOLD

        if q_factor >= 10.0:
            logging.info("فاز احتراق پایدار با موفقیت برقرار شد.")
            return f"FUSION_BREAKEVEN_SUCCESS: فاز احتراق پایدار. ضریب (Q) = {q_factor:.2f}."
        elif q_factor >= 1.0:
            logging.info("بازدهی انرژی مثبت ثبت شد.")
            return f"NET_ENERGY_GAIN: بازدهی مثبت. ضریب (Q) = {q_factor:.2f}."
        else:
            return f"ENERGY_SINK: گداخت ناپایدار. ضریب (Q) = {q_factor:.2f}."

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی و مقایسه عملکرد
# -------------------------------------------------------------
if __name__ == "__main__":
    kernel = HamzahFusionKernel()
    
    iter_density = 0.8e20
    iter_temp = 15.0
    iter_time = 3.8
    danger_density = 1.5e20  # فراتر از حد مجاز
    
    print("=== تست اول: شبیه‌سازی فاز احتراق پایدار ===")
    print(f"فرمول کلاسیک : Q = {classic_fusion_solver(iter_density, iter_temp, iter_time):.2f}")
    print(f"موتور HamzahXcell : {kernel.execute_plasma_fusion_protocol(iter_density, iter_temp, iter_time)}")
    
    print("\n=== تست دوم: افزایش بی‌رویه چگالی و پدیده فروپاشی پلاسما ===")
    print(f"فرمول کلاسیک (گمراه‌کننده) : Q = {classic_fusion_solver(danger_density, iter_temp, iter_time):.2f}")
    print(f"موتور HamzahXcell : {kernel.execute_plasma_fusion_protocol(danger_density, iter_temp, iter_time)}")
    print(f"وضعیت پایداری هسته: {kernel.integrity_score}")

 
