# -------------------------------------------------------------
# ۱. پیاده‌سازی کلاسیک تحلیل نقدینگی (بدون فیلتر پایداری تانسوری)
# -------------------------------------------------------------
def classic_market_volatility(flows):
    # محاسبه میانگین ساده بدون پوشش در برابر شوک‌های ناگهانی بازار
    return np.mean(flows) * np.std(flows)

# -------------------------------------------------------------
# ۲. پیاده‌سازی موتور تانسوری مانیفلد نقدینگی حمزه (HamzahEconophysicsTensorEngine)
# -------------------------------------------------------------
class HamzahEconophysicsTensorEngine:
    def __init__(self, cluster_id="Hamzah_Econophysics_Omega"):
        self.cluster_id = cluster_id
        self.stability_index = 1.0

    def compute_safe_market_tensor(self, flows):
        """
        محاسبه تانسور انحنای سرمایه مجهز به فیلتر مهار شوک‌های نقدینگی و مقادیر نامعتبر
        """
        if not flows or any(f < 0 for f in flows):
            self.stability_index = 0.3
            return "ERROR: ناپایداری تانسوری بازار! جریان سرمایه منفی یا خالی است."
        
        tensor_array = np.array(flows, dtype=np.float32)
        mean_val = np.mean(tensor_array)
        std_val = np.std(tensor_array)
        
        # فیلتر تانسوری برای میرایی نوسانات مخرب مارکت
        damped_volatility = float(mean_val * std_val * np.exp(-0.02 * std_val))
        return round(damped_volatility, 4)

# -------------------------------------------------------------
# اجرای تست مقایسه‌ای تانسوری بازار
# -------------------------------------------------------------
