    print(f"نرم فروبنیوس ماتریس کوواریانس جریان: {tensor_engine.compute_stream_covariance_norm(sample_stream_data)}")
    print(f"شاخص یکپارچگی مانیفلد ثبت‌شده: {tensor_engine.manifold_integrity}")

