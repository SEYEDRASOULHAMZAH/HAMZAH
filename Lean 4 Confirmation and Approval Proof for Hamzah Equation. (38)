import numpy as np
import logging
from typing import Union, List

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahCausalPharmacokineticEngine:
    """
    هسته پیشرفته کینتیک دارویی علی و پالایش تداخلات متابولیتی (Omega Production Grade)
    مدل‌سازی انحنای نمایی غلظت دارو و مهار نویزهای متابولیک.
    """
    def __init__(self, half_life_constant: float = 0.693) -> None:
        self.k = half_life_constant # ثابتِ سرعتِ دفعِ دارو
        self.integrity_score = 1.0
        logging.info("هسته کینتیک دارویی HamzahXcell-Level13 با موفقیت راه‌اندازی شد.")

    def verify_metabolic_integrity(self, current_conc: float, previous_conc: float) -> Union[float, str]:
        """
        پیش‌بینیِ کینتیکِ علی و پالایش تداخلات متابولیتی غلظت دارو
        """
        if np.isnan(current_conc) or np.isnan(previous_conc) or np.isinf(current_conc):
            self.integrity_score -= 0.15
            logging.warning("مقدار نامعتبر (NaN/Inf) در غلظت دارویی شناسایی شد.")
            return previous_conc

        if current_conc < 0.0 or previous_conc < 0.0:
            self.integrity_score -= 0.1
            logging.error("خطا: غلظت دارو نمی‌تواند منفی باشد.")
            return "ERROR: مقدار غلظت نامعتبر است."

        # دارویِ خالص باید طبقِ قانونِ نمایی کاهش یابد
        expected_conc = previous_conc * np.exp(-self.k * 0.1)
        
        # اگر اختلافِ غلظتِ واقعی با مدلِ کینتیکِ دارویی خیلی زیاد باشد، 
        # یعنی یک پیکِ متابولیتی (نویز) وارد شده است.
        if abs(current_conc - expected_conc) > 2.0:
            logging.warning("تداخلِ متابولیتی شناسایی شد! بازیابیِ غلظتِ واقعی...")
            self.integrity_score -= 0.05
            return float(expected_conc) # بازگشت به 'موجودیتِ علی' دارو
        
        logging.info("تأیید سلامت کینتیک دارویی با موفقیت انجام شد.")
        return float(current_conc)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی کینتیک دارویی
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahCausalPharmacokineticEngine()
    conc_data = [50.0, 48.0, 46.0, 45.0, 42.0] # 45.0 نویزِ متابولیت است
    
    print("--- تست رسمی هسته کینتیک دارویی HamzahXcell ---")
    print(f"{'گام':<5} | {'داده خام (با نویز)' :<20} | {'HamzahXcell (داروی خالص)'}")
    prev = 50.0
    
    for i, conc in enumerate(conc_data):
        clean = engine.verify_metabolic_integrity(conc, prev)
        print(f"{i:<5} | {conc:<20} | {clean:<20.2f}")
        prev = clean # به‌روزرسانی برای گام بعد
    
    print(f"\nامتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

