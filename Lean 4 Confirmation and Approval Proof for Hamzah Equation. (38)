import numpy as np
import logging
from typing import List, Tuple, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahCausalStructuralBurstEngine:
    """
    هسته پیشرفته تحلیل یکپارچگی ساختاری و تشخیص ریزترک‌های علی (Omega Production Grade)
    شناسایی Burstها و گسیختگی‌های نقطه‌ای در بستر ارتعاشات نویزی.
    """
    def __init__(self, energy_spike_threshold: float = 10.0) -> None:
        self.threshold = energy_spike_threshold
        self.integrity_score = 1.0
        logging.info("هسته تحلیل ساختاری HamzahXcell-Level15 با موفقیت راه‌اندازی شد.")

    def analyze_structural_integrity(self, raw_data: List[float]) -> Union[List[Tuple[int, float]], str]:
        """
        بررسیِ Burst ناشی از گسیختگی و فیلترینگ نویزهای ارتعاشی پیوسته
        """
        if not raw_data or len(raw_data) < 2:
            self.integrity_score -= 0.2
            logging.error("خطای ساختاری: بردار داده‌های ارتعاشی برای تحلیل کافی نیست.")
            return "ERROR: بردار داده نامعتبر است."

        arr = np.array(raw_data, dtype=np.float32)
        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
            self.integrity_score -= 0.1
            logging.warning("مقادیر نامعتبر (NaN/Inf) در داده‌های ارتعاشی اصلاح شدند.")
            arr = np.nan_to_num(arr)

        detected_events = []
        for i in range(1, len(arr)):
            # محاسبه انرژیِ ناگهانی (مشتقِ مرتبه اول)
            energy_change = abs(arr[i] - arr[i-1])
            
            # اگر تغییرِ انرژی از آستانه فراتر رود، یعنی گسیختگیِ علی رخ داده است
            if energy_change > self.threshold:
                detected_events.append((int(i), float(arr[i])))
                logging.info(f"رویداد گسیختگی (ریزترک) در گام {i} با شدت {arr[i]} شناسایی شد.")
        
        logging.info("تحلیل یکپارچگی ساختاری با موفقیت به پایان رسید.")
        return detected_events

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی تشخیص ریزترک‌های ساختاری
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahCausalStructuralBurstEngine(energy_spike_threshold=8.0)
    
    np.random.seed(42)
    vibration_noise = np.random.normal(0, 2.0, 50).tolist() # نویزِ عادی سازه
    crack_signal = [0]*20 + [15.0] + [0]*29        # یک ریزترک در زمانِ 20
    data_stream = [v + c for v, c in zip(vibration_noise, crack_signal)]
    
    events = engine.analyze_structural_integrity(data_stream)
    
    print("--- تست رسمی هسته تحلیل ساختاری HamzahXcell ---")
    print(f"نتیجه تحلیل: {len(events)} گسیختگی شناسایی شد.")
    print(f"زمان و شدتِ ریزترک: {events}")
    print(f"\nامتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

