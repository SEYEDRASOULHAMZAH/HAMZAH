# -------------------------------------------------------------
def classic_density_update(density_matrix: List[List[float]], delta_matrix: List[List[float]]) -> List[List[float]]:
    return (np.array(density_matrix) + np.array(delta_matrix)).tolist()

# -------------------------------------------------------------
# ۲. موتور پایش و میراسازی نوسانات ماتریس چگالی حمزه
# -------------------------------------------------------------
class HamzahDensityMatrixEngine:
    def __init__(self, engine_id: str = "Hamzah_Density_Matrix_Omega") -> None:
        self.engine_id = engine_id
        self.damping_factor = 0.5
        self.matrix_integrity = 1.0

    def stabilize_density_matrix(self, current_dm: List[List[float]], proposed_dm: List[List[float]]) -> Union[List[List[float]], str]:
        """
        میراسازی نوسانات چگالی الکترونی با فیلتر استواری تانسوری برای جلوگیری از واگرایی SCF
        """
        if not current_dm or not proposed_dm:
            self.matrix_integrity = 0.1
            logging.error("خطای ماتریس چگالی: ابعاد ورودی خالی است.")
            return "ERROR: ماتریس‌های چگالی نامعتبر یا تهی هستند."

        curr_np = np.array(current_dm, dtype=np.float32)
        prop_np = np.array(proposed_dm, dtype=np.float32)

        if curr_np.shape != prop_np.shape:
            self.matrix_integrity = 0.2
            return "ERROR: عدم تطابق ابعاد ماتریس‌های چگالی در تکرار SCF."

        # اعمال ضریب میراسازی پالس (Pulay Mixing Damping) برای جلوگیری از ناپایداری
        stabilized_matrix = curr_np + self.damping_factor * (prop_np - curr_np)

        if np.any(np.isnan(stabilized_matrix)) or np.any(np.isinf(stabilized_matrix)):
            self.matrix_integrity = 0.0
            return "FATAL_DIVERGENCE: واگرایی مقادیر تانسوری در بروزرسانی ماتریس چگالی."

        logging.info("ماتریس چگالی با موفقیت میراسازی و پایدار شد.")
        return stabilized_matrix.tolist()

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی ماتریس چگالی
