def classic_transition_norm(transition_matrix):
    return float(np.linalg.norm(np.array(transition_matrix)))

# -------------------------------------------------------------
# ۲. موتور تانسوری ارزیابی ایستای حمزه (HamzahMarkovTensorEngine)
# -------------------------------------------------------------
class HamzahMarkovTensorEngine:
    def __init__(self, engine_id: str = "Hamzah_Markov_Tensor_Omega") -> None:
        self.engine_id = engine_id
        self.tensor_integrity = 1.0

    def compute_stationary_tensor_stability(self, transition_matrix: List[List[float]]) -> Union[float, str]:
        """
        ارزیابی پایداری تانسوری ماتریس انتقال و بررسی همگرایی به توزیع ایستا با فیلتر خطا
        """
        if not transition_matrix:
            self.tensor_integrity = 0.1
            logging.error("خطای ساختار تانسوری: ماتریس انتقال خالی است.")
            return "ERROR: ماتریس انتقال نمی‌تواند تهی باشد."

        mat_np = np.array(transition_matrix, dtype=np.float32)
        
        if mat_np.shape[0] != mat_np.shape[1]:
            self.tensor_integrity = 0.2
            return "ERROR: ماتریس انتقال باید مربعی باشد."

        tensor_norm = np.linalg.norm(mat_np, ord=1)

        if np.isnan(tensor_norm) or np.isinf(tensor_norm):
            self.tensor_integrity = 0.0
            return "TENSOR_SINGULARITY_CRITICAL: ناپایداری شدید در نرم تانسور انتقال."

        logging.info("نرم تانسوری ماتریس انتقال با موفقیت محاسبه شد.")
        return round(float(tensor_norm), 4)

