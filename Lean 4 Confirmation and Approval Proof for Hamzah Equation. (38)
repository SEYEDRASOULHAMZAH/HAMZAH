            logging.error("خطای بحرانی: ناپایداری در ماتریس کوواریانس دما.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس دما."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری کوواریانس دما با موفقیت محاسبه شد.")
