        self.stability_index = 1.0

    def compute_safe_organizational_tensor(self, resources):
        """
        محاسبه تانسور کارایی سازمانی مجهز به فیلتر مهار انحرافات مصرف و نوسانات بحرانی منابع
        """
        if not resources or any(r < 0 for r in resources):
            self.stability_index = 0.2
            return "ERROR: ناپایداری تانسوری سازمانی! منابع تخصیصی منفی یا خالی است."
        
        tensor_array = np.array(resources, dtype=np.float32)
        mean_res = np.mean(tensor_array)
        max_res = np.max(tensor_array)
        std_res = np.std(tensor_array)
        
        # فیلتر تانسوری برای توزیع بهینه بار و میرایی نوسانات ساختاری بوروکراسی
        damped_efficiency = float((mean_res / (max_res + 1e-5)) * np.exp(-0.015 * std_res))
        return round(damped_efficiency, 4)

# -------------------------------------------------------------
# اجرای تست مقایسه‌ای تانسوری سازمانی
