import numpy as np
import logging
from typing import List, Union

logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahTensorDynamicCovarianceEngine:
    """
    موتور تانسوری تحلیل کوواریانس و پایداری پنجره‌ای چندبعدی (Omega Production Grade)
    """
    def __init__(self, cluster_id: str = "Hamzah_Tensor_Window_Omega") -> None:
        self.cluster_id = cluster_id
        self.engine_integrity = 1.0

    def compute_rolling_covariance_norm(self, matrix_blocks: List[List[float]]) -> Union[float, str]:
        """
        محاسبه ماتریس کوواریانس بلوک‌های پنجره‌ای و نرم تانسوری آن برای پایش انتروپی
        """
        if not matrix_blocks:
            self.engine_integrity = 0.2
            logging.error("خطای تانسوری: بلوک‌های داده خالی هستند.")
            return "ERROR: بلوک داده نمی‌تواند تهی باشد."

        mat = np.array(matrix_blocks, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.engine_integrity = 0.4
            logging.error("خطای ابعاد: ابعاد ماتریس برای تحلیل کوواریانس ناکافی است.")
            return "ERROR: ابعاد ماتریس نامعتبر است."

        cov_matrix = np.cov(mat, rowvar=False)
        if np.any(np.isnan(cov_matrix)) or np.any(np.isinf(cov_matrix)):
            self.engine_integrity = 0.0
            logging.error("خطای بحرانی: ناپایداری در ماتریس کوواریانس تانسور.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری ماتریس کوواریانس پنجره‌ای با موفقیت محاسبه شد.")
        return round(tensor_norm, 4)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی موتور تانسوری پنجره‌ای
# -------------------------------------------------------------
