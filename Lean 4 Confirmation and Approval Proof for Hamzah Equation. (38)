import numpy as np
import logging
from typing import List, Union

logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahTensorDriftManifoldEngine:
    """
    موتور تانسوری تحلیل ماتریسی کوواریانس جریان داده‌های مدل و انحرافات (Omega Production Grade)
    """
    def __init__(self, cluster_id: str = "Hamzah_Drift_Tensor_Omega") -> None:
        self.cluster_id = cluster_id
        self.manifold_integrity = 1.0

    def compute_drift_covariance_norm(self, drift_tensor_data: List[List[float]]) -> Union[float, str]:
        """
        محاسبه ماتریس کوواریانس داده‌های جریان مدل و نرم تانسوری فروبنیوس آن
        """
        if not drift_tensor_data:
            self.manifold_integrity = 0.2
            logging.error("خطای تانسوری: داده‌های جریان مدل خالی است.")
            return "ERROR: داده‌ها نمی‌توانند تهی باشند."

        mat = np.array(drift_tensor_data, dtype=np.float32)
        if mat.shape[0] < 2 or mat.shape[1] < 2:
            self.manifold_integrity = 0.4
            logging.error("خطای ابعاد: داده‌های جریان برای تحلیل تانسوری ناکافی است.")
            return "ERROR: ابعاد ماتریس نامعتبر است."

        cov_matrix = np.cov(mat, rowvar=False)
        if np.any(np.isnan(cov_matrix)) or np.any(np.isinf(cov_matrix)):
            self.manifold_integrity = 0.0
            logging.error("خطای بحرانی: ناپایداری در ماتریس کوواریانس انحرافات مدل.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس مدل."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری کوواریانس جریان مدل با موفقیت محاسبه شد.")
        return round(tensor_norm, 4)

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی موتور تانسوری انحراف مدل
# -------------------------------------------------------------
if __name__ == "__main__":
    tensor_engine = HamzahTensorDriftManifoldEngine()
    sample_drift_metrics = [
        [1.0, 2.0, 0.0],
        [2.0, 4.0, 0.0],
        [4.0, 12.0, 1.0]
    ]
    
