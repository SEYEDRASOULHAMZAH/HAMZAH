        """
        محاسبه پیشرفته دمای هاوکینگ مجهز به گاردریل تانسوری برای مهار تکینگی و مقادیر صفر/منفی
        """
        if mass <= 0:
            self.integrity_score = 0.4
            return "ERROR: خطای بحرانی تکینگی! جرم سیاه‌چاله نمی‌تواند صفر یا منفی باشد."
        
        # اعمال کران ایمنی ترمودینامیکی برای جلوگیری از شوک دما در مقادیر بسیار کوچک
        safe_mass = max(1e-15, mass)
