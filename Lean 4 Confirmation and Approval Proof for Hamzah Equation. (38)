# -------------------------------------------------------------
def classic_pareto_check(volumes):
    # رویکرد قدیمی: فرض صلب بر روی اینکد کردن شاخص‌ها بدون مرتب‌سازی پویا
    # فقط عنصر اول را برمی‌دارد چون به صورت پیش‌فرض فرض می‌کند اولین داده بزرگترین است!
    if not volumes:
        return 0
    classic_limit = int(len(volumes) * 0.2)  # 5 * 0.2 = 1
    return sum(volumes[:max(1, classic_limit)])

# -------------------------------------------------------------
# ۲. پیاده‌سازی موتور هوشمند حمزه (HamzahXcell Kernel - Dynamic Protocol)
# -------------------------------------------------------------
class HamzahXcellKernel:
    def __init__(self, cluster_id="Hamzah_Econophysics_Alpha"):
        self.cluster_id = cluster_id
        self.integrity_score = 1.0

    def allocate_economic_resources(self, resources):
        """
        اصل پارتو (۸۰/۲۰): تخصیص پویا و بهینه منابع برای استخراج هسته نقدینگی مانیفلد اقتصادی
        """
        if not resources:
            self.integrity_score = 0.5
            return 0
            
        # مرتب‌سازی پویا نزولی برای تضمین استخراج ۲۰٪ برتر، حتی اگر آرایه ورودی نامرتب باشد
        sorted_resources = sorted(resources, reverse=True)
        top_20_percent_cutoff = int(len(sorted_resources) * 0.2)
        
        # تضمین حداقل یک تراکنش در مانیفلد برای آرایه‌های کوچک
        if top_20_percent_cutoff == 0 and len(sorted_resources) > 0:
            top_20_percent_cutoff = 1
            
        return sum(sorted_resources[:top_20_percent_cutoff])

# -------------------------------------------------------------
# اجرای تست مقایسه‌ای و تحلیل خروجی مانیفلد
# -------------------------------------------------------------
if __name__ == "__main__":
    # الف) تست با آرایه مرتب (حالت ایده‌آل)
