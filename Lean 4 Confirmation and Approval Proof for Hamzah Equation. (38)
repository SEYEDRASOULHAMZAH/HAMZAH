            return "CRITICAL_ERROR: مقادیر نامعتبر در کوواریانس مکانیکی."

        tensor_norm = float(np.linalg.norm(cov_matrix, ord='fro'))
        logging.info("نرم تانسوری کوواریانس تنش‌های ساختاری با موفقیت محاسبه شد.")
