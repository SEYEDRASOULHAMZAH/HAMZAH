    print(f"موتور تانسوری Hamzah: {tensor_engine.compute_safe_market_tensor(market_flow_data)}")
    
    print("\n=== تست تانسوری دوم: ورود داده‌های شوک و نوسان شدید ==++")
    shock_flows = [500.0, -10.0, 2.0, 1.0]
