# -------------------------------------------------------------
# ۱. پیاده‌سازی کلاسیک (صلب، فاقد درک ویژگی Left-Stochastic)
# -------------------------------------------------------------
def classic_markov_mutation_solver(mu: float, t: float) -> np.ndarray:
    matrix = np.zeros((4, 4))
    p_stay = 0.25 + 0.75 * np.exp(-4 * mu * t)
    p_mutate = 0.25 - 0.25 * np.exp(-4 * mu * t)
    
    for i in range(4):
        for j in range(4):
            matrix[i, j] = p_stay if i == j else p_mutate
            
    return matrix

# -------------------------------------------------------------
# ۲. موتور هوشمند حمزه (HamzahXcell Kernel - Stochastic Bio-Monitor)
# -------------------------------------------------------------
class HamzahXcellKernel:
    def __init__(self, cluster_id: str = "Hamzah_Stochastic_Bio_Omega") -> None:
        self.cluster_id = cluster_id
        self.integrity_score = 1.0
        self.max_time_boundary = 500.0

    def execute_tensor_markov_protocol(self, mu: float, t: float) -> Union[np.ndarray, str]:
        """
        هسته هوشمند حمزه: تحلیل زنجیره مارکوف جهش با پایش قانون Left-Stochastic و کنترل آنتروپی
        """
        if t < 0 or mu < 0:
            self.integrity_score = 0.2
            logging.error("خطای فیزیکی: زمان تکامل یا نرخ جهش نامعتبر است.")
            return "ERROR: زمان تکامل یا نرخ جهش نامعتبر است."

        # مهار وضعیت آنتروپی مطلق در مقیاس‌های زمانی کلان
        if t > self.max_time_boundary:
            self.integrity_score = 0.4
            logging.warning("هشدار آنتروپی: زمان به سمت حد تعادل نهایی میل کرد.")
            stable_matrix = np.full((4, 4), 0.25)
            return ("GENETIC_STABILITY_REACHED: زمان به سمت بی‌نهایت میل کرد. "
                    "سیستم به تعادل پایدار نهایی (آنتروپی ماکسیمم) رسید.")

        p_stay = 0.25 + 0.75 * np.exp(-4 * mu * t)
        p_mutate = 0.25 - 0.25 * np.exp(-4 * mu * t)
        
        matrix = np.zeros((4, 4))
        for i in range(4):
            for j in range(4):
                matrix[i, j] = p_stay if i == j else p_mutate

        # راستی‌آزمایی سخت‌گیرانه قانون Left-Stochastic (مجموع احتمالات هر سطر برابر ۱)
        for row in range(4):
            if not np.isclose(np.sum(matrix[row]), 1.0, atol=1e-5):
                self.integrity_score = 0.0
                logging.error("خطای بحرانی: فروپاشی احتمالات در ماتریس مارکوف.")
                return "CRITICAL_ERROR: فروپاشی احتمالات! مجموع احتمالات سطر برابر با ۱ نیست."

        logging.info("ماتریس انتقال مارکوف با موفقیت اعتبارسنجی شد.")
        return matrix

