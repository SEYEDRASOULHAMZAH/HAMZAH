def classic_hawking_temperature(mass):
    """
    محاسبه کلاسیک دمای هاوکینگ: T = 1 / (8 * pi * M)
    اگر جرم به سمت صفر میل کند، دما به بی‌نهایت می‌رسد و سیستم کراش می‌کند!
    """
    return 1.0 / (8.0 * math.pi * mass)

