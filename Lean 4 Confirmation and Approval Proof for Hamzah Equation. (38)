این اسکریپت پردازش داده‌های طیفی آلوده به نویز، شناسایی قله‌ها به عنوان موجودیت‌های علی و میل دادن نویز محیطی به سمت خط پایه (Baseline) را پیاده‌سازی می‌کند.

Python
import numpy as np
import logging
from typing import List, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahSpectralCausalRecoveryEngine:
    """
    هسته پیشرفته بازیابی طیفی ساختاری و تفکیک موجودیت‌های علی (Omega Production Grade)
    شناسایی قله‌ها به عنوان موجودیت‌های علی و حذف نویزهای محیطی بر اساس آستانه.
    """
    def __init__(self, peak_threshold: float = 0.8) -> None:
        self.threshold = peak_threshold
        self.integrity_score = 1.0
        logging.info("هسته بازیابی طیفی HamzahXcell-Level9 با موفقیت راه‌اندازی شد.")

    def recover_spectra(self, noisy_spectrum: List[float]) -> Union[List[float], str]:
        """
        بازیابی طیف و فیلتر نویز محیطی با حفظ ساختار قله‌های علی
        """
        if not noisy_spectrum:
            self.integrity_score -= 0.15
            logging.error("خطای طیفی: بردار طیف ورودی تهی است.")
            return "ERROR: بردار طیف نمی‌تواند تهی باشد."

        recovered = []
        for val in noisy_spectrum:
            if np.isnan(val) or np.isinf(val):
                self.integrity_score -= 0.05
                logging.warning("مقدار نامعتبر (NaN/Inf) در طیف شناسایی و اصلاح شد.")
                recovered.append(0.0)
                continue
            
            # بررسی اطلاعاتی: آیا این نقطه بخشی از ساختارِ قله است؟
            if val > self.threshold:
                recovered.append(float(val))  # حفظِ اطلاعاتِ ساختاری قله
            else:
                # حذف نویز: میل دادن نویز محیطی به سمت baseline (صفر)
                recovered.append(0.0)

        logging.info("بازیابی طیف با موفقیت انجام شد.")
        return recovered

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی بازیابی طیفی و فیلترینگ قله‌ها
# -------------------------------------------------------------
if __name__ == "__main__":
    np.random.seed(42)
    engine = HamzahSpectralCausalRecoveryEngine(peak_threshold=0.5)
    
    spectrum = [0.1, 0.2, 0.9, 0.95, 0.9, 0.2, 0.1, 0.15] # قله‌های تیز در وسط
    noise = np.random.normal(0, 0.05, 8)
    noisy_data = (np.array(spectrum) + noise).tolist()
    
    clean_data = engine.recover_spectra(noisy_data)
    
    print("--- تست رسمی هسته بازیابی طیفی HamzahXcell ---")
    print(f"{'داده آلوده (طیف)':<20} | {'HamzahXcell (ساختار قله)'}")
    for n, c in zip(noisy_data, clean_data):
        print(f"{n:<20.3f} | {c:<20.3f}")
    
    print(f"امتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

