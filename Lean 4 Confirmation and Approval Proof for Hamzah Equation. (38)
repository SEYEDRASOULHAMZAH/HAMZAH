def classic_gravitational_strain(amplitude, distance):
    # محاسبات ساده بدون در نظر گرفتن فاصله صفر یا مقادیر منفی سنسورها
    # اگر فاصله صفر باشد، تقسیم بر صفر رخ داده و برنامه کراش می‌کند!
