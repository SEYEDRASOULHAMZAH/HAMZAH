Python
import numpy as np
import logging
from typing import List, Union

# راه‌اندازی سیستم ثبت لاگ استاندارد صنعتی
logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahCausalJitterPredictionEngine:
    """
    هسته پیشرفته پیش‌بینی زوال مکانیکی و تحلیل انحراف نوسانات Jitter (Omega Production Grade)
    تشخیص پیش‌دستانه خرابی بر اساس پایش روند صعودی واریانس زمان‌های جستجو.
    """
    def __init__(self, jitter_limit: float = 2.0) -> None:
        self.limit = jitter_limit # آستانه پایداریِ مکانیکی
        self.integrity_score = 1.0
        logging.info("هسته تحلیل زوال مکانیکی HamzahXcell-Level17 با موفقیت راه‌اندازی شد.")

    def predict_failure(self, seek_times: List[float]) -> Union[str, dict]:
        """
        بررسیِ انحرافِ معیارِ (Jitter) پیش‌رونده و پیش‌بینی زوال مکانیکی هد دیسک
        """
        if not seek_times or len(seek_times) < 6:
            self.integrity_score -= 0.2
            logging.error("خطای داده‌های مکانیکی: طول بردار زمان جستجو برای تحلیل Jitter ناکافی است.")
            return "ERROR: بردار داده نامعتبر یا کوتاه است."

        arr = np.array(seek_times, dtype=np.float32)
        if np.any(np.isnan(arr)) or np.any(np.isinf(arr)):
            self.integrity_score -= 0.1
            logging.warning("مقادیر نامعتبر (NaN/Inf) در بردار زمان جستجو اصلاح شدند.")
            arr = np.nan_to_num(arr)

        jitters = np.diff(arr)
        
        # محاسبه نرخِ افزایشِ نوسانات در دو بازه پنجره‌ای
        if len(jitters) >= 10:
            trend = np.mean(jitters[-5:]) - np.mean(jitters[:-5])
        else:
            trend = np.mean(jitters[len(jitters)//2:]) - np.mean(jitters[:len(jitters)//2])

        logging.info(f"مقدار روند محاسبه‌شده Jitter: {round(float(trend), 4)}")

        if trend > self.limit:
            logging.warning("هشدار بحرانی: زوال مکانیکی شناسایی شد!")
            return "CRITICAL: زوالِ مکانیکی شناسایی شد. پیش‌بینیِ خرابی در X ساعتِ آینده..."
        
        return "HEALTHY: عملکردِ مکانیکیِ نرمال"

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی پیش‌بینی خرابی مکانیکی
# -------------------------------------------------------------
if __name__ == "__main__":
    engine = HamzahCausalJitterPredictionEngine(jitter_limit=1.5)
    seek_data = [10.0, 11.0, 10.5, 12.0, 11.0, 15.0, 14.0, 20.0, 18.0, 30.0]
    
    print("--- تست رسمی هسته پیش‌بینی زوال مکانیکی HamzahXcell ---")
    print(f"{'گام':<5} | {'نوسانِ (Jitter)':<20} | {'HamzahXcell (تشخیصِ سلامت)'}")
    
    for i in range(1, len(seek_data)):
        current_trend = seek_data[i] - seek_data[i-1]
        status = engine.predict_failure(seek_data[:i+1])
        print(f"{i:<5} | {current_trend:<20.2f} | {status}")
    
    print(f"\nامتیاز پایداری نهایی سیستم: {round(engine.integrity_score, 2)}")

