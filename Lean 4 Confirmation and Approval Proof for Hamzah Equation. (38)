            logging.warning("هشدار فیزیکی: شتاب منفی در میدان گرانشی نامعتبر است.")
            return "ERROR: شتاب منفی در این میدان گرانشی معنا ندارد."
            
        # محاسبه ضریب اصلاح نسبیتی لورنتس
        lorentz_factor = math.sqrt(1 - (spin_velocity**2 / self.c**2))
        
