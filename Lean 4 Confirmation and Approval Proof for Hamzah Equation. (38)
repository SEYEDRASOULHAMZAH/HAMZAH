    هسته پیشرفته پایش فشار و تفکیک نشتی واقعی از شوک‌های شیر (Omega Production Grade)
    """
    def __init__(self, trend_window: int = 10, drop_threshold: float = -0.5) -> None:
        self.buffer: List[float] = []
        self.trend_window = trend_window
        self.drop_threshold = drop_threshold
        self.integrity_score = 1.0
        logging.info("هسته تحلیل فشار HamzahXcell-Level4 با موفقیت راه‌اندازی شد.")

    def analyze_pressure(self, current_pressure: float) -> str:
        """
        تحلیل افت فشار پنجره‌ای و تفکیک اسپایک نویز از نشتی واقعی
        """
        if np.isnan(current_pressure) or np.isinf(current_pressure):
            self.integrity_score -= 0.15
            logging.warning("هشدار فشار: مقدار نامعتبر (NaN/Inf) شناسایی شد.")
            return "ERROR: مقدار نامعتبر سنسور."

        self.buffer.append(current_pressure)
        if len(self.buffer) < self.trend_window:
            return "سنجش اولیه..."

        diffs = np.diff(self.buffer[-self.trend_window:])
        avg_drop = float(np.mean(diffs))

        if avg_drop < self.drop_threshold:
            self.integrity_score -= 0.05
            logging.warning(f"نشتی واقعی شناسایی شد! افت متوسط: {avg_drop:.2f}")
            return "ALARM: نشتی واقعی شناسایی شد!"

        logging.info("سیستم پایدار: فشار در محدوده نرمال قرار دارد.")
        return "System Stable: فشار نرمال"

# -------------------------------------------------------------
# اجرای تستِ راستی‌آزمایی پایش فشار و نشتی
# -------------------------------------------------------------
