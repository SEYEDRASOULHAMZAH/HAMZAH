        obs_arr = np.array(observations, dtype=np.float32)
        mean_obs = np.mean(obs_arr)
        var_obs = np.var(obs_arr) + 1e-5

        weights = np.exp(-0.5 * (obs_arr - mean_obs)**2 / var_obs)
        sum_weights = np.sum(weights)
        
        if sum_weights == 0.0:
            self.filter_integrity = 0.4
            logging.error("خطای محاسباتی: مجموع وزن‌ها صفر شد.")
            return "CRITICAL_ERROR: وزن ذرات فروپاشید."

        weights /= sum_weights
        estimated_state = float(np.sum(obs_arr * weights))
        
        logging.info("برآورد وضعیت ذرات با موفقیت انجام شد.")
        return round(estimated_state, 4)

