  cognitive_threshold : ℝ := 4.0
  decision_bounded : Bool := true

def defaultHicksState : HicksLawState := {}

-- Formal proof of Hick's Law decision time bounding and cognitive limit constraints
theorem hicks_law_bounded_valid (hls : HicksLawState)
    (h_time : hls.decision_time ≥ 0.0)
