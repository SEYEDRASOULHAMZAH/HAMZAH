import numpy as np
import logging
from typing import List, Union

logging.basicConfig(level=logging.INFO, format='[%(asctime)s] [%(levelname)s] : %(message)s')

class HamzahTensorSensorArrayEngine:
    """
    موتور تانسوری آرایه سنسورها و همبستگی چندکاناله (Omega Production Grade)
    """
    def __init__(self, channels: int = 3) -> None:
        self.channels = channels
        self.array_integrity = 1.0

    def process_multichannel_matrix(self, sensor_matrix: List[List[float]]) -> Union[float, str]:
        """
        محاسبه ماتریس کوواریانس و نرم فروبنیوس برای آرایه سنسورهای چندکاناله
        """
        if not sensor_matrix:
            self.array_integrity = 0.2
            logging.error("خطای تانسوری: ماتریس سنسورها خالی است.")
            return "ERROR: ماتریس سنسور نمی‌تواند تهی باشد."

        mat = np.array(sensor_matrix, dtype=np.float32)
        if np.any(np.isnan(mat)) or np.any(np.isinf(mat)):
            self.array_integrity = 0.0
            logging.error("خطای بحرانی: مقادیر نامعتبر در ماتریس آرایه سنسور.")
            return "CRITICAL_ERROR: مقادیر نامعتبر در ماتریس."

        cov_matrix = np.cov(mat, rowvar=False)
        if cov_matrix.ndim == 0:
            frobenius_norm = float(cov_matrix)
        else:
            frobenius_norm = float(np.linalg.norm(cov_matrix, ord='fro'))

        logging.info("نرم تانسوری کوواریانس آرایه سنسورها با موفقیت محاسبه شد.")
        return round(frobenius_norm, 4)

