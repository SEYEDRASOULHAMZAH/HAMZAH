        tensor_array = np.array(magnetic_matrix, dtype=np.float32)
        tensor_norm = np.linalg.norm(tensor_array)

        if np.isnan(tensor_norm) or np.isinf(tensor_norm):
            self.plasma_integrity = 0.3
            logging.error("خطای تانسوری: مقادیر NaN یا Inf در نرم تانسور محصورسازی شناسایی شد.")
            return "MAGNETIC_DISRUPTION_CRITICAL: ناپایداری شدید در محصورسازی مغناطیسی."

        return round(float(tensor_norm), 4)

