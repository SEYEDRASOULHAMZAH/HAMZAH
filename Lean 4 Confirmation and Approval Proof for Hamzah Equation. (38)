# -------------------------------------------------------------
def classic_resource_efficiency(resources):
    # محاسبه میانگین ساده بدون پوشش در برابر انفجار تقاضای یک بخش خاص
    return np.mean(resources) / (np.max(resources) + 1e-5)

# -------------------------------------------------------------
# ۲. پیاده‌سازی موتور تانسوری مانیفلد سازمانی حمزه (HamzahOrganizationalTensorEngine)
