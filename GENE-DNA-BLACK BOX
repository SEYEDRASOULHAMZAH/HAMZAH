class ResourceMonitor:
    """مانیتور منابع سیستم در حین تست استرس"""
    
    def __init__(self):
        self.cpu_usage = []
        self.memory_usage = []
        self.disk_io = []
        self.network_io = []
        self.temperatures = []
        self.start_time = time.time()
        
    def start_monitoring(self):
        """شروع مانیتورینگ"""
        self.monitoring_thread = threading.Thread(target=self._monitor_resources)
        self.monitoring_thread.daemon = True
        self.monitoring_thread.start()
    
    def _monitor_resources(self):
        """مانیتور منابع به صورت مداوم"""
        while True:
            try:
                # CPU استفاده
                cpu_percent = psutil.cpu_percent(interval=0.1, percpu=True)
                self.cpu_usage.append(cpu_percent)
                
                # حافظه
                memory = psutil.virtual_memory()
                self.memory_usage.append({
                    'total': memory.total,
                    'available': memory.available,
                    'percent': memory.percent,
                    'used': memory.used
                })
                
                # دیسک
                disk = psutil.disk_usage('/')
                self.disk_io.append({
                    'total': disk.total,
                    'used': disk.used,
                    'free': disk.free,
                    'percent': disk.percent
                })
                
                # شبکه
                net_io = psutil.net_io_counters()
                self.network_io.append({
                    'bytes_sent': net_io.bytes_sent,
                    'bytes_recv': net_io.bytes_recv
                })
                
                # دما (اگر موجود باشد)
                try:
                    temps = psutil.sensors_temperatures()
                    if temps:
                        self.temperatures.append(temps)
                except:
                    pass
                
                time.sleep(0.1)
                
            except Exception as e:
                print(f"خطا در مانیتورینگ: {e}")
                time.sleep(1)
    
    def get_summary(self) -> Dict[str, Any]:
        """خلاصه‌ای از وضعیت منابع"""
        if not self.cpu_usage:
            return {}
        
        cpu_array = np.array(self.cpu_usage)
        memory_array = np.array([m['percent'] for m in self.memory_usage])
        
        return {
            'monitoring_duration': time.time() - self.start_time,
