    def _generate_stress_test_summary(self, all_results: Dict[str, Any], 
                                     group_stats: Dict[str, Any], 
                                     total_time: float) -> Dict[str, Any]:
        """تولید خلاصه تست استرس"""
        
        # جمع‌آوری آمار
        total_tests = 0
        total_passed = 0
        total_failed = 0
        
        for stats in group_stats.values():
            total_tests += stats['tests_count']
            total_passed += stats['passed']
            total_failed += stats['failed']
        
        # محاسبه نرخ موفقیت
        success_rate = (total_passed / total_tests * 100) if total_tests > 0 else 0
        
        # یافتن مشکل‌ترین گروه
        worst_group = None
        worst_success_rate = 100
        
        for group_name, stats in group_stats.items():
            group_success = (stats['passed'] / stats['tests_count'] * 100) if stats['tests_count'] > 0 else 0
            if group_success < worst_success_rate:
                worst_success_rate = group_success
                worst_group = group_name
        
        # جمع‌آوری خطاها
        errors = []
        for group_name, results in all_results.items():
            if isinstance(results, dict) and 'error' in results:
                errors.append(f"{group_name}: {results['error']}")
        
        return {
            'total_execution_time': total_time,
            'total_tests': total_tests,
            'tests_passed': total_passed,
            'tests_failed': total_failed,
            'success_rate': success_rate,
            'group_statistics': group_stats,
            'worst_performing_group': {
                'name': worst_group,
                'success_rate': worst_success_rate
            },
            'errors_encountered': errors,
            'overall_status': 'PASSED' if success_rate >= 95 else 'MARGINAL' if success_rate >= 80 else 'FAILED'
        }
    
