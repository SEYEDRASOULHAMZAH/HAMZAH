class MemoryLeakDetector:
    """تشخیص نشت حافظه در طول تست"""
    
    def __init__(self):
        self.memory_snapshots = []
        self.leak_threshold_mb = 10  # 10 MB افزایش حافظه به عنوان نشت
        
    def take_snapshot(self, label: str = ""):
        """گرفتن تصویر از وضعیت حافظه"""
        import tracemalloc
        
        if not tracemalloc.is_tracing():
            tracemalloc.start()
        
        snapshot = tracemalloc.take_snapshot()
        self.memory_snapshots.append({
            'timestamp': time.time(),
            'label': label,
            'snapshot': snapshot
        })
        
    def analyze_snapshots(self) -> Dict[str, Any]:
        """تحلیل تصاویر حافظه برای تشخیص نشت"""
        if len(self.memory_snapshots) < 2:
            return {'error': 'تعداد تصاویر کافی نیست'}
        
        # مقایسه اولین و آخرین تصویر
        first_snapshot = self.memory_snapshots[0]['snapshot']
        last_snapshot = self.memory_snapshots[-1]['snapshot']
        
        # یافتن تفاوت‌ها
        top_stats = last_snapshot.compare_to(first_snapshot, 'lineno')
        
        # جمع‌آوری آمار
        total_increase = 0
        leaks = []
        
        for stat in top_stats[:20]:  # 20 مورد اول
            if stat.size_diff > 0:  # فقط افزایش‌ها
                total_increase += stat.size_diff
                leaks.append({
                    'file': stat.traceback[0].filename if stat.traceback else 'unknown',
                    'line': stat.traceback[0].lineno if stat.traceback else 0,
                    'size_diff_kb': stat.size_diff / 1024,
                    'count_diff': stat.count_diff
                })
        
        return {
            'leaks_detected': len(leaks) > 0,
            'total_increase_kb': total_increase / 1024,
            'total_increase_mb': total_increase / (1024 * 1024),
            'leak_count': len(leaks),
            'top_leaks': leaks[:10],  # 10 مورد اول
            'snapshots_taken': len(self.memory_snapshots)
        }
    
    def generate_report(self) -> Dict[str, Any]:
        """تولید گزارش نشت حافظه"""
        if len(self.memory_snapshots) >= 2:
            analysis = self.analyze_snapshots()
            
            # تفسیر نتایج
            interpretation = "بدون نشت حافظه قابل توجه"
            if analysis['total_increase_mb'] > self.leak_threshold_mb:
                interpretation = f"نشت حافظه احتمالی ({analysis['total_increase_mb']:.1f} MB)"
            elif analysis['leak_count'] > 10:
                interpretation = f"نشت‌های کوچک متعدد ({analysis['leak_count']} مورد)"
            
            analysis['interpretation'] = interpretation
            analysis['threshold_mb'] = self.leak_threshold_mb
            
            return analysis
        else:
            return {
                'error': 'تصاویر کافی برای تحلیل وجود ندارد',
                'snapshots_available': len(self.memory_snapshots)
            }

