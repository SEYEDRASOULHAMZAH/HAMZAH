    def __init__(self, capacity=1.0):
        self.manifold_dim = 1155
        self.MAX_DATA_CAPACITY = capacity  # حداکثر ظرفیت اطلاعاتی مجاز
        
    def simulate_nucleus_decay(self, current_entropy):
        # آنتروپی بالا = نویز پردازشی بالا
        # هسته مجبور است برای حفظ پایداری، "تخلیه" کند (واپاشی به عنوان دی‌باگ)
        if current_entropy > self.MAX_DATA_CAPACITY:
            decay_rate = current_entropy * 0.95  # نرخ تخلیه برای کاهش نویز
            status = "DEBUG_MODE (High Decay)"
        else:
            decay_rate = 0.0
            status = "STABLE (Optimized)"
        return decay_rate, status

