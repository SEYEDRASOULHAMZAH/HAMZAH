def hamzah_stability_index(dimensions: int | np.ndarray) -> float | np.ndarray:
    """
    محاسبه شاخص پایداری مانیفلد در فضای ابعادی (Hamzah Stability Index)
    مدل‌سازی تعادل میان تقارن، درجه آزادی و خطای محاسباتی
