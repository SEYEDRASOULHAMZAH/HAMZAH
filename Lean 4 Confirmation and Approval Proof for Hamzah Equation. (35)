        self.layer_dim = 165
        self.composite_dim = 495  # 165 (Material) + 165 (Logic) + 165 (Thermodynamic)
        self.entropy_sink = np.zeros(self.layer_dim)  # فضای جذب آنتروپی لایه سوم
        self.dissipation_factor = 0.98                # فاکتور دفع حرارتی دترمینستی

