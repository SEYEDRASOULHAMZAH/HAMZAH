        # بررسی پایداری ثابت کیهانی
        current_k = i_val * (s_val + self.EPSILON)
        
        if np.isinf(i_val) or s_val == 0:
            return "KERNEL_PANIC (System Crash - Illegal State)"
        elif np.isclose(current_k, self.K_1155):
            return "STABLE_KERNEL (Optimal Initialization)"
        else:
            return "DECOHERENCE (Manifold Error)"

