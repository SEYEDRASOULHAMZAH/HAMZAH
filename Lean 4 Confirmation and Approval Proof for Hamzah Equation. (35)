        self.tensor_T: np.ndarray = np.stack([self.matrix_M] * 7)

    def verify_hierarchy(self) -> dict:
        """بررسی صحت ابعاد و اشکال تانسوری در تمام سطوح سیستم"""
        return {
            "Scalar Value": self.scalar_S,
            "Vector Shape": self.vector_V.shape,
            "Matrix Shape": self.matrix_M.shape,
            "Tensor Shape": self.tensor_T.shape,
            "Total Tensor Elements": self.tensor_T.size
