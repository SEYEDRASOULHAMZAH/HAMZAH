    def analyze_stress_test_results(self, execution_time):
        """تحلیل نتایج تست‌های استرس"""
        all_tests = []
        for category in ['singularity', 'violation', 'extreme']:
            if category in self.stress_results:
                all_tests.extend(self.stress_results[category].values())
        
        total_tests = len(all_tests)
        successful_tests = sum(1 for test in all_tests if test.get('success', False))
        success_rate = successful_tests / total_tests if total_tests > 0 else 0
        
        # محاسبه مقاومت سیستم
        resilience_score = success_rate * 100
        
        # تعیین وضعیت سلامت
        if resilience_score >= 99.9999:
            health_status = "سلامت کامل - سیستم فوق‌مقاوم"
        elif resilience_score >= 99.99:
            health_status = "سلامت عالی - سیستم بسیار مقاوم"  
        elif resilience_score >= 99.9:
            health_status = "سلامت خوب - سیستم مقاوم"
        elif resilience_score >= 95:
            health_status = "سلامت قابل قبول - نیاز به نظارت"
        else:
            health_status = "سلامت بحرانی - نیاز به بازبینی"
        
        return {
            'total_tests': total_tests,
            'successful_tests': successful_tests,
            'success_rate': success_rate,
            'resilience_score': resilience_score,
            'health_status': health_status,
