        # محاسبات HCP - الگوی تداخل با قطعیت
        delta_x_HCP = self.HCP_constant / (photon_energy / self.constants['c'])
        theta_certainty_HCP = delta_x_HCP / slit_separation
        
        # شبیه‌سازی الگوی تداخل
