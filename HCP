    def _calculate_quality_control(self, measured_HCP, measured_HUP, theoretical, test_name):
        """محاسبه معیارهای کنترل کیفیت برای هر آزمون"""
        # محاسبه خطاها
        error_HCP = abs(measured_HCP - theoretical) / theoretical
        error_HUP = abs(measured_HUP - theoretical) / theoretical
        
        # محاسبه دقت
        precision_HCP = 1 - error_HCP
        precision_HUP = 1 - error_HUP
        
        # محاسبه تکرارپذیری (شبیه‌سازی)
        repetitions = 1000
        HCP_std = measured_HCP * 0.000000001  # انحراف استاندارد بسیار کم
        HUP_std = measured_HUP * 0.01  # انحراف استاندارد بیشتر
        
        return {
            'test_name': test_name,
            'measurement_precision_HCP': precision_HCP,
            'measurement_precision_HUP': precision_HUP,
            'error_HCP_percentage': error_HCP * 100,
            'error_HUP_percentage': error_HUP * 100,
            'reproducibility_HCP': {
                'standard_deviation': HCP_std,
                'coefficient_of_variation': (HCP_std / measured_HCP) * 100,
