    def _add_real_time_data(self, test_name, hcp_data, hup_data):
        """افزودن داده‌های Real-time"""
        timestamp = datetime.now().isoformat()
        
        self.real_time_data['data_points'].append({
            'timestamp': timestamp,
            'test': test_name,
            'hcp': hcp_data,
            'hup': hup_data
        })
        
        # محاسبه معیارهای عملکرد
        hcp_performance = self._calculate_performance_metrics(hcp_data)
