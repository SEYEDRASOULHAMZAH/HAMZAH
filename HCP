    def _test_quantum_oscillator_certainty(self):
        """آزمون نوسان‌گر کوانتومی با قطعیت HCP - جزئیات کامل"""
        # پارامترهای آزمایش
        m = self.constants['electron_mass']  # جرم الکترون
        omega = 1e15  # فرکانس زاویه‌ای
        k = m * omega**2  # ثابت فنر
        n = 1  # عدد کوانتومی
        
        # محاسبات HUP - اصل عدم قطعیت
        # Δx Δp ≥ ħ/2
        delta_x_HUP = np.sqrt(self.HUP_constant / (m * omega))
        delta_p_HUP = self.HUP_constant / delta_x_HUP
        energy_uncertainty_HUP = (delta_p_HUP**2) / (2 * m) + 0.5 * m * omega**2 * delta_x_HUP**2
        
        # محاسبات HCP - اصل قطعیت حمزه
        # Δx Δp = ΩH∗
        delta_x_HCP = np.sqrt(self.HCP_constant / (m * omega))
        delta_p_HCP = self.HCP_constant / delta_x_HCP
        energy_certainty_HCP = (delta_p_HCP**2) / (2 * m) + 0.5 * m * omega**2 * delta_x_HCP**2
        
        # انرژی دقیق کوانتومی
        energy_exact = self.HUP_constant * omega * (n + 0.5)
        
        # محاسبه خطاها
        error_HUP = abs(energy_uncertainty_HUP - energy_exact) / energy_exact
        error_HCP = abs(energy_certainty_HCP - energy_exact) / energy_exact
        
