        # محاسبه معیارهای قطعیت
        certainty_metrics = {
            'hcp_certainty': hcp_data.get('certainty_level', 0.9999999999),
            'hup_certainty': hup_data.get('certainty_level', 0.95),
            'improvement_factor': hcp_data.get('certainty_level', 0.9999999999) / hup_data.get('certainty_level', 0.95)
        }
        
        self.real_time_data['certainty_metrics'].append(certainty_metrics)

    def _calculate_performance_metrics(self, data):
        """محاسبه معیارهای عملکرد"""
        certainty = data.get('certainty_level', 0.5)
        stability = data.get('stability', 0.5)
        precision = data.get('precision', 0.5)
        
        overall_performance = (certainty + stability + precision) / 3
        
        return {
            'certainty': certainty,
            'stability': stability,
            'precision': precision,
            'overall': overall_performance
        }

