    def _verify_package_integrity(self, package):
        """بررسی یکپارچگی بسته"""
        required_fields = [
            'version', 'security_level', 'encryption_timestamp',
            'quantum_signature', 'encrypted_data', 'temporal_signature'
        ]
        
        # بررسی وجود فیلدهای لازم
        for field in required_fields:
            if field not in package:
                return False
        
        # بررسی امضای کوانتومی
        signature = package['quantum_signature']
        data_hash = hashlib.shake_256(package['encrypted_data']).digest(128)
        
        if signature['hash'] != data_hash.hex():
            return False
        
        # بررسی کد تأیید
        expected_code = hash(
            (data_hash, signature['planck_reference'], signature['quantum_entropy'])
        ) % 2**64
        
        if signature['verification_code'] != expected_code:
            return False
        
        return True
    
