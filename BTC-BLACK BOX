        # پارامترهای فیزیکی بنیادی
        self.hbar = 1.054571817e-34
        self.c = 299792458
        self.G = 6.67430e-11
        self.lp = sqrt(self.hbar * self.G / self.c**3)
        self.Λ = 1.0e-52  # ثابت کیهانی
        
        # پارامترهای امنیتی کوانتومی
        self.quantum_entropy = 2048  # افزایش به 2048 بیت
