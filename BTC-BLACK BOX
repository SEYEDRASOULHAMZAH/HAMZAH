    def generate_cosmic_key(self):
        """تولید کلید کیهانی با استفاده از زمان پلانک"""
        planck_time = self.lp / self.c
        cosmic_seed = int(time.time() / planck_time) % (2**4096)
        
        # افزودن آنتروپی کیهانی
        cosmic_noise = []
        for _ in range(64):
            t = time.time_ns() % 1000000
            quantum_fluct = sin(self.Λ * self.c**2 * t * 1e50) ** 2
            cosmic_noise.append(int(quantum_fluct * 2**64))
        
        final_key = cosmic_seed ^ int(''.join(str(x) for x in cosmic_noise))
        return final_key.to_bytes(512, 'big')

