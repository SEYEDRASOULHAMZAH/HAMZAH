            'communication_loss': 0.03,
            'mechanical_failure': 0.01
        }
        
        # تعدیل بر اساس محیط
        environmental_risk = environment.get('risk_factor', 1.0)
        adjusted_risks = {k: v * environmental_risk for k, v in risks.items()}
        total_risk = sum(adjusted_risks.values())
        
        return {
            'individual_risks': adjusted_risks,
            'total_risk': total_risk,
            'safety_level': 'عالی' if total_risk < 0.1 else 'خوب' if total_risk < 0.2 else 'نیازمند نظارت'
        }

