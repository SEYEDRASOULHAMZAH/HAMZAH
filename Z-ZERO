        """ایجاد برنامه پیاده‌سازی"""
        timeline = []
        current_time = 0
        
        for subsystem, improvements in optimizations.items():
            for improvement, details in improvements.items():
                timeline.append({
                    'task': f"{subsystem} - {improvement}",
                    'duration': details['time_required'],
                    'start_week': current_time,
                    'resources': details['implementation_cost']
                })
                # زمان‌بندی موازی برای زیرسیستم‌های مختلف
                if subsystem != list(optimizations.keys())[0]:
                    current_time += 1
        
        return {
            'timeline': timeline,
            'total_duration': f"{current_time + 1} هفته",
            'critical_path': self._identify_critical_path(timeline)
        }
    
    def _identify_critical_path(self, timeline):
        """شناسایی مسیر بحرانی"""
        # ساده‌سازی: طولانی‌ترین مدت زمان
        max_duration = max(int(task['duration'].split()[0]) for task in timeline)
        critical_tasks = [task for task in timeline if int(task['duration'].split()[0]) == max_duration]
        
        return {
            'critical_tasks': [task['task'] for task in critical_tasks],
            'total_critical_duration': f"{max_duration} هفته",
            'bottleneck_areas': [task.split(' - ')[0] for task in [t['task'] for t in critical_tasks]]
        }

