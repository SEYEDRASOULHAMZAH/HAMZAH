    def _calculate_optimal_density(self, volume):
        """محاسبه تراکم بهینه نانوبات‌ها"""
        # حداکثر تراکم بدون تداخل کوانتومی
        max_density = 1e9  # نانوبات بر میلی‌لیتر
        volume_factor = 1 - np.exp(-volume / 1000)
        return max_density * volume_factor
    
    def _calculate_deployment_time(self, nanobot_count, environment):
        """محاسبه زمان استقرار"""
        base_time = 3600  # 1 ساعت پایه
        environmental_factor = environment.get('permeability', 0.8)
        coordination_factor = self.performance_metrics['swarm_coordination']
        
        return base_time * (nanobot_count / 1e6) / (environmental_factor * coordination_factor)
    
    def _calculate_swarm_efficiency(self, nanobot_count, environment):
        """محاسبه کارایی گروه"""
        base_efficiency = 0.95
        count_factor = 1 - np.exp(-nanobot_count / 1e6)
        environmental_factor = environment.get('efficiency_factor', 0.9)
        
        return base_efficiency * count_factor * environmental_factor
    
    def _calculate_coverage(self, nanobot_count, volume):
        """محاسبه پوشش مغزی"""
        nanobot_volume = nanobot_count * (4/3) * np.pi * (25e-7)**3  # سانتی‌متر مکعب
        return min(100, (nanobot_volume / volume) * 100)
    
