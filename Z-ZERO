        """تولید توصیه‌های پارامتری"""
        recommendations = []
        
        for subsystem, improvements in optimizations.items():
            for improvement, details in improvements.items():
                recommendations.append({
                    'subsystem': subsystem,
                    'improvement_area': improvement,
                    'recommended_action': details['method'],
                    'priority': 'بالا' if details['expected_improvement'] > 0.1 else 'متوسط'
                })
        
        return sorted(recommendations, key=lambda x: x['priority'], reverse=True)
    
