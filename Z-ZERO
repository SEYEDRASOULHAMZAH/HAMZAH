        }
        
        return performance
    
    def _calculate_mission_success(self):
        """محاسبه موفقیت مأموریت"""
        success_factors = []
        
        # موفقیت استقرار نانوبات‌ها
        if 'nanobot_deployment' in self.performance_data:
            deployment = self.performance_data['nanobot_deployment']
            success_factors.append(deployment.get('swarm_efficiency', 0))
            success_factors.append(deployment.get('coverage_percentage', 0) / 100)
        
        # موفقیت بازنویسی حافظه
        if 'memory_rewrite' in self.performance_data:
            rewrite = self.performance_data['memory_rewrite']
            if rewrite.get('status') == 'SUCCESS':
                success_factors.append(0.9)
            elif rewrite.get('status') == 'PARTIAL_SUCCESS':
                success_factors.append(0.7)
            else:
                success_factors.append(0.3)
        
        # موفقیت فعال‌سازی کلاهک
        if 'warhead_activation' in self.performance_data:
            activation = self.performance_data['warhead_activation']
            if activation.get('status') == 'SUCCESS':
                success_factors.append(0.95)
            else:
                success_factors.append(0.5)
        
        return np.mean(success_factors) if success_factors else 0
    
