        substitution_map = {
            b'\x31\xC0': b'\x48\x31\xC0',  # XOR RAX, RAX
            b'\x89\xD8': b'\x48\x89\xC3',  # MOV RBX, RAX
            b'\x01\xD0': b'\x48\x01\xD8',  # ADD RAX, RBX
        }
        
        result = bytearray(data)
        
        for old, new in substitution_map.items():
            pos = 0
            while pos < len(result):
                found = result.find(old, pos)
                if found == -1:
                    break
                
                # جایگزینی
                result[found:found+len(old)] = new
                pos = found + len(new)
        
        return bytes(result)
    
