    def _hamzah_tensor_calculation(self, dimensions: List[int], input_value: Decimal) -> Decimal:
        """محاسبه تانسور حمزه برای ابعاد مشخص"""
        if not dimensions:
            return input_value
        
        # محاسبه فاکتور بعدی بر اساس نسبت طلایی و ثابت حمزه
        dimension_factor = Decimal('1.0')
        for dim in dimensions:
            if dim <= 4:
                factor = self.constants['golden_ratio']
            elif dim <= 8:
                factor = self.constants['hamzah_constant']
            elif dim <= 108:
                factor = Decimal('1.0') / self.constants['golden_ratio']
            elif dim == 164:
                factor = self.constants['golden_ratio'] ** 2
            elif dim == 165:
                factor = self.constants['hamzah_constant'] * self.constants['golden_ratio']
            else:
                factor = Decimal('1.0')
            
            dimension_factor *= factor
        
        # اعمال تبدیل تانسوری
        tensor_effect = input_value / (dimension_factor ** Decimal('0.5'))
        
        # اضافه کردن نویز کوانتومی (برای شبیه‌سازی واقعی)
        quantum_noise = Decimal(str(random.uniform(-1e-15, 1e-15)))
        
        return tensor_effect + quantum_noise
    
    def run_test(self, test_id: int, monte_carlo_iterations: int = 1000000) -> Dict[str, Any]:
