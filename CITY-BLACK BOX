    def _generate_security_hash(self) -> str:
        """تولید هش امنیتی برای تأیید یکپارچگی"""
        code_hash = hashlib.sha3_512(open(__file__, 'rb').read()).hexdigest()
        time_hash = hashlib.shake_256(str(time.time()).encode()).hexdigest(32)
        
