        if not successful:
            return {
                'status': 'FAILED',
                'success_rate': 0.0,
                'recommendations': ['سیستم نیاز به بازطراحی کامل دارد']
            }
        
        # محاسبه آمار
        execution_times = [r.get('execution_time', 0) for r in successful]
        scores = [r.get('evaluation', {}).get('overall_score', 0) for r in successful]
        
        # تحلیل دسته‌بندی
        category_analysis = {}
        for result in results:
            category = result.get('category', 'unknown')
            if category not in category_analysis:
                category_analysis[category] = {'total': 0, 'successful': 0}
            category_analysis[category]['total'] += 1
            if result.get('overall_success', False):
                category_analysis[category]['successful'] += 1
        
        return {
            'status': 'PASSED' if len(successful) >= 95 else 'PARTIAL',
            'total_scenarios': len(results),
            'successful_scenarios': len(successful),
            'failed_scenarios': len(failed),
            'success_rate': len(successful) / len(results),
            'execution_time_stats': {
                'mean': np.mean(execution_times) if execution_times else 0,
                'std': np.std(execution_times) if len(execution_times) > 1 else 0,
                'min': min(execution_times) if execution_times else 0,
                'max': max(execution_times) if execution_times else 0
            },
            'score_stats': {
                'mean': np.mean(scores) if scores else 0,
                'std': np.std(scores) if len(scores) > 1 else 0,
                'min': min(scores) if scores else 0,
                'max': max(scores) if scores else 0
            },
            'category_analysis': category_analysis,
            'recommendations': self._generate_recommendations(results)
        }
    
    def _generate_recommendations(self, results: List[Dict[str, Any]]) -> List[str]:
        """تولید توصیه‌ها"""
        recommendations = []
        
        # تحلیل دسته‌بندی
        category_performance = {}
        for result in results:
            category = result.get('category', 'unknown')
            success = result.get('overall_success', False)
            
            if category not in category_performance:
                category_performance[category] = {'total': 0, 'successful': 0}
            
            category_performance[category]['total'] += 1
            if success:
                category_performance[category]['successful'] += 1
        
        # تولید توصیه بر اساس عملکرد
        for category, stats in category_performance.items():
            success_rate = stats['successful'] / stats['total'] if stats['total'] > 0 else 0
            
            if success_rate < 0.9:
                recommendations.append(f'بهبود عملکرد در دسته {category}')
        
        if len([r for r in results if r.get('overall_success', False)]) >= 95:
            recommendations.append('سیستم آماده استقرار کامل است')
        else:
            recommendations.append('نیاز به بهینه‌سازی قبل از استقرار')
        
        return recommendations

