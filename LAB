    def _scientific_quality_control(self, experimental_result, setup):
        """کنترل کیفیت علمی"""
        expected = setup['expected_results']
        actual = experimental_result
        
        qc_metrics = {}
        
        for metric in setup['metrics']:
            if metric in actual and metric in expected:
                expected_val = expected[metric]
                actual_val = actual[metric]
                
                if expected_val > 0:
                    deviation = abs(actual_val - expected_val) / expected_val
                    score = 1 - min(deviation, 1.0)
                else:
                    score = 1.0 if abs(actual_val - expected_val) < 1e-15 else 0.0
                
                qc_metrics[metric] = {
                    'expected': expected_val,
                    'actual': actual_val,
                    'deviation': deviation if 'deviation' in locals() else 0,
                    'score': score,
                    'scientific_standard': 'تأیید شده' if score >= 0.999999 else 'رد شده'
                }
        
        # امتیاز کلی کنترل کیفیت علمی
        overall_score = np.mean([qc['score'] for qc in qc_metrics.values()])
        
        return {
            'qc_metrics': qc_metrics,
            'overall_score': overall_score,
            'qc_status': 'تأیید علمی' if overall_score >= 0.999999 else 'رد علمی',
            'precision_level': f'{overall_score:.15f}',
