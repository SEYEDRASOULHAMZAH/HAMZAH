    def _scenario_1_laser_source(self, setup):
        """سناریو 1: منبع لیزر پایدار"""
        params = setup['parameters']
        
        # شبیه‌سازی لیزر Nd:YAG
        time_array = np.linspace(0, 1, 1000000)
        power_fluctuations = np.random.normal(0, params['power'] * 0.008, len(time_array))
        laser_power = params['power'] + power_fluctuations
        
        # تحلیل پایداری
        power_stability = 1 - np.std(laser_power) / params['power']
        noise_deviation = np.std(power_fluctuations) / params['power']
        
        # محاسبه محصول عدم قطعیت
        delta_x, delta_p = self._calculate_uncertainty_products(laser_power)
        uncertainty_product = delta_x * delta_p
        heisenberg_limit = self.constants['hbar'] / 2
        
        return {
            'scenario': setup['name'],
            'power_stability': power_stability,
            'noise_deviation': noise_deviation,
            'uncertainty_product': uncertainty_product,
            'heisenberg_limit': heisenberg_limit,
            'violation_ratio': uncertainty_product / heisenberg_limit,
            'measurement_points': len(time_array),
            'laser_parameters': {
                'wavelength': params['wavelength'],
                'linewidth': params['linewidth'],
                'coherence_length': self.constants['c'] / params['linewidth']
            }
        }

