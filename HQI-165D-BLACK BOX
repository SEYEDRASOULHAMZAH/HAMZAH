    def _apply_singularity_management(self, matrix: np.ndarray, index: int) -> np.ndarray:
        """اعمال مدیریت تکینگی"""
        # تثبیت عددی
        epsilon = 1e-15
        identity = np.eye(matrix.shape[0]) * epsilon
        
        # روش تیکونوف برای تنظیم
        regularized = matrix + identity * (index + 1)
        
        # تجزیه مقدار ویژه برای نظارت
        eigenvalues = np.linalg.eigvals(regularized)
        
        # اطمینان از پایداری
        min_eigenvalue = np.min(np.abs(eigenvalues))
        if min_eigenvalue < 1e-10:
            regularized += np.eye(matrix.shape[0]) * (1e-10 - min_eigenvalue)
        
        return regularized
    
