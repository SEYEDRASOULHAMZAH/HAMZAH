class HamzahUrologyBiophysicalRealTimeEngine:
    MANIFOLD_DIM: int = 1155
    OMEGA_H_15: float = 2.3e170
    ALPHA_CONST: float = 1.84
    MU_V: float = 0.92
    MU_D: float = 0.87

