            "Final_Tissue_Vitality": round(float(Cv[max_steps]), 4),
            "Final_Tumor_Load": round(float(Cd[max_steps]), 4),
            "Scaffold_Reduction_Percent": round(scaffold_reduction, 4),
            "Combined_Medical_Score": round(r_comb, 6),
            "Lagrangian_Engine_Status": "OVERFLOW_FREE_1155D_APPROVED"
        }
        return report

