        dt_min = 0.001
        dt_max = 0.02
        dt = dt_max
        lagrangian_coupling_1155D = 1.155

        Cv = np.zeros(max_steps + 1, dtype=np.float64)  # Healthy breast tissue vitality index
        Cd = np.zeros(max_steps + 1, dtype=np.float64)  # IDC tumor load (ERBB2 amplification burden)
        P = np.zeros(max_steps + 1, dtype=np.float64)   # Scaffold barrier integrity index
