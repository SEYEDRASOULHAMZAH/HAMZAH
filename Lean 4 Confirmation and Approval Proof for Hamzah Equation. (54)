        dt_min = 0.001
        dt_max = 0.02
        dt = dt_max
        lagrangian_coupling_1155D = 1.155

        Cv = np.zeros(max_steps + 1, dtype=np.float64)  # Healthy tissue vitality index
        Cd = np.zeros(max_steps + 1, dtype=np.float64)  # HGSOC tumor load (Platinum resistance / PTEN silencing)
        P = np.zeros(max_steps + 1, dtype=np.float64)   # Ovarian tumor mass index
