    def hamzah_cell_flow(self, rho_current: float, rho_target: float, s_barrier: float) -> Union[float, str]:
        """محاسبه جریان مهاجرت سلولی مدل HIP بر اساس گرادیان چگالی و انتروپی مانع"""
        rc_val = float(rho_current)
