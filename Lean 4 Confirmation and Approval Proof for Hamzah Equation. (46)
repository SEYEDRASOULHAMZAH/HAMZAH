            hip_tensor = ((self.OMEGA_H**2) / (s_mat_tensor + self.EPSILON_FLOOR)) * self.MANIFOLD_CAPACITY
            
            mean_bek = torch.mean(bek_tensor).item()
            mean_hip = torch.mean(hip_tensor).item()
            tensor_std = torch.std(hip_tensor).item()

            is_valid = not torch.isnan(hip_tensor).any() and not torch.isinf(hip_tensor).any()
            status = "BEKENSTEIN_TENSOR_EQUILIBRIUM_APPROVED" if is_valid else "NUMERICAL_INSTABILITY"

            return {
