    def generate_mdg_gate_matrix(self, origin: tuple = (10, 10), destination: tuple = (40, 40), threshold: float = 3.0) -> Dict[str, Any]:
        """محاسبه ماتریس دروازه مانیفلد و ارزیابی شارش تونل‌زنی اطلاعات"""
        try:
