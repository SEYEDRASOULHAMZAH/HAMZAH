        self.EPSILON_FLOOR: float = 1.155e-20
        logging.info("راه‌اندازی کنترلر سازمانی پایداری هسته و مقایسه انرژی بستگی در مانیفلد 1155D")

    def classical_binding_energy(self, a: float, z: float) -> float:
        """محاسبه انرژی بستگی کلاسیک با فرمول نیمه‌تجربی جرم (SEMF)"""
        av, as_val, ac, aa = 15.75, 17.8, 0.711, 23.7
        a_val = float(a)
        z_val = float(z)
        term = av * a_val - as_val * (a_val**(2.0/3.0)) - ac * (z_val**2) / (a_val**(1.0/3.0)) - aa * ((a_val - 2.0 * z_val)**2) / a_val
        return float(term)

    def hamzah_binding_energy(self, a: float, z: float, s_mat: float) -> float:
        """محاسبه انرژی بستگی بر اساس چگالی اطلاعاتی و آنتروپی ساختاری در مدل HIP"""
        a_val = float(a)
        s_val = float(s_mat)
        i_density = a_val * 1.5e-13
        energy = (i_density / (s_val + self.EPSILON_FLOOR)) * (self.OMEGA_H**2)
        return float(energy / 1e6)  # تبدیل واحد به MeV

    def evaluate_element(self, name: str, a: float, z: float, s_mat: float) -> Dict[str, Any]:
        """ارزیابی مقایسه‌ای عناصر کلیدی مانند آهن و اورانیوم"""
        e_c = self.classical_binding_energy(a, z)
        e_h = self.hamzah_binding_energy(a, z, s_mat)
        
