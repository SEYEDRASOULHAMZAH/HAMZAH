        # ثابت‌های بنیادین مدل HIP
        self.OMEGA_H: float = 1.176e10
        self.EPSILON_FLOOR: float = 1.155e-20
        self.T_CROSS: float = 1.0e8
        logging.info("راه‌اندازی کنترلر سازمانی نظم کیهانی (کلاسیک در برابر همگام‌سازی آنی HIP) در مانیفلد 1155D")

