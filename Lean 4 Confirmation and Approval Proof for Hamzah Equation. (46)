                    if dist_to_line < threshold:
                        manifold[i, j] = 1.0  # تونل باز است (آنتروپی صفر / شفافیت کامل اطلاعاتی)
                    else:
                        manifold[i, j] = 0.1  # فضای عادی مانیفلد (آنتروپی بالا)

