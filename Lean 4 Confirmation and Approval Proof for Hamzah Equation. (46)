                "Manifold_Topology": self.manifold,
                "Mean_Bekenstein_Limit": f"{mean_bek:.4e}",
                "Mean_HIP_Capacity": f"{mean_hip:.4e}",
                "Tensor_Standard_Deviation": f"{tensor_std:.8e}",
                "Verification_Status": status
            }
        except Exception as e:
            return {"Error": f"خطا در پردازش تانسوری بکنشتاین: {str(e)}"}

