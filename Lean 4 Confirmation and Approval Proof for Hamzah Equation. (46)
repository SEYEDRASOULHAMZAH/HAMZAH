    def hamzah_oscillation_probability(self, l_dist: float, energy: float, s_local: float) -> Union[float, str]:
        """محاسبه احتمال نوسان نوترینو بر اساس گرادیان چگالی اطلاعات و فاز مانیفلد"""
        l_val = float(l_dist)
        e_val = float(energy)
