        """ارزیابی گره فاصله برای نوسان در خلاء و ماده"""
        s_vacuum = 0.1e-20
        s_matter = 5.0e-20
        
        p_vac = self.hamzah_oscillation_probability(l_dist, 1.0, s_vacuum)
        p_mat = self.hamzah_oscillation_probability(l_dist, 1.0, s_matter)
        
