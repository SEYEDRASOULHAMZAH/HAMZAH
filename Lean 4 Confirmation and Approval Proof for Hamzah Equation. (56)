        dt_min = 0.001
        dt_max = 0.02
        dt = dt_max
        lagrangian_coupling_1155D = 1.155

        Cv = np.zeros(max_steps + 1, dtype=np.float64)  # Thyroid tissue homeostasis index
        Cd = np.zeros(max_steps + 1, dtype=np.float64)  # Pathological kinase and vascular addressing load
        P = np.zeros(max_steps + 1, dtype=np.float64)   # MEN2-MTC tumor vascular infiltration index
        Cv[0] = 100.0
        Cd[0] = 0.85
        P[0] = 1.0

