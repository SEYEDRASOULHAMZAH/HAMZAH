        logging.info(f"Initializing Wormhole Traversal Kernel for Cluster: {self.cluster_id} in {self.MANIFOLD_DIM}D.")

    def classical_tidal_force(self, mass: float, r_throat: float = 1.0, M_eff: float = 1e30) -> float:
