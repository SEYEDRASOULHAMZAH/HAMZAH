                "Sample_Points": int(points),
                "Peak_Amplitude": float(np.max(captured_signal)),
                "Mean_Signal_Power": float(np.mean(np.square(captured_signal)))
            }
        except Exception as ex:
            self.integrity_score -= 0.3
            logging.error(f"خطای محاسباتی در استریم HPT: {str(ex)}")
            return {"Error": str(ex)}

