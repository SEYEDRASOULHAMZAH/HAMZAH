            pulse = np.exp(-((t - 0.5 * window_ns) ** 2) / ((0.1 * window_ns) ** 2)) * np.sin(2 * np.pi * self.OMEGA_H * t)
            noise = np.random.normal(0, 0.5, points)
            captured_signal = pulse + noise

