            "Cluster_ID": self.cluster_id,
            "Manifold_Dimension": self.MANIFOLD_DIM,
            "HPT_Frequency_Hz": self.OMEGA_H,
            "Sampling_Rate_Hz": self.FS,
            "Stream_Metrics": stream_data,
            "Kernel_Status": "FULLY_OPERATIONAL_HPT_MODEL",
            "Integrity_Score": round(self.integrity_score, 2)
        }
        return report

