        """محاسبه همگرایی محاسباتی پایدار در مدل حمزه (HIP) در مانیفلد 1155D"""
        if steps.size == 0:
            self.integrity_score -= 0.1
            return np.zeros(1)
        return np.ones_like(steps) * self.EPSILON_FLOOR

    def evaluate_drift_resilience(self, max_steps: int = 100) -> Dict[str, Any]:
        """ارزیابی مقایسه‌ای رانش هندسی LQG در برابر همگرایی پایدار HIP"""
