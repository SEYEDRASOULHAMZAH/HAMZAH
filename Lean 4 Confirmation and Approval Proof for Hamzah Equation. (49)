        stress_levels = np.linspace(1, max_stress, 500)
        m_resp = self.m_theory_stress_response(stress_levels)
        hip_resp = self.hip_1155d_stress_response(stress_levels)

        max_m_collapse = float(np.max(m_resp))
        max_hip_stable = float(np.max(hip_resp))

        return {
            "M_Theory_Max_Divergence": max_m_collapse,
            "Hamzah_1155D_Max_Stability": max_hip_stable,
            "Stress_Verdict": "HAMZAH_1155D_ABSOLUTE_STABILITY_VERIFIED",
            "Status": "NOMINAL"
        }

