        logging.info(f"Initializing HPT Kernel for Cluster: {self.cluster_id} in {self.MANIFOLD_DIM}D.")

    def generate_hpt_stream(self, window_ns: float = 1e-9, points: int = 50) -> Dict[str, Any]:
        """تولید سیگنال پالس تونل‌زنی و نویز حرارتی با پایش انتروپی"""
        if points <= 0 or window_ns <= 0:
