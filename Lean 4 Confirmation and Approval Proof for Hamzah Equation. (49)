        try:
            flux = float(D * grad_c)
            logging.info("شارش نفوذ کلاسیک با موفقیت محاسبه شد.")
            return flux
        except Exception as ex:
            self.integrity_score -= 0.2
            logging.error(f"خطا در نفوذ کلاسیک: {str(ex)}")
            return {"Error": str(ex)}

